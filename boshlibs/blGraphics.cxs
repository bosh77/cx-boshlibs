Class blScrollBar Extends blGraphic

	Global scrollbars:= New List<blGraphic>
	
	'Field fn:Myfontnew
	
	Field minv, maxv
	
	Field value:Float
	
	Field obar:float
	
	Field hookon
	Field hooky:Float
	
	Field stp:Float
	
	Field orient '0-VERT  1-ORIZ
	
	Field xb1, yb1, wb1, hb1
	
	'Method New(x:float, y:float, w:float, h:float, co1, MinVal, MaxVal, Parent:blGraphic, Value:float = 0, Stp:float = 1, a:float = 1) ', f:Myfontnew, txt:String, co1, co2, ju, a:Float = 1, sc:float = 1)
	Method New(x:float, y:float, w:float, h:float, MinVal, MaxVal, Stp, orie)
	
		Self.typeobj = 2
	
		'Self.parent = Parent
		
		Self.minv = MinVal
		
		Self.maxv = MaxVal
		
		Self.stp = Stp
		
				
		Self.xb1 = x
		Self.yb1 = y
		Self.wb1 = w
		Self.hb1 = h
	
		Self.orient = orie
		
		'Self.a = a
		
		'Self.r = r
		'Self.g = g
		'Self.b = b
		'Self.txt = txt
		
		'Self.col1 = co1
		'Self.col2 = co2
	
		'Self.ju = ju
		
		'Self.a = a
		
		'Self.sc = sc
		
		
		'Self.parent = d
		
		'draws.AddLast(Self)
		'AddToList Self
		
		scrollbars.AddLast(Self)
		
		
	End Method
	
	Method DrawBar(canv:Canvas) ', docu:blDocument, x1, y1, w1, h1)
	
		
		'Local xx, yy, xb
				
		'If docu Then xb = docu.ww2 + 6
		
		If obar < 0 Then obar = 0
		
		
		IdeUiSetCanvas canv, IDEUI_SCROLL_TRACK
		canv.DrawRect(xb1, yb1, wb1 - 2, hb1 - 2)
				
		canv.SetColor 1, 1, 1
		
		Select orient
		
			Case 0
		
				'xx = x1 + x2 - wb1
				'yy = y1 + y2 - 20
				
				'If obar > hb1 - 20 Then obar = hb1 - 20
				
				canv.DrawImageRect(objsimg, xb1, yb1, 80, 0, 20, 20) ', 0, 0.5, 0.5)
				canv.DrawImageRect(objsimg, xb1, yb1 + hb1 - 20, 100, 0, 20, 20) ', 0, 0.5, 0.5)
				canv.DrawImageRect(objsimg, xb1 + 2, yb1 + 20 + obar, 120, 0, 20, 30) ', 0, 0.5, 0.5)
	
			Case 1
		
				'xx = x1 + xb '+ x2 - wb1
				'yy = y1 + y2 - 20
				
				'If obar > wb1 - 20 Then obar = wb1 - 20
				
				canv.DrawImageRect(objsimg, xb1, yb1, 40, 0, 20, 20) ', 0, 0.5, 0.5)
				canv.DrawImageRect(objsimg, xb1 + wb1 - 20, yb1, 60, 0, 20, 20) ', 0, 0.5, 0.5)
				canv.DrawImageRect(objsimg, xb1 + 20 + obar, yb1 + 2, 40, 20, 30, 20) ', 0, 0.5, 0.5)

				
		End
	
		
	End Method
	
	Method UpdateBar() 'docu:blDocument, x1, y1, x2, y2)
	
		'Local xx = xb1 ' + w
		'Local yy = yb1 + 20 + obar
							
		
		Select orient
				
			Case 0
		
				If IsTouchHit(xb1, yb1 + 20 + obar, 20, 30) Then hookon = 1; hooky = ymou - obar
		
				Local tr = 0
				
				If IsTouchRep(xb1, yb1, 20, 20) Then obar = obar - stp; tr = 1
		
				If IsTouchRep(xb1, yb1 + hb1 - 20, 20, 20) Then obar = obar + stp; tr = 1 '; Print stp
		
				'Print scrolly * stp
		
				'If IsOnRect(xb1, yb1, wb1, hb1) Then ybar = ybar - zmou * stp
		
				If hookon Then obar = ymou - hooky
				
				'If hookon or tr Then
		
				CheckOBARlimits
		
				If hookon or tr Then
				
					SetValueFromOBAR
			
				EndIf
				
				If value < 0 Then value = 0
				
				'If value > maxv Then value = maxv
				
				'Print maxv
				'Print value
				
			Case 1
				
				If IsTouchHit(xb1 + 20 + obar, yb1, 20, 30) Then hookon = 1; hooky = xmou - obar
		
				Local tr = 0
				
				If IsTouchRep(xb1, yb1, 20, 20) Then obar = obar - stp; tr = 1
		
				If IsTouchRep(xb1 + wb1 - 20, yb1, 20, 20) Then obar = obar + stp; tr = 1 '; Print stp
		
				'Print scrolly * stp
		
				'If IsOnRect(xb1, yb1, wb1, hb1) Then ybar = ybar - zmou * stp
		
				If hookon or tr Then obar = xmou - hooky
		
				'If hookon or tr Then
				
				CheckOBARlimits
		
				If obar < 0 Then obar = 0
				
				'If hookon or tr Then
				
				SetValueFromOBAR
				
				If value < 0 Then value = 0
				
				'If value > maxv Then value = maxv
				
				'EndIf
				
				
		End
				
		If touchrel or (touchdown = 0 and touchhit = 0) Then hookon = 0
		
		
	End Method
	
	Method CheckOBARlimits()
		
		Select orient
				
			Case 0
			
				If obar < 0 Then obar = 0
		
				Local maxy = hb1 - 72
				If obar > maxy Then obar = maxy
				
			Case 1
			
				If obar < 0 Then obar = 0
		
				Local maxx = wb1 - 72
				If obar > maxx Then obar = maxx
			
		End
				
	End
	
	Method SetValueFromOBAR()
		
		Select orient
				
			Case 0
			
				Local hh:Float = hb1 - 72
				value = (obar + 0.0001) * maxv / Float(hh)
				
			Case 1
			
				Local ww:Float = wb1 - 72
				value = obar / Float(ww) * maxv
				
		End
			
	End
	
	Method SetOBARFromValue()
	
		Select orient
		
			Case 0
			
				Local hh = hb1 - 72
				'obar = Float(value) * Float(hh) / Float(maxv)
				obar = Float(value + 0.0001) * Float(hh) / Float(maxv)
			
			Case 1
		
				Local ww = wb1 - 72
				'obar = Float(value) * Float(ww) / Float(maxv)
				obar = Float(value) * Float(ww) / Float(maxv)
			
		End
		
		CheckOBARlimits
		SetValueFromOBAR
		
		'If obar < 0 Then obar = 0
						
	End Method
	
End
	




Function GetAbsScrX:Int(v:Float)
	
	If v < 0 Then
		
		Return Abs(v)
		
	Else
		
		Return DeviceWidth * v
		
	EndIf

End Function

Function GetAbsScrY1:Int(v:Float)
	
	If v < 0 Then
		
		Return Abs(v)
		
	Else
		
		Return DeviceHeight * v
		
	EndIf

End Function
Function GetAbsScrY2:Int(v:Float)
	
	If v < 0 Then
		
		Return DeviceHeight + v
		
	Else
		
		Return DeviceHeight * v
		
	EndIf

End Function

Function GetAbsX:Int(v:Float)
	
	Return ScrW * v

End Function

Function GetRelX:Float(V)

	Return Float(V) / Float(ScrW)
	
End Function

Function GetAbsY:Int(v:Float)

	Return ScrH * v

End Function

Function GetRelY:Float(V)

	Return Float(V) / Float(ScrH)
	
End Function

Function GetAbsW:Int(v:Float)
	
	Return ScrW * v

End Function

Function GetAbsH:Int(v:Float)

	Return ScrH * v

End Function

Function MySetColor(canv:Canvas, r, g, b)
	
	canv.SetColor(r / 255.0, g / 255.0, b / 255.0)
	
End
	
Function MySetColor(canv:Canvas, c)
	
	Local r2:Float = ( (c shr 16) & 255) / 255.0
	Local g2:Float = ( (c shr 8) & 255) / 255.0
	Local b2:Float = (c & 255) / 255.0
		
	canv.SetColor(r2, g2, b2)
	
End

