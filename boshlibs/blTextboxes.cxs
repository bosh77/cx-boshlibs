	Method SetStartValues()
		
		
		VSBar.value = line
		VSBar.SetOBARFromValue
			
		HSBar.value = xoffdraw
		HSBar.SetOBARFromValue
		
		GetCursorLine
		
		hlNeedViewport = 1
		hlIdleId1 = -1
		hlIdleId2 = -1
		line2 = -1
		
	End
	
	Function MakeLinesAll()
		
		For Local o1:= EachIn blSheet.allsheets
			
			For Local proj:= EachIn o1.childsboxes
		
				proj.MakeLines
						
			Next
			
		Next
		
	End
	
	Method MakeLines()
	
		For Local o1:= EachIn blSheet.allsheets
			
			For Local proj:= EachIn o1.childsboxes
		
				If proj.doc = doc Then proj.MakeLines2
				
			Next
			
		Next
	
	End

	Method DocLogicalContentEnd:Int()
		If doc = Null Then Return 0
		Local l:Int = doc.Crs.Length
		If l <= 0 Then Return 0
		For Local i:Int = l - 1 To 0 Step -1
			If (doc.Crs[i] & 255) <> 0 Then Return i + 1
		Next
		Return 0
	End
	
	Method DocEnsureCrsTerminator()
		If doc = Null Then Return
		
		Local endPos:Int = DocLogicalContentEnd()
		Local needLen:Int = endPos + 2
		If needLen > doc.Crs.Length Then
			doc.Crs = doc.Crs.Resize(needLen + doc.stepcrs)
		EndIf
		
		doc.Crs[endPos] = 0
		doc.Crs[endPos + 1] = 0
		For Local i:Int = endPos + 2 To doc.Crs.Length - 1
			doc.Crs[i] = 0
		Next
	End
	
	Method DocNeedsLineRebuildAfterEdit:Int(insertPos:Int, oldChar:Int)
		If doc = Null Then Return 0
		
		' File grandi: rebuild completo solo se cambia la struttura righe (CR/LF).
		If doc.numtotallines > 8000 Then
			If oldChar = 13 Or oldChar = 10 Then Return 1
			If oldChar = 0 Then
				If insertPos >= 0 And insertPos < doc.Crs.Length Then
					Local cDel:Int = doc.Crs[insertPos] & 255
					If cDel = 13 Or cDel = 10 Then Return 1
				EndIf
			EndIf
			Return 0
		EndIf
		
		If oldChar = 0 Then Return 1
		Local logicalEnd:Int = DocLogicalContentEnd()
		If insertPos >= logicalEnd - 1 Then Return 1
		If insertPos >= maxcrs - 2 Then Return 1
		Return 0
	End
	
	Method ShiftIdlinesAfterPos(delta:Int, pos:Int)
		If delta = 0 Then Return
		If doc.idlines < 2 Then Return
		
		Local maxLineIdx:Int = doc.idlines - 2
		If maxLineIdx < 0 Then maxLineIdx = 0
		
		Local lo:Int = 0
		Local hi:Int = maxLineIdx
		Local curLine:Int = 0
		
		While lo <= hi
			Local mid:Int = (lo + hi) / 2
			Local s:Int = doc.idline[mid]
			Local e:Int = doc.idline[mid + 1]
			
			If pos < s Then
				hi = mid - 1
			ElseIf pos >= e Then
				lo = mid + 1
			Else
				curLine = mid
				Exit
			EndIf
		Wend
		
		For Local i:Int = curLine + 1 To doc.idlines - 1
			doc.idline[i] += delta
		Next
		
		maxcrs += delta
	End
	
	Method MakeLines2()

		DocEnsureCrsTerminator()

		' Fotografia della tabella degli inizi riga PRIMA che venga rifatta: e' il
		' solo modo per sapere da quale riga in poi il documento e' cambiato, dato
		' che qui si riscansiona tutto senza sapere dove si e' editato.
		' Serve a ScopeShiftForEdit; senza, ogni Invio azzera i colori semantici.
		Local shOldIdline:Int[]
		Local shOldLines:Int = -1
		If ScopeShiftPossible() Then
			shOldLines = doc.numtotallines
			Local n:Int = shOldLines
			If n > doc.idline.Length Then n = doc.idline.Length
			shOldIdline = New Int[n]
			For Local i:Int = 0 To n - 1
				shOldIdline[i] = doc.idline[i]
			Next
		EndIf

		linemaxlen = 0

		For Local i:Int = 0 To maxlines - 1
			doc.idline[i] = 0
		Next

		doc.idlines = 1

		Local l:Int = doc.Crs.Length
		Local j:Int = 0

		For Local i:Int = 0 To l - 2

			j = j + 1

			Local c1:Int = doc.Crs[i] & 255
			Local c2:Int = doc.Crs[i + 1] & 255

			If c1 = 13 And c2 = 10 Then

				doc.idline[doc.idlines] = i + 2
				doc.idlines = doc.idlines + 1

				If linemaxlen < j Then linemaxlen = j

				j = 0

			End If

			If c1 = 0 And c2 = 0 Then
				Local hasMore:Int = 0
				Local k:Int = i + 2
				While k < l - 1
					If (doc.Crs[k] & 255) <> 0 Then
						hasMore = 1
						Exit
					EndIf
					k += 1
				Wend
				
				If hasMore Then
					i += 1
					Continue
				EndIf
				
				doc.idline[doc.idlines] = i + 2
				doc.idlines = doc.idlines + 1

				If linemaxlen < j Then linemaxlen = j

				Exit
				
			End If

		Next

		maxcrs = doc.idline[doc.idlines - 1] + 1

		doc.idline[doc.idlines] = doc.idline[doc.idlines - 1]
		doc.idlines = doc.idlines + 1
            
		doc.numtotallines = doc.idlines

		' I /* */ del C/C++ attraversano le righe: qui, che le righe sono appena
		' state rifatte, si ricalcola quali cominciano dentro un commento.
		' Non fa niente sugli altri linguaggi.
		HL_CLikeScanBlockComments()

		' Riallinea la mappa degli scope alle righe nuove invece di lasciarla
		' scadere: i colori di Global/Field/Local restano vivi durante il rebuild.
		If shOldLines >= 0 Then ScopeShiftForEdit(shOldIdline, shOldLines)

		VSBar.maxv = doc.idlines

		MarkScopeDirty()
		MarkShortcutsDirty()
		HL_InvalidateLocalsCache()
		HL_InvalidateAllLineColors()
		hlNeedViewport = 1
		hlIdleId1 = -1
		hlIdleId2 = -1
		scopeDirtyFromLine = 0
		line2 = -1
		
		
		'note: SET NEW LINE MODIFY <--------
		GetCursorLine
		
		
		'Local editLn:Int = linecaret
		'editLn = Self.line
		
		Local KP:= focussheet.focusbox
		
		If KP Then
		
			Local editLn = KP.line
		
			'Print "*->" + editLn
			If doc.numtotallines2 <> doc.numtotallines Then
			
				Local dl:Int = doc.numtotallines2 - doc.numtotallines
				Local samePath:String = HL_NormalizePath(doc.fullname)
				For Local o1:= EachIn blSheet.allsheets
					For Local proj:= EachIn o1.childsboxes
						' i riquadri di disegno non hanno un documento di testo
						If proj.doc = Null Then Continue
						If proj <> KP And HL_NormalizePath(proj.doc.fullname) = samePath Then
					
							'Print "#->" + proj.line
						
							If proj.line > editLn Then
							
								'Print "3"

								proj.line -= dl
								'If proj.line < 0 Then proj.line = 0
								If proj.line > proj.doc.numtotallines - 2 Then proj.line = proj.doc.numtotallines - 2
								If proj.line < 0 Then proj.line = 0
							
								'proj.line = 0 '***
								'Print "SET L"
							
								proj.VSBar.value = proj.line
								proj.VSBar.SetOBARFromValue
								proj.line2 = -1
							EndIf
						EndIf
					Next
				Next
			EndIf
		
		
			doc.numtotallines2 = doc.numtotallines
		
		EndIf
		
	End
	
	
	
	Method DelChar()
	
		Local l:Int = doc.Crs.Length

		Local id1:Int = idcaret
		Local id2:Int = idcaret + 1

		If id2 > l - 1 Then id2 = l - 1
		
		Local wasCrlf:Int = 0
		If doc.Crs[id1] = 13 And doc.Crs[id2] = 10 Then wasCrlf = 1

		' Shift only the actual content, not the zero-padded tail of the allocated buffer.
		Local hi:Int = maxcrs - 1
		If hi <= 0 Or hi > l - 1 Then hi = l - 1
		If hi < idcaret Then hi = idcaret
		
		If wasCrlf Then

			For Local i:Int = idcaret To hi - 1
				doc.Crs[i] = doc.Crs[i + 1]
			Next
			doc.Crs[hi] = 0
			For Local i:Int = idcaret To hi - 1
				doc.Crs[i] = doc.Crs[i + 1]
			Next
			doc.Crs[hi] = 0
			If hi < l - 1 Then doc.Crs[hi + 1] = 0

		Else

			For Local i:Int = idcaret To hi - 1
				doc.Crs[i] = doc.Crs[i + 1]
			Next
			doc.Crs[hi] = 0

		End If

		doc.Crs[l - 1] = 0
		
		DocEnsureCrsTerminator()
		
		If wasCrlf Then
			MakeLines()
		ElseIf DocNeedsLineRebuildAfterEdit(idcaret, 0) Then
			MakeLines()
		Else
			ShiftIdlinesAfterPos(-1, id1)
		EndIf
		
		
		'Highlightingline(linecaret - 1)
		'Highlightingline(linecaret)
		'Highlightingline(linecaret + 1)
        
		NotifyDocEdited
		HighlightinglineCaret()
		MarkScopeDirty()
		MarkShortcutsDirty()
	
		
	End Method
	
	Method InsChar(c)
		
		Local l:Int = doc.Crs.Length

		If idcaret >= l - doc.stepcrs Or doc.Crs[l - 1] > 0 Then
						
			doc.Crs = doc.Crs.Resize(l + doc.stepcrs)

			l = doc.Crs.Length

		End If

		Select modecaret
		
			Case True

				doc.Crs[idcaret] = c

				idcaret = idcaret + 1
				MarkScopeDirty

			Case False

				' Shift only the actual content, not the zero-padded tail of the allocated buffer.
				Local hi:Int = maxcrs
				If hi <= 0 Or hi > l - 1 Then hi = l - 1 Else hi -= 1
				If hi < idcaret Then hi = idcaret
				
				For Local i:Int = hi To idcaret Step - 1

					doc.Crs[i + 1] = doc.Crs[i]
					
				Next

				doc.Crs[idcaret] = c

				idcaret = idcaret + 1
				MarkScopeDirty

		End
			
	End Method
	
	
	
	Method MoveCaretToEnd(isshift:Bool)
		
		Local idl2:Int = doc.idline[linecaret + 1] - 2
		idcaret = idl2

		Select isshift

			Case 0

				idstartsel = idcaret
				idendsel = idcaret

			Case True

				idendsel = idcaret

		End Select
		
		'CaretOutOfScreen()
		
	End Method
	
	Method MoveCaretToHome(isshift:Bool)
		
		Local idl2:Int = doc.idline[linecaret]
		idcaret = idl2

		Select isshift

			Case 0

				idstartsel = idcaret
				idendsel = idcaret

			Case True

				idendsel = idcaret

		End Select
            
		'CaretOutOfScreen()
			
	End Method
	
