	Method CloseBox(sh:blSheet)
		
		If doc.textchanged = 1 Then
						
			Local asksave:Int = Proceed("SAVE PROJECT", "Do you want to save the changes to the project " + doc.projname + "?", True)
			
			'Print asksave
			
			If asksave = 1 Then doc.SaveFile(doc.fullname)
							
			If asksave = -1 Then Return 100  'ANNULLA
							
		EndIf
		
		'Print "CLOSE TEXTBOX"
					
		sh.childsboxes.Remove(Self)
								
		If sh.childsboxes.IsEmpty Then
					
			blSheet.CloseSheet(sh)
					
			If Not blSheet.allsheets.IsEmpty Then
				
				focussheet = blSheet.allsheets.Last
				focussheet.focusbox = focussheet.childsboxes.Last
				
			Else
				
				'focussheet.focusbox = Null
				ClearALL
				
				If namesolution <> "" Then CloseSolution
				
			EndIf
			
		Else
		
			sh.focusbox = sh.childsboxes.Last
			
		EndIf
		
		
		RemoveDocumentsNotUsed
		
		
	End
	
	Method CloseBoxNoAsk(sh:blSheet)
		
		sh.childsboxes.Remove(Self)
		
		If sh.childsboxes.IsEmpty Then
					
			blSheet.CloseSheet(sh)
					
			If Not blSheet.allsheets.IsEmpty Then
				
				focussheet = blSheet.allsheets.Last
				focussheet.focusbox = focussheet.childsboxes.Last
				
			Else
			
				ClearALL
				
			EndIf
			
		Else
		
			sh.focusbox = sh.childsboxes.Last
			
		EndIf
	
		
		RemoveDocumentsNotUsed
		
			
	End
	
	Method TextSelected:String() Property
        
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then

			idsel1 = idendsel
			idsel2 = idstartsel

		End If

		Local ch:Int[idsel2 - idsel1]

		For Local i:Int = idsel1 To idsel2 - 1

			ch[i - idsel1] = doc.Crs[i] & 255

		Next

		'Return New String(ch).TrimEnd(Chr(0))
		Local txt:String = String.FromChars(ch).Trim 'TrimEnd(Chr(0))
		
		Return txt
        
	End Method
	
	
	Method UpdateMouseWheel()
		
	
		line = line - zmou * 2 '; Print zmou
				
		VSBar.value = line
				
				
		VSBar.SetOBARFromValue()
		HighlightVisibleLinesNow()
		
	End Method
	
	
	Method DrawTextBox(canv:Canvas, x1, y1, x2, y2)
		
		numlineinpage = (y2 - 70 + (1 - KHbox) * 20) / ykscale
		If numlineinpage < 1 Then numlineinpage = 1
		
		If ScopeWorkPaused() = 0 Then
			Local sct0:Int = Millisecs()
			EnsureScopeVarCache(1)
			If acDocDeclRebuildOn Then AC_RebuildDocDeclCacheIfNeeded()
		EndIf
		
		If scRefreshPending And actfocusmode = idfocus And doc.textlocked = 0 Then
			Local scDeb:Int = 2500
			If IDE_FileIsLarge() Then scDeb = 4000
			Local sameOpen:Int = 0
			Local docPathDeb:String = HL_NormalizePath(doc.fullname)
			If docPathDeb <> "" Then
				For Local o1:= EachIn blSheet.allsheets
					For Local proj:= EachIn o1.childsboxes
						' i riquadri di disegno non hanno un documento di testo
						If proj.doc = Null Then Continue
						If proj <> Self And HL_NormalizePath(proj.doc.fullname) = docPathDeb Then
							sameOpen = 1
							Exit
						EndIf
					Next
					If sameOpen Then Exit
				Next
			EndIf
			If sameOpen Then scDeb = 0
			If Millisecs() - scRefreshDirtyMs >= scDeb Then
				RefreshShortcuts()
				scRefreshPending = 0
			EndIf
		EndIf
		
		If actfocusmode = idfocus And doc.textlocked = 0 And typewin <> 3 Then
			Local docPathNow:String = HL_NormalizePath(doc.fullname)
			If docPathNow <> scRefreshDocPath Then
				scRefreshDocPath = docPathNow
				'#region debug-point open-t16-freeze:doc-path-refresh
				If IDE_FileIsLarge() Then
					DBG_KeypressLag_Event("hyp-refresh-shortcuts", "blTextbox.DrawTextBox.docPathRefresh", "Immediate RefreshShortcuts on file open/focus", "{~qfile~q:~q" + doc.fullname.Replace("~q", "'") + "~q,~qlines~q:" + String(doc.numtotallines) + "}")
				EndIf
				'#endregion
				RefreshShortcuts()
			EndIf
		EndIf
		
		If idcaret <> idcaret2 Then GetCursorLine()
		
		Local drawev, drawer
		
	
		IdeUiSetCanvas canv, IDEUI_TITLE_BAR
		canv.DrawRect(x1 + 6, y1 + 2, x2 - 8, 20)
		
		'		canv.SetColor 1, 1, 1
		'		DrawString(canv, font1, doc.fullname, x1 + 8, y1 + 3, -1, 0, 1)
		'DrawString(canv, font1, doc.fullname + "     " + line, x1 + 8, y1 + 3, -1, 0, 1)
		
		Local ww:Int = x1 + x2

		Local tls:String = doc.numtotallines
		
		doc.ww2 = 10 + xkscale * (tls.Length + 2)
		
		canv.SetAlpha 1
		canv.SetScissor x1, y1, x2, y2
		
		'num lines
		MySetColor canv, IdeUiGetR(IDEUI_LINENUM_BG), IdeUiGetG(IDEUI_LINENUM_BG), IdeUiGetB(IDEUI_LINENUM_BG)
		canv.DrawRect(x1 + 6, y1 + 24, doc.ww2, y2 - 26)
		
		MySetColor canv, IdeUiGetR(IDEUI_WIN_INNER_BG), IdeUiGetG(IDEUI_WIN_INNER_BG), IdeUiGetB(IDEUI_WIN_INNER_BG)
		canv.DrawRect(x1 + doc.ww2 + 6, y1 + 24, x2 - doc.ww2 - 10, y2 - 26)
		
		
		Local l:Int = doc.Crs.Length
				
		Local x:Int = x1 + doc.ww2 + 8
		Local y:Int = y1 + 24 + 2
		
		Local jx:Int = 0
		
		If line > doc.idlines - 1 Then line = doc.idlines - 1

		If line < 0 Then line = 0
		
		
		Local ll:Int = line
		
		Local idstartline:Int = doc.idline[line]
				
		idclic = 0
		
		caretoutofscr = True
		xoutscr = 0
			
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel
		
		If idstartsel > idendsel Then

			Local id0:Int = idsel1
			idsel1 = idsel2
			idsel2 = id0

		End If
			
		Local selon:Bool
		
		If idsel1 < idstartline Then
			If idsel1 <> idsel2 Then
				selon = True
			EndIf
		EndIf
		
		
		If xoffdraw < 0 Then xoffdraw = 0
		
		Local drwt0:Int = Millisecs()

		'start draw text box
		For Local i:Int = idstartline To l - 1

			If idsel1 = i Then selon = True
			
			If i >= idsel2 Then selon = False

			Local c1:Int = doc.Crs[i] & 255
			Local c2:Int = (doc.Crs[i] & 65280) shr 8
							
					
			'DRAW NUMBER LINE
			canv.SetScissor x1, y1, x2, y2
			If x = x1 + doc.ww2 + 8 Then
				
				Local txtline:String = ll + 1

				'Dim stringSize As SizeF
				'stringSize = e.Graphics.MeasureString(txtline, ftext)
				
				
				'Local lx:Int = xxca + ww2 - txtline.Length * 9 - 8 - (kscale - 5) * 1.2
				Local lx:Int = x1 + doc.ww2 - txtline.Length * xkscale - 4 + 6
				
								
				'e.Graphics.DrawString(txtline, ftext, pl, New PointF(ww2 - stringSize.Width - 5, y))
				MySetColor canv, IdeUiGetR(IDEUI_LINENUM_TEXT), IdeUiGetG(IDEUI_LINENUM_TEXT), IdeUiGetB(IDEUI_LINENUM_TEXT)
				'########
				'DrawTxtNew(txtline, lx, y, ks)
				'DrawString(canv, xfont1, txtline, lx, y, -1, 0, ks)
				DrawString(canv, xfont1, txtline, lx, y, -1, 0, 1)
				
				If HL_LineIsDeclClassMethodOrFunction(GetLineTextByIndex(ll)) Then
					Local sepY:Int = y - 3
					If sepY > y1 + 24 Then
						MySetColor canv, IdeUiGetR(IDEUI_DECL_SEPARATOR), IdeUiGetG(IDEUI_DECL_SEPARATOR), IdeUiGetB(IDEUI_DECL_SEPARATOR)
						canv.DrawRect(x1 + 6, sepY, x2 - 8, 1)
					EndIf
				EndIf
				
			End If
						
			'e.Graphics.Clip = New Region(New Rectangle(ww2, 0, Width - 32, Height - 32))
			
			Local rx:Int = x - xoffdraw
			
			
			canv.SetScissor x1 + doc.ww2 + 6, y1, x2 - doc.ww2 - 26, y2 + (1 - KHbox) * 20
			
			'Cursore
			If i = idcaret Then
			
				xcaret = rx
				ycaret = y
				xposcaret = jx
				
				
				'e.Graphics.FillRectangle(CursorColor, New Rectangle(rx + 2, y + 1, wcaret, hcaret))
				
				Local kvisc
				
				'If focusboxok = 1 Then kvisc = 1
				
				'If focusboxok = 0 and actfocusmode = idfocus Then kvisc = 1
				
				'If focusboxok = 1 Then focusboxok = 0
				
				'If focusboxok Then
				
				If cursorvis = 1 Then kvisc = 1; cursorvis = 0
				
				If cursorvis2 = 0 and idfocus = 2 Then kvisc = 1
				 
				
				If kvisc Then
				
					If idetheme = 2 Then
						MySetColor canv, 0, 0, 0
					Else
						MySetColor canv, 255, 255, 0
					EndIf
				
					'If rx >= xxca + ww2 + 2 and rx < ww Then Gui.DrawRect(rx, y, wcaret, hcaret)
					If rx >= x1 + doc.ww2 + 2 + 6 and rx < ww and (caretcounter & 32) = 0 Then
				
						canv.SetBlendMode BlendMode.Additive
						canv.DrawRect(rx - 1, y - 1, wcaret + 1, hcaret)
						canv.SetBlendMode BlendMode.Alpha
					
					EndIf
					
				EndIf
				
				caretoutofscr = False
				
			End If
				
			'invio
			If i < l - 1 Then
				
				If c1 = 13 Then
								
					If (doc.Crs[i + 1] & 255) = 10 Then

						xclic[idclic] = rx
						wclic[idclic] = ww - doc.ww2
						yclic[idclic] = y
						cclic[idclic] = i

						idclic = idclic + 1

						x = x1 + doc.ww2 + 2 + 6
						y = y + ykscale
						i = i + 1
						ll = ll + 1
						jx = 0

						'numlineinpage = numlineinpage + 1

						If y > y1 + y2 - 44 + (1 - KHbox) * 20 Then Exit

						Continue
						
					EndIf
				
				EndIf
				
			EndIf
				
			'Local txt:String = String.FromChar(c1)

			'If c1 = 0 Then txt = "@"

			'colore carattere
			'Dim ccar = TextColor


			If xoutscr = 0 And rx > ww Then xoutscr = rx


			'scrive carattere
                
			If c1 > 0 And rx >= x1 + doc.ww2 - 8 And rx < ww Then

				'testo selezionato
				If selon Then

					' e.Graphics.FillRectangle(SelectColor, New Rectangle(rx + 3, y, xkscale, ykscale))
				
					If focussheet.focusbox = Self Then
						MySetColor canv, IdeUiGetR(IDEUI_SEL_TEXT), IdeUiGetG(IDEUI_SEL_TEXT), IdeUiGetB(IDEUI_SEL_TEXT)
					Else
						MySetColor canv, 100, 100, 100
					EndIf
					
					canv.DrawRect(rx, y - 1, xkscale, ykscale)
										
				EndIf

				If drawev = 0 and ll + 1 = lineevid Then
					
					If lineevidcount > 0 Then
					
						MySetColor canv, 0, 140, 0
				
						'canv.DrawRect(rx, y - 1, xkscale, ykscale)
						Local kal:Float = lineevidcount
						
						If kal > 150 Then kal = 150
						
						canv.SetAlpha kal / 150.0
						canv.DrawRect(rx, y - 1, x2, ykscale)
						canv.SetAlpha 1
					
						lineevidcount = lineevidcount - 1
						
						If lineevidcount = 0 Then lineevid = -1
						
					EndIf
					
					drawev = 1
					
				EndIf
				
				If drawer = 0 and ll + 1 = lineerror Then
				
					MySetColor canv, 120, 0, 0
				
					'canv.DrawRect(rx, y - 1, xkscale, ykscale)
					canv.DrawRect(rx, y - 1, x2, ykscale)
					
					drawer = 1
					
				EndIf
				
				
				'note: DRAW CHARACTER
				
				Local cooo
				
				Select c2
				
					Case 100, 101, 102, 103
				
						Local kc = c2 - 100 + (idetheme = 2) * 4
						
						MySetColor canv, allcolor[kc]
					
						cooo = allcolor[kc]
						
					Default
						
						Local kco = c2
				
						If kco >= 0 And kco < themecolor.Length Then
						
							MySetColor canv, themecolor[kco]
					
							cooo = themecolor[kco]
						
						Else
							
							cooo = -2
						
						EndIf
						
						
						
				End
								
				
				'SELECTED TEXT IS ALL WHITE
				if selon then cooo =-2
				
				'Sheet.DrawTxtNew(canv, txt, rx - (kscale - 5) * 1, y, ks)
				'				DrawCnew(c1, rx - (kscale - 5) * 1, y, ks)
				Local cstr:= String.FromChar(c1)
				
				'DrawString(canv, xfont1, cstr, rx - (kscale - 5) * 1, y, -1, 0, ks)
				
				DrawString(canv, xfont1, cstr, rx, y, cooo, 0, 1)
				
				
				xclic[idclic] = rx
				wclic[idclic] = xkscale
				yclic[idclic] = y
				cclic[idclic] = i
				idclic = idclic + 1

			EndIf
			
				
			x = x + xkscale
			jx = jx + 1
				
		Next


		lastline = ll
		lastDrawnLine = ll
		If lastDrawnLine < line Then lastDrawnLine = line
		
		If line2 <> line Then
			HL_RequestViewportHighlight(1)
			line2 = line
		EndIf
		
		'numlineinpage already set at start of DrawTextBox from viewport height
		
		Local ww2:Int = x2 - doc.ww2 - 20
		numcolinpage = ww2 / xkscale
		
		
		
		
				
		Local xvb, yvb, wvb, hvb
		Local xhb, yhb, whb, hhb
		
		If doc Then xhb = x1 + doc.ww2 + 6; xvb = x1 + x2 - 20
		
		yhb = y1 + y2 - 40 + (1 - KHbox) * 20; yvb = y1 + 22
		
		wvb = 20; hhb = 20
		
		hvb = y2 - 60 + (1 - KHbox) * 20; whb = x2 - (doc.ww2 + 6) - 20
		
		VSBar.xb1 = xvb
		VSBar.yb1 = yvb
		VSBar.wb1 = wvb
		VSBar.hb1 = hvb
		
		HSBar.xb1 = xhb
		HSBar.yb1 = yhb
		HSBar.wb1 = whb
		HSBar.hb1 = hhb
		
		
		VSBar.maxv = doc.numtotallines - 3 '********
		
		'HSBar.maxv = numcolinpage - linemaxlen
		Local maxxc = (linemaxlen - numcolinpage) * Float(xkscale)
		
		If maxxc < 0 Then maxxc = 0
		
		HSBar.maxv = maxxc
		
		'If doc.projname.EndsWith("txt") Then Print maxxc + "," + xoffdraw + "," + GetCursorX
		
		
		canv.SetScissor 0, 0, DeviceWidth, DeviceHeight
		
		VSBar.DrawBar(canv) ', doc, xvb, yvb, wvb, hvb)
		HSBar.DrawBar(canv) ', doc, xhb, yhb, whb, hhb)
		
		
		'rettangolo in fondo
		If KHbox Then
		
			'DrawTextBoxInfo(canv, x1, y1, x2, y2)
		
			MySetColor canv, 40, 40, 40
			canv.DrawRect(x1 + doc.ww2 + 6, y1 + y2 - 22, x2 - doc.ww2 - 6, 22)
	
			Local txtp:String = "Line: " + (linecaret + 1) + "  Char: " + (xposcaret + 1) + "   " + numcolinpage '+ "   " + GetCursorX



			MySetColor canv, 255, 255, 255
			DrawString(canv, font1, txtp, x1 + doc.ww2 + 8, y1 + y2 - 20, -1, 0, 1)
		
			Local perc:String = Int(kscalefont / 16.0 * 100) + "%"
			'Local tw:= xkscale * perc.Length  ' * font1.GetTextWidth("A", 0)
			DrawString(canv, font1, perc, x1 + x2 - 5, y1 + y2 - 20, -1, 2, 1)
			
		EndIf
		
		' Colorazione della pagina visibile.
		'
		' Prima qui c'era HL_SpreadStep(), che colorava 1-2 righe per frame
		' attorno al caret: da li' l'effetto "colore che arriva una riga alla
		' volta", e allo scroll le righe nuove non venivano coperte affatto,
		' perche' il ventaglio parte dal caret e non dal viewport.
		'
		' Highlightingscreen lavora invece sull'intervallo VISIBILE e ha gia' la
		' guardia idleSkip: se la pagina e' la stessa dell'ultima passata
		' completata (stessi id1/id2, stesso Crs, stesso undo, stessa versione
		' dei simboli) ritorna subito, quindi a schermo fermo non costa nulla.
		' Mantiene anche la pausa post-modifica, cosi' durante la digitazione non
		' ricolora l'intera pagina a ogni tasto: ci pensa HighlightinglineCaret
		' a tenere aggiornata la riga che si sta scrivendo.
		Local hlt0:Int = Millisecs()
		If line <> hlLastTopLn Then
			' Scroll: la pagina e' cambiata, va colorata subito senza aspettare la
			' pausa post-modifica. NON si usa forceAll = 1 perche' quello scavalca
			' anche il limite a burst: misurato, colorare 48 righe in un frame solo
			' costa 152 ms e produce un blocco visibile di 409 ms.
			' hlForceViewport salta la pausa e lascia in piedi il burst, cosi' la
			' pagina si riempie in 3-4 frame (~60 ms totali, impercettibili) invece
			' che in uno lunghissimo.
			hlLastTopLn = line
			hlForceViewport = 1
			Highlightingscreen()
			hlForceViewport = 0
		Else
			Highlightingscreen()
		EndIf


		
		AC_Draw(canv, x1, y1, x2, y2)
		CT_Draw(canv, x1, y1, x2, y2)
		DOC_Draw(canv, x1, y1, x2, y2)
		
		'
		'			Highlightingscreen
		'
		'			line2 = line
		'
		'		EndIf
		
		idcaret2 = idcaret
		
	End
	
	Method MarkShortcutsDirty()
		scRefreshPending = 1
		scRefreshDirtyMs = Millisecs()
	End
	
	Method NotifyDocEdited()
		doc.textchanged = 1
		textchangedit = 1
		' Il testo del documento e' cambiato: la copia tenuta da SRC_TextForFile
		' non vale piu'.
		srcCurVer = ""
		hlLastEditMs = Millisecs()
		hlParserSegsStale = 1
		hlNeedViewport = 1
		
		Local samePath:String = HL_NormalizePath(doc.fullname)
		If samePath <> "" Then
			For Local o1:= EachIn blSheet.allsheets
				For Local proj:= EachIn o1.childsboxes
					' i riquadri di disegno non hanno un documento di testo
					If proj.doc = Null Then Continue
					If proj <> Self And HL_NormalizePath(proj.doc.fullname) = samePath Then
						proj.hlParserSegsStale = 1
						proj.hlNeedViewport = 1
						proj.hlIdleId1 = -1
						proj.hlIdleId2 = -1
						proj.hlSpreadAnchorLn = -1
						proj.line2 = -1
					EndIf
				Next
			Next
		EndIf
		
		CheckerErrorsStart
	End
	
	Method HL_OnCaretLineChanged()
		' Spostare il cursore NON puo' cambiare label, funzioni e classi del file:
		' quelle dipendono dal contenuto. Marcare qui gli shortcut come "da
		' rifare" faceva scattare RefreshShortcuts, che fa TRE scansioni complete
		' del documento tokenizzando ogni riga: misurati 620-1450 ms su un file di
		' 4866 righe, cioe' i blocchi di oltre un secondo mentre ci si muove nel
		' codice. L'unica lista che dipende davvero dal caret e' la cronologia,
		' che si aggiorna da sola ed e' O(1).
		HL_RequestViewportHighlight(1)
		linecaret2 = linecaret
		If IsBackOrFor = True Then
			IsBackOrFor = False
		Else
			SetNewPosCaret()
		EndIf
	End
	
	Method UpdateTextBoxOne(x1, y1, x2, y2)
	
		'Local afm = idfocus
	
		Local xxca = x1 + doc.ww2 + 6
		Local yyca = y1
		Local wwca = x2 - doc.ww2 - 26
		Local hhca = y2 + (1 - KHbox) * 20
		
		
		If doc.textlocked = 0 and actfocusmode = idfocus Then
		
			'Keys
			Local c:= keypress '   GetChar
			
			If acOn And AC_HandleMouse(x1, y1, x2, y2) Then
				textchangedit = 1
				Return
			EndIf

			' ESC chiude la finestra dei parametri/overload anche quando la lista
			' autocomplete NON e' aperta.
			' Il ramo ESC qui sotto e' annidato dentro "If acOn Then", quindi con
			' il solo tip aperto (caso tipico: hai appena digitato la parentesi)
			' non veniva mai raggiunto e la finestra non si poteva chiudere.
			' ESC chiude prima il pannello della documentazione: e' l'ultimo aperto
			' e quindi il primo che l'utente si aspetta di chiudere.
			If docTipOn Then
				If KeyHit(KEY_ESCAPE) Then
					DOC_Close
					Return
				EndIf
			EndIf

			If ctOn And acOn = 0 Then
				If KeyHit(KEY_ESCAPE) Then
					CT_Close
					Return
				EndIf
			EndIf

			If acOn Then
				If KeyHit(KEY_ESCAPE) Then
					' Autocomplete + parameter info: ESC chiude solo il tip parametri, non la lista AC.
					If ctOn Then
						CT_Close
					Else
						AC_Close
					EndIf
					acKeyUp = 0
					acKeyDown = 0
					Return
				EndIf
				
				If KeyDown(KEY_UP) Then acKeyUp += 1 Else acKeyUp = 0
				If KeyDown(KEY_DOWN) Then acKeyDown += 1 Else acKeyDown = 0
				
				If KeyDown(KEY_UP) Or KeyDown(KEY_DOWN) Then
					' Con AC + parameter info: se ci sono piÃ¹ overload, Up/Down cambiano overload (come nel tip);
					' altrimenti le frecce muovono la lista autocomplete.
					If ctOn And acOn Then
						If ctOverloads.Length > 1 Then
							If acKeyUp = 1 Or acKeyUp > 20 Then
								ctOverloadIdx -= 1
								If ctOverloadIdx < 0 Then ctOverloadIdx = ctOverloads.Length - 1
								ctOverloadManual = 1
								CT_ApplyOverloadIndex
								textchangedit = 1
							EndIf
							If acKeyDown = 1 Or acKeyDown > 20 Then
								ctOverloadIdx += 1
								If ctOverloadIdx >= ctOverloads.Length Then ctOverloadIdx = 0
								ctOverloadManual = 1
								CT_ApplyOverloadIndex
								textchangedit = 1
							EndIf
							Return
						EndIf
						If acKeyUp = 1 Or acKeyUp > 20 Then
							acSel -= 1
							If acSel < 0 Then acSel = 0
						EndIf
						If acKeyDown = 1 Or acKeyDown > 20 Then
							acSel += 1
							If acSel >= acItems.Length Then acSel = acItems.Length - 1
						EndIf
						textchangedit = 1
						Return
					ElseIf ctOn Then
						acKeyUp = 0
						acKeyDown = 0
					Else
						If acKeyUp = 1 Or acKeyUp > 20 Then
							acSel -= 1
							If acSel < 0 Then acSel = 0
						EndIf
						
						If acKeyDown = 1 Or acKeyDown > 20 Then
							acSel += 1
							If acSel >= acItems.Length Then acSel = acItems.Length - 1
						EndIf
						
						Return
					EndIf
				EndIf
				
				If c = 9 Or c = 13 Then
					AC_Confirm(xxca, yyca, wwca, hhca)
					keypress = 0
					acKeyUp = 0
					acKeyDown = 0
					Return
				EndIf
				
				If c >= 32 And c <= 255 Then
					If AC_IsIdentChar(c) = 0 Then
						AC_Confirm(xxca, yyca, wwca, hhca, 1)
					EndIf
				EndIf
			EndIf
		
			If c >= 32 and c <= 255 Then
			
				'LostFocus '**
			
				lineerror = -1
		
				If c = 127 Then

					'SaveStateDoc()

					If idstartsel = idendsel Then

						SaveSelectedAndCancToUR(1)
						DelChar()
					
					
					Else

						SaveSelectedAndCancToUR(0)
						CancSelected()
					
					
					End If

					CaretOutOfScreen(xxca, yyca, wwca, hhca)
				
					'SaveStateDoc()
					'idurstates = idurstates - 1

					ctrlpress = 0
		
				Else
		
		
					'SaveStateDoc()
					SaveSelectedAndCharToUR(c)
				
					CancSelected()
								
					Local insertPos:Int = idcaret
					Local oldChar:Int = doc.Crs[idcaret] & 255
					
					InsChar(c)
					DocEnsureCrsTerminator()
				
					If modecaret Then
						If oldChar = 13 Or oldChar = 10 Then
							MakeLines
						ElseIf DocNeedsLineRebuildAfterEdit(insertPos, oldChar) Then
							MakeLines
						EndIf
					Else
						If DocNeedsLineRebuildAfterEdit(insertPos, oldChar) Then
							MakeLines
						Else
							ShiftIdlinesAfterPos(1, insertPos)
						EndIf
					EndIf
					
					GetCursorLine
					CaretOutOfScreen(xxca, yyca, wwca, hhca)
					'Highlightingline(linecaret)
			
					NotifyDocEdited
								
				EndIf
			
				'SetCurrentLine(True)
			
				textchangedit = 1
				HighlightinglineCaret()
				
				If AC_IsIdentChar(c) Or c = 46 Then
					AC_UpdateFromCaret
				Else
					AC_Close
				EndIf
				
				If c = 40 Or c = 44 Or c = 41 Then
					CT_UpdateFromCaret
				ElseIf c <> 32 Then
					CT_Close
				EndIf
				
			EndIf
		
		
		
			If c = 8 Then
			
				'LostFocus
			
				If idstartsel = idendsel Then

					BackSpaceChar()
			
				Else
			
					SaveSelectedAndBackspaceToUR(0)
					
					CancSelected()
			
				EndIf
							
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				NotifyDocEdited
				HighlightinglineCaret()
				
				AC_Close
				CT_Close
				
			EndIf
			
			If c = 9 Then
			
				'LostFocus
		
				SaveSelectedAndTabToUR()
				
				CancSelected()
				
				InsChar(32)
				InsChar(32)
				InsChar(32)
				InsChar(32)

				CaretOutOfScreen(xxca, yyca, wwca, hhca)

				MakeLines()
				'HighlightinglineNew(linecaret)
                               
				idstartsel = idcaret
				idendsel = idcaret
		
				NotifyDocEdited
				HighlightinglineCaret()
				
				AC_Close
				CT_Close
				
			EndIf
		
			If c = 13 Then
				
				'LostFocus
			
				saveline = linecaret
		
				SaveSelectedAndEnterToUR()
			
				CancSelected()

				InsEnter()
			
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				NotifyDocEdited
				HighlightinglineCaret()
			
			
				ParseLine
			
				CT_Close
				
			End If
		
			
			If KeyHit(KEY_ESCAPE) Then lineerror = -1; lineevid = -1; lineevidcount = 0
			
			If KeyDown(KEY_CONTROL) And KeyDown(KEY_Z) Then keyundo = keyundo + 1 Else keyundo = 0
			
			If KeyDown(KEY_CONTROL) And KeyDown(KEY_Y) Then keyredo = keyredo + 1 Else keyredo = 0
						
			
			If keyundo = 1 Or keyundo > 30 Then Undo(xxca, yyca, wwca, hhca) '; makeshcut = False; AllShortcuts
						
			'Redo
			'If KeyHit(KEY_Y) Then Redo
			If keyredo = 1 Or keyredo > 30 Then Redo(xxca, yyca, wwca, hhca) '; makeshcut = False; AllShortcuts
		
			
			If KeyDown(KEY_CONTROL) Then
			
				'Save file
				If KeyHit(KEY_S) Then
				
					'SAVE ALL ********
					If doc.textchanged = 1 Then doc.SaveFile(doc.fullname)
				
				EndIf

				'Set Main PRoject
				If KeyHit(KEY_K) Then
					If focussheet.mainbox = Self Then
						focussheet.mainbox = Null
					Else
						focussheet.mainbox = Self
					EndIf
				EndIf
			
			EndIf
		
		EndIf
		
		
		If actfocusmode = idfocus Then
		
			If KeyDown(KEY_LEFT) Then keyleft = keyleft + 1 Else keyleft = 0
			If KeyDown(KEY_RIGHT) Then keyright = keyright + 1 Else keyright = 0
			
			' PiÃ¹ overload: ripetizione su contatori dedicati (come keyleft), senza alimentare
			' keyup/keydown â€” altrimenti keyup=0 dopo ogni ciclo torna a 1 ogni frame e la
			' navigazione verticale "globale" si arma quando il tip si chiude col tasto giÃ¹.
			If ctOn And ctOverloads.Length > 1 And Not acOn Then
				If KeyDown(KEY_UP) Then ctOlKeyUp += 1 Else ctOlKeyUp = 0
				If KeyDown(KEY_DOWN) Then ctOlKeyDn += 1 Else ctOlKeyDn = 0
				keyup = 0
				keydown = 0
			Else
				ctOlKeyUp = 0
				ctOlKeyDn = 0
				If KeyDown(KEY_UP) Then keyup = keyup + 1 Else keyup = 0
				If KeyDown(KEY_DOWN) Then keydown = keydown + 1 Else keydown = 0
			EndIf
		
			If KeyDown(KEY_PAGEUP) Then keypageup = keypageup + 1 Else keypageup = 0
			If KeyDown(KEY_PAGEDOWN) Then keypagedown = keypagedown + 1 Else keypagedown = 0
							
			
		
			If keyleft = 1 Or keyleft > 30 Then
				AC_Close
			
				saveline = linecaret
			
				If KeyDown(KEY_SHIFT) Then
					MoveCaretToLeft(True)
				Else
					MoveCaretToLeft(False)
				EndIf
			
				xposcaretsav = GetCursorX2
			
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				ParseLine
			
			EndIf
		
			If keyright = 1 Or keyright > 30 Then
				AC_Close
			
				saveline = linecaret
			
				If KeyDown(KEY_SHIFT) Then
					MoveCaretToRight(True)
				Else
					MoveCaretToRight(False)
				EndIf
			
				xposcaretsav = GetCursorX2
			
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				ParseLine
			
			EndIf
		
			Local ctFireUp:Int = 0
			If ctOn And ctOverloads.Length > 1 And Not acOn Then
				If KeyHit(KEY_UP) Or ctOlKeyUp = 1 Or ctOlKeyUp > 30 Then ctFireUp = 1
			Else
				If keyup = 1 Or keyup > 30 Then ctFireUp = 1
			EndIf
			
			If ctFireUp Then
				' Un solo overload in lista: forza raccolta simboli (cache vuota) al primo colpo di
				' freccia â€” spesso il merge successivo espone piÃ¹ firme.
				If ctOn And ctOverloads.Length <= 1 And KeyHit(KEY_UP) Then
					ctDeclsCached = ctDeclsCached.Resize(0)
					CT_UpdateFromCaret
				EndIf
				If ctOn And ctOverloads.Length > 1 And Not acOn Then
					ctOverloadIdx -= 1
					If ctOverloadIdx < 0 Then ctOverloadIdx = ctOverloads.Length - 1
					ctOverloadManual = 1
					CT_ApplyOverloadIndex
					textchangedit = 1
				ElseIf ctOn And acOn And KeyDown(KEY_UP) Then
					acSel -= 1
					If acSel < 0 Then acSel = 0
					textchangedit = 1
					keyup = 0
				ElseIf ctOn Then
					keyup = 0
				Else
					AC_Close
				
					saveline = linecaret
				
					If KeyDown(KEY_SHIFT) Then
						MoveCaretToUp(1, True)
					Else
						MoveCaretToUp(1, False)
					EndIf
				
					CaretOutOfScreen(xxca, yyca, wwca, hhca)
				
					ParseLine
				EndIf
			
			EndIf
		
			Local ctFireDn:Int = 0
			If ctOn And ctOverloads.Length > 1 And Not acOn Then
				If KeyHit(KEY_DOWN) Or ctOlKeyDn = 1 Or ctOlKeyDn > 30 Then ctFireDn = 1
			Else
				If keydown = 1 Or keydown > 30 Then ctFireDn = 1
			EndIf
			
			If ctFireDn Then
				If ctOn And ctOverloads.Length <= 1 And KeyHit(KEY_DOWN) Then
					ctDeclsCached = ctDeclsCached.Resize(0)
					CT_UpdateFromCaret
				EndIf
				If ctOn And ctOverloads.Length > 1 And Not acOn Then
					ctOverloadIdx += 1
					If ctOverloadIdx >= ctOverloads.Length Then ctOverloadIdx = 0
					ctOverloadManual = 1
					CT_ApplyOverloadIndex
					textchangedit = 1
				ElseIf ctOn And acOn And KeyDown(KEY_DOWN) Then
					acSel += 1
					If acSel >= acItems.Length Then acSel = acItems.Length - 1
					textchangedit = 1
					keydown = 0
				ElseIf ctOn Then
					keydown = 0
				Else
					AC_Close

					saveline = linecaret
				
					If KeyDown(KEY_SHIFT) Then
						MoveCaretToDown(1, True)
					Else
						MoveCaretToDown(1, False)
					EndIf
				
					CaretOutOfScreen(xxca, yyca, wwca, hhca)
				
					ParseLine
				EndIf
			
			EndIf
		
			If keypageup = 1 Or keypageup > 30 Then
				AC_Close

				saveline = linecaret
		
				If KeyDown(KEY_SHIFT) Then
					'MoveCaretToPageUp(True)
					MoveCaretToUp(numlineinpage, True)
				Else
					'MoveCaretToPageUp(False)
					MoveCaretToUp(numlineinpage, False)
				EndIf
			
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				'AllShortcuts '**
			
				'SetCurrentLine(False) '**
			
				ParseLine
				HighlightVisibleLinesNow()
			
			EndIf
		
			If keypagedown = 1 Or keypagedown > 30 Then
				AC_Close
			
				saveline = linecaret
			
				If KeyDown(KEY_SHIFT) Then
					MoveCaretToDown(numlineinpage, True)
				Else
					MoveCaretToDown(numlineinpage, False)
				EndIf
			
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				'AllShortcuts
			
				'SetCurrentLine(False)
			
				ParseLine
				HighlightVisibleLinesNow()
			
			EndIf

		EndIf
		
		If actfocusmode = idfocus Then
		
			If KeyHit(KEY_HOME) Then
				AC_Close
				If KeyDown(KEY_SHIFT) Then
					MoveCaretToHome(True)
				Else
					MoveCaretToHome(False)
				EndIf
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
			EndIf
		
			If KeyHit(KEY_END) Then
				AC_Close
				If KeyDown(KEY_SHIFT) Then
					MoveCaretToEnd(True)
				Else
					MoveCaretToEnd(False)
				EndIf
				CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
			EndIf
	
		EndIf
		
		
		If KeyHit(KEY_F11) Then IndentText

		' diagnostica temporanea: CTRL+F10 scarica su file lo stato dello scope e
		' dei local per la riga del caret (vedi HLDBG_DumpCaretLine)
		If KeyDown(KEY_CONTROL) And KeyHit(KEY_F10) Then
			ACDBG_DumpTip()
			HLDBG_DumpCaretLine()
		EndIf
		
		
		'CTRL + keys
		If KeyDown(KEY_CONTROL) Then
			
			
			If KeyHit(KEY_RIGHT) Then Forward(xxca, yyca, wwca, hhca)  '; AllShortcuts
				
			If KeyHit(KEY_LEFT) Then Backward(xxca, yyca, wwca, hhca)  '; AllShortcuts
			
			If KeyHit(KEY_F) Then
				
				Local proj:= focussheet.focusbox
		
				If proj <> Null Then
					If proj.TextSelected <> "" Then
						Local tx:String = proj.TextSelected
						'InputBox.objc[11].txt = tx
						blEvents.SetFindText(tx)
						findstring = proj.TextSelected
					Else
						blEvents.FocusFindBox()
						
						'InputBox.objc[11].inputon = True
					EndIf
				EndIf
	
				blEvents.SetFindReplVisible(1)
				
			EndIf
			
			
			If KeyHit(KEY_G) Then
				blEvents.SetGotoLineVisible(1)
			EndIf
			
			If KeyHit(KEY_T) Then IndentText
			
			If KeyHit(KEY_M) Then
			
				If KeyDown(KEY_SHIFT) Then
					'UncommentSelection
					
				Else
					'CommentSelection
				EndIf
				
			EndIf
			
			'If KeyHit(KEY_I) Then ControlLineIF
			
			'			If KeyHit(KEY_F) Then
			'
			'				Local proj:Mytextbox = Sheet.focusproj
			'
			'				If proj <> Null Then
			'					If proj.TextSelected <> "" Then
			'						Local tx:String = proj.TextSelected
			'						'InputBox.objc[11].txt = tx
			'						blEvents.SetFindText(tx)
			'						findstring = proj.TextSelected
			'					Else
			'						blEvents.FocusFindBox()
			'
			'						'InputBox.objc[11].inputon = True
			'					EndIf
			'				EndIf
			'
			'				blEvents.SetFindReplVisible(1)
			'
			'			EndIf
			
			
			
			'SetMainProject
				
			'EndIf
			
			'Undo
			'If KeyHit(KEY_Z) Then Undo
			'If keyundo = 1 Or keyundo > 30 Then Undo(xxca, yyca, wwca, hhca)  '; makeshcut = False; AllShortcuts
						
			'Redo
			'If KeyHit(KEY_Y) Then Redo
			'If keyredo = 1 Or keyredo > 30 Then Redo(xxca, yyca, wwca, hhca)  '; makeshcut = False; AllShortcuts
			
			
			'Copia
			' Gui.ActiveTextbox <> Null = il fuoco e' su un campo di testo della GUI
			' (Find, Replace, Go To Line, Settings): li' copia/incolla li gestisce il campo.
			If actfocusmode = idfocus And NoActiveTextbox() Then
				
				If KeyHit(KEY_C) Or KeyHit(KEY_INSERT) Then Copia

				'Seleziona tutto
				If KeyHit(KEY_A) Then SelectAll(xxca, yyca, wwca, hhca)
			
			EndIf
			
			
			If doc.textlocked = 0 and actfocusmode = idfocus And NoActiveTextbox() Then
			
				'Incolla
				If KeyHit(KEY_V) Then Incolla(xxca, yyca, wwca, hhca)  '; makeshcut = False; AllShortcuts
			
				'Taglia
				If KeyHit(KEY_X) Then Taglia(xxca, yyca, wwca, hhca)  '; makeshcut = False; AllShortcuts
			
			EndIf
			
			
		Else

			
			
			'Go To Definition
			'If KeyHit(KEY_F12) Then GoToObjectOnCaretNew   '**
			'Go To Definition
			
			If doc.textlocked = 0 Then
			
				If KeyHit(KEY_F12) Then GoToLabelOnCaret2; CaretOutOfScreen(xxca, yyca, wwca, hhca)
			
				If findstr = 1 Then CaretOutOfScreen(xxca, yyca, wwca, hhca); findstr = 0
				
						
				'Incolla
				If KeyDown(KEY_SHIFT) And KeyHit(KEY_INSERT) And NoActiveTextbox() Then Incolla(xxca, yyca, wwca, hhca)
		
				If KeyDown(KEY_SHIFT) = False And KeyHit(KEY_INSERT) = True Then
			
					modecaret = modecaret ~ True

					If modecaret Then
						wcaret = xkscale
					Else
						wcaret = 1
					End If

				EndIf
				
			EndIf
			
			'If zmou > 0 Then line = line - zmou * 2 '; Print zmou
			
			'If l > vbar.Maximum Then l = vbar.Maximum
			
			'vbar.Value = l
				
		EndIf
		
		
		
		If touchdown and selecttexton = 1 and KeyDown(KEY_CONTROL) = 0 and idstartsel <> idendsel and actfocusmode = idfocus Then
			
			If IsOnRect(xxca, yyca, wwca, hhca) Then
			
				If ymou > yyca + hhca - 80 Then line = line + 1; VSBar.value = line + 0.01; VSBar.SetOBARFromValue
								
				If ymou < yyca + 40 Then line = line - 1; VSBar.value = line; VSBar.SetOBARFromValue
				
			EndIf
			
		EndIf
		
		
		
		'note: MOUSE TEXTBOX
		
		'If dclick Then Print Millisecs
		
		If dclick = 0 and notexton = 0 Then '**
		
			If touchhit and KeyDown(KEY_CONTROL) = 0 Then
			
				'If xmou < DeviceWidth - horizbar Then

				Local xx:Int = xmou
				Local yy:Int = ymou
		
				If xx < xxca + wwca and yy < yyca + hhca - 44 Then
				
					For Local i:Int = 0 To idclic - 1

						Local x3:Int = xclic[i]
						Local y3:Int = yclic[i]
						Local w2:Int = wclic[i]

						If xx >= x3 And xx <= x3 + w2 And yy >= y3 And yy <= y3 + ykscale Then
							
							'Sheet.sheetfocus = shnum
							
							If KeyDown(KEY_SHIFT) Then
					
								linecaret2 = -1
					
								idstartsel = idcaret
								idcaret = cclic[i]
								AC_Close
								idendsel = idcaret
					
								If idstartsel > idendsel Then
					
									Local idd:Int = idstartsel
									idstartsel = idendsel
									idendsel = idd
					
								EndIf
					
								'LostFocus
								
							Else

								linecaret2 = -1
								idcaret = cclic[i]
								AC_Close

								idstartsel = idcaret
								idendsel = idstartsel

								'LostFocus
								
							EndIf

							xposcaretsav = GetCursorX2
					
							GetCursorLine
					
							Exit

						EndIf

					Next
	
					'Else
				
					'Print "OFF"
				
				EndIf
		
				selecttexton = 1
				
			EndIf
				
		
			'note: SELECT TEXT
			
			'Local kk0
		
			'			If KeyDown(KEY_CONTROL) = 0 Then
			'
			'				' kk0 = ispre Else kk0 = ispre3
			'				If selecttexton = 0 and IsTouchHit(xxca, yyca, wwca, hhca - 44) Then
			'					selecttexton = 1
			'				EndIf
			'
			'
			'			EndIf
			
				
			
			If VSBar.hookon or HSBar.hookon or boxmove Then selecttexton = 0
		
			If touchdown = 0 and touchhit = 0 Then selecttexton = 0 '; Print "OFF"
		
			'If touchrel Then selecttexton = 0 '; Print "OFF"
			
			If selecttexton Then
		
				'If xmou < DeviceWidth - horizbar Then
				
				'If vbaron = 0 and hbaron = 0 Then '**
			
				Local xx:Int = xmou
				Local yy:Int = ymou
		
			
				If xx < xxca + wwca and yy < yyca + hhca - 44 Then
				
					For Local i:Int = 0 To idclic - 1

						Local x3:Int = xclic[i]
						Local y3:Int = yclic[i]
						Local w2:Int = wclic[i]

						If xx >= x3 And xx <= x3 + w2 And yy >= y3 And yy <= y3 + ykscale Then
								
							'Sheet.sheetfocus = shnum
							
							idcaret = cclic[i]
							AC_Close

							idendsel = idcaret
					
							xposcaretsav = GetCursorX2
					
							GetCursorLine
					
							Exit

						EndIf

					Next
		
				EndIf
				
				
			EndIf
		
			'If MouseHit(MOUSE_LEFT) <> 0 And xmou = xmou2 And ymou = ymou2 Then
		
			'	LostFocus
			
			'				If countdclick > 0 Then
			'					DoubleClick
			'					dclick = 2
			'				Else
			'					countdclick = 30
			'				EndIf
			
			'	If dclick Then DoubleClick

			'EndIf
			
			
		EndIf
		
		If dclick Then dclick=0; DoubleClick
			
		
		VSBar.UpdateBar() 'doc, x1, y1, x2, y2)
		HSBar.UpdateBar() 'doc, x1, y1, x2, y2)
				
		'If idfocus = 2 Then Print HSBar.obar + "," + HSBar.value
		
		line = VSBar.value
		
		xoffdraw = HSBar.value
		
		
		If iscreated = 0 Then
			
			SetStartValues
			iscreated = 1
		
		EndIf
		
		
		If KeyHit(KEY_F5) Then RunProg
		

		If KeyHit(KEY_F6) Then BuildAndCheck
		
		
		If KeyHit(KEY_F7) Then If namesolution <> "" Then ManageSolution

		GetCursorLine()
		If linecaret <> linecaret2 Then HL_OnCaretLineChanged()
		
		If actfocusmode = idfocus And doc.textlocked = 0 And typewin <> 3 Then
			CT_UpdateFromCaret()
		EndIf
		
		If line2 <> line Then
			HL_RequestViewportHighlight(1)
			line2 = line
		EndIf
		
		If actfocusmode = idfocus And ctOn Then
			Local nowT:Int = Millisecs()
			Local need:Int = 0
			If idcaret <> ctThLastCaret Or doc.Crs.Length <> ctThLastLen Or ctOpenPos <> ctThLastOpen Or scopeLayoutGen <> ctThScopeGen Or IDE_GetParserCycleId() <> ctThParser Then need = 1
			If need = 0 And nowT - ctIdleCtPollMs >= 480 Then
				ctIdleCtPollMs = nowT
				If ctOverloadManual = 0 Then
					Local symLive:Int = SYM_GetGlobalVersion()
					Local fVer:Int = SYM_GetFileVersion(doc.fullname)
					If symLive <> ctThSymVer Or fVer <> ctDeclSigFileVer Then need = 1
				EndIf
			EndIf
			If need Then
				ctIdleCtPollMs = nowT
				CT_UpdateFromCaret
			EndIf
		EndIf
		
		
	End
	
	' Tokenizer dedicato SOLO all'analisi della condizione di un If (usato da
	' IFI_IfNeedsBlockIndent e dai suoi sotto-metodi), identico a TokenizeCodeLine
	' con UNA differenza: emette "." come token a se stante invece di scartarlo.
	'
	' PERCHE': TokenizeCodeLine scarta il punto, quindi "MCubo.Mesh" diventa due
	' token adiacenti ["MCubo", "Mesh"] indistinguibili da due identificatori
	' separati da uno spazio. Il parser di espressioni (IFI_Parse*), non sapendo
	' che sono legati da un punto, si fermava a meta' di condizioni come
	' "If A = B Or C.D = E": si fermava dopo "C", vedeva un "=" solitario dopo
	' "D" e lo scambiava per l'inizio di un ramo Then sottinteso con assegnamento,
	' concludendo (a torto) che l'If si chiude sulla riga stessa invece di aprire
	' un blocco. Qui il punto resta visibile, quindi IFI_ParsePrimaryExpr puo'
	' consumare l'intera catena "owner.member.altro" come un unico primario.
	'
	' Non si tocca TokenizeCodeLine: e' condiviso da syntax highlighting,
	' autocomplete e ricostruzione dello scope, che si affidano al fatto che il
	' punto NON produca un token. Questo tokenizer resta isolato all'indent.
	Method IFI_TokenizeCondExpr:String[](lineTxt:String)
		Local out:String[16]
		Local outCount:Int = 0
		Local n:Int = lineTxt.Length
		Local i:Int = 0
		Local inStr:Int = 0
		
		While i < n
			Local c:Int = lineTxt[i]
			
			' Una stringa e' UN OPERANDO e va emessa come token unico. Scartandola,
			' "If ec <> ~qon~q And ec <> ~qoff~q" perdeva i due operandi,
			' l'espressione non si chiudeva e l'If a blocco veniva scambiato per
			' uno a riga singola.
			If c = 34 Then
				i += 1
				While i < n And lineTxt[i] <> 34
					i += 1
				Wend
				If i < n Then i += 1
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = "~q"
				outCount += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 1 Then
				i += 1
				Continue
			EndIf
			
			If c = 64 And i + 1 < n Then
				Local cN:Int = lineTxt[i + 1]
				If IsALetter(cN) Or cN = 95 Then
					Local s:Int = i
					i += 2
					While i < n
						Local c2:Int = lineTxt[i]
						If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
							i += 1
						Else
							Exit
						EndIf
					Wend
					Local tokA:= MidString(lineTxt, s + 1, i - s)
					If outCount = out.Length Then out = out.Resize(out.Length * 2)
					out[outCount] = tokA
					outCount += 1
					Continue
				EndIf
			EndIf
			
			If IsALetter(c) Or c = 95 Or c >= 48 And c <= 57 Then
				Local s:Int = i
				i += 1
				While i < n
					Local c2:Int = lineTxt[i]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						i += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, i - s)
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = tok
				outCount += 1
				Continue
			EndIf
			
			' Simboli emessi come token, oltre a quelli di TokenizeCodeLine (,:=):
			' "." (accesso a campo) e i confronti/aritmetica/parentesi/subscript.
			' Senza questi, condizioni come "If os.FileType(p) = os.FILETYPE_FILE"
			' o "If a < b" avevano lo STESSO bug del punto: il parser si fermava a
			' meta' dell'espressione e un "=" successivo veniva scambiato per un
			' assegnamento, facendo credere che l'If si chiudesse sulla riga.
			If c = 60 And i + 1 < n And lineTxt[i + 1] = 61 Then ' "<="
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = "<="
				outCount += 1
				i += 2
				Continue
			EndIf
			If c = 60 And i + 1 < n And lineTxt[i + 1] = 62 Then ' "<>"
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = "<>"
				outCount += 1
				i += 2
				Continue
			EndIf
			If c = 62 And i + 1 < n And lineTxt[i + 1] = 61 Then ' ">="
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = ">="
				outCount += 1
				i += 2
				Continue
			EndIf
			If c = 44 Or c = 58 Or c = 61 Or c = 46 Or c = 60 Or c = 62 Or c = 40 Or c = 41 Or c = 43 Or c = 45 Or c = 42 Or c = 47 Or c = 91 Or c = 93 Or c = 126 Or c = 38 Or c = 124 Then
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = String.FromChar(c)
				outCount += 1
			EndIf
			
			i += 1
		Wend
		
		If outCount = 0 Then Return New String[0]
		Return out.Resize(outCount)
	End

	Method IFI_TrimLeadingSpaces:String(s:String)
		Local n:Int = s.Length
		Local i:Int = 0
		While i < n
			Local c:Int = s[i]
			If c = 32 Or c = 9 Then
				i += 1
			Else
				Exit
			EndIf
		Wend
		If i = 0 Then Return s
		Return s[i ..]
	End
	
	Method IFI_MakeIndentStr:String(level:Int)
		If level <= 0 Then Return ""
		Local out:String = ""
		For Local i:Int = 0 To level * 4 - 1
			out += " "
		Next
		Return out
	End
	
	Method IFI_PreprocDirective:String(body:String)
		Local s:String = IFI_TrimLeadingSpaces(body)
		If s = "" Or s[0] <> 35 Then Return ""
		Local rest:String = IFI_TrimLeadingSpaces(s[1 ..])
		If rest = "" Then Return ""
		Local toks:= TokenizeCodeLine(rest)
		Local fi:Int = FirstCodeTokenIndex(toks)
		If fi >= toks.Length Then Return ""
		Return toks[fi].ToUpper()
	End
	
	Method IFI_IsPreprocLine:Int(body:String)
		Local d:String = IFI_PreprocDirective(body)
		If d = "IF" Or d = "ELSE" Or d = "ELSEIF" Or d = "ENDIF" Or d = "END" Then Return 1
		Return 0
	End
	
	Method IFI_LineKind:Int(lineTxt:String)
		Local body:String = IFI_TrimLeadingSpaces(lineTxt)
		If body = "" Then Return 2
		If IFI_IsPreprocLine(body) Then Return 3
		Local c0:Int = body[0]
		If c0 = 39 Or c0 = 35 Then Return 1
		Return 0
	End
	
	Method IFI_IsNumberToken:Int(tok:String)
		If tok = "" Then Return 0
		For Local j:Int = 0 To tok.Length - 1
			Local c:Int = tok[j]
			If c < 48 Or c > 57 Then Return 0
		Next
		Return 1
	End
	
	' Portati dallo STESSO schema della grammatica del parser vero (myexpr.cxs /
	' transcc2/trans2/expr.cxs): Or, And, Compare(=,<,>,<=,>=,<>), Shift(Shl/Shr),
	' Add(+,-), Mul(*,/,Mod), Unary(Not,-), Primary(ident/numero/gruppo tra
	' parentesi) con postfissi .campo, (chiamata) e [subscript] incatenabili.
	' Serve solo a trovare DOVE finisce la condizione di un If, non a valutarla:
	' la precedenza conta meno della certezza di consumare tutti i token giusti.
	Method IFI_ParsePrimaryExpr:Int(toks:String[], i:Int)
		If i >= toks.Length Then Return i
		Local matched:Int = 0
		
		' Una stringa e' un operando: il tokenizer ne emette uno solo, ~q.
		If toks[i] = "~q" Then Return i + 1

		If toks[i] = "(" Then
			i = IFI_ParseOrExpr(toks, i + 1)
			If i < toks.Length And toks[i] = ")" Then i += 1
			matched = 1
		Else
			Local up:String = toks[i].ToUpper()
			If up = "TRUE" Or up = "FALSE" Or up = "NULL" Then
				i += 1
				matched = 1
			ElseIf IFI_IsNumberToken(toks[i]) Then
				i += 1
				matched = 1
			ElseIf HL_IsIdentToken(toks[i]) Then
				i += 1
				matched = 1
			EndIf
		EndIf
		If matched = 0 Then Return i
		
		' Postfissi incatenabili: "owner.member(arg)[i].altro". Con toks prodotti da
		' IFI_TokenizeCondExpr punto/parentesi/subscript sono token a se stanti,
		' quindi la catena resta UN SOLO primario invece di far apparire il pezzo
		' dopo come un token slegato che termina l'espressione a meta' (e' la
		' stessa famiglia del bug del punto: vedi IFI_TokenizeCondExpr).
		While i < toks.Length
			If toks[i] = "." And i + 1 < toks.Length And (HL_IsIdentToken(toks[i + 1]) Or IFI_IsNumberToken(toks[i + 1])) Then
				i += 2
				Continue
			EndIf
			If toks[i] = "(" Then
				Local depth:Int = 1
				i += 1
				While i < toks.Length And depth > 0
					If toks[i] = "(" Then depth += 1
					If toks[i] = ")" Then depth -= 1
					i += 1
				Wend
				Continue
			EndIf
			If toks[i] = "[" Then
				Local depth2:Int = 1
				i += 1
				While i < toks.Length And depth2 > 0
					If toks[i] = "[" Then depth2 += 1
					If toks[i] = "]" Then depth2 -= 1
					i += 1
				Wend
				Continue
			EndIf
			Exit
		Wend
		Return i
	End

	Method IFI_ParseUnaryExpr:Int(toks:String[], i:Int)
		If i < toks.Length And toks[i].ToUpper() = "NOT" Then Return IFI_ParseUnaryExpr(toks, i + 1)
		If i < toks.Length And toks[i] = "-" Then Return IFI_ParseUnaryExpr(toks, i + 1)
		' "~" e' anche il NOT bit a bit unario.
		If i < toks.Length And toks[i] = "~~" Then Return IFI_ParseUnaryExpr(toks, i + 1)
		Return IFI_ParsePrimaryExpr(toks, i)
	End

	Method IFI_ParseMulExpr:Int(toks:String[], i:Int)
		i = IFI_ParseUnaryExpr(toks, i)
		While i < toks.Length
			Local up:String = toks[i].ToUpper()
			If up = "MOD" Or toks[i] = "*" Or toks[i] = "/" Then
				i = IFI_ParseUnaryExpr(toks, i + 1)
			Else
				Exit
			EndIf
		Wend
		Return i
	End

	Method IFI_ParseAddExpr:Int(toks:String[], i:Int)
		i = IFI_ParseMulExpr(toks, i)
		While i < toks.Length And (toks[i] = "+" Or toks[i] = "-")
			i = IFI_ParseMulExpr(toks, i + 1)
		Wend
		Return i
	End

	Method IFI_ParseShiftExpr:Int(toks:String[], i:Int)
		i = IFI_ParseAddExpr(toks, i)
		While i < toks.Length
			Local up:String = toks[i].ToUpper()
			If up = "SHL" Or up = "SHR" Then
				i = IFI_ParseAddExpr(toks, i + 1)
			Else
				Exit
			EndIf
		Wend
		Return i
	End

	' Operatori di bit, fra i confronti e gli shift come in Cerberus:
	'   Or > And > confronti > | > ~ > & > Shl/Shr > +- > */
	' Mancavano del tutto: "If (x ~ y) & 1" si fermava a meta' condizione e i
	' token che avanzavano facevano credere a un If a riga singola.
	Method IFI_ParseBitAndExpr:Int(toks:String[], i:Int)
		i = IFI_ParseShiftExpr(toks, i)
		While i < toks.Length And toks[i] = "&"
			i = IFI_ParseShiftExpr(toks, i + 1)
		Wend
		Return i
	End

	Method IFI_ParseBitXorExpr:Int(toks:String[], i:Int)
		i = IFI_ParseBitAndExpr(toks, i)
		While i < toks.Length And toks[i] = "~~"
			i = IFI_ParseBitAndExpr(toks, i + 1)
		Wend
		Return i
	End

	Method IFI_ParseBitOrExpr:Int(toks:String[], i:Int)
		i = IFI_ParseBitXorExpr(toks, i)
		While i < toks.Length And toks[i] = "|"
			i = IFI_ParseBitXorExpr(toks, i + 1)
		Wend
		Return i
	End

	Method IFI_ParseCompareExpr:Int(toks:String[], i:Int)
		i = IFI_ParseBitOrExpr(toks, i)
		If i < toks.Length Then
			Local t:String = toks[i]
			If t = "=" Or t = "<" Or t = ">" Or t = "<=" Or t = ">=" Or t = "<>" Then
				Return IFI_ParseBitOrExpr(toks, i + 1)
			EndIf
		EndIf
		Return i
	End

	Method IFI_ParseAndExpr:Int(toks:String[], i:Int)
		i = IFI_ParseCompareExpr(toks, i)
		While i < toks.Length And toks[i].ToUpper() = "AND"
			i = IFI_ParseCompareExpr(toks, i + 1)
		Wend
		Return i
	End

	Method IFI_ParseOrExpr:Int(toks:String[], i:Int)
		i = IFI_ParseAndExpr(toks, i)
		While i < toks.Length And toks[i].ToUpper() = "OR"
			i = IFI_ParseAndExpr(toks, i + 1)
		Wend
		Return i
	End
	
	Method IFI_ImplicitThenStmtStart:Int(lineTxt:String, toks:String[], exprEnd:Int)
		If exprEnd >= toks.Length Then Return toks.Length
		Local eqCount:Int = 0
		For Local j:Int = exprEnd To toks.Length - 1
			If toks[j] = "=" Then eqCount += 1
		Next
		If eqCount = 1 Then
			If lineTxt.Contains(">=") Or lineTxt.Contains("<=") Or lineTxt.Contains("<>") Then Return toks.Length
		EndIf
		For Local i:Int = exprEnd To toks.Length - 1
			If toks[i] = "=" Then
				If i > exprEnd Then Return i - 1
				Return exprEnd
			EndIf
		Next
		Return toks.Length
	End
	
	' Come ParseIfStmt: dopo la condizione THEN è opzionale; indice del primo token del ramo Then.
	Method IFI_IfStmtStart:Int(lineTxt:String, toks:String[], ifIdx:Int)
		Local i:Int = IFI_ParseOrExpr(toks, ifIdx + 1)
		If i < toks.Length And toks[i].ToUpper() = "THEN" Then Return i + 1
		For Local j:Int = ifIdx + 1 To toks.Length - 1
			If toks[j].ToUpper() = "THEN" Then Return j + 1
		Next
		Return IFI_ImplicitThenStmtStart(lineTxt, toks, i)
	End
	
	' Ultimo Then sulla riga senza token dopo: apre blocco (es. If a Then If b Then).
	Method IFI_IfLastThenOpensBlock:Int(toks:String[], ifIdx:Int)
		Local lastThenIdx:Int = -1
		For Local i:Int = ifIdx + 1 To toks.Length - 1
			If toks[i].ToUpper() = "THEN" Then lastThenIdx = i
		Next
		If lastThenIdx < 0 Then Return 0
		For Local j:Int = lastThenIdx + 1 To toks.Length - 1
			Return 0
		Next
		Return 1
	End
	
	' Parole chiave che possono iniziare SOLO uno statement: non compaiono mai
	' dentro la condizione di un If. Se una di queste e' presente sulla riga
	' dell'If, allora dopo la condizione c'e' per forza il ramo Then (esplicito
	' o sottinteso), quindi l'If si esaurisce sulla riga e NON apre un blocco.
	' TokenizeCodeLine scarta il contenuto delle stringhe e taglia i commenti,
	' quindi un "Return" dentro "..." o dopo ' non puo' produrre falsi positivi.
	Method IFI_IsStmtOnlyKeyword:Int(up:String)
		If up = "PRINT" Or up = "RETURN" Or up = "EXIT" Then Return 1
		If up = "CONTINUE" Or up = "THROW" Then Return 1
		Return 0
	End

	' ";" separa due statement sulla stessa riga: non e' valido dentro una
	' condizione, quindi la sua presenza implica un If a riga singola.
	' Va cercato sul testo grezzo perche' TokenizeCodeLine non lo emette:
	' qui si saltano stringhe e commento come fa il tokenizer.
	Method IFI_HasStmtSeparator:Int(lineTxt:String)
		Local n:Int = lineTxt.Length
		Local i:Int = 0
		Local inStr:Int = 0
		While i < n
			Local c:Int = lineTxt[i]
			If c = 34 Then
				inStr = 1 - inStr
			ElseIf inStr = 0 And c = 39 Then
				Return 0
			ElseIf inStr = 0 And c = 59 Then
				Return 1
			EndIf
			i += 1
		Wend
		Return 0
	End

	' Prove che l'If si chiude sulla riga stessa.
	Method IFI_IfClosesOnSameLine:Int(lineTxt:String, toks:String[], ifIdx:Int)
		For Local i:Int = ifIdx + 1 To toks.Length - 1
			Local up:String = toks[i].ToUpper()
			If up = "ELSE" Or up = "ELSEIF" Then Return 1
			If IFI_IsStmtOnlyKeyword(up) Then Return 1
		Next
		Return IFI_HasStmtSeparator(lineTxt)
	End

	Method IFI_IfNeedsBlockIndent:Int(lineTxt:String, toks:String[], ifIdx:Int)
		' Dall'analisi profonda della condizione (le tre chiamate sotto) si usa un
		' RETOKENIZE dedicato (IFI_TokenizeCondExpr) al posto di "toks": e' l'unico
		' modo per riconoscere "owner.member" come un accesso a campo invece che
		' come due identificatori slegati (vedi il commento sul tokenizer).
		' ifIdx resta valido: un If non ha mai un punto prima di se stesso.
		Local ctoks:String[] = IFI_TokenizeCondExpr(lineTxt)

		If IFI_IfLastThenOpensBlock(ctoks, ifIdx) Then Return 1

		If IFI_IfClosesOnSameLine(lineTxt, ctoks, ifIdx) Then Return 0

		' REGOLA: si analizza la condizione con la grammatica completa e si guarda
		' se avanzano token. Se avanzano, quello e' il ramo Then sottinteso, quindi
		' If a RIGA SINGOLA; se non avanza nulla, If a BLOCCO.
		'
		' Prima ci si affidava a IFI_ImplicitThenStmtStart, che indovinava cercando
		' un "=" dopo la condizione: non vedeva "If Not syncData DeleteDir dir,True"
		' ne' "If FileType(d)<>FILETYPE_DIR Die ~qx~q", che venivano presi per
		' blocchi mai chiusi. Il loro End finiva per chiudere la classe.
		'
		' La regola vale solo perche' la grammatica ora copre TUTTA la condizione:
		' stringhe, operatori di bit (~ & |), punto, chiamate, subscript. Senza uno
		' di questi pezzi il parser si ferma a meta' e ogni condizione che lo usa
		' verrebbe scambiata per una riga singola.
		Local ends:Int = IFI_ParseOrExpr(ctoks, ifIdx + 1)

		If ends < ctoks.Length And ctoks[ends].ToUpper() = "THEN" Then
			If ends + 1 >= ctoks.Length Then Return 1
			Return 0
		EndIf

		If ends >= ctoks.Length Then Return 1
		Return 0
	End
	
	Method IFI_HasKeywordOnSameLine:Int(toks:String[], fromIdx:Int, kwUp:String)
		For Local i:Int = fromIdx + 1 To toks.Length - 1
			If toks[i].ToUpper() = kwUp Then Return 1
		Next
		Return 0
	End
	
	' For ... ; ... ; Next i sulla stessa riga: non aprire blocco sulla riga successiva.
	Method IFI_LoopClosesOnSameLine:Int(toks:String[], openerIdx:Int, openerUp:String)
		If openerUp = "FOR" Then Return IFI_HasKeywordOnSameLine(toks, openerIdx, "NEXT")
		If openerUp = "WHILE" Then Return IFI_HasKeywordOnSameLine(toks, openerIdx, "WEND")
		If openerUp = "REPEAT" Then
			If IFI_HasKeywordOnSameLine(toks, openerIdx, "FOREVER") Then Return 1
			Return IFI_HasKeywordOnSameLine(toks, openerIdx, "UNTIL")
		EndIf
		Return 0
	End
	
	' "Method Foo() ; Return x ; End" sulla stessa riga: SOLO il primo token
	' della riga viene guardato per decidere se apre un blocco (Method -> apre),
	' quindi un End piu' avanti sulla STESSA riga passava inosservato: il blocco
	' restava aperto per l'algoritmo e MAI richiuso, con un livello di indent
	' in eccesso per il resto del file (bug reale: 3dplayers.cxs righe 133-138,
	' 6 Method a riga singola -> tutto cio' che segue finiva rientrato di troppo
	' fino all'ultima riga del file).
	' Stesso schema di IFI_LoopClosesOnSameLine, per i blocchi chiusi da End.
	Method IFI_RoutineClosesOnSameLine:Int(toks:String[], openerIdx:Int)
		Return IFI_HasKeywordOnSameLine(toks, openerIdx, "END")
	End
	
	' Solo blocchi chiusi da End/Endif (For/While/Repeat usano Next/Wend/Forever/Until).
	Method IFI_IndentBlockOpener:String(firstUp:String)
		If firstUp = "SELECT" Then Return "select"
		If firstUp = "TRY" Then Return "try"
		If firstUp = "CLASS" Or firstUp = "INTERFACE" Then Return firstUp.ToLower()
		If firstUp = "METHOD" Or firstUp = "FUNCTION" Then Return firstUp.ToLower()
		Return ""
	End
	
	Method IFI_HasOpenClassBlock:Int(blkStack:String[], blkCount:Int)
		For Local i:Int = 0 To blkCount - 1
			Local b:= blkStack[i]
			If b = "class" Or b = "classx" Or b = "interface" Then Return 1
		Next
		Return 0
	End

	' Method/Function SENZA corpo: sono sole dichiarazioni, non si chiudono con
	' End, quindi dopo di esse NON si rientra. Succede in tre casi (parser.cxs:
	' "If funcDecl.IsExtern() Or funcDecl.IsAbstract() Return funcDecl"):
	'   - Extern o Abstract scritti sulla riga stessa
	'   - dentro una Interface (i metodi sono implicitamente Abstract)
	'   - dentro una sezione Extern o una classe Extern (l'attributo si eredita)
	' Senza questo controllo ogni dichiarazione apriva un blocco mai chiuso e
	' tutto il resto del file scivolava a destra (vedi lovers.cxs, Extern Private).
	Method IFI_RoutineIsBodyless:Int(toks:String[], fi:Int, blkStack:String[], blkCount:Int, externMode:Int)
		For Local i:Int = 0 To toks.Length - 1
			If i = fi Then Continue
			Local u:= toks[i].ToUpper()
			If u = "EXTERN" Or u = "ABSTRACT" Then Return 1
		Next

		For Local i:Int = blkCount - 1 To 0 Step -1
			Local b:= blkStack[i]
			If b = "interface" Or b = "classx" Then Return 1
			If b = "class" Then Return 0
		Next

		Return externMode
	End

	' Una Class e' extern se lo dichiara sulla riga o se sta in una sezione Extern.
	' Le Interface non possono essere extern (il parser lo rifiuta).
	Method IFI_ClassIsExtern:Int(toks:String[], fi:Int, externMode:Int)
		For Local i:Int = 0 To toks.Length - 1
			If i = fi Then Continue
			If toks[i].ToUpper() = "EXTERN" Then Return 1
		Next
		Return externMode
	End

	Method IFI_LineIndentDeltaBefore:Int(firstUp:String)
		If firstUp = "ENDIF" Or firstUp = "NEXT" Or firstUp = "WEND" Or firstUp = "UNTIL" Or firstUp = "FOREVER" Then Return -1
		If firstUp = "ELSE" Or firstUp = "ELSEIF" Then Return -1
		If firstUp = "CASE" Or firstUp = "DEFAULT" Then Return -1
		If firstUp = "CATCH" Then Return -1
		If firstUp = "END" Then Return -1
		Return 0
	End
	
	Method IFI_LineIndentDeltaAfter:Int(lineTxt:String, firstUp:String)
		If firstUp = "ELSE" Or firstUp = "ELSEIF" Or firstUp = "CASE" Or firstUp = "DEFAULT" Or firstUp = "CATCH" Then Return 1
		If firstUp = "IF" Then Return 0
		If firstUp = "FOR" Or firstUp = "WHILE" Or firstUp = "REPEAT" Or firstUp = "SELECT" Or firstUp = "TRY" Then Return 1
		If firstUp = "CLASS" Or firstUp = "INTERFACE" Then Return 1
		If firstUp = "METHOD" Or firstUp = "FUNCTION" Then Return 1
		Return 0
	End
	
	' L'ultima "riga" restituita da GetLineTextByIndex e' il terminatore del
	' buffer Crs (due byte 0), non testo dell'utente. Senza questo controllo
	' il formattatore le mette davanti l'indentazione e la riscrive nel
	' documento: i due byte 0 finiscono nel file salvato su disco.
	Method IFI_IsNullOnlyLine:Int(s:String)
		If s = "" Then Return 0
		For Local i:Int = 0 To s.Length - 1
			If s[i] <> 0 Then Return 0
		Next
		Return 1
	End

	Method IFI_DocContentEnd:Int()
		Local l:Int = doc.Crs.Length
		If l < 2 Then Return 0
		For Local i:Int = 0 To l - 2
			If (doc.Crs[i] & 255) = 0 And (doc.Crs[i + 1] & 255) = 0 Then Return i
		Next
		Return l
	End
	
	Method IFI_LastContentLine:Int()
		If doc.idlines < 2 Then Return -1
		Local last:Int = doc.idlines - 2
		If last < 0 Then Return -1
		Return last
	End
	
	Method IFI_LineTerminator:String(ln:Int)
		If ln < 0 Or ln + 1 >= doc.idlines Then Return invio
		Local s:Int = doc.idline[ln]
		Local e:Int = doc.idline[ln + 1] - 1
		If e < s Then Return invio
		
		Local lastNon:Int = s - 1
		For Local i:Int = s To e
			Local c:Int = doc.Crs[i] & 255
			If c <> 13 And c <> 10 Then lastNon = i
		Next
		
		Local out:String = ""
		For Local i:Int = lastNon + 1 To e
			Local c2:Int = doc.Crs[i] & 255
			If c2 = 13 Or c2 = 10 Then out += String.FromChar(c2)
		Next
		If out = "" Then Return invio
		Return out
	End
	
	Method IFI_BuildFormattedText:String()
		Local contentEnd:Int = IFI_DocContentEnd()
		Local lastLn:Int = IFI_LastContentLine()
		If lastLn < 0 Then Return ""
		
		Local level:Int = 0
		Local preprocDepth:Int = 0
		Local preprocClassOpen:Int = 0
		Local blkStack:String[] = New String[32]
		Local blkCount:Int = 0
		Local selectAwaitingCase:Int = 0
		Local externMode:Int = 0
		Local out:String = ""
		
		For Local ln:Int = 0 To lastLn
			Local raw:String = GetLineTextByIndex(ln)

			' riga-terminatore del buffer: non e' testo, non va riemessa
			If IFI_IsNullOnlyLine(raw) Then Continue

			Local kind:Int = IFI_LineKind(raw)
			Local body:String = IFI_TrimLeadingSpaces(raw)
			Local lineOut:String = ""
			Local lineLevel:Int = level
			
			If kind = 2 Then
				lineOut = ""
			ElseIf kind = 3
				Local pdir:String = IFI_PreprocDirective(body)
				
				If pdir = "IF" Then
					preprocDepth += 1
					preprocClassOpen = 0
				ElseIf pdir = "ELSE" Or pdir = "ELSEIF" Then
					If preprocClassOpen Then
						level -= 1
						If level < 0 Then level = 0
						preprocClassOpen = 0
					EndIf
				ElseIf pdir = "ENDIF" Or pdir = "END" Then
					If preprocDepth > 0 Then preprocDepth -= 1
				EndIf
				
				Local pi:Int = level
				If preprocClassOpen Then
					pi = level - 1
					If pi < 0 Then pi = 0
				EndIf
				lineOut = IFI_MakeIndentStr(pi) + body
			ElseIf kind = 1 Then
				lineOut = IFI_MakeIndentStr(lineLevel) + body
			Else
				Local toks:= TokenizeCodeLine(body)
				Local fi:Int = FirstCodeTokenIndex(toks)
				Local ifHandled:Int = 0

				' Sezione Extern a livello di modulo: la apre "Extern", la chiudono
				' "Public"/"Private". Dentro una Class invece Public/Private cambiano
				' solo la visibilita' e l'attributo Extern resta (parser.cxs), quindi
				' li si ignorano.
				If toks.Length > 0 Then
					Local t0s:= toks[0].ToUpper()
					If t0s = "EXTERN" Then
						externMode = 1
					ElseIf t0s = "PUBLIC" Or t0s = "PRIVATE" Then
						If IFI_HasOpenClassBlock(blkStack, blkCount) = 0 And (preprocDepth = 0 Or preprocClassOpen = 0) Then externMode = 0
					EndIf
				EndIf
				If fi < toks.Length Then
					Local t0:= toks[fi].ToUpper()
					Local dBefore:Int = IFI_LineIndentDeltaBefore(t0)
					If (t0 = "CASE" Or t0 = "DEFAULT") And selectAwaitingCase Then
						dBefore = 0
						selectAwaitingCase = 0
					EndIf
					If t0 = "END" Or t0 = "ENDIF" Then
						If blkCount > 0 Then
							blkCount -= 1
							If blkStack[blkCount] = "select" Then dBefore -= 1
						EndIf
					EndIf
					If dBefore < 0 Then
						level += dBefore
						If level < 0 Then level = 0
					EndIf
					lineLevel = level
					If t0 <> "CLASS" And t0 <> "INTERFACE" And t0 <> "ENUMERATE" And Not (t0 = "END" And level = 0) Then
						If IFI_HasOpenClassBlock(blkStack, blkCount) And lineLevel < 1 Then lineLevel = 1
					EndIf
				EndIf
				If fi < toks.Length And toks[fi].ToUpper() = "IF" Then
					ifHandled = 1
					lineOut = IFI_MakeIndentStr(lineLevel) + body
					If IFI_IfNeedsBlockIndent(body, toks, fi) Then
						level += 1
						If blkCount >= blkStack.Length Then blkStack = blkStack.Resize(blkStack.Length * 2 + 8)
						blkStack[blkCount] = "if"
						blkCount += 1
					EndIf
				Else
					lineOut = IFI_MakeIndentStr(lineLevel) + body
				EndIf
				
				If fi < toks.Length And ifHandled = 0 Then
					Local t0b:= toks[fi].ToUpper()
					Local preClass:Int = 0
					If preprocDepth > 0 Then
						If t0b = "CLASS" Or t0b = "INTERFACE" Or t0b = "ENUMERATE" Then preClass = 1
					EndIf
					If preClass Then
						If preprocClassOpen = 0 Then
							level += 1
							preprocClassOpen = 1
						EndIf
					Else
						Local dAfter:Int = IFI_LineIndentDeltaAfter(body, t0b)
						If IFI_LoopClosesOnSameLine(toks, fi, t0b) Then dAfter = 0
						If IFI_RoutineClosesOnSameLine(toks, fi) Then dAfter = 0
						If (t0b = "METHOD" Or t0b = "FUNCTION") And IFI_RoutineIsBodyless(toks, fi, blkStack, blkCount, externMode) Then dAfter = 0
						level += dAfter
						If level < 0 Then level = 0
						If dAfter > 0 Then
							Local opn:String = IFI_IndentBlockOpener(t0b)
							If opn = "class" And IFI_ClassIsExtern(toks, fi, externMode) Then opn = "classx"
							If opn <> "" Then
								If blkCount >= blkStack.Length Then blkStack = blkStack.Resize(blkStack.Length * 2 + 8)
								blkStack[blkCount] = opn
								blkCount += 1
								If opn = "select" Then selectAwaitingCase = 1
							EndIf
						EndIf
					EndIf
				EndIf
			EndIf
			
			out += lineOut
			out += IFI_LineTerminator(ln)
		Next
		
		Return out
	End
	
	Method IndentText()
		If doc = Null Then Return
		If doc.numtotallines <= 1 Then Return
		
		line2 = -1
		
		GetCursorLine
		Local saveLn:Int = linecaret
		Local saveCol:Int = idcaret - doc.idline[saveLn]
		If saveCol < 0 Then saveCol = 0
		
		Local newTxt:String = IFI_BuildFormattedText()
		If newTxt = "" Then Return
		
		Local contentEnd:Int = IFI_DocContentEnd()
		
		Local newCrs:= newTxt.ToChars()
		newCrs = newCrs.Resize(newCrs.Length + 2)
		newCrs[newCrs.Length - 2] = 0
		newCrs[newCrs.Length - 1] = 0
		Local newLen:Int = newCrs.Length
		
		Local same:Int = 1
		If newLen <> contentEnd + 2 Then
			same = 0
		Else
			For Local i:Int = 0 To contentEnd - 1
				If (newCrs[i] & 255) <> (doc.Crs[i] & 255) Then
					same = 0
					Exit
				EndIf
			Next
		EndIf
		If same Then Return
		
		Local urs:= New URstate
		SaveStateDoc1(urs)
		urs.lencrs = doc.Crs.Length
		
		doc.Crs = newCrs.Resize(newLen + doc.stepcrs)
		For Local i:Int = newLen To doc.Crs.Length - 1
			doc.Crs[i] = 0
		Next
		
		SaveStateDoc2(urs)
		MakeLines2()
		
		If saveLn < 0 Then saveLn = 0
		If saveLn > doc.numtotallines - 2 Then saveLn = doc.numtotallines - 2
		
		Local row0:Int = doc.idline[saveLn]
		Local row1:Int = doc.idline[saveLn + 1]
		Local textCols:Int = row1 - row0 - 2
		If textCols < 0 Then textCols = 0
		If saveCol > textCols Then saveCol = textCols
		
		idcaret = row0 + saveCol
		idstartsel = idcaret
		idendsel = idcaret
		
		GetCursorLine
		MarkScopeDirty
		NotifyDocEdited
		HighlightinglineCaret()
		RefreshShortcuts
	End
	
	Method DoubleClick()
	
		Local id = idcaret

		SelectWord(id)

		idstartsel = idselect2
		idendsel = idselect1
    	
		idcaret = idendsel
		
	End Method
	
