	Function IsLabChr(c:Int)

		If c = 32 or c = 36 Or c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then Return 1

		Return 0

	End
	
	Function SplitterV:String[] (expr:String)

		Local rr:String[201]
		Local idrr = 0

		Local vrg0 = 0
		'Local spl = 0

		Local rr0:String = ""

		expr = expr + ","

		For Local i = 1 To expr.Length

			Local c:String = String.FromChar(expr[i - 1])

			If c = "(" Then vrg0 = vrg0 + 1
			If c = ")" Then vrg0 = vrg0 - 1

			If vrg0 = 0 And c = "," Then
				rr[idrr] = rr0
				'Debug.Print(rr0)
				rr0 = ""
				idrr = idrr + 1
				'GoTo nf
			Else
				rr0 = rr0 + c
			End If
       

			'nf:
		Next

		'ReDim Preserve rr(idrr - 1)
		rr = rr.Resize(idrr)
		'Debug.Print("1->" & rr(0))
		'Debug.Print("2->" & rr(1))
		'Debug.Print(idrr - 1)

		Return rr

	End Function
	
