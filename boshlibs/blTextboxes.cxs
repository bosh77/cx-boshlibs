		'			If xcaret < doc.ww2 + 6 Then
		'
		'				xoffdraw = xoffdraw - xkscale
		'				xcaret = xcaret + xkscale
		'				If xoffdraw < 0 Then xoffdraw = 0; Exit
		'			Else
		'				Exit
		'
		'			End If
		'
		'		Forever
		'
		'		Local maxcar:Int = wwca + doc.ww2 ' - 24
		'
		'
		'		Repeat
		'			If xcaret > maxcar Then
		'				xoffdraw = xoffdraw + xkscale
		'				xcaret = xcaret - xkscale
		'				If xoffdraw > 30000 Then Exit
