	Method New(filnam:String)
		
		For Local o1_any:= EachIn blSheet.docum
			Local o1:= blDocument(o1_any)
			If o1 = Null Then Continue
		
			If o1.fullname = filnam Then
				
				doc = o1
				CreateTextboxData
				
				'PROVAUTF8
				
				Return
				
			EndIf
			
		Next
	
		Local D:= New blDocument(filnam)
		
		blSheet.docum.AddLast D
		
		doc = D
					
		
		'MakeLines
		CreateTextboxData
	
		
		
		
	End

	Method PROVAUTF8()
		
	
		'prova UTF-8
		Local u8 = 0
		For Local i = 0 To doc.Crs.Length - 1
		
			If doc.Crs[i] > 127 Then u8 = u8 + 1
		
		Next
		
		'Print "X"
		
		'Print doc.Crs.Length
		
		If u8 > 0 Then
		
			Print doc.fullname + "->" + u8
		
			Local l = doc.Crs.Length - u8
			
			Local docnew:Int[l]
			Local l2 = 0
			
			For Local i2 = 0 To doc.Crs.Length - 1
			
				If doc.Crs[i2] < 128 Then docnew[l2] = doc.Crs[i2]; l2 = l2 + 1
				
			Next
			
			doc.Crs = docnew
			
			MakeLines2
			CreateTextboxData
			
			'Print doc.Crs.Length
			
		EndIf
		
	
	End
	
	Method New(bldoc:blDocument)
				
		doc = bldoc
	
		CreateTextboxData
				
		'PROVAUTF8
		
	End
	
	Method New()
	
		'If typewin = 3 Then Print "!!"
		
		
		Local D:= New blDocument()
				
		doc = D
	
		'doc.Text = "X" + invio
		
		'Print "X"
		
		CreateTextboxData
		
		
	End
	
	Method CreateTextboxData()
		
	
		VSBar = New blScrollBar(0, 0, 20, 100, 0, 100, 5, 0)
		HSBar = New blScrollBar(0, 0, 100, 20, 0, 100, 5, 1)
			
		shortcutm = New blShortcutManager

		bookmarks = shortcutm.AddShortcut("Bookmarks", $ff7070)

		' Nel dialetto 1 (MSX BASIC) non ci sono funzioni ne' classi: il pannello
		' elenca le label e le variabili del sorgente.
		If blHLBasicVariant = 1 Then

			labels = shortcutm.AddShortcut("Labels", $70c0f0)

			vars = shortcutm.AddShortcut("Variables", $70f0a0)
			vars.sclist.cform = New ColorFormat
			vars.sclist.cform.AddChrCol(40, $e080e0)
			vars.sclist.cform.AddChrCol(58, $20d0ff)

		Else

			functions = shortcutm.AddShortcut("Functions", $70c0f0)

		EndIf

		scRefreshDocPath = ""
		scRefreshPending = 0
		scRefreshDirtyMs = 0
		
		classShortcuts = classShortcuts.Resize(0)
		classShortcutsCount = 0
		classShortcutsByUp = New StringMap<blShortcut>
		classShortcutsVersionSeen = 0
		
		histLines = New Int[20]
		histLabels = New String[20]
		histCount = 0
		history = Null
		histVisitLastLn = -1
		
		hlNeedViewport = 1
		hlForceViewport = 1
		hlIdleId1 = -1
		hlIdleId2 = -1
		line2 = -1
		
		'VSBar.SetOBARFromValue
				
		'HSBar.SetOBARFromValue
		'xoffdraw = HSBar.value
		
	End
