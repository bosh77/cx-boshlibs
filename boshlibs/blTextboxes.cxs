	Method HighlightinglineBasic(idl:Int)
	
		Local idl1:Int = doc.idline[idl]
		Local idl2:Int = doc.idline[idl + 1] - 1

		Local col:Int

		Local isrem:Int = 0
		Local is2vir:Int = 0
		Local isnum:Int = 0
		Local isword:Int = 0
		Local ishex:Int = 0
		
		Local stl:Int = -1

		For Local i:Int = idl1 To idl2

			Local c:Int = doc.Crs[i]

			local c1:Int= c & 255
			
			'Dim c2 = (c And 65280) / 256
			col = 0
			
			Local goto1:Int = 0
			Local goto2:Int = 0
			
			If c1 = charrem_bas And is2vir = 0 Then

				isrem = 1

			End If
			If c1 = char2vir_bas And isrem = 0 Then

				is2vir = 1 - is2vir

				If is2vir = 0 Then col = 2; goto1 = 1 ': GoTo gocol

			End If

			If goto1 = 0 And isnum = 1 And IsADigitDot(c1) = False Then

				SetColorWordBasic(stl, i - 1, 3)
				stl = -1
				isnum = 0

				'GoTo no2
				goto2 = 1
			End If
			
			If goto1 = 0 And ishex = 1 And IsACharHex(c1) = False Then

				SetColorWordBasic(stl, i - 1, 3)
				stl = -1
				ishex = 0

				'GoTo no2
				goto2 = 1
			End If
			
			If goto1 = 0 And goto2 = 0 And isword = 1 And IsALetter(c1) = False And IsADigitDot(c1) = False And IsLineOK(c1, i) = True Then

				SetColorWordBasic(stl, i - 1, 0)
				stl = -1
				isword = 0

				'GoTo no2
				goto2 = 1
			End If

			If goto1 = 0 And goto2 = 0 And isrem = 0 And is2vir = 0 Then
				
				If c1 = 36 And isnum = 0 And isword = 0 Then ishex = 1; If stl = -1 Then stl = i
				
				If IsALetter(c1) And isnum = 0 And ishex = 0 Then isword = 1; If stl = -1 Then stl = i

				If IsADigitDot(c1) And isword = 0 And ishex = 0 Then isnum = 1; If stl = -1 Then stl = i

			End If

			'no2:


			If goto1 = 0 And isrem = 1 Then col = 1; goto1 = 1 ': GoTo gocol

			If goto1 = 0 And is2vir = 1 Then col = 2


			'gocol:

			c = c1 | col * 256

			If c1 = 10 Then c = 10
			If c1 = 13 Then c = 13

			doc.Crs[i] = c
			
		Next
		
	End Method
	
	Method SetColorWordBasic(iniz:Int, fin:Int, tipo:Int)
		' Modalita' "preserva": una parola che il pass lessicale classifica come
		' identificatore generico (tipo 0) NON deve cancellare un colore
		' semantico gia' presente (>=5: global, local, field, method, class,
		' function). Serve per la riga che si sta scrivendo: prima il pass base
		' la sbiancava e bisognava ricalcolare i colori di scope, che su una
		' routine lunga costava 248 ms a battuta.
		' Non vale per il dialetto 1: li' 5 e 6 sono label e variabili, che si
		' rileggono dalle liste degli shortcut a ogni passata (sotto), non dal
		' calcolo di scope che questa scorciatoia serve a evitare. Preservarli
		' vorrebbe dire tenersi il colore di una label appena cancellata.
		If blHLBasicVariant <> 1 And hlPreserveSemanticWords And tipo = 0 And iniz >= 0 And iniz < doc.Crs.Length Then
			Local prevCol:Int = (doc.Crs[iniz] / 256) & 255
			If prevCol >= 5 Then Return
		EndIf

		If iniz < 0 Or iniz > doc.Crs.Length - 1 Then Return
		If fin < 0 Or fin > doc.Crs.Length - 1 Then Return

		Local ln:Int = fin - iniz + 1
		If ln <= 0 Then Return

		If hlFastBasicWordMode Then
			For Local i:Int = iniz To fin
				Local c1:Int = doc.Crs[i] & 255
				doc.Crs[i] = c1 | tipo * 256
			Next
			Return
		EndIf
		
		Local ch:Int[ln]
		For Local i:Int = 0 To ln - 1
			ch[i] = doc.Crs[iniz + i] & 255
		Next
		Local word:String = String.FromChars(ch)
		
		' Dialetto 1: le label e le variabili del sorgente MSX prendono un colore
		' proprio (5 e 6). Le liste sono quelle gia' costruite per il pannello
		' Shortcuts, quindi non c'e' niente da ri-analizzare qui.
		If blHLBasicVariant = 1 Then

			If CheckShortcut(labels, word) Then tipo = 5

			If CheckShortcut(vars, word) Then tipo = 6

		EndIf


		Local isakw:= IsAKeyWordBasic(word)

		If isakw > -1 Then
			If blHLBasicVariant = 1 And blHLKeywordsBasic.Length > 0 Then
				word = blHLKeywordsBasic[isakw]
			Else
				word = keywordscxs[isakw]
			EndIf
			tipo = 4
		End If


		If blHLBasicVariant = 1 Then

			isakw = IsAPreProcBasic(word)

			If isakw > - 1 Then
				word = blHLKeywordsPreProc[isakw]
				tipo = 7
			End If

		EndIf

		Local j:Int = 0
		
		For Local i:Int = iniz To fin

			'local c:Int = Crs[i] & 255
	
			Local cw2:Int = word[j]
			
			doc.Crs[i] = cw2 | tipo * 256

			j = j + 1

		Next

	End
	
	Method CheckShortcut(sc:blShortcut, wo:String)

		If sc = Null Then Return 0
		If sc.sclist = Null Then Return 0

		Local l:= sc.sclist.sclistname.Length
	
		For Local i = 0 To l - 1
	
			If sc.sclist.sclistname[i] = wo Then Return 1
	
		Next
	
		Return 0
	
	End
	
	Method IsAKeyWordBasic:Int(w: String)

		Local w2:String = w.ToUpper

		If blHLBasicVariant = 1 And blHLKeywordsBasic.Length > 0 Then

			For Local i:Int = 0 To blHLKeywordsBasic.Length - 1

				If w2 = blHLKeywordsBasic[i].ToUpper Then Return i

			Next

			Return -1

		EndIf

		For Local i:Int = 0 To keywordscxs.Length - 1

			If w2 = keywordscxs[i].ToUpper Then Return i

		Next

		Return -1

	End

	Method IsAPreProcBasic:Int(w:String)

		If blHLBasicVariant <> 1 Then Return -1

		Local w2:String = w.ToUpper

		For Local i:Int = 0 To blHLKeywordsPreProc.Length - 1

			If w2 = blHLKeywordsPreProc[i].ToUpper Then Return i

		Next

		Return -1

	End
	Method IsLineOK:Bool(c:Int, l:Int)

		If c <> 13 Or idcaret <> l Then Return True

		Return False

	End

	Function IsADigitDot:Bool(c:Int)

		If c = 46 Or c >= 48 And c <= 57 Then Return True

		Return False

	End

	' --- evidenziazione assembly Z80 (usata da MSXCompiler) ---

	Method HighlightinglineAsm(idl:Int)
		
	
		Local idl1:Int = doc.idline[idl]
		Local idl2:Int = doc.idline[idl + 1] - 1

		Local col:Int

		Local isrem:Int = 0
		Local is2vir:Int = 0
		Local is2vir2:int = 0
		Local isnum:Int = 0
		Local isword:Int = 0

		Local stl:Int = -1

		For Local i:Int = idl1 To idl2

			Local c:Int = doc.Crs[i]

			local c1:Int= c & 255
			
			'Dim c2 = (c And 65280) / 256
			col = 0
			
			Local goto1:Int = 0
			Local goto2:Int = 0
			
			If c1 = charrem_asm And is2vir = 0 Then

				isrem = 1

			End If
			If c1 = char2vir_bas And isrem = 0 Then

				is2vir = 1 - is2vir

				If is2vir = 0 Then col = 2; goto1 = 1 ': GoTo gocol

			End If
			
			If c1 = char2vir2_asm And isrem = 0 And is2vir = 0 Then

				is2vir2 = 1 - is2vir2

				If is2vir2 = 0 Then col = 2; goto1 = 1 ' GoTo gocol
				
			EndIf

			If goto1 = 0 And isnum = 2 And IsADigitAsm(c1) = False Then

				SetColorWordAsm(stl, i - 1, 3)
				stl = -1
				isnum = 0

				'GoTo no2
				goto1 = 1
			End If

			If goto1 = 0 And isnum = 1 And IsADigit(c1) = False Then

				SetColorWordAsm(stl, i - 1, 3)
				stl = -1
				isnum = 0

				'GoTo no2
				goto1 = 1
			End If

			If goto1 = 0 And isword = 1 And IsALetter(c1) = False And IsADigit(c1) = False And IsLineOK(c1, i) = True Then

				SetColorWordAsm(stl, i - 1, 0)
				stl = -1
				isword = 0

				'GoTo no2
				goto1 = 1
			End If

			If goto1 = 0 And isrem = 0 And is2vir = 0 And is2vir2 = 0 Then

				If IsALetter(c1) And isnum = 0 Then isword = 1; If stl = -1 Then stl = i

				If IsADigitAsm(c1) And isnum = 0 And isword = 0 Then isnum = 2; If stl = -1 Then stl = i

				If IsADigit(c1) And isnum = 0 And isword = 0 Then isnum = 1; If stl = -1 Then stl = i

				If c1 = 36 And isnum = 0 And isword = 0 Then isnum = 2; If stl = -1 Then stl = i

			End If

			'no2:


			If goto1 = 0 And isrem = 1 Then col = 1; goto2 = 1 ': GoTo gocol

			If goto2 = 0 And is2vir = 1 Then col = 2

			If goto2 = 0 And is2vir2 = 1 Then col = 2

			'gocol:

			c = c1 | col * 256

			If c1 = 10 Then c = 10
			If c1 = 13 Then c = 13

			doc.Crs[i] = c
			
		Next
		
	
	End Method

	Method SetColorWordAsm(iniz:Int, fin:Int, tipo:Int)

		If iniz < 0 Or iniz > doc.Crs.Length - 1 Then Return
		If fin < 0 Or fin > doc.Crs.Length - 1 Then Return

		Local word:String = ""
			
		For Local i:Int = iniz To fin

			Local c:Int = doc.Crs[i] & 255

			word = word + String.FromChar(c)

		Next

		Local isl2:= IsALabelAsm(word)
		
		'If isl2 Then
		'	For Local i = 0 To idlabelname - 1
		'		If word = labelname[i] Then tipo = 5
		'	Next
		'EndIf
		
		'For Local i = 0 To idvariablename - 1
		'	If word = variablename[i] Then tipo = 6
		'Next
		
		If CheckShortcut(labels, word) Then tipo = 5
		
		If CheckShortcut(vars, word) Then tipo = 6
		
		Local isakw:Int = IsAKeyWordAsm(word)

		If isakw > -1 Then
			word = keywordasm[isakw]
			tipo = 4
		EndIf

		
		
		Local j:int = 0
		For Local i:Int = iniz To fin

			'Local c:Int = Crs[i] & 255

			doc.Crs[i] = word[j] | tipo * 256

			j = j + 1

		Next

	End Method

	Function IsAKeyWordAsm:Int(w:String)

		Local w2:String = w.ToUpper

		For Local i:Int = 0 To keywordasm.Length - 1

			If w2 = keywordasm[i].ToUpper Then Return i

		Next

		Return -1

	End Function


	'note: COLORAZIONE C/C++ E JAVA
	'
	' Un colorer solo per tutti e due: hanno gli stessi commenti (// e /* */),
	' le stesse stringhe con escape e gli stessi numeri. Cambiano solo
	' l'elenco delle parole chiave e due dettagli, decisi da doc.language:
	' il preprocessore (#include) esiste solo in C, le annotazioni (@Override)
	' solo in Java.
	'
	' Stessa impalcatura di HighlightinglineAsm - si scorre la riga carattere
	' per carattere e si scrive il colore nel byte alto di Crs - con in piu' le
	' due cose che il BASIC non ha:
	'
	'   - i commenti a blocco /* */, che possono attraversare piu' righe. Il
	'     colorer da solo non potrebbe saperlo (vede una riga per volta), quindi
	'     legge da doc.remAtLineStart se la riga comincia gia' dentro un
	'     commento. Quell'array lo riempie HL_CLikeScanBlockComments.
	'   - le sequenze di escape: in "a\"b" quel \" NON chiude la stringa, e in
	'     '\\' la barra e' il carattere, non un escape. Senza questo una sola
	'     barra a fine stringa tingerebbe di stringa tutto il resto della riga.
	'
	' Le parole chiave si confrontano ESATTAMENTE, senza ToUpper: in C++ e in
	' Java "int" e "Int" sono due cose diverse.
	'
	' NON gestiti i text block di Java 15 (""" ... """), che attraversano le
	' righe come i /* */: servirebbe tenerne lo stato in remAtLineStart come si
	' fa per i commenti. Nei .java di questi moduli non ce ne sono.
	Method HighlightinglineCLike(idl:Int)

		Local idl1:Int = doc.idline[idl]
		Local idl2:Int = doc.idline[idl + 1] - 1

		' 1 se la riga comincia dentro un /* */ aperto piu' su
		Local isrem:Int = 0
		If idl >= 0 And idl < doc.remAtLineStart.Length Then isrem = doc.remAtLineStart[idl]

		Local isrem2:Int = 0        ' commento //, da qui a fine riga
		Local isstr:Int = 0         ' dentro "..."
		Local ischr:Int = 0         ' dentro '...'
		Local isnum:Int = 0
		Local isword:Int = 0
		Local isesc:Int = 0         ' il carattere precedente era una barra rovescia
		Local isprep:Int = 0        ' dentro il nome di una direttiva: #include, #define...

		Local stl:Int = -1

		For Local i:Int = idl1 To idl2

			Local c:Int = doc.Crs[i]
			Local c1:Int = c & 255

			Local c2:Int = 0
			If i < idl2 Then c2 = doc.Crs[i + 1] & 255

			Local col:Int = 0

			' fine riga: si tinge e basta, senza cambiare stato
			If c1 = 10 Or c1 = 13 Then
				doc.Crs[i] = c1
				Continue
			EndIf

			' --- chiusura di una parola o di un numero rimasti aperti
			If isrem = 0 And isrem2 = 0 And isstr = 0 And ischr = 0 Then

				If isnum = 1 And IsADigitCLike(c1) = False Then
					SetColorWordCLike(stl, i - 1, 3)
					stl = -1
					isnum = 0
				EndIf

				If isword = 1 And IsALetter(c1) = False And IsADigit(c1) = False Then
					SetColorWordCLike(stl, i - 1, 0)
					stl = -1
					isword = 0
				EndIf

			EndIf

			' --- stato
			If isrem = 1 Then

				' dentro /* */: si esce solo con */
				col = 1

				If c1 = 42 And c2 = 47 Then     ' * /
					doc.Crs[i] = c1 | 1 * 256
					i += 1
					doc.Crs[i] = 47 | 1 * 256
					isrem = 0
					Continue
				EndIf

			ElseIf isrem2 = 1 Then

				col = 1

			ElseIf isstr = 1 Or ischr = 1 Then

				col = 2

				If isesc Then
					isesc = 0
				ElseIf c1 = 92 Then             ' barra rovescia
					isesc = 1
				ElseIf isstr = 1 And c1 = 34 Then
					isstr = 0
				ElseIf ischr = 1 And c1 = 39 Then
					ischr = 0
				EndIf

			ElseIf isprep = 1 And IsALetter(c1) Then

				' il nome della direttiva subito dopo il #: include, define, if...
				col = 4

			Else

				isprep = 0

				' --- codice normale
				If c1 = 47 And c2 = 47 Then        ' //
					isrem2 = 1
					col = 1
				ElseIf c1 = 47 And c2 = 42 Then    ' /*
					doc.Crs[i] = c1 | 1 * 256
					i += 1
					doc.Crs[i] = 42 | 1 * 256
					isrem = 1
					Continue
				ElseIf c1 = 34 Then                ' "
					isstr = 1
					isesc = 0
					col = 2
				ElseIf c1 = 39 Then                ' '
					ischr = 1
					isesc = 0
					col = 2
				ElseIf c1 = 35 And doc.language = 2 And isword = 0 And isnum = 0 Then
					' direttiva del preprocessore: #include, #if, #define...
					' Il # e il nome che segue si colorano insieme. Solo C/C++:
					' in Java il cancelletto non ha nessun significato.
					isprep = 1
					col = 4
				ElseIf c1 = 64 And doc.language = 3 And isword = 0 And isnum = 0 Then
					' annotazione Java: @Override, @SuppressWarnings...
					' Stesso trucco del #: la chiocciola e il nome che segue si
					' colorano insieme.
					isprep = 1
					col = 4
				Else

					If IsALetter(c1) And isnum = 0 Then
						isword = 1
						If stl = -1 Then stl = i
					EndIf

					If IsADigit(c1) And isnum = 0 And isword = 0 Then
						isnum = 1
						If stl = -1 Then stl = i
					EndIf

				EndIf

			EndIf

			doc.Crs[i] = c1 | col * 256

		Next

		' parola o numero che finiscono con la riga
		If isrem = 0 And isrem2 = 0 And isstr = 0 And ischr = 0 And stl >= 0 Then

			Local fin:Int = idl2
			While fin >= stl
				Local cf:Int = doc.Crs[fin] & 255
				If cf <> 10 And cf <> 13 Then Exit
				fin -= 1
			Wend

			If isnum = 1 Then
				SetColorWordCLike(stl, fin, 3)
			ElseIf isword = 1 Then
				SetColorWordCLike(stl, fin, 0)
			EndIf

		EndIf

	End Method


	Method SetColorWordCLike(iniz:Int, fin:Int, tipo:Int)

		If iniz < 0 Or iniz > doc.Crs.Length - 1 Then Return
		If fin < 0 Or fin > doc.Crs.Length - 1 Then Return
		If fin < iniz Then Return

		Local word:String = ""

		For Local i:Int = iniz To fin
			word = word + String.FromChar(doc.Crs[i] & 255)
		Next

		If IsAKeyWordCLike(word, doc.language) Then tipo = 4

		For Local i:Int = iniz To fin
			doc.Crs[i] = (doc.Crs[i] & 255) | tipo * 256
		Next

	End Method


	' Confronto esatto, senza ToUpper: le parole chiave di C++ e Java sono
	' minuscole, e "Int" non e' "int".
	Function IsAKeyWordCLike:Bool(w:String, lang:Int)

		If w = "" Then Return False

		If lang = 3 Then

			For Local i:Int = 0 To keywordsjava.Length - 1
				If w = keywordsjava[i] Then Return True
			Next

			Return False

		EndIf

		For Local i:Int = 0 To keywordscpp.Length - 1
			If w = keywordscpp[i] Then Return True
		Next

		Return False

	End Function


	' Cifre di un numero C: le decimali piu' quelle esadecimali e la x di 0x.
	Function IsADigitCLike:Bool(c:Int)

		If c >= 48 And c <= 57 Then Return True
		If c >= 65 And c <= 70 Or c >= 97 And c <= 102 Then Return True
		If c = 88 Or c = 120 Then Return True

		Return False

	End


	' Una passata sola su tutto il file per sapere quali righe cominciano
	' dentro un /* */. Va rifatta quando il testo cambia: la chiama MakeLines2,
	' che gia' riscansiona tutto il documento a ogni modifica, quindi non
	' aggiunge un giro in piu' di quelli che ci sono gia'.
	'
	' Serve guardare anche stringhe e // : un "/*" dentro una stringa, o dopo
	' un //, non apre un bel niente.
	Method HL_CLikeScanBlockComments()

		If doc = Null Then Return
		If doc.language <> 2 And doc.language <> 3 Then Return

		Local n:Int = doc.idlines
		If n < 1 Then Return

		If doc.remAtLineStart.Length < n + 1
			doc.remAtLineStart = doc.remAtLineStart.Resize(n + 256)
		EndIf

		Local isrem:Int = 0

		For Local idl:Int = 0 To n - 1

			doc.remAtLineStart[idl] = isrem

			Local i1:Int = doc.idline[idl]
			Local i2:Int = doc.idline[idl + 1] - 1

			If i2 > doc.Crs.Length - 1 Then i2 = doc.Crs.Length - 1

			Local isstr:Int = 0
			Local ischr:Int = 0
			Local isesc:Int = 0

			Local i:Int = i1

			While i <= i2

				Local c1:Int = doc.Crs[i] & 255

				Local c2:Int = 0
				If i < i2 Then c2 = doc.Crs[i + 1] & 255

				If isrem Then

					If c1 = 42 And c2 = 47 Then     ' */
						isrem = 0
						i += 1
					EndIf

				ElseIf isstr Or ischr Then

					If isesc Then
						isesc = 0
					ElseIf c1 = 92 Then
						isesc = 1
					ElseIf isstr And c1 = 34 Then
						isstr = 0
					ElseIf ischr And c1 = 39 Then
						ischr = 0
					EndIf

				Else

					If c1 = 47 And c2 = 47 Then     ' // : il resto della riga non conta
						Exit
					ElseIf c1 = 47 And c2 = 42 Then ' /*
						isrem = 1
						i += 1
					ElseIf c1 = 34 Then
						isstr = 1
						isesc = 0
					ElseIf c1 = 39 Then
						ischr = 1
						isesc = 0
					EndIf

				EndIf

				i += 1

			Wend

		Next

	End Method

	Function IsALetter:Bool(c:Int)

		If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Then Return True

		Return False

	End
	
	Function IsACharHex:Bool(c:Int)

		If c >= 48 And c <= 57 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c = 36 Then Return True

		Return False

	End Function
	
	Function IsALetterOrDigitOrVirg:Bool(c:Int)

		If c = 34 or c >= 48 and c <= 57 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Then Return True

		Return False

	End

	Function IsAnOperand:Bool(c:Int)
	
		'    &         |          ~          *         +         -         /         <         >         =
		If c = 38 or c = 124 or c = 126 or c = 42 or c = 43 or c = 45 or c = 47 or c = 60 or c = 62 or c = 61 Then Return True
			
		Return False

	End

	
	
	
	'note: REFR SHORTCUTS
	
	' --- Invio: spostare gli shortcut invece di ricostruirli -----------------
	' RefreshShortcuts fa TRE scansioni complete del documento (MakeLabels,
	' MakeListFunctions, RefreshFileClassShortcuts, le ultime due tokenizzano
	' ogni riga): misurati 3208 ms su _prove/T16.cxs, 28648 righe. InsEnter la
	' faceva scattare a ogni Invio - MarkShortcutsDirty - ed era esattamente la
	' pausa di qualche secondo che si sentiva andando a capo. Digitando un
	' carattere normale invece non scatta, ed e' per questo che si sentiva solo
	' sull'Invio.
	' Ma un Invio in mezzo al codice non cambia QUALI funzioni, classi o note
	' esistono: sposta solo di una riga tutto quello che sta sotto. Quando la
	' riga spezzata non contiene niente che le tre liste guardino, si aggiornano
	' i soli numeri di riga - costo proporzionale al numero di shortcut, non
	' alle righe del file - e la ricostruzione si evita del tutto. Negli altri
	' casi (riga con una keyword di blocco, un commento o una stringa) si
	' ricostruisce come prima.

	Method SC_TokenIsShortcutSignificant:Int(u:String)
		Select u
			Case "CLASS", "INTERFACE", "METHOD", "FUNCTION", "PROPERTY"
				Return 1
			Case "FIELD", "GLOBAL", "LOCAL", "CONST"
				Return 1
			Case "SELECT", "TRY", "IF", "THEN", "ELSE", "ELSEIF", "ENDIF"
				Return 1
			Case "WHILE", "WEND", "FOR", "NEXT", "REPEAT", "UNTIL", "FOREVER"
				Return 1
			Case "END", "EXTERN", "PUBLIC", "PRIVATE", "PROTECTED"
				Return 1
			Case "ABSTRACT", "FINAL", "EXTENDS", "IMPLEMENTS", "#"
				Return 1
		End
		Return 0
	End

	Method SC_LineIsShortcutNeutral:Int(lineTxt:String)
		' L'apostrofo apre un commento, e da li' MakeLabels tira fuori le note:
		' una riga che ne contiene uno non e' mai neutra. Le virgolette possono
		' nascondere qualunque cosa al tokenizer, quindi stesso trattamento.
		If lineTxt.Contains("'") Then Return 0
		If lineTxt.Contains("~q") Then Return 0

		Local toks:= TokenizeCodeLine(lineTxt)
		For Local i:Int = 0 To toks.Length - 1
			If SC_TokenIsShortcutSignificant(toks[i].ToUpper()) Then Return 0
		Next
		Return 1
	End

	Method SC_ShiftOneShortcutList:Void(sc:blShortcut, fromLine:Int, delta:Int, onlyFile:String)
		If sc = Null Then Return
		If sc.sclist = Null Then Return

		For Local i:Int = 0 To sc.sclist.sclistline.Length - 1
			If onlyFile <> "" And i < sc.sclist.sclistfile.Length Then
				If sc.sclist.sclistfile[i] <> onlyFile Then Continue
			EndIf
			If sc.sclist.sclistline[i] >= fromLine Then
				sc.sclist.sclistline[i] = sc.sclist.sclistline[i] + delta
			EndIf
		Next
	End

	Method SC_ShiftShortcutLines:Void(fromLine:Int, delta:Int)
		SC_ShiftOneShortcutList(bookmarks, fromLine, delta, "")
		SC_ShiftOneShortcutList(functions, fromLine, delta, "")

		' Gli shortcut di classe tengono anche il file di provenienza: si
		' spostano solo le voci che vengono da QUESTO documento.
		Local pNorm:String = HL_NormalizePath(doc.fullname)
		For Local i:Int = 0 To classShortcutsCount - 1
			SC_ShiftOneShortcutList(classShortcuts[i], fromLine, delta, pNorm)
		Next
	End

	Method RefreshShortcuts()
		
		' Le tre liste dipendono SOLO dal testo di questo documento. Se il testo
		' non e' cambiato dall'ultima ricostruzione riuscita non c'e' niente da
		' rifare: si esce subito invece di ri-tokenizzare tutto il file. La firma
		' e' l'insieme dei valori che cambiano a ogni modifica registrata.
		Local scPathNow:String = HL_NormalizePath(doc.fullname)
		If scRefreshDoneOnce Then
			If scRefreshSeenLen = doc.Crs.Length And scRefreshSeenLines = doc.numtotallines Then
				If scRefreshSeenUr = doc.idurstates And scRefreshSeenPath = scPathNow Then
					Return
				EndIf
			EndIf
		EndIf
		scRefreshDoneOnce = 1
		scRefreshSeenLen = doc.Crs.Length
		scRefreshSeenLines = doc.numtotallines
		scRefreshSeenUr = doc.idurstates
		scRefreshSeenPath = scPathNow
		
		bookmarks.sclist.ClearList
		MakeLabels(bookmarks)

		If blHLBasicVariant = 1 Then

			labels.sclist.ClearList
			MakeListLabels(labels)

			vars.sclist.ClearList
			MakeListVariables(vars)

			Return

		EndIf

		functions.sclist.ClearList
		MakeListFunctions(functions)

		RefreshFileClassShortcuts()

		EnsureHistoryShortcutLast()
		RefreshHistoryShortcutList()

	End
	
	Method MakeListFunctions(sc:blShortcut)
		If sc = Null Then Return
		
		Local stackKind:String[64]
		Local top:Int = -1
		Local externMode:Int = 0

		For Local ln:Int = 0 To doc.numtotallines - 1
			Local lineTxt:String = GetLineTextByIndex(ln)
			Local toks:= TokenizeCodeLine(lineTxt)
			Local fi:Int = FirstCodeTokenIndex(toks)
			externMode = SCAN_TrackExternSection(toks, stackKind, top, externMode)
			If fi >= toks.Length Then Continue

			Local t0:String = toks[fi].ToUpper()
			Local t1:String = ""
			If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()

			If t0 = "ENDIF" Then
				top = AC_ScanPopKind(stackKind, top, "IF")
				Continue
			EndIf

			If t0 = "WEND" Or t0 = "NEXT" Then
				top = AC_ScanPopKind(stackKind, top, "LOOP")
				Continue
			EndIf

			If t0 = "CLASS" Or t0 = "INTERFACE" Then
				Local opnC:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
				If opnC <> "" Then
					top += 1
					If top > 63 Then top = 63
					stackKind[top] = opnC
				EndIf
				Continue
			EndIf

			If t0 = "METHOD" Or t0 = "FUNCTION" Then
				If t0 = "FUNCTION" Then
					Local inClass:Int = 0
					For Local si:Int = 0 To top
						If SCAN_IsClassKind(stackKind[si]) Then inClass = 1
					Next
					If inClass = 0 And fi + 1 < toks.Length Then
						Local nm:String = toks[fi + 1]
						If HL_IsIdentToken(nm) And Not HL_IsKeywordCXS(nm) Then
							sc.sclist.AddShortcut("Function " + nm, ln, "")
						EndIf
					EndIf
				' I metodi delle classi NON vanno nella lista "Functions": ci finivano
				' tutti accanto alla funzione vera e comparivano due volte (anche nel
				' sottoalbero della loro classe). Qui resta solo la Function globale.
				EndIf
				Local opnM:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
				If opnM <> "" Then
					top += 1
					If top > 63 Then top = 63
					stackKind[top] = opnM
				EndIf
				Continue
			EndIf

			If t0 = "END" Then
				Local want:String = SCAN_EndWantKind(t1)

				If want <> "" Then
					While top >= 0
						Local k:String = stackKind[top]
						top -= 1
						If k = want Or (want = "CLASS" And k = "CLASSX") Then Exit
					Wend
				ElseIf top >= 0 Then
					top -= 1
				EndIf
				Continue
			EndIf

			' Select/Try/If a blocco/While/For: chiusi da End, vanno sulla pila.
			Local opn:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
			If opn <> "" Then
				top += 1
				If top > 63 Then top = 63
				stackKind[top] = opn
				Continue
			EndIf
		Next
	End
	
	Method MakeLabels(sc:blShortcut)
	
		'idlabelsx = 0
		'numlabels = 0
		'idlabellines = 0
		
		Local labelchr:Int[1024]
		Local idlabelsx:Int
		
		For Local i = 0 To doc.numtotallines - 1
		
			Local l1 = doc.idline[i]
			Local l2 = doc.idline[i + 1]
			'Print l
			'Print l1 + "," + l2
						
			Local virg = 0
			Local k:int = 0
			'Local k2:Int = 0
			
			'Local label:string
			
			For Local j = l1 To l2 - 3
			
				Local c = doc.Crs[j] & 255
			
				If k = 1 Then
				
					'Print idlabelsx
				
					labelchr[idlabelsx] = c
					idlabelsx = idlabelsx + 1
					
				Else
				
					If c = 34 and k = 0 Then virg = 1 - virg
			
					If virg = 0 Then
					
						If c = 39 Then
							
							Local pn = ParseNOTE(j + 1)
							
							'If j < l2 - 4 and doc.Crs[j + 1] & 255 = 64 Then
							If j < l2 - 4 and pn Then
							
								k = 1
								'k2 = idlabelsx
								'Print "OK"
								
								If pn = 2 Then j = j + 4
								
							EndIf
				
						EndIf
				
					EndIf
					
				EndIf
				
			Next
			
			If k = 1 Then
				
				'If idstartbookm = -1 Then idstartbookm = k2
				
				'labellines[idlabellines] = i
				'labelindex[idlabellines] = k2
				'labellen[idlabellines] = idlabelsx - k2
				Local lb2chr:Int[idlabelsx - 1]
				
				For Local j = 1 To idlabelsx - 1
					
					lb2chr[j - 1] = labelchr[j]
				Next
				'idlabellines = idlabellines + 1
				Local nm:= String.FromChars(lb2chr).Trim
				'labelchr[idlabelsx] = 13
				'idlabelsx = idlabelsx + 1
				
				sc.sclist.AddShortcut(nm, i, "")
				
				idlabelsx = 0
				'numlabels = numlabels + 1
				
			EndIf
			
		Next
		
	End Method

	Method ParseNOTE(j)
	
		If doc.Crs[j] & 255 = 64 Then Return 1
		
		Local cmn:String = "note:"
		Local ok
		
		For Local i = 0 To 4
			
			Local ij = i + j
			
			If ij < doc.Crs.Length - 1 Then
			
				Local c = doc.Crs[ij] & 255
				
				If c = cmn[i] Then ok = ok + 1
			
			EndIf
				
		Next
	
		If ok = 5 Then Return 2
		
		Return 0
		
	End
	
	Method MakeListLabels(sc:blShortcut)
	
		'idlabelname = 0
	
		'Local labelchr:Int[1024]
		'ocal idlabelsx:Int
		
		For Local i = 0 To doc.numtotallines - 1
			
			Local l1 = doc.idline[i]
			Local l2 = doc.idline[i + 1]
		
			Local sl = 0
			Local il = 0
			
			'idlabelsx = 0
			
			For Local j = l1 To l2 - 3
			
				Local c = doc.Crs[j] & 255
			
				If IsLabChr(c) = 0 Then
					
					If sl = 0 Then Exit
					
					If c = 58 Then
						
						'Local k2 = idlabelsx
								
						'If idstartlabel = -1 Then idstartlabel = k2
							
						'labelchr[idlabelsx] = 38
						'idlabelsx = idlabelsx + 1
									
						Local ln = j - il - 1
						
						Local chrl:Int[ln + 1]
						
						Local kk = 0
						'Print "<" + ll + ">"
						For Local jj = il To j - 1
						
							'labelchr[idlabelsx] = doc.Crs[jj] & 255
							'idlabelsx = idlabelsx + 1
							
							chrl[kk] = doc.Crs[jj] & 255
							kk = kk + 1
						Next
									
						'labellines[idlabellines] = i
						'labelindex[idlabellines] = k2
						'labellen[idlabellines] = idlabelsx - k2
						
						'idlabellines = idlabellines + 1
										
						'Print ln + "->" + String.FromChars(chrl)
						
						Local labn:= String.FromChars(chrl)
						
						sc.sclist.AddShortcut(labn, i, "")
						
						'idlabelname = idlabelname + 1
									
						'labelchr[idlabelsx] = 13
						'idlabelsx = idlabelsx + 1
				
						'numlabels = numlabels + 1
					
					EndIf
						
					sl = 0
					
					Exit
						
				Else
					
					If sl = 0 Then
						sl = 1
						il = j
					EndIf
					
				EndIf
			
			Next
				
		Next
		
		
	End Method
	
	
	Method MakeListVariables(sc:blShortcut)
				
		'idvariablename = 0
		
		'Select language
		
		'Case 0
			
		For Local i = 0 To doc.numtotallines - 1
			
			MakeVariable(i, sc)
				
		Next
				
		'Case 1
			
		'For Local i = 0 To doc.numtotallines - 1
			
		'MakeEquVariable(i)
				
		'Next
				
		'End
		
		
	End Method
	
	Method MakeVariable(lin:int, sc:blShortcut)
			
		Local l1 = doc.idline[lin]
		Local l2 = doc.idline[lin + 1]
		'Print l
		'Print l1 + "," + l2
						
		Local virg = 0
		Local vrem = 0
		Local k:int = 0
			
		Local linevar:string
		Local linevardt:Int[1024]
		Local idlinevardt:Int
		
		For Local j = l1 To l2 - 3
			
			Local c = doc.Crs[j] & 255
			
			If k > 0 Then
				
				'Print idlabelsx
				If c = 39 Then Exit
				
				'linevar = linevar + String.FromChar(c)
				linevardt[idlinevardt] = c
				idlinevardt = idlinevardt + 1
				idlinevardt = idlinevardt & 1023
					
			Else
				
				If c = 34 and k = 0 and vrem = 0 Then virg = 1 - virg
				
				If c = 39 and k = 0 and virg = 0 Then Exit
			
				If virg = 0 and vrem = 0 Then
					
					If c = 100 or c = 68 Then
													
						k = 1
						'linevar = "D"
						linevardt[idlinevardt] = c
						idlinevardt = idlinevardt + 1
												
					EndIf
					'					If c = 102 or c = 70 Then
					'
					'						k = 2
					'						'linevar = "F"
					'						linevardt[idlinevardt] = c
					'						idlinevardt = idlinevardt + 1
					'
					'					EndIf
					'					If c = 109 or c = 77 Then
					'
					'						k = 3
					'						'linevar = "M"
					'						linevardt[idlinevardt] = c
					'						idlinevardt = idlinevardt + 1
					'
					'					EndIf
				EndIf
					
			EndIf
				
		Next
		
		If k > 0 Then
			
			linevardt = linevardt.Resize(idlinevardt)
			linevar = String.FromChars(linevardt)
		
		EndIf
		
		Select k
		
			Case 1
		
				Local ls:STRING = LeftString(linevar, 4).ToUpper
		
				If ls = "DIM " Then
			
					linevar = RightString(linevar, linevar.Length - 4).Trim
			
					linevar = linevar.Replace(" as ", " As ")
					linevar = linevar.Replace(" As ", "@!$@")
					linevar = linevar.Replace(" at ", " At ")
					linevar = linevar.Replace(" At ", "@!$@")
					linevar = linevar.Replace("=", "@!$@")
					
					Local lnv2:String[] = linevar.Split("@!$@")
			
					If lnv2.Length >= 2 Then
			
						Local nomivars:String[1]
				
						If lnv2[0].Find(",") > - 1 Then
			
							'nomivars = lnv2[0].Split(",")
							nomivars = SplitterV(lnv2[0])
							
						Else
							nomivars[0] = lnv2[0]
				
						EndIf
				
						'Local t = GetTipoVariable(lnv2[1].Trim)
						'If t = -1 Then t = 0
						
						't = 0
						
						For Local i = 0 To nomivars.Length - 1
					
							Local nwp:= nomivars[i].Split("(")
							
							'variablename[idvariablename] = nwp[0]
							
							Local vn:= nwp[0].Trim
									
							'idvariablename = idvariablename + 1
							
							
							Local strv:String = vn + "@" + nomivars[i].Trim + ":" + lnv2[1].Trim
							
							'Local strv:String = vn.Trim + ":" + lnv2[1].Trim
							
							'If t > 0 Then
							'	strv = "!" + nomivars[i].Trim + ":" + t
							'Else
							
							'EndIf
							
							
							'Print strv
					
							'Local k2 = idlabelsx
					
							'If idstartvaria = -1 Then idstartvaria = k2
							
							'							For Local j = 1 To strv.Length
							'
							'
							'								Local cv = strv[j-1]
							'
							'								labelchr[idlabelsx] = cv
							'								idlabelsx = idlabelsx + 1
							'
							'							Next
					
							'labellines[idlabellines] = lin
							'labelindex[idlabellines] = k2
							'labellen[idlabellines] = idlabelsx - k2
							
							'idlabellines = idlabellines + 1
				
							'labelchr[idlabelsx] = 13
							'idlabelsx = idlabelsx + 1
				
							'numlabels = numlabels + 1

							sc.sclist.AddShortcut(strv, lin, "")
							
						Next
				
					EndIf
			
				EndIf
		
				'			Case 2
				'
				'				Local ls:STRING = LeftString(linevar, 9).ToUpper
				'
				'				If ls = "FUNCTION " Then
				'
				'					linevar = RightString(linevar, linevar.Length - 9).Trim
				'
				'					Local strv:String = "$" + linevar
				'
				'					'Print strv
				'
				'					Local k2 = idlabelsx
				'
				'					For Local j = 1 To strv.Length
				'
				'
				'						Local cv = strv[j-1]
				'
