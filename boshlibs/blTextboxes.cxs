	Method SelectAll(xxca, yyca, wwca, hhca)
		
		MakeLines()

		idstartsel = 0
		
		If doc.idlines > doc.idline.Length - 1 Then doc.idlines = doc.idline.Length - 1
		
		If doc.idlines < 1 Then doc.idlines = 1
		
		'Print idline.Length
		'Print idlines
		
		idendsel = doc.idline[doc.idlines - 1] - 1

		idcaret = idendsel
		
		CaretOutOfScreen(xxca, yyca, wwca, hhca)
		
	End Method
	
	Method Copia()
		
		Local txt:String = ""
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		
		If idsel1 > doc.Crs.Length - 1 Then idsel1 = doc.Crs.Length - 1
		If idsel2 > doc.Crs.Length - 1 Then idsel2 = doc.Crs.Length - 1
		
		If idsel1 < 0 Then idsel1 = 0
		If idsel2 < 0 Then idsel2 = 0
				
		
		If idsel1 > idsel2 Then

			Local id0:Int = idsel1
			idsel1 = idsel2
			idsel2 = id0

		End If

		
		'Print idsel1 + "->" + idsel2
		
		
		For Local i:Int = idsel1 To idsel2 - 1

			Local c:Int = doc.Crs[i] & 255

			txt = txt + String.FromChar(c)

		Next

		If txt <> "" Then SetClipboard(txt)

		'Print txt

		'For Local i = 0 To txt.Length - 1
		
		'Print txt[i]
			
		'Next


	End Method
	
	Method Incolla(xxca, yyca, wwca, hhca)
		
		Local txt:String

		txt = GetClipboard
		
		If txt <> "" Then
		
			SaveSelectedAndPasteToUR()

			CancSelected()

			'For Local i:Int = 0 To txt.Length - 1

			'********
			'	Local c:Int = txt[i]
			'	InsChar(c)

			'Next

			'NEW
			
			Local paste:= txt.ToChars()
			
			Local lp = txt.Length
			
			
			InsertBlock(idcaret, idcaret + lp, paste)
						
			
			'MakeLines()
			
			idcaret = idcaret + lp
			
			CaretOutOfScreen(xxca, yyca, wwca, hhca)

			NotifyDocEdited
			HighlightinglineCaret()
			
			Return
			
			'OLD
			
			Local lc:Int = txt.Length
			Local lt:Int = doc.Crs.Length
						
			doc.Crs = doc.Crs.Resize(lt + lc + doc.stepcrs)
			
			'Local nlt = idcaret + lc
			
			Local ll = lt - idcaret '+ lc
			Local s1 = idcaret + ll
			'Local s2 = idcaret + lc
			
			'@@@@@@@@
			
			'Print s1
			'Print s1 - lc
			
			For Local i = 0 To ll - 1
			 
				If s1 - lc < 0 Then Exit
				
				doc.Crs[s1] = doc.Crs[s1 - lc]
				s1 = s1 - 1
				
				'If s1 - lc < 0 Then Exit
				
			Next
			
			
			For Local i = 0 To lc - 1
				doc.Crs[idcaret + i] = txt[i]
			Next
									
			MakeLines()
			
			idcaret = idcaret + lc
			
			CaretOutOfScreen(xxca, yyca, wwca, hhca)

			NotifyDocEdited
				
			AC_Close
			
		End If
		
		'SetCurrentLine(False)
		
	End Method
	
	Method Taglia(xxca, yyca, wwca, hhca)
	
		If idstartsel = idendsel Then Return

		Copia()

		SaveSelectedAndCutToUR()

		CancSelected()
		
		CaretOutOfScreen(xxca, yyca, wwca, hhca)
		
		NotifyDocEdited
		HighlightinglineCaret()
		
		'SetCurrentLine(False)
		
	End Method
	
	
	
	'note: UNDO/REDO SAVE DATA
	
	Method SaveSelectedAndCharToUR(c:Int)
	
		Local urs:= New URstate
		
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		Local l:Int = idsel2 - idsel1
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		
		Local cc3:Int[1]
		cc3[0] = c
		
		If idsel2 > - 1 and idsel2 <> idsel1 Then idcaret = idsel2
		
		urs.crs3 = cc3
		urs.idstartc3 = idcaret
		urs.idendc3 = idcaret + 1
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
			
	End Method
	
	Method SaveSelectedAndCancToUR(dd)
	
		Local urs:= New URstate
	
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		If idsel1 = idsel2 Then
			
			idsel1 = idcaret
			idsel2 = idcaret + 1
		
		EndIf
		
		If dd = 1 Then
			If doc.Crs[idsel1] = 13 And doc.Crs[idsel2] = 10 Then
				idsel2 = idsel2 + 1
			EndIf
		EndIf
		
		Local l:Int = idsel2 - idsel1
		
		'Print l
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		urs.idendc3 = 0
		urs.idstartc3 = 0
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
		
	End Method
	
	Method SaveSelectedAndBackspaceToUR(dd)
	
		Local urs:= New URstate
	
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		If idsel1 = idsel2 Then
			
			idsel1 = idcaret - 1
			idsel2 = idcaret
		
		EndIf
		
		If dd = 1 and idsel2 - 1 >= 0 and idsel1 - 1 >= 0 Then
			If doc.Crs[idsel2 - 1] = 10 And doc.Crs[idsel1 - 1] = 13 Then
				'idsel2 = idsel2 + 1
				idsel1 = idsel1 - 1
				'Print "!!!"
			EndIf
		EndIf
		
		If idsel1 < 0 Then idsel1 = 0
		
		Local l:Int = idsel2 - idsel1
		
		'Print l
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		urs.idendc3 = 0
		urs.idstartc3 = 0
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
		
	End Method
	
	Method SaveSelectedAndTabToUR()
	
		Local urs:= New URstate
		
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		Local l:Int = idsel2 - idsel1
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		
		Local cc3:Int[4]
		cc3[0] = 32
		cc3[1] = 32
		cc3[2] = 32
		cc3[3] = 32
		
		urs.crs3 = cc3
		urs.idstartc3 = idcaret
		urs.idendc3 = idcaret + 4
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
			
	End Method
	
	Method SaveSelectedAndEnterToUR()
	
		Local urs:= New URstate
		
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		Local l:Int = idsel2 - idsel1
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		Local indent:Int[] = EnterIndentChars()
		Local cc3:Int[2 + indent.Length]
		cc3[0] = 13
		cc3[1] = 10
		For Local i:Int = 0 To indent.Length - 1
			cc3[i + 2] = indent[i]
		Next
		
		urs.crs3 = cc3
		urs.idstartc3 = idcaret
		urs.idendc3 = idcaret + cc3.Length
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
			
	End Method
	
	Method SaveSelectedAndPasteToUR()
	
		Local urs:= New URstate
		
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		Local l:Int = idsel2 - idsel1
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		
		Local txt:String = GetClipboard
		
		If txt <> "" Then
		
			Local cc3:Int[txt.Length]
			
			For Local i:Int = 0 To txt.Length - 1

				Local c:Int = txt[i]
				cc3[i] = c
			
			Next
		
			urs.crs3 = cc3
			urs.idstartc3 = idcaret
			urs.idendc3 = idcaret + txt.Length
		
		EndIf
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
			
	End Method
	
	Method SaveSelectedAndCutToUR()
	
		Local urs:= New URstate
	
		urs.modeur = 0
		
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		If idsel1 = idsel2 Then
			
			idsel1 = idcaret
			idsel2 = idcaret' + 1
		
		EndIf
		
		Local l:Int = idsel2 - idsel1
		
		Local cc2:Int[l]
		Local cc3:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
			cc3[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		urs.crs3 = cc3
		urs.idstartc3 = 0'idsel1
		urs.idendc3 = 0'idsel2
		
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
		
	End Method
	
	
	Method SaveParseLineToUR(idl1, idl2, lin:String)
		
		'@@@@@@@@
		
		Local urs:= New URstate
					
		urs.modeur = 1
		
		urs.lencrs = doc.Crs.Length
		
		Local l:Int = idl2 - idl1
		
		Local l2:Int = lin.Length
		
		If l < 0 Then l = 0
		
		If l2 < 0 Then l2 = 0
		
		Local cc2:Int[l]
		Local cc3:Int[l2]
		
		'Print l
		'Print l2
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idl1 + i] '& 255
		Next
				
		'Print String.FromChars(cc2)
				
		For Local i = 0 To l2 - 1
			cc3[i] = lin[i]
		Next
		
		'Print String.FromChars(cc3)
		
		urs.crs2 = cc2
		urs.idstartc2 = idl1
		urs.idendc2 = idl2
		
		
		urs.crs3 = cc3
		urs.idstartc3 = idl1
		urs.idendc3 = idl1 + l2
		
		
		urs.poscar = idcaret
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
		
	End
	
	
	Method BackSpaceChar()
		
		SaveSelectedAndBackspaceToUR(1)
	
		idcaret = idcaret - 1

		If idcaret < 0 Then idcaret = 0

		Local id2:Int = idcaret - 1
		If id2 < 0 Then id2 = 0
		
		Local wasCrlf:Int = 0
		If doc.Crs[idcaret] = 10 And doc.Crs[id2] = 13 Then wasCrlf = 1

		If wasCrlf Then

			idcaret = idcaret - 1
			Local l:Int = doc.Crs.Length
			' Shift only the actual content, not the zero-padded tail of the allocated buffer.
			Local hi:Int = maxcrs - 1
			If hi <= 0 Or hi > l - 1 Then hi = l - 1
			If hi < idcaret Then hi = idcaret
			For Local i:Int = idcaret To hi - 1
				doc.Crs[i] = doc.Crs[i + 1]
			Next
			doc.Crs[hi] = 0
			For Local i:Int = idcaret To hi - 1
				doc.Crs[i] = doc.Crs[i + 1]
			Next
			doc.Crs[hi] = 0
			If hi < l - 1 Then doc.Crs[hi + 1] = 0

		Else

			Local l:Int = doc.Crs.Length
			' Shift only the actual content, not the zero-padded tail of the allocated buffer.
			Local hi:Int = maxcrs - 1
			If hi <= 0 Or hi > l - 1 Then hi = l - 1
			If hi < idcaret Then hi = idcaret
			For Local i:Int = idcaret To hi - 1
				doc.Crs[i] = doc.Crs[i + 1]
			Next
			doc.Crs[hi] = 0

		End If
		
		DocEnsureCrsTerminator()
		
		If wasCrlf Then
			MakeLines()
		ElseIf DocNeedsLineRebuildAfterEdit(idcaret, 0) Then
			MakeLines()
		Else
			ShiftIdlinesAfterPos(-1, idcaret)
		EndIf
		
		MarkScopeDirty
		
		'HighlightinglineNew(linecaret - 1)
		'HighlightinglineNew(linecaret)
		'HighlightinglineNew(linecaret + 1)

	
		'CaretOutOfScreen()
			
		
	End Method
	
	Method EnterIndentChars:Int[]()
		Local out:Int[0]
		If doc = Null Then Return out
		If doc.idlines < 2 Then Return out
		
		Local ln:Int = linecaret
		If ln < 0 Or ln >= doc.idlines - 1 Then Return out
		
		Local s:Int = doc.idline[ln]
		Local e:Int = doc.idline[ln + 1] - 1
		If e < s Then Return out
		
		Local n:Int = 0
		For Local i:Int = s To e
			Local c:Int = doc.Crs[i] & 255
			If c = 13 Or c = 10 Then Exit
			If c <> 32 And c <> 9 Then Exit
			n += 1
		Next
		
		If n <= 0 Then Return out
		out = out.Resize(n)
		For Local i:Int = 0 To n - 1
			out[i] = doc.Crs[s + i] & 255
		Next
		Return out
	End Method
	
	'	Method EnterIndentChars:Int[] ()
	'		Local out:Int[0]
	'		If doc = Null Then Return out
	'		If doc.idlines < 2 Then Return out
	'
	'		Local ln:Int = linecaret
	'		If ln < 0 Or ln >= doc.idlines - 1 Then Return out
	'
	'		Local s:Int = doc.idline[ln]
	'		Local e:Int = doc.idline[ln + 1] - 1
	'		If e < s Then Return out
	'
	'		Local n:Int = 0
	'		For Local i:Int = s To e
	'			Local c:Int = doc.Crs[i] & 255
	'			If c = 13 Or c = 10 Then Exit
	'			If c <> 32 And c <> 9 Then Exit
	'			n += 1
	'		Next
	'
	'		If n <= 0 Then Return out
	'		out = out.Resize(n)
	'		For Local i:Int = 0 To n - 1
	'			out[i] = doc.Crs[s + i] & 255
	'		Next
	'		Return out
	'	End Method
	
	Method InsEnter()
	
		' Dove cade l'Invio dentro la riga: da questo dipende se le liste di
		' shortcut cambiano davvero o se scalano soltanto di una riga.
		' Vedi il commento davanti a SC_LineIsShortcutNeutral.
		GetCursorLine()
		Local scLnBefore:Int = linecaret
		Local scShiftFrom:Int = -1
		Local scMidSplit:Int = 0

		If scLnBefore >= 0 And scLnBefore < doc.numtotallines Then

			Local scTxt:String = GetLineTextByIndex(scLnBefore)
			Local scCol:Int = idcaret - doc.idline[scLnBefore]
			If scCol < 0 Then scCol = 0
			If scCol > scTxt.Length Then scCol = scTxt.Length

			Local scLeft:String = scTxt[.. scCol].Trim()
			Local scRight:String = scTxt[scCol ..].Trim()

			If scRight = "" Then
				' Invio a fine riga - il caso di gran lunga piu' frequente,
				' si scrive una riga e si va a capo. La riga resta identica e
				' sotto ne nasce una vuota: nessuna lista cambia contenuto.
				scShiftFrom = scLnBefore + 1
			ElseIf scLeft = "" Then
				' Invio a inizio riga: la riga scende di uno tale e quale,
				' quindi si sposta anche lei.
				scShiftFrom = scLnBefore
			ElseIf SC_LineIsShortcutNeutral(scTxt) Then
				' Spezzata a meta', ma non contiene niente che le liste guardino.
				scShiftFrom = scLnBefore + 1
				scMidSplit = 1
			EndIf

		EndIf

		Local indent:Int[] = EnterIndentChars()
		Local addLen:Int = 2 + indent.Length
		Local l:Int = doc.Crs.Length

		If idcaret >= l - doc.stepcrs Then

			doc.Crs = doc.Crs.Resize(l + doc.stepcrs + indent.Length)

			l = doc.Crs.Length

		End If

		' Shift only the actual content, not the zero-padded tail of the allocated buffer.
		Local hi:Int = maxcrs - 1
		If hi <= 0 Or hi > l - addLen - 1 Then hi = l - addLen - 1
		If hi < idcaret Then hi = idcaret

		For Local i:Int = hi To idcaret Step - 1

			doc.Crs[i + addLen] = doc.Crs[i]
			
		Next

		doc.Crs[idcaret] = 13
		doc.Crs[idcaret + 1] = 10
		For Local i:Int = 0 To indent.Length - 1
			doc.Crs[idcaret + 2 + i] = indent[i]
		Next

		idcaret = idcaret + addLen

		DocEnsureCrsTerminator()
		MakeLines()
		NotifyDocEdited
		HighlightinglineCaret()
		MarkScopeDirty

		' Solo quando la riga e' stata spezzata a meta' le due parti vanno
		' ricontrollate: spezzare "EndIfX" produce un "EndIf" che prima non
		' c'era. A fine o a inizio riga il testo resta contiguo e intatto.
		If scMidSplit Then
			If SC_LineIsShortcutNeutral(GetLineTextByIndex(scLnBefore)) = 0 Then scShiftFrom = -1
			If scShiftFrom >= 0 And scLnBefore + 1 < doc.numtotallines Then
				If SC_LineIsShortcutNeutral(GetLineTextByIndex(scLnBefore + 1)) = 0 Then scShiftFrom = -1
			EndIf
		EndIf

		If scShiftFrom >= 0 Then
			SC_ShiftShortcutLines(scShiftFrom, 1)
		Else
			MarkShortcutsDirty()
		EndIf

		HL_RefreshVisibleLinesSameFileNow()

		'HighlightinglineNew(linecaret - 1)
		'HighlightinglineNew(linecaret)
		'HighlightinglineNew(linecaret + 1)


		'CaretOutOfScreen()
	
		
	End Method
	
	Method Undo(xxca, yyca, wwca, hhca)
		
		If doc.idurstates <> doc.idurstates2 Then
				
			'Print "UNDO!"
			
			doc.idurstates = doc.idurstates - 1
			If doc.idurstates < 0 Then doc.idurstates = doc.maxur
						
			Local urs:= doc.URstates[doc.idurstates]
			
			Select urs.modeur
			
				Case 0

					InsertBlock urs.idstartc2, urs.idendc2, urs.crs2
									
					CancelBlock urs.idstartc3, urs.idendc3
				
				Case 1

					CancelBlock urs.idstartc3, urs.idendc3

					InsertBlock urs.idstartc2, urs.idendc2, urs.crs2

					'				Case 2
					'
					'					CancelBlock urs.idstartc3, urs.idendc3
					'
					'					InsertBlock urs.idstartc2, urs.idendc2, urs.crs2
					
			End
						
			If urs.lencrs > - 1 Then doc.Crs = doc.Crs.Resize(urs.lencrs)
			
			idcaret = urs.poscar

			MakeLines()
			
			CaretOutOfScreen(xxca,yyca,wwca,hhca)

			NotifyDocEdited
			HighlightinglineCaret()
			
			idstartsel = -1
			idendsel = -1
			
		End If
	
	End Method
	
	Method Redo(xxca, yyca, wwca, hhca)
				
		Local id:Int = doc.idurstates
				
		If doc.URstates[id] <> Null Then
			
			Local id1:int = doc.idurstates + 1
			If id1 > doc.maxur Then id1 = 0
						
			If id1 = doc.idurstates2 Then Return
		
			'Print "REDO!"
			
			Local urs:= doc.URstates[id]
			
			idcaret = urs.poscar + 1
			
			Select urs.modeur

				Case 0
				
					InsertBlock urs.idstartc3, urs.idendc3, urs.crs3
					
					CancelBlock urs.idstartc2, urs.idendc2
				
				Case 1

					CancelBlock urs.idstartc2, urs.idendc2
		
					InsertBlock urs.idstartc3, urs.idendc3, urs.crs3

					'				Case 2
					'
					'					CancelBlock urs.idstartc2, urs.idendc2
					'
					'					InsertBlock urs.idstartc3, urs.idendc3, urs.crs3

			End
			
			If urs.lencrs > - 1 Then doc.Crs = doc.Crs.Resize(urs.lencrs)
			
			MakeLines()
			
			CaretOutOfScreen(xxca, yyca, wwca, hhca)

			NotifyDocEdited
			HighlightinglineCaret()
			
			'SetCurrentLine(False)
						
			doc.idurstates = doc.idurstates + 1
			If doc.idurstates > doc.maxur Then doc.idurstates = 0
			
		End If
	
	
	End Method
	
	
	Method SetNewPosCaret()

		idnavig = idnavig + 1

		If idnavig > maxnavig Then idnavig = maxnavig

		PointCaret[idnavig] = idcaret

		maxidnavig = idnavig - 1
		If idnavig > maxnavig Then idnavig = maxnavig


	End
	Method Forward(xxca, yyca, wwca, hhca)

		idnavig = idnavig + 1

		If idnavig > maxidnavig + 1 Then idnavig = maxidnavig + 1

		If idnavig > maxnavig Then idnavig = maxnavig

		idcaret = PointCaret[idnavig]

		IsBackOrFor = True
		CaretOutOfScreen(xxca, yyca, wwca, hhca)

		idcaret2 = idcaret

		IsBackOrFor = True
		'Refresh()

	End
	Method Backward(xxca, yyca, wwca, hhca)

		idnavig = idnavig - 1
		If idnavig < 0 Then idnavig = 0

		idcaret = PointCaret[idnavig]

		IsBackOrFor = True
		CaretOutOfScreen(xxca, yyca, wwca, hhca)

		idcaret2 = idcaret

		IsBackOrFor = True
		'Refresh()

	End
	
	Method GoToLine(ln)
		
		line = ln - 3
						
		If line < 0 Then line = 0
						
		If line > doc.numtotallines - 2 Then line = doc.numtotallines - 2
					
		VSBar.value = line
		VSBar.SetOBARFromValue
		
	End
	
	
	
	Method InsertBlock(idstart, idend, crsx:Int[])
		
		Local l = idend - idstart '- 1
		
		If l <= 0 Then Return
		
		Local cl:= doc.Crs.Length
		
		doc.Crs = doc.Crs.Resize(cl + l + 10)
		
		For Local i:Int = doc.Crs.Length - 2 To idstart + 1 Step - 1
		
			If i - l < 0 Then Exit
		
			doc.Crs[i] = doc.Crs[i - l]
					
		Next
		
		Local id:= idstart
							
		For Local i = 0 To l - 1 '+ 1
				
			doc.Crs[i + id] = crsx[i]
	
		Next
	
		MakeLines2
		MarkScopeDirty
		
	
	End Method
	
	Method CancelBlock(idstart, idend)
	
		
		Local l:Int = doc.Crs.Length

		Local id1:Int = idstart
		Local id2:Int = idend
		
		'Print idstart
		'Print idend
		
		If idstart >= idend Then Return
		
		'If id2 > l - 3 Then id2 = l - 3

		Local l0:Int = id2 - id1' - 1
		

		For Local i:Int = id1 To l - l0 - 1
			doc.Crs[i] = doc.Crs[i + l0]
			doc.Crs[i + l0] = 0
		Next
 
		idcaret = idcaret - l0
		
		MakeLines
		MarkScopeDirty

	
	End Method
	
	Method AC_Close()
		acOn = 0
		acApplyingCase = 0
		acPrefixUp = ""
		acOwnerTypeUp = ""
		acOwnerStaticClass = 0
		acStringKeywordDot = 0
		acItems = acItems.Resize(0)
		acSel = 0
		acScroll = 0
		acScrollHookOn = 0
		acScrollHookY = 0
		acPrefixStart = -1
		acPrefixEnd = -1
	End
	
	Method AC_IsIdentChar:Int(c:Int)
		If c = 95 Then Return 1
		If c >= 65 And c <= 90 Then Return 1
		If c >= 97 And c <= 122 Then Return 1
		If c >= 48 And c <= 57 Then Return 1
		Return 0
	End
	
	Method CT_Close()
		ctOn = 0
		ctOpenPos = -1
		ctParenCall = 1
		ctDecl = ""
		ctName = ""
		ctParams = ""
		ctArgIndex = 0
		ctOverloads = ctOverloads.Resize(0)
		ctOverloadIdx = 0
		ctOverloadManual = 0
		ctOlKeyUp = 0
		ctOlKeyDn = 0
		ctCtxOpenPos = -1
		ctCtxIdent = ""
		ctCtxOwner = ""
		ctCtxArgHint = -99999
		ctDeclsCached = ctDeclsCached.Resize(0)
		ctDeclSigIdent = ""
		ctDeclSigOwner = ""
		ctDeclSigDoc = ""
		ctDeclSigOpenPos = -1
		ctDeclSigSym = -1
		ctDeclSigScopeGen = -1
		ctDeclSigParser = -1
		ctDeclSigFileVer = -1
		ctDeclSymDebounceMs = 0
		ctIdleCtPollMs = 0
		ctPmLastSig = ""
		ctPmDecls = ctPmDecls.Resize(0)
		ctDrawLaySig = ""
		ctDrawInnerSigW = 0
		ctDrawInnerInfoW = 0
		ctThLastCaret = -1
		ctThLastLen = -1
		ctThLastOpen = -99999
		ctThSymVer = -1
		ctThParser = -1
		ctThScopeGen = -1
	End
	
	Method CT_ExtractParamsFromDecl:String(declStr:String)
		If declStr = "" Then Return ""
		Local a:Int = declStr.Find("(")
		If a < 0 Then Return ""
		Local b:Int = declStr.Find(")", a + 1)
		If b < 0 Then Return ""
		Return declStr[a + 1 .. b].Trim
	End
	
	Method CT_FindArgRange:Int[](params:String, argIdx:Int)
		Local out:Int[2]
		out[0] = -1
		out[1] = -1
		If params = "" Then Return out
		If argIdx < 0 Then argIdx = 0
		
		Local cur:Int = 0
		Local startPos:Int = 0
		Local depthRound:Int = 0
		Local depthAngle:Int = 0
		
		For Local i:Int = 0 To params.Length
			Local isEnd:Int = (i >= params.Length)
			Local c:Int = 0
			If Not isEnd Then c = params[i]
			
			If Not isEnd Then
				If c = 40 Then depthRound += 1
				If c = 41 And depthRound > 0 Then depthRound -= 1
				If c = 60 Then depthAngle += 1
				If c = 62 And depthAngle > 0 Then depthAngle -= 1
			EndIf
			
			Local isSep:Int = 0
			If isEnd Then
				isSep = 1
			ElseIf c = 44 And depthRound = 0 And depthAngle = 0 Then
				isSep = 1
			EndIf
			
			If isSep Then
				If cur = argIdx Then
					Local s:Int = startPos
					Local e:Int = i
					While s < e And params[s] = 32
						s += 1
					Wend
					While e > s And params[e - 1] = 32
						e -= 1
					Wend
					out[0] = s
					out[1] = e
					Return out
				EndIf
				cur += 1
				startPos = i + 1
			EndIf
		Next
		
		Return out
	End
	
	Method CT_ComputeArgIndex:Int(openPos:Int)
		If openPos < 0 Then Return 0
		If idcaret <= openPos Then Return 0
		
		Local depth:Int = 0
		Local argIdx:Int = 0
		
		For Local i:Int = openPos + 1 To idcaret - 1
			Local c:Int = doc.Crs[i] & 255
			If c = 40 Then
				depth += 1
			ElseIf c = 41 Then
				If depth > 0 Then depth -= 1 Else Exit
			ElseIf c = 44 And depth = 0 Then
				argIdx += 1
			EndIf
		Next
		
		If argIdx < 0 Then argIdx = 0
		Return argIdx
	End
	
	Method CT_FindIdentSpanAtOrBefore:Int[](pos:Int, lineStart:Int)
		Local res:Int[2]
		res[0] = -1
		res[1] = -1
		If pos < lineStart Then Return res
		
		Local p:Int = pos
		While p >= lineStart And (doc.Crs[p] & 255) = 32
			p -= 1
		Wend
		If p < lineStart Then Return res
		If Not AC_IsIdentChar(doc.Crs[p] & 255) Then Return res
		
		Local endp:Int = p
		While p >= lineStart And AC_IsIdentChar(doc.Crs[p] & 255)
			p -= 1
		Wend
		
		res[0] = p + 1
		res[1] = endp
		Return res
	End
	
	Method CT_IsRoutineDeclLine:Int(lineTxt:String, identUp:String)
		If lineTxt = "" Or identUp = "" Then Return 0
		Local u:String = lineTxt.Trim.ToUpper()
		Local want1:String = "FUNCTION " + identUp
		Local want2:String = "METHOD " + identUp
		If u.StartsWith(want1) Then Return 1
		If u.StartsWith(want2) Then Return 1
		Return 0
	End
	
	Method CT_ResolveCallContext:Int[](lineStart:Int, lineEnd:Int, caretLn:Int)
		Local ctx:Int[3]
		ctx[0] = -1
		ctx[1] = 1
		ctx[2] = -1
		
		Local depth:Int = 0
		Local openPos:Int = -1
		
		For Local i:Int = idcaret - 1 To lineStart Step -1
			Local c:Int = doc.Crs[i] & 255
			If c = 41 Then
				depth += 1
			ElseIf c = 40 Then
				If depth = 0 Then
					openPos = i
					Exit
				Else
					depth -= 1
				EndIf
			EndIf
		Next
		
		If openPos >= 0 Then
			ctx[0] = openPos
			ctx[1] = 1
			Local span:= CT_FindIdentSpanAtOrBefore(openPos - 1, lineStart)
			ctx[2] = span[0]
			Return ctx
		EndIf
		
		Local span2:= CT_FindIdentSpanAtOrBefore(idcaret - 1, lineStart)
		If span2[0] < 0 Then Return ctx
		
		Local identStart:Int = span2[0]
		Local identEnd:Int = span2[1]
		
		Local ident:String = ""
		For Local k:Int = identStart To identEnd
			ident += String.FromChar(doc.Crs[k] & 255)
		Next
		If ident = "" Or HL_IsKeywordCXS(ident) Then Return ctx
		
		Local lineTxt:String = GetLineTextByIndex(caretLn)
		If CT_IsRoutineDeclLine(lineTxt, ident.ToUpper()) Then Return ctx
		
		If idcaret < identStart Then Return ctx
		
		Local q:Int = identEnd + 1
		While q <= lineEnd And (doc.Crs[q] & 255) = 32
			q += 1
		Wend
		If q <= lineEnd Then
			Local cq:Int = doc.Crs[q] & 255
			If cq = 40 Then Return ctx
			If cq = 61 Then Return ctx
		EndIf
		
		ctx[0] = identEnd
		ctx[1] = 0
		ctx[2] = identStart
		Return ctx
	End
	
	Method CT_ComputeArgIndexEx:Int(openPos:Int, parenCall:Int, lineEnd:Int)
		If openPos < 0 Then Return 0
		If parenCall Then Return CT_ComputeArgIndex(openPos)
		
		Local argStart:Int = openPos + 1
		While argStart <= lineEnd And (doc.Crs[argStart] & 255) = 32
			argStart += 1
		Wend
		If idcaret <= argStart Then Return 0
		
		Local depth:Int = 0
		Local inStr:Int = 0
		Local argIdx:Int = 0
		
		For Local i:Int = argStart To idcaret - 1
			Local c:Int = doc.Crs[i] & 255
			If c = 34 Then
				inStr = 1 - inStr
				Continue
			EndIf
			If inStr Then Continue
			
			If c = 40 Or c = 91 Then
				depth += 1
			ElseIf c = 41 Or c = 93 Then
				If depth > 0 Then depth -= 1
			ElseIf c = 44 And depth = 0 Then
				argIdx += 1
			EndIf
		Next
		
		If argIdx < 0 Then argIdx = 0
		Return argIdx
	End
	
	Method CT_FindDeclForCall:String(ownerTypeUp:String, identUp:String, argCountHint:Int)
		If identUp = "" Then Return ""
		
		Local bestDecl:String = ""
		Local bestScore:Int = -1000000
		
		For Local pass:Int = 0 To 1
			Local m:StringMap<SymbolFileData>
			If pass = 0 Then m = symFiles Else m = symFilesFixed
			
			For Local it:=Eachin m
				Local fd:SymbolFileData = SymbolFileData(it.Value)
				If fd = Null Then Continue
				
				For Local i:Int = 0 To fd.count - 1
					Local decl:String = fd.decls[i]
					Local knd:String = SYM_DeclKindUp(decl)
					If knd <> "METHOD" And knd <> "FUNCTION" Then Continue
					
					Local nmUp:String = fd.names[i].ToUpper()
					Local identMatch:Int = 0
					Local ownerMatch:Int = 0
					
					If nmUp = identUp Then
						identMatch = 1
					Else
						Local d:Int = nmUp.FindLast(".")
						If d > 0 Then
							Local leftUp:String = LeftString(nmUp, d)
							Local rightUp:String = nmUp[d + 1 ..]
							If rightUp = identUp Then
								identMatch = 1
								If ownerTypeUp <> "" Then
									Local lShort:String = AC_ShortTypeUp(leftUp)
									Local oShort:String = AC_ShortTypeUp(ownerTypeUp)
									If leftUp = ownerTypeUp Or lShort = oShort Or AC_IsBaseOfUp(ownerTypeUp, leftUp) Then ownerMatch = 1
								EndIf
							EndIf
						EndIf
					EndIf
					
					If identMatch = 0 Then Continue
					
					Local score:Int = 0
					If ownerTypeUp <> "" Then
						If ownerMatch Then score += 300 Else score -= 150
					Else
						If knd = "FUNCTION" Then score += 80
					EndIf
					
					If argCountHint >= 0 Then
						Local mm:Int[] = SYM_ParseArgMinMax(decl)
						If mm[0] >= 0 Then
							If argCountHint >= mm[0] And argCountHint <= mm[1] Then score += 120 Else score -= 30
						Else
							Local ac:Int = SYM_ParseArgCount(decl)
							If ac >= 0 Then
								If ac = argCountHint Then score += 120 Else score -= 30
							EndIf
						EndIf
					EndIf
					
					If score > bestScore Then
						bestScore = score
						bestDecl = decl
					EndIf
				Next
			Next
		Next
		
		'Fallback: resolve member directly from owner source when symbol DB misses it
		'(eg some fixed-module methods like DrawText can be absent/incomplete in decl cache).
		If bestDecl = "" And ownerTypeUp <> "" Then
			Local visited:= New StringMap<Int>
			Local infoM:String = AC_FindMemberDeclInSource(ownerTypeUp, identUp, argCountHint, visited, 0)
			If infoM <> "" Then
				Local parts:= infoM.Split("|")
				If parts.Length >= 2 Then
					Local fpNorm:String = parts[0]
					Local ln0:Int = Int(parts[1])
					If fpNorm <> "" And ln0 >= 0 Then
						Local txt:String = ""
						Local curNorm:= HL_NormalizePath(doc.fullname).ToLower()
						If curNorm = fpNorm.ToLower() Then
							txt = doc.Text
						Else
							Local fp:= fpNorm.Replace("\", "/")
							If os.FileType(fp) = os.FILETYPE_FILE Then txt = os.LoadString(fp)
						EndIf
						
						If txt <> "" Then
							txt = txt.Replace(invio, "~n")
							txt = txt.Replace(String.FromChar(13), "~n")
							txt = txt.Replace(String.FromChar(10), "~n")
							Local lines:= txt.Split("~n")
							If ln0 >= 0 And ln0 < lines.Length Then
								Local lineDecl:String = lines[ln0].Trim
								If lineDecl <> "" Then bestDecl = lineDecl
							EndIf
						EndIf
					EndIf
				EndIf
			EndIf
		EndIf
		
		Return bestDecl
	End
	
	Method CT_DeclAritySortKey:Int(declStr:String)
		If declStr = "" Then Return 999999999
		Local mm:Int[] = SYM_ParseArgMinMax(declStr)
		If mm[0] >= 0 Then Return mm[0] * 65536 + mm[1]
		Local ac:Int = SYM_ParseArgCount(declStr)
		If ac < 0 Then Return 999999999
		Return ac * 65536 + ac
	End
	
	Method CT_SortDeclsByArity:Void(decls:String[])
		Local n:Int = decls.Length
		If n < 2 Then Return
		For Local i:Int = 0 To n - 2
			For Local j:Int = i + 1 To n - 1
				If CT_DeclAritySortKey(decls[i]) > CT_DeclAritySortKey(decls[j]) Then
					Local sw:String = decls[i]
					decls[i] = decls[j]
					decls[j] = sw
				EndIf
			Next
		Next
	End
	
	Method CT_ArityDistance:Int(declStr:String, argHint:Int)
		If argHint <= 0 Then Return 0
		Local mm:Int[] = SYM_ParseArgMinMax(declStr)
		If mm[0] >= 0 Then
			If argHint < mm[0] Then Return mm[0] - argHint
			If argHint > mm[1] Then Return argHint - mm[1]
			Return 0
		EndIf
		Local ac:Int = SYM_ParseArgCount(declStr)
		If ac < 0 Then Return Abs(argHint) + 100
		Return Abs(ac - argHint)
	End
	
	Method CT_BestOverloadIdx:Int(decls:String[], argHint:Int)
		Local n:Int = decls.Length
		If n <= 1 Then Return 0
		If argHint <= 0 Then Return 0
		Local bestI:Int = 0
		Local bestD:Int = 1000000
		For Local i:Int = 0 To n - 1
			Local d:Int = CT_ArityDistance(decls[i], argHint)
			If d < bestD Or (d = bestD And i < bestI) Then
				bestD = d
				bestI = i
			EndIf
		Next
		Return bestI
	End
	
	Method CT_ClassDeclVisibleFromOwner:Int(declClassUp:String, ownerTypeUp:String)
		If declClassUp = "" Or ownerTypeUp = "" Then Return 0
		If declClassUp = ownerTypeUp Then Return 1
		If AC_IsBaseOfUp(ownerTypeUp, declClassUp) Then Return 1
		Return 0
	End
	
	Method CT_ApplyOverloadIndex()
		If ctOverloads.Length = 0 Then Return
		If ctOverloadIdx < 0 Then ctOverloadIdx = 0
		If ctOverloadIdx >= ctOverloads.Length Then ctOverloadIdx = ctOverloads.Length - 1
		Local decl:String = ctOverloads[ctOverloadIdx]
		ctDecl = decl
		Local params:String = CT_ExtractParamsFromDecl(decl)
		ctParams = params
	End
	
	Method CT_OverloadParamKey:String(declStr:String)
		If declStr = "" Then Return ""
		Local p:String = CT_ExtractParamsFromDecl(declStr).Trim
		If p <> "" Then Return p
		Local a:Int = declStr.Find("(")
		Local b:Int = declStr.Find(")", a + 1)
		If a >= 0 And b > a Then Return declStr[a + 1 .. b].Trim
		Return declStr.Trim
	End
	
	' Chiave per riconoscere due volte la STESSA firma. Si confrontano i TIPI
	' dei parametri, non il testo: la stessa Method arriva in due forme diverse,
	' quella letta dal sorgente
	'     ( image:Image,tx:Float,ty:Float )
	' e quella dichiarata dal parser
	'     (Local image:$Image,Local tx:Float,Local ty:Float)
	' che ha in piu' "Local", il marcatore "$" sui tipi-oggetto e talvolta nomi
	' di parametro diversi. Confrontando il testo non combaciavano mai, e il tip
	' mostrava 8 firme invece di 4.
	Method CT_NormalizeParamTextForDedupe:String(params:String)
		If params = "" Then Return ""
		Local parts:= params.Split(",")
		Local out:String = ""
		For Local i:Int = 0 To parts.Length - 1
			Local p:String = parts[i].Trim.ToUpper()
			If p = "" Then Continue

			' via il valore di default: "rz:Float=0" e "rz:Float" sono la stessa cosa
			Local eq:Int = p.Find("=")
			If eq >= 0 Then p = LeftString(p, eq).Trim

			' il TIPO, non il nome del parametro
			Local c:Int = p.FindLast(":")
			If c >= 0 Then p = p[c + 1 ..].Trim

			p = p.Replace("LOCAL ", "").Replace("$", "").Replace(" ", "").Replace("~t", "")

			If out <> "" Then out += ","
			out += p
		Next
		Return out
	End

	' Come CT_OverloadListHasSignature, ma dice DOVE: serve per sostituire una
	' firma gia' presente con la riga di sorgente, piu' leggibile di quella
	' ricostruita dal parser.
	Method CT_OverloadIndexOfSignature:Int(out:String[], identUp:String, declStr:String)
		If declStr = "" Then Return -1
		Local key:String = CT_OverloadSignatureKey(identUp, declStr)
		For Local i:Int = 0 To out.Length - 1
			If CT_OverloadSignatureKey(identUp, out[i]) = key Then Return i
		Next
		Return -1
	End
	
	Method CT_DeclKindForOverload:String(declStr:String)
		Local k:String = SYM_DeclKindUp(declStr)
		If k = "METHOD" Or k = "FUNCTION" Then Return k
		Local dt:String = declStr.Trim.ToUpper()
		If dt.StartsWith("METHOD ") Then Return "METHOD"
		If dt.StartsWith("FUNCTION ") Then Return "FUNCTION"
		Return k
	End
	
	Method CT_OverloadSignatureKey:String(identUp:String, declStr:String)
		Local iu:String = identUp.ToUpper()
		If iu = "" Then iu = "?"
		Local knd:String = CT_DeclKindForOverload(declStr)
		Local paramsNorm:String = CT_NormalizeParamTextForDedupe(CT_OverloadParamKey(declStr))
		Return iu + "|" + knd + "|" + paramsNorm
	End
	
	Method CT_OverloadListHasSignature:Int(out:String[], identUp:String, declStr:String)
		If declStr = "" Then Return 1
		Local key:String = CT_OverloadSignatureKey(identUp, declStr)
		For Local i:Int = 0 To out.Length - 1
			If CT_OverloadSignatureKey(identUp, out[i]) = key Then Return 1
		Next
		Return 0
	End
	
	Method CT_ScrapeOverloadDeclLinesFromDoc:String[](ownerTypeUp:String, identUp:String, caretLn:Int)
		Local acc:String[] = New String[0]
		If identUp = "" Then Return acc
		
		Local n:Int = doc.numtotallines
		If n <= 0 Then Return acc
		
		Local curClassUp:String = ""
		Local ccId:Int = -1
		If caretLn >= 0 And caretLn < scopeClassAtLine.Length Then ccId = scopeClassAtLine[caretLn]
		If ccId >= 0 And ccId < scopeClassCount Then curClassUp = scopeClasses[ccId].nameUp
		
		Local stackUp:String[64]
		Local depth:Int = 0
		
		Local fromLn:Int = 0
		Local toLn:Int = n - 1
		If n > 8000 And caretLn >= 0 Then
			fromLn = caretLn - 2500
			If fromLn < 0 Then fromLn = 0
			toLn = caretLn + 2500
			If toLn >= n Then toLn = n - 1
		EndIf
		
		For Local ln:Int = fromLn To toLn
			Local lineTxt:String = GetLineTextByIndex(ln).Trim
			If lineTxt = "" Then Continue
			Local c0:Int = lineTxt[0]
			If c0 = 39 Or c0 = 35 Then Continue
			
			Local toks:String[] = TokenizeCodeLine(lineTxt)
			If toks.Length = 0 Then Continue
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			
			Local t0:String = toks[fi].ToUpper()
			Local t1u:String = ""
			If fi + 1 < toks.Length Then t1u = toks[fi + 1].ToUpper()
			
			If t0 = "CLASS" Or t0 = "INTERFACE" Then
				If depth < 64 Then
					stackUp[depth] = t1u
					depth += 1
				EndIf
				Continue
			EndIf
			
			If t0 = "END" And (t1u = "CLASS" Or t1u = "INTERFACE") Then
				If depth > 0 Then depth -= 1
				Continue
			EndIf
			
			If t0 <> "METHOD" And t0 <> "FUNCTION" Then Continue
			If fi + 1 >= toks.Length Then Continue
			Local memUp:String = toks[fi + 1].ToUpper()
			If memUp <> identUp Then Continue
			If lineTxt.Find("(") < 0 Then Continue
			
			Local pOpen:Int = lineTxt.Find("(")
			Local pClose:Int = -1
			If pOpen >= 0 Then pClose = lineTxt.Find(")", pOpen + 1)
			If pOpen < 0 Or pClose < pOpen Then Continue
			
			Local keepDecl:Int = 0
			If ownerTypeUp <> "" Then
				If depth <= 0 Then Continue
				Local declCU:String = stackUp[depth - 1]
				If declCU = "" Then Continue
				If CT_ClassDeclVisibleFromOwner(declCU, ownerTypeUp) Then keepDecl = 1
			ElseIf curClassUp <> "" Then
				If depth <= 0 Then Continue
				Local declCU2:String = stackUp[depth - 1]
				If CT_ClassDeclVisibleFromOwner(declCU2, curClassUp) Then keepDecl = 1
			Else
				If t0 = "METHOD" Then Continue
				If depth > 0 Then Continue
				keepDecl = 1
			EndIf
			
			If keepDecl = 0 Then Continue
			
			If CT_OverloadListHasSignature(acc, identUp, lineTxt) Then Continue
			
			acc = acc.Resize(acc.Length + 1)
			acc[acc.Length - 1] = lineTxt
		Next
		
		Return acc
	End
	
	Method CT_MergeOverloadLinesFromCurrentDoc:String[](ownerTypeUp:String, identUp:String, caretLn:Int, baseOut:String[])
		Local extra:String[] = CT_ScrapeOverloadDeclLinesFromDoc(ownerTypeUp, identUp, caretLn)
		If extra.Length = 0 Then Return baseOut
		
		Local merged:String[] = New String[0]
		For Local bi:Int = 0 To baseOut.Length - 1
			merged = merged.Resize(merged.Length + 1)
			merged[merged.Length - 1] = baseOut[bi]
		Next
		
		For Local ei:Int = 0 To extra.Length - 1
			Local dline:String = extra[ei]
			If CT_OverloadListHasSignature(merged, identUp, dline) Then Continue
			
			merged = merged.Resize(merged.Length + 1)
			merged[merged.Length - 1] = dline
		Next
		
		Return merged
	End
	
	Method CT_CollectDeclsForCall:String[](ownerTypeUp:String, identUp:String, caretLn:Int)
		If identUp = "" Then Return New String[0]
		
		Local out:String[] = New String[0]
		
		For Local pass:Int = 0 To 1
			Local m:StringMap<SymbolFileData>
			If pass = 0 Then m = symFiles Else m = symFilesFixed
			
			For Local it:=Eachin m
				Local fd:SymbolFileData = SymbolFileData(it.Value)
				If fd = Null Then Continue
				Local fpKey:String = HL_NormalizePath(String(it.Key))
				
				For Local i:Int = 0 To fd.count - 1
					Local decl:String = fd.decls[i]
					Local knd:String = SYM_DeclKindUp(decl)
					If knd <> "METHOD" And knd <> "FUNCTION" Then Continue
					
					Local nmUp:String = fd.names[i].ToUpper()
					Local identMatch:Int = 0
					Local ownerMatch:Int = 0
					
					If nmUp = identUp Then
						identMatch = 1
					Else
						Local d:Int = nmUp.FindLast(".")
						If d > 0 Then
							Local leftUp:String = LeftString(nmUp, d)
							Local rightUp:String = nmUp[d + 1 ..]
							If rightUp = identUp Then
								identMatch = 1
								If ownerTypeUp <> "" Then
									Local lShort:String = AC_ShortTypeUp(leftUp)
									Local oShort:String = AC_ShortTypeUp(ownerTypeUp)
									If leftUp = ownerTypeUp Or lShort = oShort Or AC_IsBaseOfUp(ownerTypeUp, leftUp) Then ownerMatch = 1
								EndIf
							EndIf
						EndIf
					EndIf
					
					If identMatch = 0 Then Continue
					
					If ownerTypeUp <> "" Then
						If ownerMatch = 0 Then
							If (knd = "METHOD" Or knd = "FUNCTION") And nmUp = identUp Then
								Local ln0:Int = fd.lines[i]
								If ln0 >= 0 Then
									Local dcu:String = AC_GetClassUpAtLine(fpKey, ln0)
									If dcu <> "" And CT_ClassDeclVisibleFromOwner(dcu, ownerTypeUp) Then ownerMatch = 1
								EndIf
							EndIf
						EndIf
						If ownerMatch = 0 Then Continue
					Else
						If knd <> "FUNCTION" And knd <> "METHOD" Then Continue
						Local okName:Int = 0
						If nmUp = identUp Then
							okName = 1
						Else
							Local dotp:Int = nmUp.FindLast(".")
							If dotp > 0 And nmUp[dotp + 1 ..] = identUp Then okName = 1
						EndIf
						If okName = 0 Then Continue
					EndIf
					
					Local pOpen:Int = decl.Find("(")
					Local pClose:Int = -1
					If pOpen >= 0 Then pClose = decl.Find(")", pOpen + 1)
					If pOpen < 0 Or pClose < pOpen Then Continue
					
					If CT_OverloadListHasSignature(out, identUp, decl) Then Continue
					
					out = out.Resize(out.Length + 1)
					out[out.Length - 1] = decl
				Next
			Next
		Next
		
		If ownerTypeUp <> "" Then
			Local visitSrc:= New StringMap<Int>
			Local srcDecls:String[] = AC_CollectMemberDeclLinesInTypeSource(ownerTypeUp, identUp, visitSrc)
			For Local si:Int = 0 To srcDecls.Length - 1
				Local dline:String = srcDecls[si]
				Local at:Int = CT_OverloadIndexOfSignature(out, identUp, dline)
				If at >= 0 Then
					' stessa firma gia' presente nella forma del parser: si tiene
					' la riga di sorgente, che e' quella che l'utente ha scritto
					out[at] = dline
					Continue
				EndIf
				out = out.Resize(out.Length + 1)
				out[out.Length - 1] = dline
			Next
		EndIf
		
		out = CT_MergeOverloadLinesFromCurrentDoc(ownerTypeUp, identUp, caretLn, out)
		
		If out.Length = 0 Then
			Local fb:String = CT_FindDeclForCall(ownerTypeUp, identUp, 0)
			If fb <> "" Then
				out = out.Resize(1)
				out[0] = fb
			EndIf
		EndIf
		
		If out.Length > 1 Then CT_SortDeclsByArity(out)
		Return out
	End
	
	' Guardia d'ingresso al tip dei parametri.
	'
	' In UpdateTextBoxOne c'e' una chiamata INCONDIZIONATA a CT_UpdateFromCaret
	' a ogni frame. Misurato su un file da 28.000 righe costava 20-58 ms per
	' frame, cioe' da sola tutta la lentezza della digitazione.
	' Il risultato del tip dipende solo da: posizione del caret, contenuto del
	' documento, scope, simboli del parser e file corrente. Se nessuno di questi
	' e' cambiato dall'ultima chiamata, ricalcolarlo produce lo stesso risultato.
	Method CT_UpdateFromCaret()

		Local parserNow:Int = IDE_GetParserCycleId()
		Local symNow:Int = SYM_GetGlobalVersion()

		If ctGuardValid Then
			If ctGuardCaret = idcaret And ctGuardLen = doc.Crs.Length And ctGuardUr = doc.idurstates Then
				If ctGuardLines = doc.numtotallines And ctGuardPath = doc.fullname Then
					If ctGuardParser = parserNow And ctGuardSym = symNow And ctGuardScopeGen = scopeLayoutGen Then
						Return
					EndIf
				EndIf
			EndIf
		EndIf

		ctGuardValid = 1
		ctGuardCaret = idcaret
		ctGuardLen = doc.Crs.Length
		ctGuardUr = doc.idurstates
		ctGuardLines = doc.numtotallines
		ctGuardPath = doc.fullname
		ctGuardParser = parserNow
		ctGuardSym = symNow
		ctGuardScopeGen = scopeLayoutGen

		Local ctt0:Int = Millisecs()
		CT_UpdateFromCaretDo()

	End

	Method CT_UpdateFromCaretDo()
		If focussheet = Null Or focussheet.focusbox <> Self Then
			CT_Close
			Return
		EndIf
		
		If idcaret <= 0 Then
			CT_Close
			Return
		EndIf
		
		GetCursorLine
		Local caretLn:Int = linecaret
		If caretLn < 0 Then caretLn = 0
		
		Local lineStart:Int = 0
		Local lineEnd:Int = doc.Crs.Length - 1
		If caretLn >= 0 And caretLn < doc.idlines Then
			lineStart = doc.idline[caretLn]
			lineEnd = doc.idline[caretLn + 1] - 2
		EndIf
		If lineEnd < lineStart Then lineEnd = lineStart
		
		Local callCtx:= CT_ResolveCallContext(lineStart, lineEnd, caretLn)
		Local openPos:Int = callCtx[0]
		ctParenCall = callCtx[1]
		
		If openPos < 0 Then
			CT_Close
			Return
		EndIf
		
		Local identPos:Int = openPos
		If ctParenCall Then identPos = openPos - 1
		
		Local p:Int = identPos
		While p >= lineStart And (doc.Crs[p] & 255) = 32
			p -= 1
		Wend
		If p < lineStart Then
			CT_Close
			Return
		EndIf
		
		Local ident:String = AC_ReadIdentLeftOfPos(identPos)
		If ident = "" Then
			CT_Close
			Return
		EndIf
		
		EnsureScopeVarCache(0)

		Local identUp:String = ident.ToUpper()

		' Filtro O(1) per le chiamate SENZA parentesi.
		'
		' In quel ramo l'identificatore sotto il caret e' una parola qualsiasi che
		' si sta scrivendo, e cambia a ogni lettera (c -> ca -> can): la firma
		' della cache cambia insieme a lei, quindi CT_CollectDeclsForCall e
		' CT_MergeOverloadLinesFromCurrentDoc riscandivano l'INTERO documento a
		' ogni battuta (misurati 20-29 ms su 28.000 righe).
		' Se la parola non e' nemmeno il nome di una funzione o di un metodo
		' conosciuto, non c'e' nessuna firma da mostrare: si esce subito.
		' Le mappe servono gia' all'highlighting e sono gia' costruite, quindi la
		' verifica e' una lookup invece di una scansione.
		'
		' Il filtro NON tocca il caso "dentro le parentesi" (ctParenCall = 1), dove
		' il comportamento resta identico a prima. E si applica solo a cache
		' costruita: se il parser non ha ancora prodotto simboli si passa oltre,
		' altrimenti il tip non comparirebbe mai al primo avvio.
		If ctParenCall = 0 And hlCallableCacheVersion >= 0 Then
			EnsureHLCallableNameCache()
			If Not hlFunctionNames.Contains(identUp) And Not hlMethodNames.Contains(identUp) Then
				CT_Close
				Return
			EndIf
		EndIf

		Local ownerTypeUp:String = ""
		Local q:Int = p - ident.Length
		While q >= lineStart And (doc.Crs[q] & 255) = 32
			q -= 1
		Wend
		
		If q >= lineStart And (doc.Crs[q] & 255) = 46 Then
			Local owner:String = AC_ReadIdentLeftOfPos(q - 1)
			Local ownerUp:String = owner.ToUpper()
			
			Local clsId:Int = -1
			If caretLn >= 0 And caretLn < scopeClassAtLine.Length Then clsId = scopeClassAtLine[caretLn]
			Local curClassUp:String = ""
			Local curExtUp:String = ""
			If clsId >= 0 And clsId < scopeClassCount Then
				curClassUp = scopeClasses[clsId].nameUp
				curExtUp = scopeClasses[clsId].extendsUp
			EndIf
			
			If ownerUp = "SELF" Then
				ownerTypeUp = curClassUp
			ElseIf ownerUp = "SUPER" Then
				If curExtUp <> "" Then ownerTypeUp = curExtUp Else ownerTypeUp = curClassUp
			Else
				ownerTypeUp = AC_FindTypeOfIdentUp(ownerUp, caretLn)
				If ownerTypeUp = "" And AC_IsKnownTypeUp(ownerUp) Then ownerTypeUp = ownerUp
			EndIf
		EndIf
		
		Local argIdx:Int = CT_ComputeArgIndexEx(openPos, ctParenCall, lineEnd)
		Local argHint:Int = argIdx + 1
		If ctParenCall Then
			If idcaret <= openPos + 1 Then argHint = 0
		Else
			Local argStart:Int = openPos + 1
			While argStart <= lineEnd And (doc.Crs[argStart] & 255) = 32
				argStart += 1
			Wend
			If idcaret <= argStart Then argHint = 0
		EndIf
		
		Local docSig:String = HL_NormalizePath(doc.fullname).ToLower()
		Local symNow:Int = SYM_GetGlobalVersion()
		Local parserNow:Int = IDE_GetParserCycleId()
		Local recollect:Int = 0
		
		' NOTA: si controlla il flag di validita', non la lunghezza. Un risultato
		' legittimamente vuoto (l'identificatore non e' una chiamata) e' comunque
		' un risultato da ricordare: usando .Length = 0 la cache non si armava
		' mai e CT_CollectDeclsForCall riscandiva tutto il documento ogni frame.
		If ctDeclsCachedValid = 0 Then
			recollect = 1
		ElseIf identUp <> ctDeclSigIdent Or ownerTypeUp <> ctDeclSigOwner Or openPos <> ctDeclSigOpenPos Or docSig <> ctDeclSigDoc Or scopeLayoutGen <> ctDeclSigScopeGen Or parserNow <> ctDeclSigParser Then
			recollect = 1
		ElseIf symNow <> ctDeclSigSym Then
			' Il freno vale SEMPRE, non solo quando ci sono piu' overload.
			'
			' Prima con 0 o 1 dichiarazione in cache (il caso normale) qualunque
			' avanzamento della versione dei simboli forzava recollect, e
			' CT_CollectDeclsForCall scandisce TUTTI i simboli di TUTTI i file.
			' Il parser avanza di versione di continuo mentre si scrive, quindi
			' dentro le parentesi si pagava quella scansione a ogni battuta:
			' e' il rallentamento su "mCamera.Scale(".
			' Al massimo un overload appena arrivato dal parser compare con
			' qualche centinaio di millisecondi di ritardo.
			If ctDeclSigSym < 0 Or Millisecs() - ctDeclSymDebounceMs > CT_SYM_DEBOUNCE_MS Then
				recollect = 1
			EndIf
		ElseIf SYM_GetFileVersion(doc.fullname) <> ctDeclSigFileVer Then
			If ctDeclSigSym < 0 Or Millisecs() - ctDeclSymDebounceMs > CT_SYM_DEBOUNCE_MS Then
				recollect = 1
			EndIf
		EndIf
		
		Local decls:String[]
		If recollect Then
			decls = CT_CollectDeclsForCall(ownerTypeUp, identUp, caretLn)
			ctDeclsCached = decls
			ctDeclsCachedValid = 1
			ctDeclSigIdent = identUp
			ctDeclSigOwner = ownerTypeUp
			ctDeclSigDoc = docSig
			ctDeclSigOpenPos = openPos
			ctDeclSigSym = symNow
			ctDeclSigScopeGen = scopeLayoutGen
			ctDeclSigParser = parserNow
			ctDeclSigFileVer = SYM_GetFileVersion(doc.fullname)
			ctDeclSymDebounceMs = Millisecs()
		Else
			decls = ctDeclsCached
		EndIf
		
		Local mergeDl:String = String.FromChar(31)
		Local mergeSig:String = ownerTypeUp + mergeDl + identUp + mergeDl + openPos + mergeDl + scopeLayoutGen
		If recollect = 0 And ctPmValid And mergeSig = ctPmLastSig Then
			decls = ctPmDecls
		Else
			decls = CT_MergeOverloadLinesFromCurrentDoc(ownerTypeUp, identUp, caretLn, decls)
			ctPmLastSig = mergeSig
			ctPmDecls = decls
			ctPmValid = 1
		EndIf
		
		If decls.Length = 0 Then
			CT_Close
			Return
		EndIf
		
		' ctxCh = call target moved. argHint change alone must NOT clear ctOverloadManual or
		' Up/Down overload cycling is overwritten every CT_UpdateFromCaret poll.
		Local ctxCh:Int = 0
		If openPos <> ctCtxOpenPos Or identUp <> ctCtxIdent Or ownerTypeUp <> ctCtxOwner Then ctxCh = 1
		
		Local argCh:Int = 0
		If argHint <> ctCtxArgHint Then argCh = 1
		
		If ctxCh Then
			ctCtxOpenPos = openPos
			ctCtxIdent = identUp
			ctCtxOwner = ownerTypeUp
			ctCtxArgHint = argHint
			ctOverloadManual = 0
			ctOverloadIdx = CT_BestOverloadIdx(decls, argHint)
		ElseIf argCh Then
			ctCtxArgHint = argHint
			If ctOverloadManual = 0 Then
				ctOverloadIdx = CT_BestOverloadIdx(decls, argHint)
			Else
				If ctOverloadIdx >= decls.Length Then ctOverloadIdx = decls.Length - 1
				If ctOverloadIdx < 0 Then ctOverloadIdx = 0
			EndIf
		ElseIf ctOverloadManual = 0 Then
			ctOverloadIdx = CT_BestOverloadIdx(decls, argHint)
		Else
			If ctOverloadIdx >= decls.Length Then ctOverloadIdx = decls.Length - 1
			If ctOverloadIdx < 0 Then ctOverloadIdx = 0
		EndIf
		
		ctOverloads = decls
		ctOn = 1
		ctOpenPos = openPos
		ctName = ident
		ctArgIndex = argIdx
		CT_ApplyOverloadIndex
		
		ctThLastCaret = idcaret
		ctThLastLen = doc.Crs.Length
		ctThLastOpen = openPos
		ctThSymVer = SYM_GetGlobalVersion()
		ctThParser = IDE_GetParserCycleId()
		ctThScopeGen = scopeLayoutGen
	End
	
	Method AC_IsLineInsideClass:Int(filePathNorm:String, line0:Int)
		If filePathNorm = "" Then Return 0
		If line0 < 0 Then Return 0
		
		Local k:= filePathNorm.ToLower()
		Local cd:= acInClassCache.Get(k)
		
		If cd And (cd.inClass.Length = 0 Or line0 >= cd.inClass.Length) Then
			acInClassCache.Set(k, Null)
			cd = Null
		EndIf
		
		If cd = Null Then
			Local curNorm:= HL_NormalizePath(doc.fullname).ToLower()
			If curNorm = k Then
				EnsureScopeVarCache
				
				cd = New ACInClassData
				cd.inClass = cd.inClass.Resize(doc.numtotallines)
				
				For Local ln:Int = 0 To cd.inClass.Length - 1
					If scopeClassAtLine.Length > ln And scopeClassAtLine[ln] >= 0 Then
						cd.inClass[ln] = 1
					Else
						cd.inClass[ln] = 0
					EndIf
				Next
				
				acInClassCache.Set(k, cd)
			Else
				Local txt:String = ""
				Local fp:= filePathNorm.Replace("\", "/")
				If os.FileType(fp) = os.FILETYPE_FILE Then txt = os.LoadString(fp)
				
				txt = txt.Replace(invio, "~n")
				txt = txt.Replace(String.FromChar(13), "~n")
				txt = txt.Replace(String.FromChar(10), "~n")
				Local lines:= txt.Split("~n")
				
				cd = New ACInClassData
				cd.inClass = cd.inClass.Resize(lines.Length)
				
				Local stackKind:String[128]
				Local top:Int = -1
				Local classDepth:Int = 0
				Local externMode:Int = 0
				For Local ln:Int = 0 To lines.Length - 1
					If classDepth > 0 Then cd.inClass[ln] = 1 Else cd.inClass[ln] = 0

					Local lineTxt:String = lines[ln]
					Local toks:= SYM_TokenizeLineSimple(lineTxt)
					Local fi:Int = SYM_FirstCodeTokenIndex(toks)
					externMode = SCAN_TrackExternSection(toks, stackKind, top, externMode)
					If fi < toks.Length Then
						Local t0:= toks[fi].ToUpper()
						Local t1:String = ""
						If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()

						If t0 = "END" Then
							Local want:String = SCAN_EndWantKind(t1)

							If want <> "" Then
								While top >= 0
									Local knd:String = stackKind[top]
									top -= 1
									If SCAN_IsClassKind(knd) Then classDepth -= 1
									If knd = want Or (want = "CLASS" And knd = "CLASSX") Then Exit
								Wend
							Else
								If top >= 0 Then
									Local knd:String = stackKind[top]
									top -= 1
									If SCAN_IsClassKind(knd) Then classDepth -= 1
								ElseIf classDepth > 0 Then
									classDepth -= 1
								EndIf
							EndIf

							If classDepth < 0 Then classDepth = 0
						ElseIf t0 = "ENDIF" Then
							top = AC_ScanPopKind(stackKind, top, "IF")
						ElseIf t0 = "WEND" Or t0 = "NEXT" Then
							top = AC_ScanPopKind(stackKind, top, "LOOP")
						Else
							Local opn:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
							If opn <> "" Then
								top += 1
								If top > 127 Then top = 127
								stackKind[top] = opn
								If SCAN_IsClassKind(opn) Then classDepth += 1
							EndIf
						EndIf
					EndIf
				Next
				
				acInClassCache.Set(k, cd)
			EndIf
		EndIf
		
		If cd = Null Or cd.inClass.Length = 0 Then Return 0
		If line0 < 0 Or line0 >= cd.inClass.Length Then Return 0
		Return cd.inClass[line0]
	End
	
	Method AC_GetClassUpAtLine:String(filePathNorm:String, line0:Int)
		If filePathNorm = "" Then Return ""
		If line0 < 0 Then Return ""
		
		Local k:= filePathNorm.ToLower()
		Local cd:= acClassCtxCache.Get(k)
		
		If cd And (cd.classUpAtLine.Length = 0 Or line0 >= cd.classUpAtLine.Length) Then
			acClassCtxCache.Set(k, Null)
			cd = Null
		EndIf
		
		If cd = Null Then
			Local curNorm:= HL_NormalizePath(doc.fullname).ToLower()
			If curNorm = k Then
				EnsureScopeVarCache
				
				cd = New ACClassContextData
				cd.inClass = cd.inClass.Resize(doc.numtotallines)
				cd.classUpAtLine = cd.classUpAtLine.Resize(doc.numtotallines)
				
				For Local ln:Int = 0 To cd.inClass.Length - 1
					Local clsId:Int = -1
					If scopeClassAtLine.Length > ln Then clsId = scopeClassAtLine[ln]
					If clsId >= 0 And clsId < scopeClassCount Then
						cd.inClass[ln] = 1
						cd.classUpAtLine[ln] = scopeClasses[clsId].nameUp
					Else
						cd.inClass[ln] = 0
						cd.classUpAtLine[ln] = ""
					EndIf
				Next
				
				acClassCtxCache.Set(k, cd)
			Else
				Local txt:String = ""
				Local fp:= filePathNorm.Replace("\", "/")
				If os.FileType(fp) = os.FILETYPE_FILE Then txt = os.LoadString(fp)
				
				txt = txt.Replace(invio, "~n")
				txt = txt.Replace(String.FromChar(13), "~n")
				txt = txt.Replace(String.FromChar(10), "~n")
				Local lines:= txt.Split("~n")
				
				cd = New ACClassContextData
				cd.inClass = cd.inClass.Resize(lines.Length)
				cd.classUpAtLine = cd.classUpAtLine.Resize(lines.Length)
				
				Local stackKind:String[128]
				Local stackName:String[128]
				Local top:Int = -1
				Local curClassUp:String = ""
				Local externMode:Int = 0

				For Local ln:Int = 0 To lines.Length - 1
					If curClassUp <> "" Then
						cd.inClass[ln] = 1
						cd.classUpAtLine[ln] = curClassUp
					Else
						cd.inClass[ln] = 0
						cd.classUpAtLine[ln] = ""
					EndIf

					Local lineTxt:String = lines[ln]
					Local toks:= SYM_TokenizeLineSimple(lineTxt)
					Local fi:Int = SYM_FirstCodeTokenIndex(toks)
					externMode = SCAN_TrackExternSection(toks, stackKind, top, externMode)
					If fi < toks.Length Then
						Local t0:= toks[fi].ToUpper()
						Local t1:String = ""
						If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()

						If t0 = "END" Then
							Local want:String = SCAN_EndWantKind(t1)

							If want <> "" Then
								While top >= 0
									Local knd:String = stackKind[top]
									top -= 1
									If knd = want Or (want = "CLASS" And knd = "CLASSX") Then Exit
								Wend
							Else
								If top >= 0 Then top -= 1
							EndIf

							curClassUp = ""
							For Local i:Int = top To 0 Step -1
								If SCAN_IsClassKind(stackKind[i]) Then
									curClassUp = stackName[i]
									Exit
								EndIf
							Next
						ElseIf t0 = "ENDIF" Then
							top = AC_ScanPopKindNamed(stackKind, stackName, top, "IF")
						ElseIf t0 = "WEND" Or t0 = "NEXT" Then
							top = AC_ScanPopKindNamed(stackKind, stackName, top, "LOOP")
						Else
							Local opn:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
							If opn <> "" Then
								Local nmUp:String = ""
								If SCAN_IsClassKind(opn) Then
									Local nm:String = ""
									If fi + 1 < toks.Length Then nm = toks[fi + 1]
									If HL_IsIdentToken(nm) And Not HL_IsKeywordCXS(nm) Then nmUp = nm.ToUpper()
								EndIf

								top += 1
								If top > 127 Then top = 127
								stackKind[top] = opn
								stackName[top] = nmUp
								If SCAN_IsClassKind(opn) Then curClassUp = nmUp
							EndIf
						EndIf
					EndIf
				Next
				
				acClassCtxCache.Set(k, cd)
			EndIf
		EndIf
		
		If cd = Null Or cd.classUpAtLine.Length = 0 Then Return ""
		If line0 < 0 Or line0 >= cd.classUpAtLine.Length Then Return ""
		Return cd.classUpAtLine[line0]
	End
	
	Method AC_ReadIdentLeftOfPos:String(pos:Int)
		If pos <= 0 Then Return ""
		Local p:Int = pos
		While p >= 0 And (doc.Crs[p] & 255) = 32
			p -= 1
		Wend
		If p < 0 Then Return ""
		
		Local endp:Int = p
		While p >= 0 And AC_IsIdentChar(doc.Crs[p] & 255)
			p -= 1
		Wend
		Local startp:Int = p + 1
		If endp < startp Then Return ""
		
		Local s:String = ""
		For Local i:Int = startp To endp
			s += String.FromChar(doc.Crs[i] & 255)
		Next
		Return s
	End
	
	Method AC_FindMatchingOpenParen:Int(closePos:Int)
		If closePos < 0 Or closePos >= doc.Crs.Length Then Return -1
		If (doc.Crs[closePos] & 255) <> 41 Then Return -1
		
		Local depth:Int = 0
		For Local i:Int = closePos To 0 Step -1
			Local c:Int = doc.Crs[i] & 255
			If c = 41 Then
				depth += 1
			ElseIf c = 40 Then
				depth -= 1
				If depth = 0 Then Return i
			ElseIf c = 34 Then
				Local q:Int = i - 1
				While q >= 0
					If (doc.Crs[q] & 255) = 34 Then
						Local esc:Int = 0
						Local k:Int = q - 1
						While k >= 0 And (doc.Crs[k] & 255) = 92
							esc += 1
							k -= 1
						Wend
						If esc Mod 2 = 0 Then
							i = q
							Exit
						EndIf
					EndIf
					q -= 1
				Wend
			EndIf
		Next
		Return -1
	End
	
	Method AC_CountCallArgsBetween:Int(openPos:Int, closePos:Int)
		If openPos < 0 Or closePos <= openPos Then Return 0
		
		Local hasContent:Int = 0
		Local depth:Int = 0
		Local commas:Int = 0
		
		For Local i:Int = openPos + 1 To closePos - 1
			Local c:Int = doc.Crs[i] & 255
			If c = 40 Then
				depth += 1
			ElseIf c = 41 Then
				If depth > 0 Then depth -= 1
			ElseIf c = 44 And depth = 0 Then
				commas += 1
				hasContent = 1
			ElseIf c <> 32 And c <> 9 And depth = 0 Then
				hasContent = 1
			EndIf
		Next
		
		If hasContent = 0 Then Return 0
		Return commas + 1
	End
	
	Method AC_FindMethodReturnTypeUp:String(ownerTypeUp:String, methodUp:String, argCountHint:Int)
		If methodUp = "" Then Return ""
		Local decl:String = CT_FindDeclForCall(ownerTypeUp, methodUp, argCountHint)
		If decl = "" Then Return ""
		Return AC_TypeIdNormUp(SYM_ParseDeclTypeAfterColonUp(decl))
	End
	
	Method AC_FindMatchingOpenBracket:Int(closePos:Int)
		If closePos < 0 Or closePos >= doc.Crs.Length Then Return -1
		If (doc.Crs[closePos] & 255) <> 93 Then Return -1
		
		Local depth:Int = 0
		For Local i:Int = closePos To 0 Step -1
			Local c:Int = doc.Crs[i] & 255
			If c = 34 Then
				Local q:Int = i - 1
				While q >= 0
					If (doc.Crs[q] & 255) = 34 Then
						Local esc:Int = 0
						Local k:Int = q - 1
						While k >= 0 And (doc.Crs[k] & 255) = 92
							esc += 1
							k -= 1
						Wend
						If esc Mod 2 = 0 Then
							i = q
							Exit
						EndIf
					EndIf
					q -= 1
				Wend
				Continue
			EndIf
			If c = 93 Then
				depth += 1
			ElseIf c = 91 Then
				depth -= 1
				If depth = 0 Then Return i
			EndIf
		Next
		Return -1
	End
	
	Method AC_StripOneArrayBracketSuffixUp:String(tyUp:String)
		If tyUp = "" Then Return ""
		Local u:String = tyUp.Trim.ToUpper()
		Local L:Int = u.Length
		If L >= 2 And u[L - 2] = 91 And u[L - 1] = 93 Then Return LeftString(u, L - 2)
		Return u
	End
	
	Method AC_IsArrayTypeSuffixUp:Int(tyUp:String)
		If tyUp = "" Then Return 0
		Local u:String = tyUp.Trim.ToUpper()
		If u = "ARRAY" Then Return 1
		Local L:Int = u.Length
		If L >= 2 And u[L - 2] = 91 And u[L - 1] = 93 Then Return 1
		Return 0
	End
	
	Method AC_RawLineDeclTypeArrayUp:Int(lineTxt:String, nameUp:String)
		' -1 = nameUp non dichiarato in questa riga; 0 = dichiarato non-array; 1 = dichiarato array
		If lineTxt = "" Or nameUp = "" Then Return -1
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		Local tokIndex:Int = 0
		Local seenName:Int = 0
		Local afterColon:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			If inStr Then
				p += 1
				Continue
			EndIf
			If c = 39 Then Exit
			
			If IsALetter(c) Or c = 95 Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				Local up:String = MidString(lineTxt, s + 1, p - s).ToUpper()
				
				If tokIndex = 0 Then
					If up <> "LOCAL" And up <> "FIELD" And up <> "GLOBAL" And up <> "CONST" Then Return -1
					tokIndex = 1
					Continue
				EndIf
				tokIndex += 1
				
				If seenName = 0 And afterColon = 0 And up = nameUp Then seenName = 1
				Continue
			EndIf
			
			If c = 58 Then
				afterColon = 1
				p += 1
				Continue
			EndIf
			
			If c = 91 Then
				If seenName Then Return 1
				p += 1
				Continue
			EndIf
			
			If c = 44 Then
				If seenName Then Return 0
				afterColon = 0
				p += 1
				Continue
			EndIf
			
			If c = 61 Then
				If seenName Then Return 0
				p += 1
				Continue
			EndIf
			
			p += 1
		Wend
		
		If seenName Then Return 0
		Return -1
	End
	
	' Cached: scans up to 4000 lines backwards from caretLn tokenizing each one,
	' and AC_UpdateFromCaret's after-dot path calls it twice per keystroke for the
	' same (name, caretLn). The cache makes typing after a dot O(1) per call once
	' the first lookup has run. Invalidated on parser/scope rebuild.
	Method AC_IdentDeclaredAsArrayUp:Int(nameUp:String, caretLn:Int)
		If nameUp = "" Then Return 0
		
		' Keyed on scopeLayoutGen only (see AC_FindTypeOfIdentUp): survives parser
		' cycles during typing; the cold path scans up to 4000 lines backward.
		If acIdentArrayCacheGen <> scopeLayoutGen Then
			acIdentArrayCacheGen = scopeLayoutGen
			acIdentArrayCache = New StringMap<Int>
		EndIf
		
		Local key:String = nameUp + "@" + caretLn
		If acIdentArrayCache.Contains(key) Then Return acIdentArrayCache.Get(key)
		
		Local start:Int = caretLn
		If start < 0 Then start = 0
		If start >= doc.numtotallines Then start = doc.numtotallines - 1
		Local lo:Int = start - 4000
		If lo < 0 Then lo = 0
		
		For Local ln:Int = start To lo Step -1
			Local r:Int = AC_RawLineDeclTypeArrayUp(GetLineTextByIndex(ln), nameUp)
			If r >= 0 Then
				acIdentArrayCache.Set(key, r)
				Return r
			EndIf
		Next
		
		acIdentArrayCache.Set(key, 0)
		Return 0
	End
	
	Method AC_ShouldBlockMemberAutocompleteAfterDot:Int(dotPos:Int, ownerUp:String, ownerTypeUp:String, caretLn:Int)
		If dotPos < 0 Then Return 0
		
		Local exprEnd:Int = dotPos - 1
		While exprEnd >= 0
			Local ec:Int = doc.Crs[exprEnd] & 255
			If ec <> 32 And ec <> 9 Then Exit
			exprEnd -= 1
		Wend
		If exprEnd < 0 Then Return 0
		
		Local chLeft:Int = doc.Crs[exprEnd] & 255
		If chLeft = 93 Then Return 0
		
		If AC_IsArrayTypeSuffixUp(ownerTypeUp) Then Return 1
		If ownerUp <> "" And AC_IdentDeclaredAsArrayUp(ownerUp, caretLn) Then Return 1
		If AC_IsScalarPrimitiveUp(ownerTypeUp) Then Return 1
		Return 0
	End
	
	' Tipi scalari di Cerberus X: NON sono oggetti, non hanno membri istanza.
	' "ok." con ok:Bool non deve proporre nulla, e soprattutto non deve finire
	' nel fallback di AC_BuildItems che raccoglie TUTTI i metodi dei moduli.
	' String e' esclusa: ha membri veri (e il caso "String." e' gestito a parte).
	Method AC_IsScalarPrimitiveUp:Int(typeUp:String)
		Local u:String = AC_TypeIdNormUp(typeUp)
		If u = "BOOL" Or u = "INT" Or u = "FLOAT" Or u = "UINT" Or u = "VOID" Or u = "NULL" Then Return 1
		Return 0
	End
	
	Method AC_IsStringKeywordBeforeDot:Int(dotPos:Int)
		Local p:Int = dotPos - 1
		While p >= 0
			Local c:Int = doc.Crs[p] & 255
			If c <> 32 And c <> 9 Then Exit
			p -= 1
		Wend
		If p < 0 Then Return 0
		
		Local endp:Int = p
		While p >= 0 And AC_IsIdentChar(doc.Crs[p] & 255)
			p -= 1
		Wend
		Local startp:Int = p + 1
		If endp < startp Then Return 0
		
		Local before:Int = startp - 1
		While before >= 0
			Local c2:Int = doc.Crs[before] & 255
			If c2 <> 32 And c2 <> 9 Then Return 0
			before -= 1
		Wend
		
		Local ident:String = ""
		For Local i:Int = startp To endp
			ident += String.FromChar(doc.Crs[i] & 255)
		Next
		If ident = "" Then Return 0
		If ident.ToUpper() <> "STRING" Then Return 0
		If HL_IsKeywordCXS(ident) Then Return 1
		Return 0
	End
	
	Method AC_ReadSimpleLiteralLeftOfPos:String(pos:Int)
		If pos < 0 Then Return ""
		Local endp:Int = pos
		Local p:Int = pos
		While p >= 0
			Local c:Int = doc.Crs[p] & 255
			If IsADigitDot(c) Or c = 36 Or c = 45 Then
				p -= 1
			Else
				Exit
			EndIf
		Wend
		Local startp:Int = p + 1
		If endp < startp Then Return ""
		Local s:String = ""
		For Local i:Int = startp To endp
			s += String.FromChar(doc.Crs[i] & 255)
		Next
		Return s
	End
	
	' Tipo dell'espressione immediatamente a sinistra del "." (letterali, identificatori, catene di metodi).
	Method AC_InferExprTypeUpAtPos:String(pos:Int, caretLn:Int)
		If pos < 0 Then Return ""
		
		Local p:Int = pos
		While p >= 0
			Local c:Int = doc.Crs[p] & 255
			If c <> 32 And c <> 9 Then Exit
			p -= 1
		Wend
		If p < 0 Then Return ""
		
		Local c:Int = doc.Crs[p] & 255
		
		If c = 41 Then
			Local openPos:Int = AC_FindMatchingOpenParen(p)
			If openPos < 0 Then Return ""
			
			Local methodIdent:String = AC_ReadIdentLeftOfPos(openPos - 1)
			If methodIdent = "" Then Return ""
			
			Local argCount:Int = AC_CountCallArgsBetween(openPos, p)
			Local beforeMethod:Int = openPos - 1
			While beforeMethod >= 0
				Local bc:Int = doc.Crs[beforeMethod] & 255
				If bc <> 32 And bc <> 9 Then Exit
				beforeMethod -= 1
			Wend
			
			If beforeMethod >= 0 And (doc.Crs[beforeMethod] & 255) = 46 Then
				Local ownerType:String = AC_InferExprTypeUpAtPos(beforeMethod - 1, caretLn)
				Return AC_FindMethodReturnTypeUp(ownerType, methodIdent.ToUpper(), argCount)
			EndIf
			
			Return AC_FindMethodReturnTypeUp("", methodIdent.ToUpper(), argCount)
		EndIf
		
		If c = 93 Then
			Local openB:Int = AC_FindMatchingOpenBracket(p)
			If openB < 0 Then Return ""
			Local beforeBr:Int = openB - 1
			While beforeBr >= 0
				Local bc:Int = doc.Crs[beforeBr] & 255
				If bc <> 32 And bc <> 9 Then Exit
				beforeBr -= 1
			Wend
			If beforeBr < 0 Then Return ""
			Local arrTy:String = AC_InferExprTypeUpAtPos(beforeBr, caretLn)
			If arrTy = "" Then Return ""
			Return AC_StripOneArrayBracketSuffixUp(arrTy)
		EndIf
		
		If c = 34 Then
			Local q:Int = p - 1
			While q >= 0
				If (doc.Crs[q] & 255) = 34 Then
					Local esc:Int = 0
					Local k:Int = q - 1
					While k >= 0 And (doc.Crs[k] & 255) = 92
						esc += 1
						k -= 1
					Wend
					If esc Mod 2 = 0 Then Return "STRING"
				EndIf
				q -= 1
			Wend
			Return ""
		EndIf
		
		If AC_IsIdentChar(c) Then
			Local ident:String = AC_ReadIdentLeftOfPos(p)
			If ident = "" Then Return ""
			
			Local beforeIdent:Int = p - ident.Length
			While beforeIdent >= 0
				Local bc:Int = doc.Crs[beforeIdent] & 255
				If bc <> 32 And bc <> 9 Then Exit
				beforeIdent -= 1
			Wend
			
			If beforeIdent >= 0 And (doc.Crs[beforeIdent] & 255) = 46 Then
				Local ownerType:String = AC_InferExprTypeUpAtPos(beforeIdent - 1, caretLn)
				Return AC_FindMethodReturnTypeUp(ownerType, ident.ToUpper(), -1)
			EndIf
			
			Local iu:String = ident.ToUpper()
			If iu = "TRUE" Or iu = "FALSE" Then Return "BOOL"
			If iu = "NULL" Then Return "NULL"
			Return AC_FindTypeOfIdentUp(iu, caretLn)
		EndIf
		
		Local lit:String = AC_ReadSimpleLiteralLeftOfPos(p)
		If lit <> "" Then Return SYM_InferExprTypeUp(lit, caretLn)
		
		Return ""
	End
	
	' Cached wrapper around AC_FindTypeOfIdentUpRaw.
	' The raw lookup scans up to caretLn lines (tokenizing each) every call, and
	' AC_UpdateFromCaret's after-dot path calls it up to 3 times per keystroke for
	' the same (owner, caretLn). The cache turns those repeated O(N) scans into
	' O(1) map lookups during typing bursts. Invalidated when parser symbols or
	' the scope layout change.
	Method AC_FindTypeOfIdentUp:String(nameUp:String, caretLn:Int)
		If nameUp = "" Then Return ""
		
		' Keyed on scopeLayoutGen only (not parserCycleId): the type is resolved by
		' scanning live doc text within the enclosing routine/class, so it only goes
		' stale on a real structural change, which bumps scopeLayoutGen. This keeps
		' the cache alive even if the parser completes a cycle mid-typing â€” important
		' because the cold path does O(caretLn) backward scans on a cache miss.
		If acFindTypeCacheGen <> scopeLayoutGen Then
			acFindTypeCacheGen = scopeLayoutGen
			acFindTypeCache = New StringMap<String>
		EndIf
		
		Local key:String = nameUp + "@" + caretLn
		If acFindTypeCache.Contains(key) Then Return acFindTypeCache.Get(key)
		
		Local res:String = AC_FindTypeOfIdentUpRaw(nameUp, caretLn)
		acFindTypeCache.Set(key, res)
		Return res
	End
	
	Method AC_FindTypeOfIdentUpRaw:String(nameUp:String, caretLn:Int)
		If nameUp = "" Then Return ""
		
		Local scopeId:Int = -1
		If caretLn >= 0 And caretLn < scopeMethodAtLine.Length Then scopeId = scopeMethodAtLine[caretLn]
		If scopeId < 0 And caretLn >= 0 And caretLn < scopeFuncAtLine.Length Then scopeId = scopeFuncAtLine[caretLn]
		
		Local classId:Int = -1
		If caretLn >= 0 And caretLn < scopeClassAtLine.Length Then classId = scopeClassAtLine[caretLn]
		
		If scopeId >= 0 And scopeId < scopeInfoCount Then
			Local s:Int = scopeInfos[scopeId].startLine
			Local e:Int = scopeInfos[scopeId].endLine
			If s < 0 Then s = 0
			If e < 0 Or e >= doc.numtotallines Then e = doc.numtotallines - 1
			If caretLn >= 0 And caretLn < e Then e = caretLn
			
			For Local ln:Int = e To s Step -1
				Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
				Local fi:Int = FirstCodeTokenIndex(toks)
				If fi >= toks.Length Then Continue
				If toks[fi].ToUpper() <> "LOCAL" Then Continue
				
				Local seenName:Int = 0
				For Local i:Int = fi + 1 To toks.Length - 2
					Local tk:= toks[i]
					Local up:= tk.ToUpper()
					
					If tk = "," Then
						seenName = 0
						Continue
					EndIf
					
					If HL_IsIdentToken(tk) And Not HL_IsKeywordCXS(tk) Then
						If up = nameUp Then
							seenName = 1
						ElseIf seenName Then
							Exit
						EndIf
					EndIf
					
					If seenName And tk = ":" Then
						If i + 1 < toks.Length And toks[i + 1] = "=" Then
							If i + 3 < toks.Length And toks[i + 2].ToUpper() = "NEW" And HL_IsIdentToken(toks[i + 3]) Then Return toks[i + 3].ToUpper()
							Exit
						EndIf
						Local tyUp:String = AC_TypeNameFromToksAt(toks, i + 1)
						If tyUp <> "" Then Return tyUp
						Exit
					EndIf
					
					If seenName And tk = "=" Then
						If i + 2 < toks.Length And toks[i + 1].ToUpper() = "NEW" And HL_IsIdentToken(toks[i + 2]) Then Return toks[i + 2].ToUpper()
						Exit
					EndIf
				Next
			Next
		EndIf
		
		If classId >= 0 And classId < scopeClassCount Then
			Local s:Int = scopeClasses[classId].startLine
			Local e:Int = scopeClasses[classId].endLine
			If s < 0 Then s = 0
			If e < 0 Or e >= doc.numtotallines Then e = doc.numtotallines - 1
			
			For Local ln:Int = e To s Step -1
				Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
				Local fi:Int = FirstCodeTokenIndex(toks)
				If fi >= toks.Length Then Continue
				If toks[fi].ToUpper() <> "FIELD" Then Continue
				
				Local seenName:Int = 0
				For Local i:Int = fi + 1 To toks.Length - 2
					Local tk:= toks[i]
					Local up:= tk.ToUpper()
					
					If tk = "," Then
						seenName = 0
						Continue
					EndIf
					
					If HL_IsIdentToken(tk) And Not HL_IsKeywordCXS(tk) Then
						If up = nameUp Then
							seenName = 1
						ElseIf seenName Then
							Exit
						EndIf
					EndIf
					
					If seenName And tk = ":" Then
						If i + 1 < toks.Length And toks[i + 1] = "=" Then
							If i + 3 < toks.Length And toks[i + 2].ToUpper() = "NEW" And HL_IsIdentToken(toks[i + 3]) Then Return toks[i + 3].ToUpper()
							Exit
						EndIf
						Local tyUp:String = AC_TypeNameFromToksAt(toks, i + 1)
						If tyUp <> "" Then Return tyUp
						Exit
					EndIf
					
					If seenName And tk = "=" Then
						If i + 2 < toks.Length And toks[i + 1].ToUpper() = "NEW" And HL_IsIdentToken(toks[i + 2]) Then Return toks[i + 2].ToUpper()
						Exit
					EndIf
				Next
			Next
		EndIf
		
		For Local ln:Int = caretLn To 0 Step -1
			If scopeClassAtLine.Length > ln And scopeClassAtLine[ln] >= 0 Then Continue
			
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			Local k0:= toks[fi].ToUpper()
			If k0 <> "GLOBAL" And k0 <> "FIELD" Then Continue
			
			Local seenName:Int = 0
			For Local i:Int = fi + 1 To toks.Length - 2
				Local tk:= toks[i]
				Local up:= tk.ToUpper()
				
				If tk = "," Then
					seenName = 0
					Continue
				EndIf
				
				If HL_IsIdentToken(tk) And Not HL_IsKeywordCXS(tk) Then
					If up = nameUp Then
						seenName = 1
					ElseIf seenName Then
						Exit
					EndIf
				EndIf
				
				If seenName And tk = ":" Then
					If i + 1 < toks.Length And toks[i + 1] = "=" Then
						If i + 3 < toks.Length And toks[i + 2].ToUpper() = "NEW" And HL_IsIdentToken(toks[i + 3]) Then Return toks[i + 3].ToUpper()
						Exit
					EndIf
					Local tyUp:String = AC_TypeNameFromToksAt(toks, i + 1)
					If tyUp <> "" Then Return tyUp
					Exit
				EndIf
				
				If seenName And tk = "=" Then
					If i + 2 < toks.Length And toks[i + 1].ToUpper() = "NEW" And HL_IsIdentToken(toks[i + 2]) Then Return toks[i + 2].ToUpper()
					Exit
				EndIf
			Next
		Next
		
		For Local ln:Int = caretLn To 0 Step -1
			Local tyFb:= SYM_FindVarTypeInLine(SYM_TokenizeLineSimple(GetLineTextByIndex(ln)), nameUp)
			If tyFb <> "" Then Return tyFb.ToUpper()
		Next
		
		Return ""
	End
	
	Method AC_IsKnownTypeUp:Int(nameUp:String)
		If nameUp = "" Then Return 0
		
		Local nmUp2:String = nameUp
		Local d2:Int = nmUp2.FindLast(".")
		If d2 >= 0 Then nmUp2 = nmUp2[d2 + 1 ..]
		
		For Local it:=Eachin symFiles
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			If fd = Null Then Continue
			
			For Local i:Int = 0 To fd.count - 1
				If fd.names[i] = "" Then Continue
				Local nmu:String = fd.names[i].ToUpper()
				Local d:Int = nmu.FindLast(".")
				If d >= 0 Then nmu = nmu[d + 1 ..]
				If nmu <> nmUp2 Then Continue
				
				Local decl:= fd.decls[i]
				Local bits:= decl.Trim.Split(" ")
				If bits.Length = 0 Then Continue
				Local knd:= SYM_DeclKindUp(decl)
				If knd = "CLASS" Or knd = "INTERFACE" Then Return 1
			Next
		Next
		
		For Local it:=Eachin symFilesFixed
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			If fd = Null Then Continue
			
			For Local i:Int = 0 To fd.count - 1
				If fd.names[i] = "" Then Continue
				Local nmu:String = fd.names[i].ToUpper()
				Local d:Int = nmu.FindLast(".")
				If d >= 0 Then nmu = nmu[d + 1 ..]
				If nmu <> nmUp2 Then Continue
				
				Local decl:= fd.decls[i]
				Local bits:= decl.Trim.Split(" ")
				If bits.Length = 0 Then Continue
				Local knd:= SYM_DeclKindUp(decl)
				If knd = "CLASS" Or knd = "INTERFACE" Then Return 1
			Next
		Next
		
		Return 0
	End
	
	Method AC_RebuildTypeBaseCacheIfNeeded()
		Local v:Int = IDE_GetParserCycleId()
		If acTypeExtCacheVersion = v Then Return
		acTypeExtCacheVersion = v
		
		acTypeBaseUp = New StringMap<String>
		
		For Local it:=Eachin symFiles
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			If fd = Null Then Continue
			
			For Local i:Int = 0 To fd.count - 1
				Local decl:= fd.decls[i]
				If decl = "" Then Continue
				Local bits:= decl.Trim.Split(" ")
				If bits.Length < 2 Then Continue
				Local knd:= SYM_DeclKindUp(decl)
				If knd <> "CLASS" And knd <> "INTERFACE" Then Continue
				
				Local nmUp:String = fd.names[i].ToUpper()
				Local d:Int = nmUp.FindLast(".")
				If d >= 0 Then nmUp = nmUp[d + 1 ..]
				If nmUp = "" Then Continue
				
				Local baseUp:String = ""
				For Local j:Int = 0 To bits.Length - 2
					If bits[j].ToUpper() = "EXTENDS" Then
						baseUp = SYM_NormalizeTypeUp(bits[j + 1])
						Exit
					EndIf
				Next
				
				If baseUp <> "" Then
					Local d2:Int = baseUp.FindLast(".")
					If d2 >= 0 Then baseUp = baseUp[d2 + 1 ..]
					If baseUp <> "" Then
						Local k:String = AC_TypeIdNormUp(nmUp)
						Local v:String = AC_TypeIdNormUp(baseUp)
						If k <> "" And v <> "" Then acTypeBaseUp.Set(k, v)
					EndIf
				EndIf
			Next
		Next
		
		For Local it:=Eachin symFilesFixed
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			If fd = Null Then Continue
			
			For Local i:Int = 0 To fd.count - 1
				Local decl:= fd.decls[i]
				If decl = "" Then Continue
				Local bits:= decl.Trim.Split(" ")
				If bits.Length < 2 Then Continue
				Local knd:= SYM_DeclKindUp(decl)
				If knd <> "CLASS" And knd <> "INTERFACE" Then Continue
				
				Local nmUp:String = fd.names[i].ToUpper()
				Local d:Int = nmUp.FindLast(".")
				If d >= 0 Then nmUp = nmUp[d + 1 ..]
				If nmUp = "" Then Continue
				
				Local baseUp:String = ""
				For Local j:Int = 0 To bits.Length - 2
					If bits[j].ToUpper() = "EXTENDS" Then
						baseUp = SYM_NormalizeTypeUp(bits[j + 1])
						Exit
					EndIf
				Next
				
				If baseUp <> "" Then
					Local d2:Int = baseUp.FindLast(".")
					If d2 >= 0 Then baseUp = baseUp[d2 + 1 ..]
					If baseUp <> "" Then
						Local k:String = AC_TypeIdNormUp(nmUp)
						Local v:String = AC_TypeIdNormUp(baseUp)
						If k <> "" And v <> "" Then acTypeBaseUp.Set(k, v)
					EndIf
				EndIf
			Next
		Next
	End
	
	Method AC_ShortTypeUp:String(typeUp:String)
		If typeUp = "" Then Return ""
		Local t:String = typeUp.Trim.ToUpper()

		' Il parser marca i tipi-oggetto con "$" davanti: "$DrawList", "$Image".
		' Nessuno lo toglieva, quindi cercare la classe base "$DRAWLIST" non
		' trovava niente e la ricorsione sui membri EREDITATI non partiva mai.
		' Verificato col dump di CTRL+F10 su "myCanvas.DrawImage(":
		'   extends dal decl = |$DRAWLIST|
		'   AC_CollectMemberDeclLinesInTypeSource = 0
		' cosi' il tip ripiegava sulla prima DrawImage trovata - quella GLOBALE
		' di mojo1 - invece delle quattro dichiarate in DrawList.
		While t.Length > 0 And t[0] = 36
			t = t[1 ..]
		Wend

		Local d:Int = t.FindLast(".")
		If d >= 0 Then t = t[d + 1 ..]
		Return t
	End
	
	' Nome tipo per confronti (es. @String in lang.cxs â†’ STRING come il tipo String del codice).
	Method AC_TypeIdNormUp:String(raw:String)
		Local t:String = AC_ShortTypeUp(raw)
		If t = "" Then Return ""
		If t.Length > 0 And t[0] = 64 Then Return t[1 ..]
		Return t
	End
	
	Method AC_IsBaseOfUp:Int(typeUp:String, baseUp:String)
		Local tUp:String = AC_TypeIdNormUp(typeUp)
		Local bUp:String = AC_TypeIdNormUp(baseUp)
		If tUp = "" Or bUp = "" Then Return 0
		If tUp = bUp Then Return 0
		
		Local curUp:String = tUp
		For Local i:Int = 0 To 63
			curUp = acTypeBaseUp.Get(curUp)
			If curUp = "" Then Exit
			If curUp = bUp Then Return 1
		Next
		
		Return 0
	End
	
	Method AC_RebuildTypeDeclInfoCacheIfNeeded()
		Local v:Int = IDE_GetParserCycleId()
		Local cx:String = CXpath
		If acTypeDeclInfoCacheVersion = v And acTypeDeclInfoCacheCX = cx Then Return
		acTypeDeclInfoCacheVersion = v
		acTypeDeclInfoCacheCX = cx
		acTypeDeclInfoCache = New StringMap<String>
	End
	
	Method AC_RebuildCXDocTypeCacheIfNeeded()
		Local cx:String = CXpath
		If acCxTypesCacheLoaded And acCxTypesCacheCX = cx Then Return
		acCxTypesCacheLoaded = 1
		acCxTypesCacheCX = cx
		acCxTypesByFirst = New StringMap<StringList>
		acCxFunctionsByFirst = New StringMap<StringList>
		acCxCallableNames = New StringMap<Int>
		acCxMethodNames = New StringMap<Int>
		
		If cx = "" Then Return
		Local base:String = cx.Replace("\", "/")
		If base.EndsWith("/") Then base = LeftString(base, base.Length - 1)
		Local fp:String = base + "/docs/html/decls.txt"
		If os.FileType(fp) <> os.FILETYPE_FILE Then Return
		
		Local txt:String = os.LoadString(fp)
		If txt = "" Then Return
		
		txt = txt.Replace(invio, "~n")
		txt = txt.Replace(String.FromChar(13), "~n")
		txt = txt.Replace(String.FromChar(10), "~n")
		Local lines:= txt.Split("~n")
		
		Local seenTypes:= New StringMap<Int>
		Local seenFunctions:= New StringMap<Int>
		
		For Local lineTxt:String = Eachin lines
			Local s:String = lineTxt.Trim
			If s = "" Then Continue
			
			Local parts:= s.Split(";")
			If parts.Length < 2 Then Continue
			
			Local kindUp:String = parts[0].Trim.ToUpper()
			
			Local nm:String = parts[1].Trim
			If nm = "" Then Continue
			
			Local up:String = nm.ToUpper()
			' Function e Method vanno tenuti SEPARATI: finivano tutti in
			' acCxCallableNames e da li' in hlFunctionNames, cosi' ogni Method
			' del documento veniva colorato 10 (Function) invece di 8 (Method).
			If kindUp = "FUNCTION" Then
				acCxCallableNames.Set(up, 1)
			ElseIf kindUp = "METHOD" Or kindUp = "PROPERTY" Then
				acCxMethodNames.Set(up, 1)
			EndIf
			
			If kindUp = "CLASS" Or kindUp = "INTERFACE" Or kindUp = "ENUMERATE" Then
				If seenTypes.Contains(up) Then Continue
				seenTypes.Set(up, 1)
				
				Local key:String = String.FromChar(up[0])
				Local lst:StringList = acCxTypesByFirst.Get(key)
				If lst = Null Then
					lst = New StringList
					acCxTypesByFirst.Set(key, lst)
				EndIf
				lst.AddLast nm
			ElseIf kindUp = "FUNCTION" Then
				If seenFunctions.Contains(up) Then Continue
				seenFunctions.Set(up, 1)
				
				Local key2:String = String.FromChar(up[0])
				Local lst2:StringList = acCxFunctionsByFirst.Get(key2)
				If lst2 = Null Then
					lst2 = New StringList
					acCxFunctionsByFirst.Set(key2, lst2)
				EndIf
				lst2.AddLast nm
			EndIf
		Next
	End
	
	Method AC_FindTypeDeclLine0InText:Int(lines:String[], typeUpShort:String)
		If typeUpShort = "" Then Return - 1
		If lines.Length = 0 Then Return -1
		Local want:String = AC_TypeIdNormUp(typeUpShort)
		If want = "" Then Return -1
		For Local ln:Int = 0 To lines.Length - 1
			Local toks:= SYM_TokenizeLineSimple(lines[ln])
			Local fi:Int = SYM_FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			Local t0:String = toks[fi].ToUpper()
			If t0 <> "CLASS" And t0 <> "INTERFACE" Then Continue
			If fi + 1 >= toks.Length Then Continue
			If AC_TypeIdNormUp(toks[fi + 1]) = want Then Return ln
		Next
		Return -1
	End
	
	Method AC_ReadExtendsUpFromClassLine:String(lines:String[], line0:Int)
		If lines.Length = 0 Then Return ""
		If line0 < 0 Or line0 >= lines.Length Then Return ""
		Local toks:= SYM_TokenizeLineSimple(lines[line0])
		Local fi:Int = SYM_FirstCodeTokenIndex(toks)
		If fi >= toks.Length Then Return ""
		For Local j:Int = fi To toks.Length - 2
			If toks[j].ToUpper() = "EXTENDS" Then
				Return AC_ShortTypeUp(SYM_NormalizeTypeUp(toks[j + 1]))
			EndIf
		Next
		Return ""
	End
	
	Method AC_SearchTypeDeclInfoInDir:String(dirPath:String, typeUpShort:String)
		If dirPath = "" Or typeUpShort = "" Then Return ""
		Local dirSys:String = dirPath.Replace("\", "/")
		If os.FileType(dirSys) <> os.FILETYPE_DIR Then Return ""
		
		Local stack:StringList = New StringList
		stack.AddLast dirSys
		
		Local scanned:Int = 0
		While Not stack.IsEmpty()
			Local cur:String = stack.RemoveLast()
			If cur = "" Then Continue
			
			Local entries:String[] = os.LoadDir(cur)
			For Local nm:String = Eachin entries
				If nm = "" Then Continue
				If nm = "." Or nm = ".." Then Continue
				
				Local fullSys:String = cur + "\" + nm
				Local ft:Int = os.FileType(fullSys)
				If ft = os.FILETYPE_DIR Then
					stack.AddLast fullSys
					Continue
				EndIf
				
				If ft <> os.FILETYPE_FILE Then Continue
				
				Local low:String = nm.ToLower()
				If Not low.EndsWith(".cxs") Then Continue
				
				scanned += 1
				If scanned > 3000 Then Return ""
				
				Local txt:String = os.LoadString(fullSys)
				If txt = "" Then Continue
				
				Local upTxt:String = txt.ToUpper()
				Local tWant:String = typeUpShort.ToUpper()
				If Not upTxt.Contains("CLASS " + tWant) And Not upTxt.Contains("CLASS @" + tWant) And Not upTxt.Contains("INTERFACE " + tWant) And Not upTxt.Contains("INTERFACE @" + tWant) Then Continue
				
				txt = txt.Replace(invio, "~n")
				txt = txt.Replace(String.FromChar(13), "~n")
				txt = txt.Replace(String.FromChar(10), "~n")
				Local lines:= txt.Split("~n")
				
				Local ln0:Int = AC_FindTypeDeclLine0InText(lines, typeUpShort)
				If ln0 < 0 Then Continue
				
				Local extUp:String = AC_ReadExtendsUpFromClassLine(lines, ln0)
				Return HL_NormalizePath(fullSys) + "|" + ln0 + "|" + extUp
			Next
		Wend
		
		Return ""
	End
	
	Method AC_SearchTypeDeclInfoInCX:String(typeUpShort:String)
		If typeUpShort = "" Then Return ""
		Local cx:String = CXpath
		If cx = "" Then Return ""
		Local base:String = cx.Replace("\", "/")
		If base.EndsWith("/") Then base = LeftString(base, base.Length - 1)
		
		Local info:String = ""
		info = AC_SearchTypeDeclInfoInDir(base + "/modules", typeUpShort)
		If info <> "" Then Return info
		
		info = AC_SearchTypeDeclInfoInDir(base + "/cerberus/modules", typeUpShort)
		If info <> "" Then Return info
		
		info = AC_SearchTypeDeclInfoInDir(base + "/module", typeUpShort)
		If info <> "" Then Return info
		
		info = AC_SearchTypeDeclInfoInDir(base + "/cerberus/module", typeUpShort)
		If info <> "" Then Return info
		
		Return ""
	End
	
	Method AC_SearchTypeDeclInfoInImportedModules:String(typeUpShort:String)
		If typeUpShort = "" Then Return ""
		AC_RebuildImportModulePathsCacheIfNeeded
		
		For Local it:=Eachin acImportCachePaths
			Local fpKey:String = String(it.Key)
			If fpKey = "" Then Continue
			
			Local txt:String = SRC_TextForFile(fpKey)
			If txt = "" Then Continue
			
			Local upTxt:String = txt.ToUpper()
			Local tWant:String = typeUpShort.ToUpper()
			If Not upTxt.Contains("CLASS " + tWant) And Not upTxt.Contains("CLASS @" + tWant) And Not upTxt.Contains("INTERFACE " + tWant) And Not upTxt.Contains("INTERFACE @" + tWant) Then Continue
			
			txt = txt.Replace(invio, "~n")
			txt = txt.Replace(String.FromChar(13), "~n")
			txt = txt.Replace(String.FromChar(10), "~n")
			Local lines:= txt.Split("~n")
			
			Local ln0:Int = AC_FindTypeDeclLine0InText(lines, typeUpShort)
			If ln0 < 0 Then Continue
			
			Local extUp:String = AC_ReadExtendsUpFromClassLine(lines, ln0)
			Return HL_NormalizePath(fpKey) + "|" + ln0 + "|" + extUp
		Next
		
		Return ""
	End
	
	Method AC_SearchDeclInfoInDir:String(dirPath:String, kindHint:String, identUp:String, allowInClass:Int)
		If dirPath = "" Or identUp = "" Then Return ""
		Local dirSys:String = dirPath.Replace("\", "/")
		If os.FileType(dirSys) <> os.FILETYPE_DIR Then Return ""
		
		Local stack:StringList = New StringList
		stack.AddLast dirSys
		
		Local scanned:Int = 0
		While Not stack.IsEmpty()
			Local cur:String = stack.RemoveLast()
			If cur = "" Then Continue
			
			Local entries:String[] = os.LoadDir(cur)
			For Local nm:String = Eachin entries
				If nm = "" Then Continue
				If nm = "." Or nm = ".." Then Continue
				
				Local fullSys:String = cur + "\" + nm
				Local ft:Int = os.FileType(fullSys)
				If ft = os.FILETYPE_DIR Then
					stack.AddLast fullSys
					Continue
				EndIf
				If ft <> os.FILETYPE_FILE Then Continue
				
				Local low:String = nm.ToLower()
				If Not low.EndsWith(".cxs") Then Continue
				
				scanned += 1
				If scanned > 3000 Then Return ""
				
				Local fpNorm:String = HL_NormalizePath(fullSys)
				Local ln:Int = SYM_FindDeclLineInFile(fpNorm, kindHint, identUp, allowInClass)
				If ln >= 0 Then Return fpNorm + "|" + ln + "|" + kindHint
			Next
		Wend
		
		Return ""
	End
	
	Method AC_SearchDeclInfoInCX:String(kindHint:String, identUp:String, allowInClass:Int)
		If identUp = "" Then Return ""
		Local cx:String = CXpath
		If cx = "" Then Return ""
		Local base:String = cx.Replace("\", "/")
		If base.EndsWith("/") Then base = LeftString(base, base.Length - 1)
		
		Local info:String = ""
		info = AC_SearchDeclInfoInDir(base + "/modules", kindHint, identUp, allowInClass)
		If info <> "" Then Return info
		
		info = AC_SearchDeclInfoInDir(base + "/cerberus/modules", kindHint, identUp, allowInClass)
		If info <> "" Then Return info
		
		info = AC_SearchDeclInfoInDir(base + "/module", kindHint, identUp, allowInClass)
		If info <> "" Then Return info
		
		info = AC_SearchDeclInfoInDir(base + "/cerberus/module", kindHint, identUp, allowInClass)
		If info <> "" Then Return info
		
		Return ""
	End
	
	Method AC_FindTypeDeclInfo:String(typeUp:String)
		Local wantUp:String = AC_ShortTypeUp(typeUp)
		If wantUp = "" Then Return ""
		
		AC_RebuildTypeDeclInfoCacheIfNeeded
		Local cached:String = acTypeDeclInfoCache.Get(wantUp)
		If cached = "-" Then Return ""
		If cached <> "" Then Return cached
		
		For Local pass:Int = 0 To 1
			Local m:StringMap<SymbolFileData>
			If pass = 0 Then m = symFiles Else m = symFilesFixed
			
			For Local it:=Eachin m
				Local fpNorm:String = HL_NormalizePath(String(it.Key))
				Local fd:SymbolFileData = SymbolFileData(it.Value)
				If fd = Null Then Continue
				
				For Local i:Int = 0 To fd.count - 1
					Local decl:= fd.decls[i]
					If decl = "" Then Continue
					Local bits:= decl.Trim.Split(" ")
					If bits.Length < 2 Then Continue
					Local knd:= bits[0].ToUpper()
					If knd <> "CLASS" And knd <> "INTERFACE" Then Continue
					
					Local nmUp:String = fd.names[i].ToUpper()
					Local shortUp:String = AC_TypeIdNormUp(nmUp)
					If shortUp <> wantUp Then Continue
					
					Local extUp:String = ""
					For Local j:Int = 0 To bits.Length - 2
						If bits[j].ToUpper() = "EXTENDS" Then
							extUp = SYM_NormalizeTypeUp(bits[j + 1])
							extUp = AC_ShortTypeUp(extUp)
							Exit
						EndIf
					Next
					
					Local ln0:Int = fd.lines[i]
					If ln0 >= 0 Then
						Local info:String = fpNorm + "|" + ln0 + "|" + extUp
						acTypeDeclInfoCache.Set(wantUp, info)
						Return info
					EndIf
				Next
			Next
		Next
		
		Local info2:String = AC_SearchTypeDeclInfoInImportedModules(wantUp)
		If info2 <> "" Then
			acTypeDeclInfoCache.Set(wantUp, info2)
			Return info2
		EndIf
		
		Local info3:String = AC_SearchTypeDeclInfoInCX(wantUp)
		If info3 <> "" Then
			acTypeDeclInfoCache.Set(wantUp, info3)
			Return info3
		EndIf
		
		acTypeDeclInfoCache.Set(wantUp, "-")
		Return ""
	End
	
	Method AC_AddMemberNamesFromToksToList:Void(lst:StringList, toks:String[], kwIdx:Int)
		If lst = Null Then Return
		Local expectName:Int = 1
		For Local j:Int = kwIdx + 1 To toks.Length - 1
			Local tk:String = toks[j]
			If tk = "," Then
				expectName = 1
				Continue
			EndIf
			If tk = ":" Or tk = "=" Then Exit
			If expectName And HL_IsIdentToken(tk) And Not HL_IsKeywordCXS(tk) Then
				lst.AddLast tk
				expectName = 0
			EndIf
		Next
	End
	
	' --- TESTO SORGENTE DI UN FILE, CON CACHE --------------------------------
	'
	' Le AC_* devono leggere il sorgente che dichiara un tipo. Finora ogni
	' chiamata rifaceva il lavoro da capo, e sono due lavori pesanti:
	'
	'  - file APERTO: doc.Text ricostruisce l'INTERA stringa del documento da
	'    Crs, allocando un Int[] e una String di centinaia di KB (250 KB su
	'    3dplayers.cxs). Non e' una lettura, e' una copia completa.
	'  - altro file: lettura da disco PIU' ri-tokenizzazione.
	'
	' Scrivendo "mCamera." si incatenano AC_ParseMembersFromSource,
	' AC_FindMemberDeclInSource e AC_CollectMemberDeclLinesInTypeSource, che
	' rifacevano tutte e tre lo stesso lavoro sullo stesso file: da qui i picchi
	' da 77-150 ms sull'accesso ai membri.
	'
	' Il documento aperto si invalida a ogni modifica (NotifyDocEdited azzera
	' srcCurVer); i file su disco con la stessa impronta "mtime|size" usata dal
	' sorvegliante dei file esterni, quindi un file modificato fuori dall'IDE
	' viene comunque riletto.
	Method SRC_TextForFile:String(fileNorm:String)
		If fileNorm = "" Then Return ""

		Local key:String = fileNorm.ToLower()
		Local curNorm:String = HL_NormalizePath(doc.fullname).ToLower()

		If curNorm = key Then
			If srcCurVer = "" Then
				srcCurTxt = doc.Text
				srcCurVer = "1"
			EndIf
			Return srcCurTxt
		EndIf

		' I chiamanti passano il percorso in entrambe le forme: si prova prima con
		' le barre rovesce, poi quello grezzo.
		Local fp:String = fileNorm.Replace("\", "/")
		If os.FileType(fp) <> os.FILETYPE_FILE Then
			fp = fileNorm
			If os.FileType(fp) <> os.FILETYPE_FILE Then Return ""
		EndIf

		Local stamp:String = String(os.FileTime(fp)) + "|" + String(os.FileSize(fp))

		If srcFileStamps.Contains(key) Then
			If srcFileStamps.Get(key) = stamp Then Return srcFileTexts.Get(key)
		EndIf

		Local txt:String = os.LoadString(fp)

		' Tetto grossolano: senza, aprendo molti moduli la cache crescerebbe
		' senza limite. Si svuota tutta invece di sfrattare il meno usato: e'
		' raro, e il costo e' una rilettura.
		If srcFileCount >= SRC_TXT_MAX Then
			srcFileTexts = New StringMap<String>
			srcFileStamps = New StringMap<String>
			srcFileCount = 0
		EndIf

		srcFileTexts.Set(key, txt)
		srcFileStamps.Set(key, stamp)
		srcFileCount += 1

		Return txt
	End

	' --- CHIUSURA DEI BLOCCHI NEGLI SCANNER DI SORGENTE ----------------------
	'
	' I tre scanner che seguono (membri di un tipo, riga di dichiarazione di un
	' membro, firme di un membro) devono sapere DOVE finisce una classe.
	' Contavano solo Class/Interface/Method/Function/Property/Select, ma in
	' Cerberus "End" nudo chiude anche If, Try, While e For: Wend e Next sono
	' alternative, non obblighi (parser.cxs: "Expecting 'while' block to
	' terminate with 'End' or 'End While'"). Ogni End di quei blocchi consumava
	' quindi un livello che non gli apparteneva e la classe finiva troppo presto.
	'
	' Caso reale: mojo2/graphics.cxs. Dentro Class Canvas il Method
	' SetViewMatrix chiude un If con "End" nudo, e quell'End faceva uscire lo
	' scanner dalla classe a riga 2827 invece che a 3323; identico in DrawList,
	' che finiva a 2480 invece che a 2686. Scrivendo "myCanvas." sparivano
	' tutti i membri dichiarati sotto quel punto, Clear e DrawImage compresi.
	'
	' Repeat NON entra nel conteggio: si chiude solo con Until/Forever.
	Method SCAN_RoutineHasExternOrAbstract:Int(toks:String[], fi:Int)
		For Local i:Int = 0 To toks.Length - 1
			If i = fi Then Continue
			Local u:String = toks[i].ToUpper()
			If u = "EXTERN" Or u = "ABSTRACT" Then Return 1
		Next
		Return 0
	End

	Method AC_ScanIsBodylessRoutine:Int(toks:String[], fi:Int, stackKind:String[], top:Int, externMode:Int)
		' L'attributo si eredita dalla classe che contiene la routine, e i
		' metodi di una Interface sono abstract d'ufficio.
		If SCAN_RoutineHasExternOrAbstract(toks, fi) Then Return 1

		For Local i:Int = top To 0 Step -1
			Local k:String = stackKind[i]
			If k = "INTERFACE" Or k = "CLASSX" Then Return 1
			If k = "CLASS" Then Return 0
		Next

		Return externMode
	End

	' Toglie dalla pila il blocco piu' interno di un certo tipo. Serve per
	' Endif/Wend/Next, che chiudono il loro blocco anche se sopra di esso ne
	' sono rimasti aperti altri. Ritorna il nuovo indice di cima.

	Method SCAN_OpenKind:String(lineTxt:String, toks:String[], fi:Int, stackKind:String[], top:Int, externMode:Int)
		If fi >= toks.Length Then Return ""
		Local t0:String = toks[fi].ToUpper()

		If t0 = "CLASS" Then
			If IFI_ClassIsExtern(toks, fi, externMode) Then Return "CLASSX"
			Return "CLASS"
		EndIf
		If t0 = "INTERFACE" Then Return "INTERFACE"

		If t0 = "METHOD" Or t0 = "FUNCTION" Or t0 = "PROPERTY" Then
			If IFI_HasKeywordOnSameLine(toks, fi, "END") Then Return ""
			If AC_ScanIsBodylessRoutine(toks, fi, stackKind, top, externMode) Then Return ""
			Return t0
		EndIf

		If t0 = "SELECT" Or t0 = "TRY" Then Return "SELECT"

		If t0 = "IF" Then
			If IFI_IfNeedsBlockIndent(lineTxt, toks, fi) Then Return "IF"
			Return ""
		EndIf

		' Wend/Next sulla stessa riga: il ciclo non lascia nulla aperto.
		If t0 = "WHILE" Then
			If IFI_HasKeywordOnSameLine(toks, fi, "WEND") Then Return ""
			Return "LOOP"
		EndIf
		If t0 = "FOR" Then
			If IFI_HasKeywordOnSameLine(toks, fi, "NEXT") Then Return ""
			Return "LOOP"
		EndIf

		Return ""
	End

	Method SCAN_EndWantKind:String(t1Up:String)
		If t1Up = "CLASS" Or t1Up = "INTERFACE" Or t1Up = "METHOD" Or t1Up = "FUNCTION" Or t1Up = "PROPERTY" Or t1Up = "SELECT" Then Return t1Up
		If t1Up = "TRY" Then Return "SELECT"
		If t1Up = "IF" Then Return "IF"
		If t1Up = "WHILE" Or t1Up = "FOR" Then Return "LOOP"
		Return ""
	End

	Method SCAN_IsClassKind:Int(k:String)
		If k = "CLASS" Or k = "CLASSX" Or k = "INTERFACE" Then Return 1
		Return 0
	End

	Method SCAN_TrackExternSection:Int(toks:String[], stackKind:String[], top:Int, externMode:Int)
		If toks.Length = 0 Then Return externMode
		Local u:String = toks[0].ToUpper()
		If u = "EXTERN" Then Return 1
		If u = "PUBLIC" Or u = "PRIVATE" Then
			For Local i:Int = 0 To top
				If SCAN_IsClassKind(stackKind[i]) Then Return externMode
			Next
			Return 0
		EndIf
		Return externMode
	End

	Method AC_ScanPopKind:Int(stackKind:String[], top:Int, kindUp:String)
		For Local i:Int = top To 0 Step -1
			If stackKind[i] = kindUp Then
				For Local j:Int = i To top - 1
					stackKind[j] = stackKind[j + 1]
				Next
				Return top - 1
			EndIf
		Next
		Return top
	End

	Method AC_ScanPopKindNamed:Int(stackKind:String[], stackName:String[], top:Int, kindUp:String)
		For Local i:Int = top To 0 Step -1
			If stackKind[i] = kindUp Then
				For Local j:Int = i To top - 1
					stackKind[j] = stackKind[j + 1]
					stackName[j] = stackName[j + 1]
				Next
				Return top - 1
			EndIf
		Next
		Return top
	End

	' L'Extends di un tipo puo' mancare in AC_FindTypeDeclInfo: quello riempie la
	' base solo quando trova la dichiarazione fra i simboli del parser. Se ci
	' arriva da un ripiego (moduli importati, docs/html/decls.txt) la base non
	' c'e' — decls.txt non la contiene proprio: "Class;Canvas;mojo2.graphics;Canvas;".
	' Senza base questi scanner non ricorrono sulla classe padre e i membri
	' EREDITATI spariscono. E' il motivo per cui il tip di "myCanvas.DrawImage("
	' mostrava una firma sola invece delle quattro dichiarate in DrawList:
	' AC_CollectMemberDeclLinesInTypeSource non scendeva mai in DrawList.
	' acTypeBaseUp invece e' costruita scorrendo TUTTI i file di simboli e la
	' base ce l'ha (e' con quella che l'autocomplete arriva ai membri ereditati).
	Method AC_TypeBaseFallbackUp:String(tUp:String, extUp:String)
		If extUp <> "" Then Return extUp
		If tUp = "" Then Return ""
		AC_RebuildTypeBaseCacheIfNeeded
		Return acTypeBaseUp.Get(tUp)
	End

	' Gli scanner dei membri partono dalla RIGA DELLA CLASSE, non dall'inizio del
	' file: la direttiva "Extern" che apre la sezione sta piu' in alto e non la
	' vedono mai. Per questo le classi Extern dei moduli brl/ (BBDataBuffer,
	' BBProcess, BBFileStream, BBHttpRequest, ...) risultavano lunghe il doppio:
	' i loro Method sono SOLE DICHIARAZIONI, ma senza sapere di stare in una
	' sezione Extern lo scanner li contava come blocchi da chiudere e la classe
	' inglobava quelle successive.
	' Si risale all'indietro fino al primo marcatore di sezione. Qui siamo fuori
	' da qualsiasi classe (si parte dalla dichiarazione di una classe di primo
	' livello), quindi Public/Private chiudono davvero la sezione.
	Method AC_ScanExternModeAt:Int(lines:String[], ln0:Int)
		For Local ln:Int = ln0 - 1 To 0 Step -1
			Local toks:= SYM_TokenizeLineSimple(lines[ln])
			If toks.Length = 0 Then Continue
			Local u:String = toks[0].ToUpper()
			If u = "EXTERN" Then Return 1
			If u = "PUBLIC" Or u = "PRIVATE" Or u = "PROTECTED" Then Return 0

			' Confine di ramo del preprocessore: un "Extern" scritto sopra
			' appartiene all'ALTRO ramo, non a questo. In mojo/asyncimageloader.cxs
			' ci sono due classi con lo stesso nome, una in "Extern Private" e
			' l'altra nel "#Else": scavalcare il #Else le confondeva.
			If u = "#" And toks.Length >= 2 Then
				Local d:String = toks[1].ToUpper()
				If d = "ELSE" Or d = "ELSEIF" Then Return 0
			EndIf
		Next
		Return 0
	End

	Method AC_ParseMembersFromSource:StringList(typeUp:String, visited:StringMap<Int>, staticOnly:Int = 0)
		Local out:= New StringList
		
		Local tUp:String = AC_TypeIdNormUp(typeUp)
		If tUp = "" Then Return out
		If visited And visited.Contains(tUp) Then Return out
		If visited Then visited.Set(tUp, 1)
		
		Local info:String = AC_FindTypeDeclInfo(tUp)
		Local extUp:String = ""
		Local fileNorm:String = ""
		Local ln0:Int = -1
		
		If info <> "" Then
			Local parts:= info.Split("|")
			If parts.Length >= 2 Then
				fileNorm = parts[0]
				ln0 = Int(parts[1])
			EndIf
			If parts.Length >= 3 Then extUp = parts[2]
		EndIf

		extUp = AC_TypeBaseFallbackUp(tUp, extUp)
		
		If fileNorm <> "" And ln0 >= 0 Then
			Local txt:String = SRC_TextForFile(fileNorm)
			
			txt = txt.Replace(invio, "~n")
			txt = txt.Replace(String.FromChar(13), "~n")
			txt = txt.Replace(String.FromChar(10), "~n")
			Local lines:= txt.Split("~n")
			
			If ln0 < 0 Then ln0 = 0
			If ln0 >= lines.Length Then ln0 = lines.Length - 1
			
			Local stackKind:String[256]
			Local top:Int = -1
			Local inTarget:Int = 0
			Local externMode:Int = AC_ScanExternModeAt(lines, ln0)
			
			For Local ln:Int = ln0 To lines.Length - 1
				Local lineTxt:String = lines[ln]
				Local toks:= SYM_TokenizeLineSimple(lineTxt)
				Local fi:Int = SYM_FirstCodeTokenIndex(toks)

				' Sezione Extern di modulo: la apre "Extern", la chiudono
				' "Public"/"Private" fuori da una classe (dentro cambiano solo la
				' visibilita', l'attributo Extern resta). Va letta prima del filtro
				' su fi: una riga con il solo "Public" non ha token di codice.
				If toks.Length > 0 Then
					Local tSec:String = toks[0].ToUpper()
					If tSec = "EXTERN" Then
						externMode = 1
					ElseIf tSec = "PUBLIC" Or tSec = "PRIVATE" Then
						Local inCls:Int = 0
						For Local i:Int = 0 To top
							Local kc:String = stackKind[i]
							If kc = "CLASS" Or kc = "CLASSX" Or kc = "INTERFACE" Then inCls = 1
						Next
						If inCls = 0 Then externMode = 0
					EndIf
				EndIf
				If fi < toks.Length Then
					Local t0:String = toks[fi].ToUpper()
					Local t1:String = ""
					If fi + 1 < toks.Length Then t1 = toks[fi + 1]
					
					If t0 = "CLASS" Or t0 = "INTERFACE" Then
						Local clsKey:String = AC_TypeIdNormUp(t1)
						top += 1
						If top > 255 Then top = 255
						stackKind[top] = t0
						If t0 = "CLASS" And IFI_ClassIsExtern(toks, fi, externMode) Then stackKind[top] = "CLASSX"
						If inTarget = 0 And clsKey = tUp Then inTarget = 1
					ElseIf t0 = "METHOD" Or t0 = "FUNCTION" Or t0 = "PROPERTY" Then
						' Una routine che si apre e si chiude sulla stessa riga, o che
						' e' una sola dichiarazione (Extern/Abstract), non lascia
						' nessun End da aspettarsi: non va messa sulla pila.
						If IFI_HasKeywordOnSameLine(toks, fi, "END") = 0 And AC_ScanIsBodylessRoutine(toks, fi, stackKind, top, externMode) = 0 Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = t0
						EndIf
						
						If inTarget Then
							If staticOnly Then
								If t0 = "FUNCTION" Then AC_AddMemberNamesFromToksToList(out, toks, fi)
							ElseIf t0 = "METHOD" Or t0 = "PROPERTY" Then
								AC_AddMemberNamesFromToksToList(out, toks, fi)
							EndIf
						EndIf
					ElseIf t0 = "FIELD" Then
						If inTarget And staticOnly = 0 Then
							AC_AddMemberNamesFromToksToList(out, toks, fi)
						EndIf
					ElseIf t0 = "SELECT" Or t0 = "TRY" Then
						top += 1
						If top > 255 Then top = 255
						stackKind[top] = "SELECT"
					ElseIf t0 = "IF" Then
						If IFI_IfNeedsBlockIndent(lineTxt, toks, fi) Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = "IF"
						EndIf
					ElseIf t0 = "WHILE" Or t0 = "FOR" Then
						' Wend/Next sulla stessa riga: il ciclo non lascia nulla aperto.
						Local closerUp:String = "WEND"
						If t0 = "FOR" Then closerUp = "NEXT"
						If IFI_HasKeywordOnSameLine(toks, fi, closerUp) = 0 Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = "LOOP"
						EndIf
					ElseIf t0 = "WEND" Or t0 = "NEXT" Then
						top = AC_ScanPopKind(stackKind, top, "LOOP")
					ElseIf t0 = "ENDIF" Then
						top = AC_ScanPopKind(stackKind, top, "IF")
					ElseIf t0 = "END" Then
						Local want:String = ""
						Local t1u:String = t1.ToUpper()
						If t1u = "CLASS" Or t1u = "INTERFACE" Or t1u = "METHOD" Or t1u = "FUNCTION" Or t1u = "PROPERTY" Or t1u = "SELECT" Then want = t1u
						If t1u = "TRY" Then want = "SELECT"
						If t1u = "IF" Then want = "IF"
						If t1u = "WHILE" Or t1u = "FOR" Then want = "LOOP"
						
						Local poppedClass:Int = 0
						If want <> "" Then
							While top >= 0
								Local knd:String = stackKind[top]
								top -= 1
								If knd = "CLASS" Or knd = "CLASSX" Or knd = "INTERFACE" Then poppedClass = 1
								If knd = want Or (want = "CLASS" And knd = "CLASSX") Then Exit
							Wend
						ElseIf top >= 0 Then
							Local knd:String = stackKind[top]
							top -= 1
							If knd = "CLASS" Or knd = "CLASSX" Or knd = "INTERFACE" Then poppedClass = 1
							If knd = "SELECT" Or knd = "IF" Or knd = "LOOP" Then poppedClass = 0
						EndIf
						
						If inTarget And poppedClass Then Exit
					EndIf
				EndIf
			Next
		EndIf
		
		If extUp <> "" Then
			Local baseList:= AC_ParseMembersFromSource(extUp, visited, staticOnly)
			For Local nm:String = Eachin baseList
				out.AddLast nm
			Next
		EndIf
		
		Return out
	End
	
	Method AC_FindMemberDeclInSource:String(typeUp:String, memberUp:String, argCountHint:Int, visited:StringMap<Int>, preferStaticMember:Int = 0)
		Local tUp:String = AC_TypeIdNormUp(typeUp)
		If tUp = "" Or memberUp = "" Then Return ""
		If visited And visited.Contains(tUp) Then Return ""
		If visited Then visited.Set(tUp, 1)
		
		Local info:String = AC_FindTypeDeclInfo(tUp)
		Local extUp:String = ""
		Local fileNorm:String = ""
		Local ln0:Int = -1
		
		If info <> "" Then
			Local parts:= info.Split("|")
			If parts.Length >= 2 Then
				fileNorm = parts[0]
				ln0 = Int(parts[1])
			EndIf
			If parts.Length >= 3 Then extUp = parts[2]
		EndIf

		extUp = AC_TypeBaseFallbackUp(tUp, extUp)
		
		If fileNorm <> "" And ln0 >= 0 Then
			Local txt:String = SRC_TextForFile(fileNorm)
			
			txt = txt.Replace(invio, "~n")
			txt = txt.Replace(String.FromChar(13), "~n")
			txt = txt.Replace(String.FromChar(10), "~n")
			Local lines:= txt.Split("~n")
			
			If ln0 < 0 Then ln0 = 0
			If ln0 >= lines.Length Then ln0 = lines.Length - 1
			
			Local stackKind:String[256]
			Local top:Int = -1
			Local inTarget:Int = 0
			Local externMode:Int = AC_ScanExternModeAt(lines, ln0)
			
			Local bestLn:Int = -1
			Local bestScore:Int = -1000000
			
			For Local ln:Int = ln0 To lines.Length - 1
				Local lineTxt:String = lines[ln]
				Local toks:= SYM_TokenizeLineSimple(lineTxt)
				Local fi:Int = SYM_FirstCodeTokenIndex(toks)

				' Sezione Extern di modulo: la apre "Extern", la chiudono
				' "Public"/"Private" fuori da una classe (dentro cambiano solo la
				' visibilita', l'attributo Extern resta). Va letta prima del filtro
				' su fi: una riga con il solo "Public" non ha token di codice.
				If toks.Length > 0 Then
					Local tSec:String = toks[0].ToUpper()
					If tSec = "EXTERN" Then
						externMode = 1
					ElseIf tSec = "PUBLIC" Or tSec = "PRIVATE" Then
						Local inCls:Int = 0
						For Local i:Int = 0 To top
							Local kc:String = stackKind[i]
							If kc = "CLASS" Or kc = "CLASSX" Or kc = "INTERFACE" Then inCls = 1
						Next
						If inCls = 0 Then externMode = 0
					EndIf
				EndIf
				If fi < toks.Length Then
					Local t0:String = toks[fi].ToUpper()
					Local t1:String = ""
					If fi + 1 < toks.Length Then t1 = toks[fi + 1]
					
					If t0 = "CLASS" Or t0 = "INTERFACE" Then
						Local clsKey:String = AC_TypeIdNormUp(t1)
						top += 1
						If top > 255 Then top = 255
						stackKind[top] = t0
						If t0 = "CLASS" And IFI_ClassIsExtern(toks, fi, externMode) Then stackKind[top] = "CLASSX"
						If inTarget = 0 And clsKey = tUp Then inTarget = 1
					ElseIf t0 = "METHOD" Or t0 = "FUNCTION" Or t0 = "PROPERTY" Then
						' Una routine che si apre e si chiude sulla stessa riga, o che
						' e' una sola dichiarazione (Extern/Abstract), non lascia
						' nessun End da aspettarsi: non va messa sulla pila.
						If IFI_HasKeywordOnSameLine(toks, fi, "END") = 0 And AC_ScanIsBodylessRoutine(toks, fi, stackKind, top, externMode) = 0 Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = t0
						EndIf
						
						If inTarget Then
							Local nm:String = ""
							If fi + 1 < toks.Length Then nm = toks[fi + 1]
							Local nmU:String = nm.ToUpper()
							If nmU = memberUp Then
								Local score:Int = 0
								If argCountHint >= 0 Then
									Local ac:Int = SYM_ParseArgCount(lineTxt)
									If ac >= 0 Then
										If ac = argCountHint Then score += 100 Else score -= 20
									EndIf
								EndIf
								
								Local kBonus:Int = 0
								If preferStaticMember Then
									If t0 = "FUNCTION" Then kBonus = 200
								EndIf
								If preferStaticMember = 0 Then
									If t0 = "METHOD" Then kBonus = 200
									If t0 = "PROPERTY" Then kBonus = 190
								EndIf
								score += kBonus
								
								If score > bestScore Then
									bestScore = score
									bestLn = ln
								EndIf
							EndIf
						EndIf
					ElseIf t0 = "FIELD" Then
						If inTarget Then
							For Local ii:Int = fi + 1 To toks.Length - 1
								Local tk:String = toks[ii]
								Local tkUp:String = tk.ToUpper()
								
								If tk = "," Then Continue
								If tk = ":" Or tk = "=" Then Exit
								If tkUp = "LOCAL" Or tkUp = "GLOBAL" Or tkUp = "FIELD" Or tkUp = "METHOD" Or tkUp = "FUNCTION" Or tkUp = "PROPERTY" Or tkUp = "CLASS" Or tkUp = "END" Then Exit
								
								If HL_IsIdentToken(tk) And Not HL_IsKeywordCXS(tk) Then
									If tkUp = memberUp Then
										Local scoreF:Int = 120
										If preferStaticMember Then
											scoreF -= 80
										Else
											scoreF += 80
										EndIf
										If scoreF > bestScore Then
											bestScore = scoreF
											bestLn = ln
										EndIf
										Exit
									EndIf
								EndIf
							Next
						EndIf
					ElseIf t0 = "SELECT" Or t0 = "TRY" Then
						top += 1
						If top > 255 Then top = 255
						stackKind[top] = "SELECT"
					ElseIf t0 = "IF" Then
						If IFI_IfNeedsBlockIndent(lineTxt, toks, fi) Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = "IF"
						EndIf
					ElseIf t0 = "WHILE" Or t0 = "FOR" Then
						' Wend/Next sulla stessa riga: il ciclo non lascia nulla aperto.
						Local closerUp:String = "WEND"
						If t0 = "FOR" Then closerUp = "NEXT"
						If IFI_HasKeywordOnSameLine(toks, fi, closerUp) = 0 Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = "LOOP"
						EndIf
					ElseIf t0 = "WEND" Or t0 = "NEXT" Then
						top = AC_ScanPopKind(stackKind, top, "LOOP")
					ElseIf t0 = "ENDIF" Then
						top = AC_ScanPopKind(stackKind, top, "IF")
					ElseIf t0 = "END" Then
						Local want:String = ""
						Local t1u:String = t1.ToUpper()
						If t1u = "CLASS" Or t1u = "INTERFACE" Or t1u = "METHOD" Or t1u = "FUNCTION" Or t1u = "PROPERTY" Or t1u = "SELECT" Then want = t1u
						If t1u = "TRY" Then want = "SELECT"
						If t1u = "IF" Then want = "IF"
						If t1u = "WHILE" Or t1u = "FOR" Then want = "LOOP"
						
						Local poppedClass:Int = 0
						If want <> "" Then
							While top >= 0
								Local knd:String = stackKind[top]
								top -= 1
								If knd = "CLASS" Or knd = "CLASSX" Or knd = "INTERFACE" Then poppedClass = 1
								If knd = want Or (want = "CLASS" And knd = "CLASSX") Then Exit
							Wend
						ElseIf top >= 0 Then
							Local knd:String = stackKind[top]
							top -= 1
							If knd = "CLASS" Or knd = "CLASSX" Or knd = "INTERFACE" Then poppedClass = 1
							If knd = "SELECT" Or knd = "IF" Or knd = "LOOP" Then poppedClass = 0
						EndIf
						
						If inTarget And poppedClass Then Exit
					EndIf
				EndIf
			Next
			
			If bestLn >= 0 Then
				Return fileNorm + "|" + bestLn
			EndIf
		EndIf
		
		If extUp <> "" Then
			Return AC_FindMemberDeclInSource(extUp, memberUp, argCountHint, visited, preferStaticMember)
		EndIf
		
		Return ""
	End
	
	' Tutte le righe METHOD/FUNCTION del membro nella classe (e, se vuoto, nella base),
	' stesso file/stack di AC_FindMemberDeclInSource â€” per parameter info overload vs F12.
	Method AC_CollectMemberDeclLinesInTypeSource:String[](typeUp:String, memberUp:String, visited:StringMap<Int>)
		Local tUp:String = AC_TypeIdNormUp(typeUp)
		If tUp = "" Or memberUp = "" Then Return New String[0]
		If visited And visited.Contains(tUp) Then Return New String[0]
		If visited Then visited.Set(tUp, 1)
		
		Local acc:String[] = New String[0]
		
		Local info:String = AC_FindTypeDeclInfo(tUp)
		Local extUp:String = ""
		Local fileNorm:String = ""
		Local ln0:Int = -1
		
		If info <> "" Then
			Local parts:= info.Split("|")
			If parts.Length >= 2 Then
				fileNorm = parts[0]
				ln0 = Int(parts[1])
			EndIf
			If parts.Length >= 3 Then extUp = parts[2]
		EndIf

		extUp = AC_TypeBaseFallbackUp(tUp, extUp)
		
		If fileNorm <> "" And ln0 >= 0 Then
			Local txt:String = SRC_TextForFile(fileNorm)
			
			txt = txt.Replace(invio, "~n")
			txt = txt.Replace(String.FromChar(13), "~n")
			txt = txt.Replace(String.FromChar(10), "~n")
			Local lines:= txt.Split("~n")
			
			If ln0 < 0 Then ln0 = 0
			If ln0 >= lines.Length Then ln0 = lines.Length - 1
			
			Local stackKind:String[256]
			Local top:Int = -1
			Local inTarget:Int = 0
			Local externMode:Int = AC_ScanExternModeAt(lines, ln0)
			
			For Local ln:Int = ln0 To lines.Length - 1
				Local lineTxt:String = lines[ln]
				Local toks:= SYM_TokenizeLineSimple(lineTxt)
				Local fi:Int = SYM_FirstCodeTokenIndex(toks)

				' Sezione Extern di modulo: la apre "Extern", la chiudono
				' "Public"/"Private" fuori da una classe (dentro cambiano solo la
				' visibilita', l'attributo Extern resta). Va letta prima del filtro
				' su fi: una riga con il solo "Public" non ha token di codice.
				If toks.Length > 0 Then
					Local tSec:String = toks[0].ToUpper()
					If tSec = "EXTERN" Then
						externMode = 1
					ElseIf tSec = "PUBLIC" Or tSec = "PRIVATE" Then
						Local inCls:Int = 0
						For Local i:Int = 0 To top
							Local kc:String = stackKind[i]
							If kc = "CLASS" Or kc = "CLASSX" Or kc = "INTERFACE" Then inCls = 1
						Next
						If inCls = 0 Then externMode = 0
					EndIf
				EndIf
				If fi < toks.Length Then
					Local t0:String = toks[fi].ToUpper()
					Local t1:String = ""
					If fi + 1 < toks.Length Then t1 = toks[fi + 1]
					
					If t0 = "CLASS" Or t0 = "INTERFACE" Then
						Local clsKey:String = AC_TypeIdNormUp(t1)
						top += 1
						If top > 255 Then top = 255
						stackKind[top] = t0
						If t0 = "CLASS" And IFI_ClassIsExtern(toks, fi, externMode) Then stackKind[top] = "CLASSX"
						If inTarget = 0 And clsKey = tUp Then inTarget = 1
					ElseIf t0 = "METHOD" Or t0 = "FUNCTION" Or t0 = "PROPERTY" Then
						' Una routine che si apre e si chiude sulla stessa riga, o che
						' e' una sola dichiarazione (Extern/Abstract), non lascia
						' nessun End da aspettarsi: non va messa sulla pila.
						If IFI_HasKeywordOnSameLine(toks, fi, "END") = 0 And AC_ScanIsBodylessRoutine(toks, fi, stackKind, top, externMode) = 0 Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = t0
						EndIf
						
						If inTarget And (t0 = "METHOD" Or t0 = "FUNCTION") Then
							Local nm:String = ""
							If fi + 1 < toks.Length Then nm = toks[fi + 1]
							Local nmU:String = nm.ToUpper()
							If nmU = memberUp Then
								Local lt:String = lineTxt.Trim
								Local pOpen:Int = lt.Find("(")
								Local pClose:Int = -1
								If pOpen >= 0 Then pClose = lt.Find(")", pOpen + 1)
								If pOpen >= 0 And pClose > pOpen Then
									Local dup:Int = 0
									For Local k:Int = 0 To acc.Length - 1
										If acc[k] = lt Then dup = 1; Exit
									Next
									If dup = 0 Then
										acc = acc.Resize(acc.Length + 1)
										acc[acc.Length - 1] = lt
									EndIf
								EndIf
							EndIf
						EndIf
					ElseIf t0 = "SELECT" Or t0 = "TRY" Then
						top += 1
						If top > 255 Then top = 255
						stackKind[top] = "SELECT"
					ElseIf t0 = "IF" Then
						If IFI_IfNeedsBlockIndent(lineTxt, toks, fi) Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = "IF"
						EndIf
					ElseIf t0 = "WHILE" Or t0 = "FOR" Then
						' Wend/Next sulla stessa riga: il ciclo non lascia nulla aperto.
						Local closerUp:String = "WEND"
						If t0 = "FOR" Then closerUp = "NEXT"
						If IFI_HasKeywordOnSameLine(toks, fi, closerUp) = 0 Then
							top += 1
							If top > 255 Then top = 255
							stackKind[top] = "LOOP"
						EndIf
					ElseIf t0 = "WEND" Or t0 = "NEXT" Then
						top = AC_ScanPopKind(stackKind, top, "LOOP")
					ElseIf t0 = "ENDIF" Then
						top = AC_ScanPopKind(stackKind, top, "IF")
					ElseIf t0 = "END" Then
						Local want:String = ""
						Local t1u:String = t1.ToUpper()
						If t1u = "CLASS" Or t1u = "INTERFACE" Or t1u = "METHOD" Or t1u = "FUNCTION" Or t1u = "PROPERTY" Or t1u = "SELECT" Then want = t1u
						If t1u = "TRY" Then want = "SELECT"
						If t1u = "IF" Then want = "IF"
						If t1u = "WHILE" Or t1u = "FOR" Then want = "LOOP"
						
						Local poppedClass:Int = 0
						If want <> "" Then
							While top >= 0
								Local knd:String = stackKind[top]
								top -= 1
								If knd = "CLASS" Or knd = "CLASSX" Or knd = "INTERFACE" Then poppedClass = 1
								If knd = want Or (want = "CLASS" And knd = "CLASSX") Then Exit
							Wend
						ElseIf top >= 0 Then
							Local knd:String = stackKind[top]
							top -= 1
							If knd = "CLASS" Or knd = "CLASSX" Or knd = "INTERFACE" Then poppedClass = 1
							If knd = "SELECT" Or knd = "IF" Or knd = "LOOP" Then poppedClass = 0
						EndIf
						
						If inTarget And poppedClass Then Exit
					EndIf
				EndIf
			Next
		EndIf
		
		If acc.Length = 0 And extUp <> "" Then Return AC_CollectMemberDeclLinesInTypeSource(extUp, memberUp, visited)
		
		Return acc
	End
	
	Method AC_GetMembersForType:StringList(typeUp:String, staticOnly:Int = 0)
		' Due cache, ENTRAMBE azzerate al cambio di parserCycleId: quella
		' "modulo" per i tipi di cerberus/modules/ (Canvas, Image, ecc.) e
		' quella "user" per i tipi del progetto. Dentro lo stesso ciclo la prima
		' "." paga il parse del sorgente, tutte le successive tornano subito.
		' Vedi sotto perche' la "modulo" NON puo' durare tutta la sessione.
		Local tUp:String = AC_TypeIdNormUp(typeUp)
		If tUp = "" Then Return New StringList
		
		Local cached:StringList = Null

		Local v:Int = IDE_GetParserCycleId()
		If acTypeMembersCacheVersion <> v Then
			acTypeMembersCacheVersion = v
			acTypeMembersCache = New StringMap<StringList>
			acTypeStaticMembersCache = New StringMap<StringList>

			' ANCHE la cache "modulo" va buttata a ogni ciclo del parser.
			' Il SORGENTE di Canvas & C. non cambia in sessione, ed e' su questo
			' che si basava la scelta di tenerla per sempre. Ma la lista dei
			' membri non dipende solo dal sorgente: dipende dalla catena
			' Extends, che arriva dal PARSER e a inizio sessione puo' non essere
			' ancora nota. Se "myCanvas." veniva premuto prima che il parser
			' avesse riportato "Canvas Extends DrawList", i membri ereditati non
			' entravano e quella lista MONCA restava per TUTTA la sessione:
			' DrawImage spariva e non tornava piu'. Ora si rigenera al ciclo
			' dopo. Costa poco: il testo del file lo tiene gia' SRC_TextForFile,
			' quindi non si torna sul disco, e dentro lo stesso ciclo la cache
			' continua a servire tutti i "." digitati.
			acTypeMembersCacheMod = New StringMap<StringList>
			acTypeStaticMembersCacheMod = New StringMap<StringList>
		EndIf

		If staticOnly Then
			cached = acTypeStaticMembersCacheMod.Get(tUp)
		Else
			cached = acTypeMembersCacheMod.Get(tUp)
		EndIf
		If cached Then Return cached
		
		If staticOnly Then
			cached = acTypeStaticMembersCache.Get(tUp)
		Else
			cached = acTypeMembersCache.Get(tUp)
		EndIf
		If cached Then Return cached
		
		Local visited:= New StringMap<Int>
		Local lst:= AC_ParseMembersFromSource(tUp, visited, staticOnly)
		
		' Decide in quale cache memorizzare in base al file sorgente del tipo:
		' file dei moduli Cerberus -> cache persistente; tutto il resto ->
		' cache invalidata al successivo ciclo del parser.
		Local info:String = AC_FindTypeDeclInfo(tUp)
		Local fileNorm:String = ""
		If info <> "" Then
			Local parts:= info.Split("|")
			If parts.Length >= 1 Then fileNorm = parts[0]
		EndIf
		
		If fileNorm <> "" And IDE_IsFixedModulePath(fileNorm) Then
			If staticOnly Then
				acTypeStaticMembersCacheMod.Set(tUp, lst)
			Else
				acTypeMembersCacheMod.Set(tUp, lst)
			EndIf
		Else
			If staticOnly Then
				acTypeStaticMembersCache.Set(tUp, lst)
			Else
				acTypeMembersCache.Set(tUp, lst)
			EndIf
		EndIf
		Return lst
	End
	
	Method AC_SortItems(items:String[])
		Local n:Int = items.Length
		If n <= 1 Then Return
		
		' Precompute uppercase keys once to avoid O(N^2) ToUpper() allocations inside the sort.
		Local ups:String[n]
		For Local i:Int = 0 To n - 1
			ups[i] = items[i].ToUpper()
		Next
		
		' Insertion sort keeps comparisons cheap (no ToUpper inside the inner loop)
		' and is well suited to the small/partially ordered N we typically get from AC.
		For Local i:Int = 1 To n - 1
			Local k:String = items[i]
			Local kUp:String = ups[i]
			Local j:Int = i - 1
			While j >= 0 And ups[j] > kUp
				items[j + 1] = items[j]
				ups[j + 1] = ups[j]
				j -= 1
			Wend
			items[j + 1] = k
			ups[j + 1] = kUp
		Next
	End
	
	Method AC_AddDeclNamesFromTokensCase(seen:StringMap<String>, toks:String[], startIdx:Int, prefixUp:String)
		If seen = Null Then Return
		Local expectName:Int = 1
		
		For Local i:Int = startIdx + 1 To toks.Length - 1
			Local t:= toks[i]
			Local up:= t.ToUpper()
			
			If t = "," Then
				expectName = 1
				Continue
			EndIf
			
			If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "END" Then Exit
			
			If expectName And HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
				Local nameUp:String = up
				If nameUp.StartsWith(prefixUp) Then
					If Not seen.Contains(nameUp) Then seen.Set(nameUp, t)
				EndIf
				expectName = 0
				Continue
			EndIf
		Next
	End
	
	Method AC_RebuildDocDeclCacheIfNeeded()
		Local p:String = HL_NormalizePath(doc.fullname)
		' Non usare doc.Crs.Length/idurstates qui: cambiano a ogni tasto e su file enormi
		' costringevano a riscansionare tutto il documento per ogni autocomplete.
		If acDocDeclCachePath = p And acDocDeclCacheLen = doc.numtotallines And acDocDeclRebuildOn = 0 Then Return
		
		Local n:Int = doc.numtotallines
		Local chunk:Int = 800
		If n > 12000 Then chunk = 1200
		
		If acDocDeclCachePath <> p Or acDocDeclCacheLen <> n Then
			acDocDeclCachePath = p
			acDocDeclCacheLen = n
			acDocDeclCacheUr = doc.idurstates
			acDocDeclCache = New StringMap<String>
			acDocDeclNextLn = 0
			acDocDeclRebuildOn = 0
		EndIf
		
		If n <= 4000 Then
			For Local ln:Int = 0 To n - 1
				Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
				Local fi:Int = FirstCodeTokenIndex(toks)
				If fi >= toks.Length Then Continue
				Local k0:String = toks[fi].ToUpper()
				If k0 = "GLOBAL" Or k0 = "CONST" Or k0 = "FUNCTION" Or k0 = "CLASS" Or k0 = "INTERFACE" Or k0 = "ENUMERATE" Then
					AC_AddDeclNamesFromTokensCase(acDocDeclCache, toks, fi, "")
				EndIf
			Next
			acDocDeclRebuildOn = 0
			Return
		EndIf
		
		acDocDeclRebuildOn = 1
		Local lim:Int = acDocDeclNextLn + chunk - 1
		If lim >= n - 1 Then lim = n - 1
		
		For Local ln:Int = acDocDeclNextLn To lim
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			Local k0:String = toks[fi].ToUpper()
			If k0 = "GLOBAL" Or k0 = "CONST" Or k0 = "FUNCTION" Or k0 = "CLASS" Or k0 = "INTERFACE" Or k0 = "ENUMERATE" Then
				AC_AddDeclNamesFromTokensCase(acDocDeclCache, toks, fi, "")
			EndIf
		Next
		
		acDocDeclNextLn = lim + 1
		If acDocDeclNextLn >= n Then acDocDeclRebuildOn = 0
	End
	
	Method AC_RebuildLocalDeclCacheIfNeeded(caretLn:Int)
		Local p:String = HL_NormalizePath(doc.fullname)
		If acLocalDeclCachePath = p And acLocalDeclCacheLine = caretLn And acLocalDeclCacheLines = doc.numtotallines Then Return
		
		acLocalDeclCachePath = p
		acLocalDeclCacheLine = caretLn
		acLocalDeclCacheLines = doc.numtotallines
		acLocalDeclCache = New StringMap<String>
		
		Local enc:= FindNearestRoutineStart(caretLn)
		Local routineStart:Int = enc[0]
		If routineStart < 0 Then Return
		
		Local cached:StringMap<Int> = GetCachedLocalsForRoutine(routineStart, caretLn, enc[1])
		If cached <> Null Then
			For Local it:= Eachin cached
				Local disp:String = String(it.Key)
				Local up:String = disp.ToUpper()
				acLocalDeclCache.Set(up, disp)
			Next
			Return
		EndIf
		
		Local hlLocals:StringMap<Int> = HL_EnsureLocalsForHighlight(routineStart, caretLn, enc[1])
		If hlLocals <> Null Then
			For Local it2:= Eachin hlLocals
				Local disp2:String = String(it2.Key)
				Local up2:String = disp2.ToUpper()
				acLocalDeclCache.Set(up2, disp2)
			Next
			Return
		EndIf
		
		Local scanStart:Int = routineStart
		
		For Local ln:Int = scanStart To caretLn
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			For Local i:Int = 0 To toks.Length - 1
				If toks[i].ToUpper() = "LOCAL" Then AC_AddDeclNamesFromTokensCase(acLocalDeclCache, toks, i, "")
			Next
		Next
	End
	
	Method AC_RebuildClassDeclCacheIfNeeded(caretLn:Int)
		Local p:String = HL_NormalizePath(doc.fullname)
		If acClassDeclCachePath = p And acClassDeclCacheLine = caretLn And acClassDeclCacheLines = doc.numtotallines Then Return
		
		acClassDeclCachePath = p
		acClassDeclCacheLine = caretLn
		acClassDeclCacheLines = doc.numtotallines
		acClassDeclCache = New StringMap<String>
		
		Local classStart:Int = FindNearestClassStart(caretLn)
		If classStart < 0 Then Return
		
		For Local ln:Int = classStart To caretLn
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			For Local i:Int = 0 To toks.Length - 1
				Local up:String = toks[i].ToUpper()
				If up = "FIELD" Or up = "CONST" Then AC_AddDeclNamesFromTokensCase(acClassDeclCache, toks, i, "")
			Next
		Next
	End
	
	Method AC_AddCachedDeclMap(seen:StringMap<String>, mp:StringMap<String>, prefixUp:String, caretLn:Int)
		If seen = Null Or mp = Null Then Return
		For Local it:=Eachin mp
			Local up:String = String(it.Key)
			If up = "" Then Continue
			If prefixUp <> "" And Not up.StartsWith(prefixUp) Then Continue
			If Not seen.Contains(up) Then
				Local disp:String = String(it.Value)
				If disp = "" Then disp = up
				seen.Set(up, disp)
			EndIf
		Next
	End
	
	Method AC_AddCurrentDocDeclsOnDemand(seen:StringMap<String>, prefixUp:String, caretLn:Int)
		If seen = Null Then Return
		
		If caretLn < 0 Then caretLn = 0
		If caretLn >= doc.numtotallines Then caretLn = doc.numtotallines - 1
		
		AC_RebuildDocDeclCacheIfNeeded
		AC_AddCachedDeclMap(seen, acDocDeclCache, prefixUp, caretLn)
		
		AC_RebuildLocalDeclCacheIfNeeded(caretLn)
		AC_AddCachedDeclMap(seen, acLocalDeclCache, prefixUp, caretLn)
		
		Local allowClassDecls:Int = AC_InClassInstanceMethod(caretLn)
		If allowClassDecls = 0 Then allowClassDecls = AC_IsTextualInstanceMethodContext(caretLn)
		If allowClassDecls Then
			AC_RebuildClassDeclCacheIfNeeded(caretLn)
			AC_AddCachedDeclMap(seen, acClassDeclCache, prefixUp, caretLn)
		EndIf
	End
	
	Method AC_FindDisplayCaseFromDecl:String(up:String, caretLn:Int)
		If up = "" Then Return ""
		If doc = Null Then Return ""
		
		Local limit:Int = caretLn
		If limit < 0 Then Return ""
		If limit >= doc.numtotallines Then limit = doc.numtotallines - 1
		
		For Local ln:Int = 0 To limit
			Local lineTxt:String = GetLineTextByIndex(ln)
			If lineTxt = "" Then Continue
			Local toks:= TokenizeCodeLine(lineTxt)
			Local fi:Int = FirstCodeTokenIndex(toks)
			
			If fi >= 0 And fi + 1 < toks.Length Then
				Local t0:String = toks[fi]
				If HL_IsIdentToken(t0) And Not HL_IsKeywordCXS(t0) And toks[fi + 1] = "=" Then
					If t0.ToUpper() = up Then Return t0
				EndIf
			EndIf
			
			For Local i:Int = 0 To toks.Length - 1
				Local kwUp:String = toks[i].ToUpper()
				If kwUp = "LOCAL" Or kwUp = "GLOBAL" Or kwUp = "FIELD" Or kwUp = "CONST" Or kwUp = "CLASS" Or kwUp = "INTERFACE" Or kwUp = "FUNCTION" Or kwUp = "ENUMERATE" Or kwUp = "METHOD" Then
					Local expectName:Int = 1
					For Local j:Int = i + 1 To toks.Length - 1
						Local t:String = toks[j]
						Local tUp:String = t.ToUpper()
						If t = "," Then
							expectName = 1
							Continue
						EndIf
						If tUp = "LOCAL" Or tUp = "GLOBAL" Or tUp = "FIELD" Or tUp = "METHOD" Or tUp = "FUNCTION" Or tUp = "END" Then Exit
						If expectName And HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
							If tUp = up Then Return t
							expectName = 0
							Continue
						EndIf
					Next
				EndIf
			Next
		Next
		
		Return ""
	End
	
	Method AC_FindDisplayCaseInDoc:String(up:String, caretLn:Int)
		If up = "" Then Return ""
		If doc = Null Then Return up
		
		Local declCase:String = AC_FindDisplayCaseFromDecl(up, caretLn)
		If declCase <> "" Then Return declCase
		
		If caretLn < 0 Then caretLn = 0
		If caretLn >= doc.numtotallines Then caretLn = doc.numtotallines - 1
		
		For Local ln:Int = caretLn - 1 To 0 Step -1
			Local lineTxt:String = GetLineTextByIndex(ln)
			If lineTxt = "" Then Continue
			Local toks:= SYM_TokenizeLineSimple(lineTxt)
			For Local i:Int = 0 To toks.Length - 1
				Local t:String = toks[i]
				If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
					If t.ToUpper() = up Then Return t
				EndIf
			Next
		Next
		
		For Local ln:Int = caretLn + 1 To doc.numtotallines - 1
			Local lineTxt:String = GetLineTextByIndex(ln)
			If lineTxt = "" Then Continue
			Local toks:= SYM_TokenizeLineSimple(lineTxt)
			For Local i:Int = 0 To toks.Length - 1
				Local t:String = toks[i]
				If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
					If t.ToUpper() = up Then Return t
				EndIf
			Next
		Next
		
		Return up
	End
	
	' Builds (lazily) a single doc-wide map UPPER -> first-seen display-case of every identifier
	' in the current document. Invalidated only when the line count or doc path changes, so
	' during fast typing on the same line it stays valid and AC_AddMapKeys becomes O(M) total
	' instead of O(N*M) (one full-doc tokenize scan per map entry).
	' Questa cache serve SOLO a mostrare nell'autocomplete la grafia originale
	' di un identificatore (maiuscolo/minuscolo). Costruirla vuol dire pero'
	' tokenizzare TUTTE le righe del documento: misurati 1200 ms su
	' _prove/T16.cxs, 28648 righe.
	'
	' Prima la validita' dipendeva anche da doc.numtotallines. Ma il numero di
	' righe cambia a ogni Invio, quindi: si andava a capo, si digitava la prima
	' lettera della parola dopo, e li' l'intero documento veniva ri-tokenizzato.
	' Era il blocco di uno-due secondi che si sentiva "dopo l'Invio".
	'
	' Il numero di righe non c'entra con quello che la cache contiene: andare a
	' capo non cambia come e' scritto un identificatore. Adesso la cache si
	' ricostruisce solo quando cambia il FILE, e a ogni chiamata si fonde la
	' riga in cui si sta scrivendo, che e' il solo posto dove possono comparire
	' grafie nuove. Costa una riga invece di ventottomila.
	'
	' Restano dentro anche identificatori nel frattempo cancellati: e' una
	' cache di sola visualizzazione, una voce in piu' non fa danno.
	Method AC_EnsureIdentCaseCache()
		If doc = Null Then Return
		
		Local p:String = HL_NormalizePath(doc.fullname)
		
		If acIdentCaseValid And acIdentCasePath = p Then
			AC_IdentCaseMergeLine(linecaret)
			Return
		EndIf
		
		acIdentCase = New StringMap<String>
		acIdentCasePath = p
		acIdentCaseLines = doc.numtotallines
		acIdentCaseValid = 1
		
		Local n:Int = doc.numtotallines
		For Local ln:Int = 0 To n - 1
			Local lineTxt:String = GetLineTextByIndex(ln)
			If lineTxt = "" Then Continue
			Local toks:= TokenizeCodeLine(lineTxt)
			For Local i:Int = 0 To toks.Length - 1
				Local t:String = toks[i]
				If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
					Local up:String = t.ToUpper()
					If Not acIdentCase.Contains(up) Then acIdentCase.Set(up, t)
				EndIf
			Next
		Next
	End

	' Aggiunge alla cache le grafie della sola riga indicata.
	Method AC_IdentCaseMergeLine(ln:Int)
		If acIdentCase = Null Then Return
		If doc = Null Then Return
		If ln < 0 Or ln >= doc.numtotallines Then Return
		
		Local lineTxt:String = GetLineTextByIndex(ln)
		If lineTxt = "" Then Return
		
		Local toks:= TokenizeCodeLine(lineTxt)
		For Local i:Int = 0 To toks.Length - 1
			Local t:String = toks[i]
			If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
				Local up:String = t.ToUpper()
				If Not acIdentCase.Contains(up) Then acIdentCase.Set(up, t)
			EndIf
		Next
	End
	
	Method AC_InvalidateIdentCaseCache()
		acIdentCaseValid = 0
	End
	
	Method AC_AddMapKeys(seen:StringMap<String>, mp:StringMap<Int>, prefixUp:String, caretLn:Int)
		If seen = Null Or mp = Null Then Return
		
		Local haveCache:Int = 0
		
		For Local it:= Eachin mp
			Local key:String = String(it.Key)
			If key = "" Then Continue
			Local up:String = key.ToUpper()
			If prefixUp <> "" And Not up.StartsWith(prefixUp) Then Continue
			If Not seen.Contains(up) Then
				Local disp:String = key
				If disp.ToUpper() = up Then
					' Only build the case cache on demand (the first map entry that needs it).
					If haveCache = 0 Then
						AC_EnsureIdentCaseCache()
						haveCache = 1
					EndIf
					Local cached:String = acIdentCase.Get(up)
					If cached <> "" Then
						disp = cached
					Else
						disp = key
					EndIf
				EndIf
				seen.Set(up, disp)
			EndIf
		Next
	End
	
	Method AC_AddKeywords(seen:StringMap<String>, prefixUp:String)
		If seen = Null Then Return
		For Local i:Int = 0 To keywordscxs.Length - 1
			Local kw:String = keywordscxs[i]
			If kw = "" Then Continue
			Local up:String = kw.ToUpper()
			If prefixUp <> "" And Not up.StartsWith(prefixUp) Then Continue
			If Not seen.Contains(up) Then seen.Set(up, kw)
		Next
	End
	
	' true se leftUp (tipo qualificato da sym) appartiene alla catena `allowed` (O(1) sul caso comune).
	Method AC_SymLeftMatchesAllowed:Int(leftUp:String, allowed:StringMap<Int>)
		If leftUp = "" Or allowed = Null Then Return 0
		If allowed.Contains(leftUp) Then Return 1
		Local lsu:String = AC_ShortTypeUp(leftUp)
		If lsu <> "" And allowed.Contains(lsu) Then Return 1
		For Local a:=Eachin allowed
			Local tUp:String = String(a.Key)
			If leftUp.EndsWith("." + tUp) Then Return 1
		Next
		Return 0
	End
	
	Method AC_AddDottedMembersFromSymFd:Void(seen:StringMap<String>, fd:SymbolFileData, prefixUp:String)
		If fd = Null Then Return
		For Local i:Int = 0 To fd.count - 1
			Local decl:= fd.decls[i]
			Local knd:String = SYM_DeclKindUp(decl)
			Local nm:String = fd.names[i]
			If nm = "" Then Continue
			Local member:String = nm
			Local d:Int = nm.FindLast(".")
			If d < 0 Then Continue
			If knd <> "METHOD" And knd <> "FUNCTION" And knd <> "PROPERTY" Then Continue
			member = nm[d + 1 ..]
			Local memberUp:String = member.ToUpper()
			If prefixUp <> "" And Not memberUp.StartsWith(prefixUp) Then Continue
			If Not seen.Contains(memberUp) Then seen.Set(memberUp, member)
		Next
	End
	
	Method AC_CollectSymFilePathsForTypes:String[](allowed:StringMap<Int>)
		Local pathSeen:= New StringMap<Int>
		Local paths:String[] = New String[0]
		
		For Local a:=Eachin allowed
			Local tUp:String = String(a.Key)
			If tUp = "" Then Continue
			Local info:String = AC_FindTypeDeclInfo(tUp)
			If info = "" Then
				Local ts:String = AC_ShortTypeUp(tUp)
				If ts <> "" And ts <> tUp Then info = AC_FindTypeDeclInfo(ts)
			EndIf
			If info = "" Then Continue
			Local parts:= info.Split("|")
			If parts.Length < 1 Then Continue
			Local fp:String = parts[0].Trim
			If fp = "" Then Continue
			Local fk:String = HL_NormalizePath(fp).ToLower()
			If pathSeen.Contains(fk) Then Continue
			pathSeen.Set(fk, 1)
			Local n:Int = paths.Length
			paths = paths.Resize(n + 1)
			paths[n] = fp
		Next
		
		Local curFk:String = HL_NormalizePath(doc.fullname).ToLower()
		If Not pathSeen.Contains(curFk) Then
			Local m:Int = paths.Length
			paths = paths.Resize(m + 1)
			paths[m] = doc.fullname
		EndIf
		
		Return paths
	End
	
	Method AC_AddSymFdMembersForOwner:Void(seen:StringMap<String>, fd:SymbolFileData, fpNorm:String, allowed:StringMap<Int>, prefixUp:String, staticOnly:Int = 0)
		If fd = Null Then Return
		For Local i:Int = 0 To fd.count - 1
			Local decl:= fd.decls[i]
			Local knd:String = SYM_DeclKindUp(decl)
			If staticOnly Then
				If knd <> "FUNCTION" Then Continue
			ElseIf knd <> "METHOD" And knd <> "FIELD" And knd <> "PROPERTY" Then
				Continue
			EndIf
			
			Local nm:String = fd.names[i]
			If nm = "" Then Continue
			
			Local member:String = ""
			Local d:Int = nm.FindLast(".")
			If d >= 0 Then
				Local leftUp:String = LeftString(nm, d).ToUpper()
				If AC_SymLeftMatchesAllowed(leftUp, allowed) = 0 Then Continue
				member = nm[d + 1 ..]
			Else
				Local clsUp:String = AC_GetClassUpAtLine(fpNorm, fd.lines[i])
				If clsUp = "" Then Continue
				If Not allowed.Contains(clsUp) Then Continue
				member = nm
			EndIf
			If member = "" Then Continue
			Local memberUp:String = member.ToUpper()
			If prefixUp <> "" And Not memberUp.StartsWith(prefixUp) Then Continue
			
			If Not seen.Contains(memberUp) Then seen.Set(memberUp, member)
		Next
	End
	
	' Dopo "String." (keyword): solo FromChar/FromChars. Dopo variabile String: tutto tranne quelle due.
	Method AC_ApplyStringMemberDotPolicy:String[](items:String[])
		If items.Length = 0 Then Return items
		If acOwnerTypeUp <> "STRING" Then Return items
		Local out2:String[] = New String[0]
		If acStringKeywordDot Then
			For Local i:Int = 0 To items.Length - 1
				Local up:String = items[i].ToUpper()
				If up = "FROMCHAR" Or up = "FROMCHARS" Then
					Local l:Int = out2.Length
					out2 = out2.Resize(l + 1)
					out2[l] = items[i]
				EndIf
			Next
			Return out2
		EndIf
		For Local i:Int = 0 To items.Length - 1
			Local up:String = items[i].ToUpper()
			If up = "FROMCHAR" Or up = "FROMCHARS" Then Continue
			Local l:Int = out2.Length
			out2 = out2.Resize(l + 1)
			out2[l] = items[i]
		Next
		Return out2
	End
	
	Method AC_TryResolveImportModulePath:String(mainFile:String, modName:String)
		If mainFile = "" Or modName = "" Then Return ""
		If modName.Contains(".") Then Return ""
		
		Local baseDir:String = os.ExtractDir(mainFile).Replace("\", "/")
		If baseDir = "" Then Return ""
		If Not baseDir.EndsWith("/") Then baseDir += "/"
		
		Local cands:String[] = New String[2]
		cands[0] = baseDir + modName + "/" + modName + ".cxs"
		cands[1] = baseDir + modName + ".cxs"
		
		For Local i:Int = 0 To cands.Length - 1
			Local fp:String = cands[i]
			If os.FileType(fp) = os.FILETYPE_FILE Then Return HL_NormalizePath(fp)
		Next
		
		Return ""
	End
	
	Method AC_CollectImportModulePathsRecursive(baseFile:String, seen:StringMap<Int>, depth:Int = 0)
		If baseFile = "" Or seen = Null Then Return
		If depth > 12 Then Return
		
		Local fpNorm:String = HL_NormalizePath(baseFile)
		If fpNorm = "" Then Return
		
		Local txt:String = SRC_TextForFile(fpNorm)
		If txt = "" Then Return
		
		txt = txt.Replace(invio, "~n")
		txt = txt.Replace(String.FromChar(13), "~n")
		txt = txt.Replace(String.FromChar(10), "~n")
		Local lines:String[] = txt.Split("~n")
		Local scanLim:Int = lines.Length
		If scanLim > 600 Then scanLim = 600
		
		For Local ln:Int = 0 To scanLim - 1
			Local toks:= TokenizeCodeLine(lines[ln])
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			If toks[fi].ToUpper() <> "IMPORT" Then Continue
			If fi + 1 >= toks.Length Then Continue
			
			Local modName:String = toks[fi + 1]
			If modName = "" Or modName.StartsWith("#") Then Continue
			If modName[0] = 34 Or modName[0] = 39 Then Continue
			
			Local impPath:String = AC_TryResolveImportModulePath(fpNorm, modName)
			If impPath = "" Then Continue
			
			Local impKey:String = impPath.ToLower()
			If seen.Contains(impKey) Then Continue
			seen.Set(impKey, 1)
			AC_CollectImportModulePathsRecursive(impPath, seen, depth + 1)
		Next
	End
	
	Method AC_RebuildImportModulePathsCacheIfNeeded()
		Local p:String = HL_NormalizePath(doc.fullname)
		If acImportCachePath = p And acImportCacheLen = doc.numtotallines Then Return
		
		acImportCachePath = p
		acImportCacheLen = doc.numtotallines
		acImportCachePaths = New StringMap<Int>
		If p = "" Then Return
		
		AC_CollectImportModulePathsRecursive(p, acImportCachePaths)
	End
	
	Method AC_SymFileReachableForDoc:Int(symFilePath:String)
		If symFilePath = "" Then Return 1
		If IDE_HasReachabilityInfo(doc.fullname) = 0 Then Return 1
		
		Local fpNorm:String = HL_NormalizePath(symFilePath).ToLower()
		If IDE_IsSymFileReachableForMain(doc.fullname, fpNorm) Then Return 1
		
		AC_RebuildImportModulePathsCacheIfNeeded
		If acImportCachePaths.Contains(fpNorm) Then Return 1
		Return 0
	End
	
	Method AC_AddTopLevelDeclsFromSymFd:Void(seen:StringMap<String>, fd:SymbolFileData, prefixUp:String)
		If fd = Null Then Return
		
		For Local i:Int = 0 To fd.count - 1
			Local decl:= fd.decls[i]
			Local knd:String = SYM_DeclKindUp(decl)
			If knd <> "GLOBAL" And knd <> "CONST" And knd <> "FUNCTION" And knd <> "CLASS" And knd <> "INTERFACE" And knd <> "ENUMERATE" Then Continue
			
			Local nm:String = fd.names[i]
			If nm = "" Then Continue
			
			Local showNm:String = nm
			Local dot:Int = nm.FindLast(".")
			If dot >= 0 Then
				If knd <> "CLASS" And knd <> "INTERFACE" And knd <> "ENUMERATE" Then Continue
				showNm = nm[dot + 1 ..]
				If showNm = "" Then Continue
			EndIf
			
			Local nmUp:String = showNm.ToUpper()
			If prefixUp <> "" And Not nmUp.StartsWith(prefixUp) Then Continue
			
			If Not seen.Contains(nmUp) Then seen.Set(nmUp, showNm)
		Next
	End
	
	Method AC_ScanFileTopLevelDeclsFromPath:Void(seen:StringMap<String>, fpKey:String, prefixUp:String)
		If fpKey = "" Then Return
		
		Local txt:String = SRC_TextForFile(fpKey)
		If txt = "" Then Return
		
		txt = txt.Replace(invio, "~n")
		txt = txt.Replace(String.FromChar(13), "~n")
		txt = txt.Replace(String.FromChar(10), "~n")
		Local lines:= txt.Split("~n")
		
		For Local ln:Int = 0 To lines.Length - 1
			Local toks:= TokenizeCodeLine(lines[ln])
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			Local k0:String = toks[fi].ToUpper()
			If k0 = "GLOBAL" Or k0 = "CONST" Or k0 = "FUNCTION" Or k0 = "CLASS" Or k0 = "INTERFACE" Or k0 = "ENUMERATE" Then
				AC_AddDeclNamesFromTokensCase(seen, toks, fi, prefixUp)
			EndIf
		Next
	End
	
	Method AC_AddTopLevelDeclsFromImportedModules:Void(seen:StringMap<String>, prefixUp:String)
		AC_RebuildImportModulePathsCacheIfNeeded
		
		For Local it:=Eachin acImportCachePaths
			Local fpKey:String = String(it.Key)
			If fpKey = "" Then Continue
			
			Local fd:SymbolFileData = SYM_GetFile(fpKey)
			If fd = Null Then
				Local fpOrig:String = HL_NormalizePath(fpKey)
				fd = SYM_GetFile(fpOrig)
			EndIf
			' Fast path: if the parser-populated symbol cache has the file, use it and
			' avoid the per-keystroke disk read + re-tokenize of the imported module.
			If fd <> Null And fd.count > 0 Then
				AC_AddTopLevelDeclsFromSymFd(seen, fd, prefixUp)
			Else
				AC_ScanFileTopLevelDeclsFromPath(seen, fpKey, prefixUp)
			EndIf
		Next
	End
	
	Method HL_ScanCallableNamesFromFile:Void(fpKey:String)
		If fpKey = "" Then Return
		
		Local txt:String = SRC_TextForFile(fpKey)
		If txt = "" Then Return
		
		txt = txt.Replace(invio, "~n")
		txt = txt.Replace(String.FromChar(13), "~n")
		txt = txt.Replace(String.FromChar(10), "~n")
		Local lines:= txt.Split("~n")
		
		Local classDepth:Int = 0
		Local curClassUp:String = ""
		
		For Local ln:Int = 0 To lines.Length - 1
			Local toks:= TokenizeCodeLine(lines[ln])
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			Local k0:String = toks[fi].ToUpper()
			
			If k0 = "CLASS" Or k0 = "INTERFACE" Then
				If fi + 1 < toks.Length Then
					Local cn:String = toks[fi + 1]
					If HL_IsIdentToken(cn) And Not HL_IsKeywordCXS(cn) Then
						curClassUp = cn.ToUpper()
						hlClassNamesUp.Set(curClassUp, 1)
					EndIf
				EndIf
				classDepth += 1
				Continue
			EndIf
			If k0 = "END" Then
				If classDepth > 0 Then
					classDepth -= 1
					If classDepth = 0 Then curClassUp = ""
				EndIf
				Continue
			EndIf
			
			If classDepth = 0 Then
				If k0 = "FUNCTION" Then
					For Local j:Int = fi + 1 To toks.Length - 1
						Local t:String = toks[j]
						If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
							hlFunctionNames.Set(t.ToUpper(), 1)
							Exit
						EndIf
					Next
				ElseIf k0 = "GLOBAL" Or k0 = "CONST" Then
					For Local j:Int = fi + 1 To toks.Length - 1
						Local t:String = toks[j]
						If t = "," Then Continue
						Local up:String = t.ToUpper()
						If up = "GLOBAL" Or up = "CONST" Or up = "END" Then Exit
						If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
							hlGlobalNamesCase.Set(t, 1)
						EndIf
					Next
				EndIf
			Else
				If k0 = "METHOD" Or k0 = "FUNCTION" Then
					For Local j:Int = fi + 1 To toks.Length - 1
						Local t:String = toks[j]
						If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
							If k0 = "FUNCTION" Then
								hlFunctionNames.Set(t.ToUpper(), 1)
							Else
								hlMethodNames.Set(t.ToUpper(), 1)
							EndIf
							Exit
						EndIf
					Next
				EndIf
			EndIf
		Next
	End
	
	Method HL_RefreshClassNamesFromDocLines()
		For Local ln:Int = 0 To doc.numtotallines - 1
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			Local k0:String = toks[fi].ToUpper()
			If k0 = "CLASS" Or k0 = "INTERFACE" Or k0 = "ENUMERATE" Then
				If fi + 1 < toks.Length Then
					Local cn:String = toks[fi + 1]
					If HL_IsIdentToken(cn) And Not HL_IsKeywordCXS(cn) Then hlClassNamesUp.Set(cn.ToUpper(), 1)
				EndIf
			EndIf
		Next
	End
	
	Method HL_RefreshCallableNamesFromImportFiles()
		AC_RebuildImportModulePathsCacheIfNeeded
		
		Local clsT0:Int = Millisecs()
		HL_RefreshClassNamesFromDocLines()
		
		Local impT0:Int = Millisecs()
		For Local it:=Eachin acImportCachePaths
			Local fpKey:String = String(it.Key)
			If fpKey = "" Then Continue
			
			' Fast path: se il parser ha gia' i simboli di questo modulo in memoria
			' (il caso normale: mojo2 e la sua catena di import vengono parsati e
			' restano in symFiles), si riusano quelli invece di rileggere il file da
			' disco e ritokenizzarlo per intero.
			'
			' Prima QUESTO era il costo dominante di EnsureHLCallableNameCache: a ogni
			' ciclo COMPLETATO del parser, ogni modulo importato (transitivamente,
			' inclusi quelli standard come mojo2) veniva riletto da disco e
			' ritokenizzato riga per riga, senza limite di lunghezza. Misurati ~70 ms
			' a comparsa, percepiti come uno scatto isolato ogni volta che il parser
			' finiva un ciclo mentre si scriveva.
			'
			' Stessa idea gia' usata in AC_AddTopLevelDeclsFromImportedModules.
			Local fd:SymbolFileData = SYM_GetFile(fpKey)
			If fd = Null Then
				Local fpOrig:String = HL_NormalizePath(fpKey)
				fd = SYM_GetFile(fpOrig)
			EndIf
			
			If fd <> Null And fd.count > 0 Then
				HL_CollectCallableNamesFromSymFd(fd)
			Else
				' Nessun dato dal parser per questo file (avvio a freddo, o il parser
				' non l'ha ancora raggiunto): si ripiega sulla lettura da disco.
				HL_ScanCallableNamesFromFile(fpKey)
			EndIf
		Next
	End
	
	Method HL_CallableColor:Int(identUp:String)
		If identUp = "" Then Return 0
		If hlFunctionNames.Contains(identUp) Then Return 10
		If hlMethodNames.Contains(identUp) Then Return 8
		Return 0
	End
	
	Method HL_CallableColorCtx:Int(lineTxt:String, tokStart:Int, idl:Int, identUp:String)
		If identUp = "" Then Return 0
		
		Local hasFn:Int = hlFunctionNames.Contains(identUp)
		Local hasMt:Int = hlMethodNames.Contains(identUp)
		If hasFn = 0 And hasMt = 0 Then Return 0
		
		' Contesto a punto (owner.Membro): deve sempre essere risolto come membro,
		' indipendentemente da come l'ident risulta classificato nelle cache (Fn/Mt).
		' In Cerberus-X non si possono richiamare Function globali tramite "x.Foo()".
		Local q:Int = tokStart - 1
		While q >= 0
			Local cq:Int = lineTxt[q]
			If cq = 32 Or cq = 9 Then
				q -= 1
				Continue
			EndIf
			Exit
		Wend
		If q >= 0 And lineTxt[q] = 46 Then
			Local ownerStr:String = HL_ReadIdentBeforeDot(lineTxt, q)
			If ownerStr <> "" Then
				If HL_IsClassNameUp(ownerStr.ToUpper()) Then
					' ClassName.X => se esiste come Function (statica) usa 10, altrimenti Method (8)
					If hasFn Then Return 10
					Return 8
				EndIf
				' instance.X => sempre membro (Method)
				Return 8
			EndIf
		EndIf
		
		' Nessun contesto a punto: usa il match singolo Fn vs Mt.
		If hasFn And hasMt = 0 Then Return 10
		If hasMt And hasFn = 0 Then Return 8
		
		If AC_InClassStaticFunction(idl) Then Return 10
		If AC_InClassInstanceMethod(idl) Then Return 8
		
		Return HL_CallableColor(identUp)
	End
	
	' True if the previously built items list can be safely reused as the source
	' for the new prefix (just by filtering it). The new prefix must be a strict
	' extension of the cached prefix and all the inputs that drove the previous
	' build (scope, parser, doc, after-dot context) must be unchanged.
	Method AC_FilterCacheCanReuse:Int(prefixUp:String, caretLn:Int, afterDot:Int)
		If acFilterCacheValid = 0 Then Return 0
		If prefixUp = "" Then Return 0
		' acFilterCachePrefixUp = "" means the cache holds the FULL match set
		' (e.g. the first AC call right after typing "."). Any non-empty prefix
		' is a valid extension of the empty prefix, so the cache is still usable
		' â€” we just filter the full set down by the new prefix. This is the key
		' optimization for typing "canv.DrawImage" after the dot.
		If acFilterCachePrefixUp <> "" And Not prefixUp.StartsWith(acFilterCachePrefixUp) Then Return 0
		If afterDot <> acFilterCacheAfterDot Then Return 0
		If caretLn <> acFilterCacheCaretLn Then Return 0
		If doc = Null Then Return 0
		If doc.numtotallines <> acFilterCacheNumLines Then Return 0
		If HL_NormalizePath(doc.fullname) <> acFilterCachePath Then Return 0
		If afterDot Then
			' Member completion ("canv.DrawImage"): the member set of the owner type
			' does not change while you type the member name, so we DON'T gate reuse
			' on parser/scope generation here. The parser can complete a cycle between
			' keystrokes (350ms debounce), which would otherwise force a full member
			' re-enumeration on every key. Reuse stays keyed on the resolved owner
			' type + caret line + line count, which is what actually matters; it
			' refreshes naturally when you move to another line or change line count.
			If acOwnerTypeUp <> acFilterCacheOwnerTypeUp Then Return 0
			If acOwnerStaticClass <> acFilterCacheOwnerStatic Then Return 0
			If acStringKeywordDot <> acFilterCacheStringKwDot Then Return 0
		Else
			' Top-level / scoped identifier completion: candidate set depends on
			' scope locals/globals, so refresh when the scope layout actually
			' rebuilds (debounced; stable during a burst) or the parser commits.
			If IDE_GetParserCycleId() <> acFilterCacheSymVer Then Return 0
			If scopeLayoutGen <> acFilterCacheScopeGen Then Return 0
		EndIf
		Return 1
	End
	
	' Filter the cached (already sorted) items by the new (longer) prefix.
	' Cached uppercase keys avoid per-call ToUpper allocations.
	Method AC_FilterPrevItems:String[](prefixUp:String)
		Local n:Int = acFilterCacheItems.Length
		If n = 0 Then Return New String[0]
		
		Local count:Int = 0
		For Local i:Int = 0 To n - 1
			Local up:String = ""
			If i < acFilterCacheItemsUp.Length Then up = acFilterCacheItemsUp[i]
			If up = "" Then up = acFilterCacheItems[i].ToUpper()
			If up.StartsWith(prefixUp) Then count += 1
		Next
		
		If count = 0 Then Return New String[0]
		
		Local arr:String[count]
		Local ups:String[count]
		Local idx:Int = 0
		For Local i:Int = 0 To n - 1
			Local up:String = ""
			If i < acFilterCacheItemsUp.Length Then up = acFilterCacheItemsUp[i]
			If up = "" Then up = acFilterCacheItems[i].ToUpper()
			If up.StartsWith(prefixUp) Then
				arr[idx] = acFilterCacheItems[i]
				ups[idx] = up
				idx += 1
			EndIf
		Next
		
		' Keep the cache ups in sync with the filtered set so the NEXT
		' incremental filter call can stay allocation-free too.
		acFilterCacheItemsUp = ups
		Return arr
	End
	
	' Save the freshly built items list (and its uppercase mirror) so the next
	' keystroke can use the incremental filter fast path.
	Method AC_FilterCacheStore(items:String[], prefixUp:String, caretLn:Int, afterDot:Int)
		acFilterCacheValid = 1
		acFilterCachePrefixUp = prefixUp
		acFilterCacheItems = items
		
		Local n:Int = items.Length
		Local ups:String[n]
		For Local i:Int = 0 To n - 1
			Local s:String = items[i]
			If s = "" Then ups[i] = "" Else ups[i] = s.ToUpper()
		Next
		acFilterCacheItemsUp = ups
		
		acFilterCacheAfterDot = afterDot
		acFilterCacheCaretLn = caretLn
		If doc <> Null Then
			acFilterCacheNumLines = doc.numtotallines
			acFilterCachePath = HL_NormalizePath(doc.fullname)
		Else
			acFilterCacheNumLines = -1
			acFilterCachePath = ""
		EndIf
		acFilterCacheSymVer = IDE_GetParserCycleId()
		acFilterCacheScopeGen = scopeLayoutGen
		If afterDot Then
			acFilterCacheOwnerTypeUp = acOwnerTypeUp
			acFilterCacheOwnerStatic = acOwnerStaticClass
			acFilterCacheStringKwDot = acStringKeywordDot
		Else
			acFilterCacheOwnerTypeUp = ""
			acFilterCacheOwnerStatic = 0
			acFilterCacheStringKwDot = 0
		EndIf
	End
	
	Method AC_FilterCacheInvalidate()
		acFilterCacheValid = 0
	End
	
	Method AC_BuildItems:String[](prefixUp:String, caretLn:Int, afterDot:Int)
		Local out:String[] = New String[0]
		If prefixUp = "" And afterDot = 0 Then Return out
		
		' Fast path: while the user keeps extending the current identifier
		' ("c" -> "ca" -> "can" -> "canv"), every new match set is a subset of
		' the previous one. Filter the already-sorted cached list instead of
		' iterating all symFiles / scope maps and re-sorting from scratch.
		If AC_FilterCacheCanReuse(prefixUp, caretLn, afterDot) Then
			out = AC_FilterPrevItems(prefixUp)
			acFilterCachePrefixUp = prefixUp
			acFilterCacheItems = out
			Return out
		EndIf
		
		Local seen:= New StringMap<String>
		
		If afterDot Then
			Local ownerTypeUp:String = acOwnerTypeUp
			' Tipo scalare (Bool/Int/Float/UInt/...): nessun membro, e soprattutto
			' NON cadere nel fallback sotto che butta tutti i METHOD dei moduli.
			If AC_IsScalarPrimitiveUp(ownerTypeUp) Then
				AC_FilterCacheInvalidate
				Return New String[0]
			EndIf
			If ownerTypeUp = "" Then
				' Tipo non risolto: non iterare tutti i symFiles (centinaia/migliaia di file) â€” solo il .cxs corrente.
				Local fdUnk:SymbolFileData = SYM_GetFile(doc.fullname)
				AC_AddDottedMembersFromSymFd(seen, fdUnk, prefixUp)
				
				out = AC_SeenToArray(seen)
				
				AC_SortItems(out)
				AC_FilterCacheStore(out, prefixUp, caretLn, afterDot)
				Return out
			EndIf
			
			AC_RebuildTypeBaseCacheIfNeeded
			
			Local mlist:= AC_GetMembersForType(ownerTypeUp, acOwnerStaticClass)
			For Local nm:String = Eachin mlist
				Local up:String = nm.ToUpper()
				If prefixUp <> "" And Not up.StartsWith(prefixUp) Then Continue
				If Not seen.Contains(up) Then seen.Set(up, nm)
			Next
			
			Local allowed:= New StringMap<Int>
			Local curUp:String = ownerTypeUp
			While curUp <> ""
				If allowed.Contains(curUp) Then Exit
				allowed.Set(curUp, 1)
				
				Local nextUp:String = ""
				
				For Local ci:Int = 0 To scopeClassCount - 1
					If scopeClasses[ci].nameUp = curUp Then
						nextUp = scopeClasses[ci].extendsUp
						Exit
					EndIf
				Next
				
				If nextUp = "" Then nextUp = acTypeBaseUp.Get(curUp)
				
				curUp = nextUp
			Wend
			
			Local scanPaths:String[] = AC_CollectSymFilePathsForTypes(allowed)
			If scanPaths.Length > 0 Then
				For Local pi:Int = 0 To scanPaths.Length - 1
					Local fpRaw:String = scanPaths[pi]
					Local fpNorm:String = HL_NormalizePath(fpRaw)
					If AC_SymFileReachableForDoc(fpNorm) = 0 Then Continue
					Local fd:SymbolFileData = SYM_GetFile(fpRaw)
					AC_AddSymFdMembersForOwner(seen, fd, fpNorm, allowed, prefixUp, acOwnerStaticClass)
				Next
			Else
				For Local it:=Eachin symFiles
					Local fpKey:String = String(it.Key)
					If AC_SymFileReachableForDoc(fpKey) = 0 Then Continue
					Local fpNorm:String = HL_NormalizePath(String(it.Key))
					Local fd:SymbolFileData = SymbolFileData(it.Value)
					AC_AddSymFdMembersForOwner(seen, fd, fpNorm, allowed, prefixUp, acOwnerStaticClass)
				Next
				
				For Local it:=Eachin symFilesFixed
					Local fpNorm:String = HL_NormalizePath(String(it.Key))
					Local fd:SymbolFileData = SymbolFileData(it.Value)
					AC_AddSymFdMembersForOwner(seen, fd, fpNorm, allowed, prefixUp, acOwnerStaticClass)
				Next
			EndIf
			
			out = AC_SeenToArray(seen)
			
			If out.Length = 0 Then
				seen = New StringMap<String>
				
				Local wantKnd:String = "METHOD"
				If acOwnerStaticClass Then wantKnd = "FUNCTION"
				
				For Local it:=Eachin symFiles
					Local fpKey2:String = String(it.Key)
					If AC_SymFileReachableForDoc(fpKey2) = 0 Then Continue
					Local fd:SymbolFileData = SymbolFileData(it.Value)
					If fd = Null Then Continue
					
					For Local i:Int = 0 To fd.count - 1
						Local decl:= fd.decls[i]
						Local knd:String = SYM_DeclKindUp(decl)
						If knd <> wantKnd Then Continue
						
						Local nm:String = fd.names[i]
						If nm = "" Then Continue
						
						Local member:String = nm
						Local d:Int = nm.FindLast(".")
						If d >= 0 Then member = nm[d + 1 ..]
						
						Local memberUp:String = member.ToUpper()
						If prefixUp <> "" And Not memberUp.StartsWith(prefixUp) Then Continue
						If Not seen.Contains(memberUp) Then seen.Set(memberUp, member)
					Next
				Next
				
				For Local it:=Eachin symFilesFixed
					Local fd:SymbolFileData = SymbolFileData(it.Value)
					If fd = Null Then Continue
					
					For Local i:Int = 0 To fd.count - 1
						Local decl:= fd.decls[i]
						Local knd:String = SYM_DeclKindUp(decl)
						If knd <> wantKnd Then Continue
						
						Local nm:String = fd.names[i]
						If nm = "" Then Continue
						
						Local member:String = nm
						Local d:Int = nm.FindLast(".")
						If d >= 0 Then member = nm[d + 1 ..]
						
						Local memberUp:String = member.ToUpper()
						If prefixUp <> "" And Not memberUp.StartsWith(prefixUp) Then Continue
						If Not seen.Contains(memberUp) Then seen.Set(memberUp, member)
					Next
				Next
				
				out = AC_SeenToArray(seen)
			EndIf
			
			out = AC_ApplyStringMemberDotPolicy(out)
			AC_SortItems(out)
			AC_FilterCacheStore(out, prefixUp, caretLn, afterDot)
			Return out
		EndIf
		
		EnsureScopeVarCache(0)
		Local scopeId:Int = -1
		If caretLn >= 0 And caretLn < scopeMethodAtLine.Length Then scopeId = scopeMethodAtLine[caretLn]
		If scopeId < 0 And caretLn >= 0 And caretLn < scopeFuncAtLine.Length Then scopeId = scopeFuncAtLine[caretLn]
		
		Local classId:Int = -1
		If caretLn >= 0 And caretLn < scopeClassAtLine.Length Then classId = scopeClassAtLine[caretLn]
		
		If scopeId >= 0 And scopeId < scopeInfoCount Then
			AC_AddMapKeys(seen, scopeInfos[scopeId].locals, prefixUp, caretLn)
		EndIf
		
		If classId >= 0 And classId < scopeClassCount And AC_InClassInstanceMethod(caretLn) Then
			AC_AddMapKeys(seen, scopeClasses[classId].fields, prefixUp, caretLn)
		EndIf
		
		AC_AddMapKeys(seen, scopeFields, prefixUp, caretLn)
		AC_AddMapKeys(seen, scopeGlobals, prefixUp, caretLn)
		AC_AddMapKeys(seen, scopeConsts, prefixUp, caretLn)
		AC_AddCurrentDocDeclsOnDemand(seen, prefixUp, caretLn)
		AC_AddTopLevelDeclsFromImportedModules(seen, prefixUp)
		
		For Local it:=Eachin symFiles
			Local fpKey:String = String(it.Key)
			If AC_SymFileReachableForDoc(fpKey) = 0 Then Continue
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			AC_AddTopLevelDeclsFromSymFd(seen, fd, prefixUp)
		Next
		
		For Local it:=Eachin symFilesFixed
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			AC_AddTopLevelDeclsFromSymFd(seen, fd, prefixUp)
		Next
		
		If prefixUp <> "" Then
			AC_RebuildCXDocTypeCacheIfNeeded
			Local key:String = String.FromChar(prefixUp[0])
			Local lst:StringList = acCxTypesByFirst.Get(key)
			If lst Then
				For Local nm:String = Eachin lst
					Local up:String = nm.ToUpper()
					If Not up.StartsWith(prefixUp) Then Continue
					If Not seen.Contains(up) Then seen.Set(up, nm)
				Next
			EndIf
			
			Local lstFunc:StringList = acCxFunctionsByFirst.Get(key)
			If lstFunc Then
				For Local nm:String = Eachin lstFunc
					Local up:String = nm.ToUpper()
					If Not up.StartsWith(prefixUp) Then Continue
					If Not seen.Contains(up) Then seen.Set(up, nm)
				Next
			EndIf
		EndIf
		
		AC_AddKeywords(seen, prefixUp)
		
		out = AC_SeenToArray(seen)
		
		AC_SortItems(out)
		AC_FilterCacheStore(out, prefixUp, caretLn, afterDot)
		Return out
	End
	
	' Two-pass conversion: count first, then resize once and fill.
	' Replaces the previous O(N^2) "Resize(l+1) per element" pattern.
	Method AC_SeenToArray:String[](seen:StringMap<String>)
		If seen = Null Then Return New String[0]
		
		Local count:Int = 0
		For Local it:=Eachin seen
			Local nm:String = String(it.Value)
			If nm <> "" Then count += 1
		Next
		
		If count = 0 Then Return New String[0]
		
		Local arr:String[count]
		Local idx:Int = 0
		For Local it:=Eachin seen
			Local nm:String = String(it.Value)
			If nm = "" Then Continue
			arr[idx] = nm
			idx += 1
		Next
		
		Return arr
	End
	
	Method AC_UpdateFromCaret()
		Local actt0:Int = Millisecs()
		AC_UpdateFromCaretDo()
	End

	Method AC_UpdateFromCaretDo()
		acPrefixStart = -1
		acPrefixEnd = -1
		
		Local endp:Int = idcaret
		Local p:Int = endp - 1
		While p >= 0 And AC_IsIdentChar(doc.Crs[p] & 255)
			p -= 1
		Wend
		Local startp:Int = p + 1
		
		acAfterDot = 0
		acOwnerTypeUp = ""
		acOwnerStaticClass = 0
		acStringKeywordDot = 0
		Local q:Int = startp - 1
		While q >= 0 And (doc.Crs[q] & 255) = 32
			q -= 1
		Wend
		If q >= 0 And (doc.Crs[q] & 255) = 46 Then acAfterDot = 1
		
		If startp < 0 Or startp > endp Then
			AC_Close
			Return
		EndIf
		
		If startp >= endp And acAfterDot = 0 Then
			AC_Close
			Return
		EndIf
		
		Local prefix:String = ""
		If startp < endp Then
			For Local i:Int = startp To endp - 1
				prefix += String.FromChar(doc.Crs[i] & 255)
			Next
		EndIf
		
		Local prefixUp:String = prefix.ToUpper()
		If prefixUp <> "" Then
			Local c0:Int = prefixUp[0]
			If Not (c0 = 95 Or c0 >= 65 And c0 <= 90) Then
				AC_Close
				Return
			EndIf
		EndIf
		
		GetCursorLine
		Local caretLn:Int = linecaret
		If caretLn < 0 Then caretLn = 0
		
		If acAfterDot Then
			Local owner:String = AC_ReadIdentLeftOfPos(q - 1)
			Local ownerUp:String = owner.ToUpper()
			
			' Fast path: la risoluzione dell'owner dopo il punto e' identica ad ogni
			' keystroke finche' (caretLn, posizione del punto, identificatore owner,
			' scope/parser generation, numero di righe) sono invariati. E' il caso
			' tipico mentre si digita "canv.DrawImage": ogni tasto dopo il "." cadeva
			' sul percorso lento (EnsureScopeVarCache + AC_FindTypeOfIdentUp +
			' AC_InferExprTypeUpAtPos + AC_IsClassNameUp + AC_ShouldBlockMemberAutocompleteAfterDot).
			' Con la cache, dopo la prima risoluzione la lettura e' O(1).
			Local parserVerNow:Int = IDE_GetParserCycleId()
			Local docPathNow:String = HL_NormalizePath(doc.fullname)
			Local ownerCtxHit:Int = 0
			If acOwnerCtxCacheValid And acOwnerCtxCacheCaretLn = caretLn And acOwnerCtxCacheDotPos = q Then
				If acOwnerCtxCacheOwnerUp = ownerUp And acOwnerCtxCacheNumLines = doc.numtotallines Then
					If acOwnerCtxCacheScopeGen = scopeLayoutGen And acOwnerCtxCacheParserVer = parserVerNow Then
						If acOwnerCtxCachePath = docPathNow Then
							ownerCtxHit = 1
						EndIf
					EndIf
				EndIf
			EndIf
			
			If ownerCtxHit Then
				acOwnerTypeUp = acOwnerCtxCacheTypeUp
				acOwnerStaticClass = acOwnerCtxCacheStatic
				acStringKeywordDot = acOwnerCtxCacheStringKw
			Else
				EnsureScopeVarCache(0)
				Local clsId:Int = -1
				If caretLn >= 0 And caretLn < scopeClassAtLine.Length Then clsId = scopeClassAtLine[caretLn]
				
				Local curClassUp:String = ""
				Local curExtUp:String = ""
				If clsId >= 0 And clsId < scopeClassCount Then
					curClassUp = scopeClasses[clsId].nameUp
					curExtUp = scopeClasses[clsId].extendsUp
				EndIf
				
				If ownerUp = "SELF" Then
					acOwnerTypeUp = curClassUp
					acStringKeywordDot = 0
				ElseIf ownerUp = "SUPER" Then
					If curExtUp <> "" Then acOwnerTypeUp = curExtUp Else acOwnerTypeUp = curClassUp
					acStringKeywordDot = 0
				Else
					Local exprEnd:Int = q - 1
					While exprEnd >= 0
						Local ec:Int = doc.Crs[exprEnd] & 255
						If ec <> 32 And ec <> 9 Then Exit
						exprEnd -= 1
					Wend
					
					' Array + "." senza indice: blocca subito (evita InferExpr + seconda lookup).
					If exprEnd >= 0 And ownerUp <> "" Then
						Local chLeft:Int = doc.Crs[exprEnd] & 255
						If chLeft <> 93 Then
							Local tyQuick:String = AC_FindTypeOfIdentUp(ownerUp, caretLn)
							If AC_IsArrayTypeSuffixUp(AC_TypeIdNormUp(tyQuick)) Or AC_IdentDeclaredAsArrayUp(ownerUp, caretLn) Then
								AC_Close
								Return
							EndIf
						EndIf
					EndIf
					
					acStringKeywordDot = AC_IsStringKeywordBeforeDot(q)
					acOwnerTypeUp = AC_InferExprTypeUpAtPos(exprEnd, caretLn)
					
					If acOwnerTypeUp = "" And ownerUp <> "" Then
						acOwnerTypeUp = AC_FindTypeOfIdentUp(ownerUp, caretLn)
						If acOwnerTypeUp = "" Then
							If ownerUp = "STRING" And HL_IsKeywordCXS(owner) And AC_IsKnownTypeUp(ownerUp) Then
								acOwnerTypeUp = ownerUp
								acStringKeywordDot = 1
							ElseIf HL_IsClassNameUp(ownerUp) And Not HL_IsKeywordCXS(owner) Then
								acOwnerTypeUp = ownerUp
							EndIf
						EndIf
					EndIf
					
					If ownerUp <> "SELF" And ownerUp <> "SUPER" Then
						If HL_IsClassNameUp(ownerUp) And AC_FindTypeOfIdentUp(ownerUp, caretLn) = "" Then
							acOwnerStaticClass = 1
						EndIf
					EndIf
				EndIf
				acOwnerTypeUp = AC_TypeIdNormUp(acOwnerTypeUp)
				
				If AC_ShouldBlockMemberAutocompleteAfterDot(q, ownerUp, acOwnerTypeUp, caretLn) Then
					acAfterDot = 0
					AC_Close
					Return
				EndIf
				
				' Cache la risoluzione: i prossimi keystroke con lo stesso contesto
				' a sinistra del punto saltano l'intero blocco di sopra.
				acOwnerCtxCacheValid = 1
				acOwnerCtxCacheCaretLn = caretLn
				acOwnerCtxCacheDotPos = q
				acOwnerCtxCacheOwnerUp = ownerUp
				acOwnerCtxCacheNumLines = doc.numtotallines
				acOwnerCtxCacheScopeGen = scopeLayoutGen
				acOwnerCtxCacheParserVer = parserVerNow
				acOwnerCtxCachePath = docPathNow
				acOwnerCtxCacheTypeUp = acOwnerTypeUp
				acOwnerCtxCacheStatic = acOwnerStaticClass
				acOwnerCtxCacheStringKw = acStringKeywordDot
			EndIf
		EndIf
		
		Local items:= AC_BuildItems(prefixUp, caretLn, acAfterDot)
		If items.Length = 0 Then
			AC_Close
			Return
		EndIf
		
		acOn = 1
		acPrefixUp = prefixUp
		acItems = items
		acPrefixStart = startp
		acPrefixEnd = endp
		
		If acSel < 0 Then acSel = 0
		If acSel >= acItems.Length Then acSel = acItems.Length - 1

		' NIENTE correzione di maiuscole/minuscole qui.
		' Prima, appena la parola digitata raggiungeva la lunghezza del
		' suggerimento, veniva riscritta con le maiuscole di quello: digitando
		' "R" con un Field "r" dichiarato, la R diventava r all'istante e non
		' c'era modo di scrivere "R2", perche' la correzione scattava sulla
		' "R" prima ancora di poter battere il "2".
		' La sostituzione avviene ora solo quando si digita qualcosa DOPO la
		' parola (vedi AC_Confirm), che e' il momento in cui la parola e'
		' davvero finita.
	End
	
	
	Method SaveSelectedAndAutoCompleteToUR(txt:String)
		Local urs:= New URstate
		urs.modeur = 0
		urs.lencrs = doc.Crs.Length
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel
		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf
		
		Local l:Int = idsel2 - idsel1
		Local cc2:Int[l]
		For Local i:Int = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		Local cc3:Int[]
		If txt <> "" Then
			cc3 = txt.ToChars()
			urs.crs3 = cc3
			urs.idstartc3 = idcaret
			urs.idendc3 = idcaret + txt.Length
		EndIf
		
		urs.poscar = idcaret
		doc.URstates[doc.idurstates] = urs
		doc.NextURstates
	End
	
	' implicitEnd = 1 quando la conferma non e' stata chiesta (Tab/Invio) ma e'
	' scattata perche' si e' digitato un carattere che chiude la parola.
	' In quel caso, se quello che si e' scritto coincide ESATTAMENTE con una
	' delle voci, si lascia com'e': e' una parola valida, scritta apposta cosi'.
	' Senza questo, avendo dichiarati sia "r" sia "R", scrivere "R" seguito da
	' uno spazio lo trasformava in "r" - la voce selezionata - e la maiuscola
	' era di fatto impossibile da scrivere.
	' Su Tab/Invio invece si sostituisce sempre con la voce SELEZIONATA, anche
	' se il testo digitato coincide con un'altra voce: li' la scelta e' esplicita
	' (digitare "r" e premere Tab su "rv" deve dare "rv").
	Method AC_Confirm(xxca, yyca, wwca, hhca, implicitEnd:Int = 0)
		If acOn = 0 Then Return
		If acItems.Length = 0 Then
			AC_Close
			Return
		EndIf
		
		If acSel < 0 Then acSel = 0
		If acSel >= acItems.Length Then acSel = acItems.Length - 1

		If implicitEnd And acPrefixStart >= 0 And acPrefixStart <= idcaret Then
			Local typed:String = ""
			For Local i:Int = acPrefixStart To idcaret - 1
				typed += String.FromChar(doc.Crs[i] & 255)
			Next
			If typed <> "" Then
				For Local i:Int = 0 To acItems.Length - 1
					If acItems[i] = typed Then
						AC_Close
						Return
					EndIf
				Next
			EndIf
		EndIf

		Local txt:String = acItems[acSel]
		If txt = "" Then
			AC_Close
			Return
		EndIf
		
		If acPrefixStart >= 0 And acPrefixStart <= idcaret Then
			idstartsel = acPrefixStart
			idendsel = idcaret
		EndIf
		
		SaveSelectedAndAutoCompleteToUR(txt)
		CancSelected()
		
		Local crs:= txt.ToChars()
		InsertBlock(idcaret, idcaret + txt.Length, crs)
		idcaret = idcaret + txt.Length
		
		CaretOutOfScreen(xxca, yyca, wwca, hhca)
		NotifyDocEdited
		HighlightinglineCaret()
		
		AC_Close
	End
	
	Method AC_HandleMouse:Int(x1, y1, x2, y2)
		If acOn = 0 Or focussheet = Null Or focussheet.focusbox <> Self Or acItems.Length = 0 Then
			acScrollHookOn = 0
			Return 0
		EndIf
		
		Local rows:Int = 6
		Local rowH:Int = ykscale
		If rowH < 16 Then rowH = 16
		Local total:Int = acItems.Length
		
		Local maxLen:Int = 0
		Local lim:Int = total
		If lim > 200 Then lim = 200
		For Local i:Int = 0 To lim - 1
			Local s:String = acItems[i]
			If s.Length > maxLen Then maxLen = s.Length
		Next
		Local barW:Int = 14
		Local pad:Int = 6
		Local w:Int = pad * 2 + maxLen * xkscale + barW
		If w < 140 Then w = 140
		If w > 420 Then w = 420
		Local h:Int = rows * rowH + pad * 2
		Local px:Int = xcaret
		Local py:Int = ycaret + rowH
		Local right:Int = x1 + x2 - 22
		Local bottom:Int = y1 + y2 - 60
		If px + w > right Then px = right - w
		If px < x1 + doc.ww2 + 8 Then px = x1 + doc.ww2 + 8
		If py + h > bottom Then py = ycaret - h
		If py < y1 + 24 Then py = y1 + 24
		Local visibleRows:Int = rows
		If total < visibleRows Then visibleRows = total
		If IsTouchHit(px + 1, py + pad, w - barW - 2, visibleRows * rowH) Then
			Local hitRow:Int = (ymou - (py + pad)) / rowH
			If hitRow >= 0 And hitRow < visibleRows Then
				Local idx:Int = acScroll + hitRow
				If idx >= 0 And idx < total Then
					acSel = idx
					AC_Confirm(x1, y1, x2, y2)
					Return 1
				EndIf
			EndIf
		EndIf
		If total <= rows Then
			If touchrel Or (touchdown = 0 And touchhit = 0) Then acScrollHookOn = 0
			Return 0
		EndIf
		Local bx:Int = px + w - barW
		Local by:Int = py + 1
		Local bh:Int = h - 2
		Local thumbH:Int = bh * rows / total
		If thumbH < 12 Then thumbH = 12
		If thumbH > bh Then thumbH = bh
		Local maxScroll:Int = total - rows
		Local thumbY:Int = by
		If maxScroll > 0 Then thumbY = by + (bh - thumbH) * acScroll / maxScroll
		If IsTouchHit(bx + 2, thumbY, barW - 5, thumbH) Then acScrollHookOn = 1; acScrollHookY = ymou - thumbY; Return 1
		If acScrollHookOn Then
			Local travel:Int = bh - thumbH
			Local newThumbY:Int = ymou - acScrollHookY
			If newThumbY < by Then newThumbY = by
			If newThumbY > by + travel Then newThumbY = by + travel
			If travel > 0 And maxScroll > 0 Then acScroll = (newThumbY - by) * maxScroll / travel Else acScroll = 0
			If acScroll < 0 Then acScroll = 0
			If acScroll > maxScroll Then acScroll = maxScroll
			acSel = acScroll
			If acSel >= total Then acSel = total - 1
			If touchrel Or (touchdown = 0 And touchhit = 0) Then acScrollHookOn = 0
			Return 1
		EndIf
		If touchrel Or (touchdown = 0 And touchhit = 0) Then acScrollHookOn = 0
		Return 0
	End
	
	Method AC_HandleWheel:Int(x1, y1, x2, y2)
		If zmou = 0 Then Return 0
		If acOn = 0 Or focussheet = Null Or focussheet.focusbox <> Self Or acItems.Length = 0 Then Return 0
		
		Local rows:Int = 6
		Local rowH:Int = ykscale
		If rowH < 16 Then rowH = 16
		Local total:Int = acItems.Length
		Local maxLen:Int = 0
		Local lim:Int = total
		If lim > 200 Then lim = 200
		For Local i:Int = 0 To lim - 1
			Local s:String = acItems[i]
			If s.Length > maxLen Then maxLen = s.Length
		Next
		Local barW:Int = 14
		Local pad:Int = 6
		Local w:Int = pad * 2 + maxLen * xkscale + barW
		If w < 140 Then w = 140
		If w > 420 Then w = 420
		Local h:Int = rows * rowH + pad * 2
		Local px:Int = xcaret
		Local py:Int = ycaret + rowH
		Local right:Int = x1 + x2 - 22
		Local bottom:Int = y1 + y2 - 60
		If px + w > right Then px = right - w
		If px < x1 + doc.ww2 + 8 Then px = x1 + doc.ww2 + 8
		If py + h > bottom Then py = ycaret - h
		If py < y1 + 24 Then py = y1 + 24
		If Not IsOnRect(px, py, w, h) Then Return 0
		If total <= rows Then Return 1
		Local maxScroll:Int = total - rows
		acScroll -= zmou
		If acScroll < 0 Then acScroll = 0
		If acScroll > maxScroll Then acScroll = maxScroll
		If acSel < acScroll Then acSel = acScroll
		If acSel >= acScroll + rows Then acSel = acScroll + rows - 1
		If acSel >= total Then acSel = total - 1
		If acSel < 0 Then acSel = 0
		Return 1
	End
	
	Method AC_Draw(canv:Canvas, x1, y1, x2, y2)
		If acOn = 0 Then Return
		If focussheet = Null Or focussheet.focusbox <> Self Then Return
		If acItems.Length = 0 Then Return
		
		Local rows:Int = 6
		Local rowH:Int = ykscale
		If rowH < 16 Then rowH = 16
		
		Local total:Int = acItems.Length
		If acSel < 0 Then acSel = 0
		If acSel >= total Then acSel = total - 1
		
		If acScroll < 0 Then acScroll = 0
		If acScroll > total - 1 Then acScroll = total - 1
		
		If acSel < acScroll Then acScroll = acSel
		If acSel >= acScroll + rows Then acScroll = acSel - rows + 1
		If acScroll < 0 Then acScroll = 0
		If total > rows Then
			If acScroll > total - rows Then acScroll = total - rows
		Else
			acScroll = 0
		EndIf
		
		Local maxLen:Int = 0
		Local lim:Int = total
		If lim > 200 Then lim = 200
		For Local i:Int = 0 To lim - 1
			Local s:String = acItems[i]
			If s.Length > maxLen Then maxLen = s.Length
		Next
		
		Local barW:Int = 14
		Local pad:Int = 6
		Local w:Int = pad * 2 + maxLen * xkscale + barW
		If w < 140 Then w = 140
		If w > 420 Then w = 420
		
		Local h:Int = rows * rowH + pad * 2
		
		Local px:Int = xcaret
		Local py:Int = ycaret + rowH
		
		Local right:Int = x1 + x2 - 22
		Local bottom:Int = y1 + y2 - 60
		
		If px + w > right Then px = right - w
		If px < x1 + doc.ww2 + 8 Then px = x1 + doc.ww2 + 8
		
		If py + h > bottom Then py = ycaret - h
		If py < y1 + 24 Then py = y1 + 24
		
		canv.SetScissor 0, 0, DeviceWidth, DeviceHeight
		
		MySetColor canv, IdeUiGetR(IDEUI_WIN_INNER_BG), IdeUiGetG(IDEUI_WIN_INNER_BG), IdeUiGetB(IDEUI_WIN_INNER_BG)
		canv.DrawRect(px, py, w, h)
		
		MySetColor canv, IdeUiGetR(IDEUI_SEL_TEXT), IdeUiGetG(IDEUI_SEL_TEXT), IdeUiGetB(IDEUI_SEL_TEXT)
		canv.DrawRect(px, py, w, 1)
		canv.DrawRect(px, py + h - 1, w, 1)
		canv.DrawRect(px, py, 1, h)
		canv.DrawRect(px + w - 1, py, 1, h)
		
		For Local r:Int = 0 To rows - 1
			Local idx:Int = acScroll + r
			If idx >= total Then Exit
			
			Local yy:Int = py + pad + r * rowH
			If idx = acSel Then
				MySetColor canv, IdeUiGetR(IDEUI_SEL_TEXT), IdeUiGetG(IDEUI_SEL_TEXT), IdeUiGetB(IDEUI_SEL_TEXT)
				canv.DrawRect(px + 1, yy, w - barW - 2, rowH)
			EndIf
			
			Local s:String = acItems[idx]
			If idx = acSel Then
				MySetColor canv, IdeUiGetR(IDEUI_WIN_INNER_BG), IdeUiGetG(IDEUI_WIN_INNER_BG), IdeUiGetB(IDEUI_WIN_INNER_BG)
			Else
				MySetColor canv, 170, 195, 235
			EndIf
			DrawString(canv, xfont1, s, px + pad, yy, -1, 0, 1)
		Next
		
		If total > rows Then
			Local bx:Int = px + w - barW
			Local by:Int = py + 1
			Local bh:Int = h - 2
			
			MySetColor canv, 60, 60, 60
			canv.DrawRect(bx, by, barW - 1, bh)
			
			Local thumbH:Int = bh * rows / total
			If thumbH < 12 Then thumbH = 12
			If thumbH > bh Then thumbH = bh
			
			Local maxScroll:Int = total - rows
			Local thumbY:Int = by
			If maxScroll > 0 Then
				thumbY = by + (bh - thumbH) * acScroll / maxScroll
			EndIf
			
			MySetColor canv, IdeUiGetR(IDEUI_SEL_TEXT), IdeUiGetG(IDEUI_SEL_TEXT), IdeUiGetB(IDEUI_SEL_TEXT)
			canv.DrawRect(bx + 2, thumbY, barW - 5, thumbH)
		EndIf
	End
	
	' ============================================================================
	'  DOC INLINE (F1)
	' ----------------------------------------------------------------------------
	'  Pannello vicino al caret con nome, scope e descrizione presi dall'indice
	'  della documentazione Cerberus. Stessa collocazione e stessa logica di
	'  posizionamento del tip parametri (CT_Draw), da cui e' modellato.
	'
	'  Il testo viene spezzato a capo UNA VOLTA e memorizzato in docTipLines: il
	'  calcolo della larghezza di una stringa non e' gratis e questo pannello
	'  viene ridisegnato a ogni frame finche' resta aperto.
	' ============================================================================

	Method DOC_Close()
		docTipOn = 0
		docTipName = ""
		docTipText = ""
		docTipScope = ""
		docTipLines = docTipLines.Resize(0)
		docTipLaySig = ""
	End

	' 1 se il pannello e' gia' aperto sulla stessa parola: e' quello che
	' distingue la prima F1 (mostra inline) dalla seconda (apre il browser).
	Method DOC_IsShowing:Int(nm:String)
		If docTipOn = 0 Then Return 0
		If nm = "" Then Return 0
		If docTipName.ToUpper() = nm.ToUpper() Then Return 1
		Return 0
	End

	Method DOC_Show(nm:String, scope:String, txt:String)
		docTipOn = 1
		docTipName = nm
		docTipScope = scope
		docTipText = txt
		docTipLaySig = ""
	End

	' Spezza txt in righe che stanno dentro maxW pixel, tagliando sugli spazi.
	Method DOC_WrapText:String[](txt:String, fnt:blFont, maxW:Int)
		Local out:String[8]
		Local n:Int = 0

		If txt = "" Then Return out.Resize(0)

		Local words:String[] = txt.Split(" ")
		Local cur:String = ""

		For Local i:Int = 0 To words.Length - 1
			Local w:String = words[i]
			If w = "" Then Continue

			Local test:String = w
			If cur <> "" Then test = cur + " " + w

			If fnt.GetTextWidth(test, 0, 1) <= maxW Or cur = "" Then
				cur = test
			Else
				If n = out.Length Then out = out.Resize(out.Length * 2)
				out[n] = cur
				n += 1
				cur = w
			EndIf
		Next

		If cur <> "" Then
			If n = out.Length Then out = out.Resize(out.Length + 1)
			out[n] = cur
			n += 1
		EndIf

		Return out.Resize(n)
	End

	Method DOC_Draw(canv:Canvas, x1, y1, x2, y2)
		If docTipOn = 0 Then Return
		If focussheet = Null Or focussheet.focusbox <> Self Then Return
		If docTipName = "" Then Return

		Local fpi:blFont = fontpi
		If fpi = Null Then fpi = xfont1

		Local rowH:Int = ykscale
		If rowH < 16 Then rowH = 16
		Local pad:Int = 6

		Local leftBound:Int = x1 + doc.ww2 + 8
		Local right:Int = x1 + x2 - 22
		Local bottom:Int = y1 + y2 - 60

		Local maxW:Int = right - leftBound - 4
		If maxW > 620 Then maxW = 620
		If maxW < 240 Then maxW = 240

		Local titleTxt:String = docTipName
		If docTipScope <> "" Then titleTxt = titleTxt + "   " + docTipScope

		' ricalcola l'a-capo solo se serve
		Local dlim:String = String.FromChar(31)
		Local laySig:String = docTipText + dlim + maxW + dlim + rowH + dlim + idelang
		If laySig <> docTipLaySig Then
			docTipLines = DOC_WrapText(docTipText, fpi, maxW - pad * 2)
			docTipLaySig = laySig
		EndIf

		' larghezza effettiva: la riga piu' lunga fra titolo e corpo
		' La riga in fondo va MISURATA come le altre: prima non entrava nel calcolo
		' e con un contenuto corto il riquadro restava piu' stretto di lei, tagliando
		' via la parte finale ("ESC = chiudi").
		Local hintTxt:String = LANG_T("docs.hint")

		Local wInner:Int = Int(fpi.GetTextWidth(titleTxt, 0, 1) + 0.999)
		Local wHint:Int = Int(fpi.GetTextWidth(hintTxt, 0, 1) + 0.999)
		If wHint > wInner Then wInner = wHint
		For Local i:Int = 0 To docTipLines.Length - 1
			Local wl:Int = Int(fpi.GetTextWidth(docTipLines[i], 0, 1) + 0.999)
			If wl > wInner Then wInner = wl
		Next

		Local w:Int = wInner + pad * 2 + 4
		If w < 240 Then w = 240
		If w > maxW Then w = maxW

		Local nRows:Int = docTipLines.Length + 1     ' titolo + corpo
		Local hintRow:Int = 1                        ' riga "F1 = pagina completa"
		Local h:Int = rowH * (nRows + hintRow) + pad * 2 + 4

		Local px:Int = xcaret
		Local py:Int = ycaret + rowH + 2

		If px + w > right Then px = right - w
		If px < leftBound Then px = leftBound
		If py + h > bottom Then py = ycaret - h - 2
		If py < y1 + 24 Then py = y1 + 24

		canv.SetScissor 0, 0, DeviceWidth, DeviceHeight

		MySetColor canv, IdeUiGetR(IDEUI_WIN_INNER_BG), IdeUiGetG(IDEUI_WIN_INNER_BG), IdeUiGetB(IDEUI_WIN_INNER_BG)
		canv.DrawRect(px, py, w, h)

		' bordo ambra, per distinguerlo a colpo d'occhio dal tip parametri (teal)
		Local bR:Int = 214
		Local bG:Int = 170
		Local bB:Int = 70
		MySetColor canv, bR, bG, bB
		canv.DrawRect(px, py, w, 1)
		canv.DrawRect(px, py + h - 1, w, 1)
		canv.DrawRect(px, py, 1, h)
		canv.DrawRect(px + w - 1, py, 1, h)

		Local siW:Int = w - 2
		Local siH:Int = h - 2
		If siW < 1 Then siW = 1
		If siH < 1 Then siH = 1
		canv.SetScissor(px + 1, py + 1, siW, siH)

		Local tx:Int = px + pad
		Local ty:Int = py + pad

		MySetColor canv, bR, bG, bB
		DrawString(canv, fpi, titleTxt, tx, ty, -1, 0, 1)
		ty += rowH

		MySetColor canv, 235, 235, 235
		For Local i:Int = 0 To docTipLines.Length - 1
			DrawString(canv, fpi, docTipLines[i], tx, ty, -1, 0, 1)
			ty += rowH
		Next

		MySetColor canv, 140, 140, 140
		DrawString(canv, fpi, hintTxt, tx, ty, -1, 0, 1)

		canv.SetScissor 0, 0, DeviceWidth, DeviceHeight
	End

	Method CT_Draw(canv:Canvas, x1, y1, x2, y2)
		If ctOn = 0 Then Return
		If focussheet = Null Or focussheet.focusbox <> Self Then Return
		If ctName = "" Then Return
		
		Local fpi:blFont = fontpi
		If fpi = Null Then fpi = xfont1
		
		' Teal parameter tip (un po' piÃ¹ chiaro del vecchio 0,153,128)
		Local tipR:Int = 52
		Local tipG:Int = 188
		Local tipB:Int = 162
		
		Local prefix:String = ctName + "("
		Local suffix:String = ")"
		Local fullTxt:String = prefix + ctParams + suffix
		
		Local rowH:Int = ykscale
		If rowH < 16 Then rowH = 16
		Local pad:Int = 6
		
		Local infoLine:String = ""
		Local hasOl:Int = 0
		If ctOverloads.Length > 1 Then
			hasOl = 1
			infoLine = "(" + (ctOverloadIdx + 1) + " of " + ctOverloads.Length + ")  Up/Down = overload"
		EndIf
		
		Local leftBound:Int = x1 + doc.ww2 + 8
		Local right:Int = x1 + x2 - 22
		Local bottom:Int = y1 + y2 - 60
		Local maxTipW:Int = right - leftBound - 4
		If maxTipW < 220 Then maxTipW = 220
		
		Local dlim:String = String.FromChar(31)
		Local laySig:String = fullTxt + dlim + infoLine + dlim + rowH
		Local wSig:Int
		Local wInfo:Int
		If laySig = ctDrawLaySig And ctDrawInnerSigW > 0 Then
			wSig = ctDrawInnerSigW
			wInfo = ctDrawInnerInfoW
		Else
			Local twFull:Float = fpi.GetTextWidth(fullTxt, 0, 1)
			Local twInfoF:Float = 0.0
			If infoLine <> "" Then twInfoF = fpi.GetTextWidth(infoLine, 0, 1)
			wSig = Int(twFull + 0.999) + 12
			wInfo = 0
			If infoLine <> "" Then wInfo = Int(twInfoF + 0.999) + 12
			ctDrawLaySig = laySig
			ctDrawInnerSigW = wSig
			ctDrawInnerInfoW = wInfo
		EndIf
		
		Local wNeed:Int = pad * 2
		If wSig > wInfo Then wNeed += wSig Else wNeed += wInfo
		If wNeed < 180 Then wNeed = 180
		Local w:Int = wNeed
		If w > maxTipW Then w = maxTipW
		
		Local olGap:Int = 2
		Local h:Int = rowH + pad * 2
		If hasOl Then h += rowH + olGap
		
		Local px:Int = xcaret
		Local py:Int = ycaret + rowH + 2
		
		If px + w > right Then px = right - w
		If px < leftBound Then px = leftBound
		If py + h > bottom Then py = ycaret - h - 2
		If py < y1 + 24 Then py = y1 + 24
		
		canv.SetScissor 0, 0, DeviceWidth, DeviceHeight
		
		MySetColor canv, IdeUiGetR(IDEUI_WIN_INNER_BG), IdeUiGetG(IDEUI_WIN_INNER_BG), IdeUiGetB(IDEUI_WIN_INNER_BG)
		canv.DrawRect(px, py, w, h)
		
		MySetColor canv, tipR, tipG, tipB
		canv.DrawRect(px, py, w, 1)
		canv.DrawRect(px, py + h - 1, w, 1)
		canv.DrawRect(px, py, 1, h)
		canv.DrawRect(px + w - 1, py, 1, h)
		
		Local siW:Int = w - 2
		Local siH:Int = h - 2
		If siW < 1 Then siW = 1
		If siH < 1 Then siH = 1
		canv.SetScissor(px + 1, py + 1, siW, siH)
		
		Local argRange:Int[] = CT_FindArgRange(ctParams, ctArgIndex)
		Local hiS:Int = -1
		Local hiE:Int = -1
		If argRange.Length >= 2 Then
			hiS = argRange[0]
			hiE = argRange[1]
		EndIf
		
		Local tx:Int = px + pad
		Local tySig:Int = py + pad
		If hasOl Then
			DrawString(canv, fpi, infoLine, tx, tySig, -1, 0, 1)
			tySig += rowH + olGap
		EndIf
		
		' CT_FindArgRange: hiE = fine esclusiva (stile slice Cerberus: [hiS..hiE) = fino al carattere prima di hiE).
		Local yyF:Float = Float(tySig)
		If hiS >= 0 And hiE > hiS And hiE <= ctParams.Length Then
			Local hiParam:String = ctParams[hiS .. hiE]
			Local beforeHi:String = prefix
			' Stesso slice a fine esclusiva: [0..hiS) = tutto prima dell'argomento bianco (include la virgola a hiS-1).
			If hiS > 0 Then beforeHi = prefix + ctParams[0 .. hiS]
			Local afterHi:String = suffix
			If hiE < ctParams.Length Then afterHi = ctParams[hiE ..] + suffix
			
			Local x2:Float = Float(tx)
			MySetColor canv, tipR, tipG, tipB
			If beforeHi <> "" Then fpi.DrawText(canv, beforeHi, x2, yyF, -1, 0, 1)
			x2 = x2 + fpi.GetTextWidth(beforeHi, 0, 1)
			If idetheme = 2 Then
				MySetColor canv, 0, 110, 95
			Else
				MySetColor canv, 255, 255, 255
			EndIf
			fpi.DrawText(canv, hiParam, x2, yyF, -1, 0, 1)
			x2 = x2 + fpi.GetTextWidth(hiParam, 0, 1)
			MySetColor canv, tipR, tipG, tipB
			If afterHi <> "" Then fpi.DrawText(canv, afterHi, x2, yyF, -1, 0, 1)
		Else
			MySetColor canv, tipR, tipG, tipB
			DrawString(canv, fpi, fullTxt, tx, tySig, -1, 0, 1)
		EndIf
		
		canv.SetScissor 0, 0, DeviceWidth, DeviceHeight
	End
	

	Method CancSelected()
	

		If idstartsel = idendsel Then Return

		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel '- 1

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel '- 1
		EndIf

		Local l:Int = idsel2 - idsel1 - 1
		Local lc:Int = doc.Crs.Length - 1
		Local l2:Int = lc - l
		Local l3:Int = lc - idsel2

		'ReDim Preserve Crs(lc + l + stepcrs)

		For Local i:Int = 0 To l3

			doc.Crs[idsel1 + i] = doc.Crs[idsel2 + i]

		Next

		For Local i:Int = l2 To lc '- 1

			doc.Crs[i] = 0

		Next

		idcaret = idsel1
		idstartsel = idsel1
		idendsel = idsel1

		MakeLines()
		'Highlightingall()
            			
		'CaretOutOfScreen()

		NotifyDocEdited
		MarkScopeDirty
		
		
	End Method
	
	
	Method GetCursorX()
		
	
		'If line > idlines - 1 Then line = idlines - 1
	
		
		For Local l2 = 0 To doc.idlines - 1

			Local xp = 0
		
			Local idl1:Int = doc.idline[l2]
			Local idl2:Int = doc.idline[l2 + 1]
			
			For Local l1 = idl1 To idl2 - 1
			
				If idcaret = l1 Then Return xp

				xp = xp + 1
			Next
			
		Next
		
		Return 0
	
	
	End Method
	
	' Versione O(log lines) di GetCursorX: trova la riga del caret con binary search
	' e ritorna la colonna come (idcaret - start_riga). Senza side effects.
	Method GetCursorX2:Int()
		If doc = Null Then Return 0
		If doc.idlines < 2 Then Return 0
		
		Local pos:Int = idcaret
		Local ln:Int = 0
		Local lo:Int = 0
		Local hi:Int = doc.idlines - 2
		Local found:Int = 0
		
		While lo <= hi
			Local mid:Int = (lo + hi) / 2
			Local s:Int = doc.idline[mid]
			Local e:Int = doc.idline[mid + 1]
			
			If pos < s Then
				hi = mid - 1
			ElseIf pos >= e Then
				lo = mid + 1
			Else
				ln = mid
				found = 1
				Exit
			EndIf
		Wend
		
		If found = 0 Then
			If lo > 0 Or pos >= doc.idline[doc.idlines - 1] Then
				ln = lo
				If ln > doc.idlines - 2 Then ln = doc.idlines - 2
			EndIf
			If ln < 0 Then ln = 0
		EndIf
		
		Return pos - doc.idline[ln]
	End
	
	Method GetCursorLine()
		linecaret = 0
		If doc = Null Then Return
		If doc.idlines < 2 Then Return
		
		Local pos:Int = idcaret
		Local lo:Int = 0
		Local hi:Int = doc.idlines - 2
		Local found:Int = 0
		
		While lo <= hi
			Local mid:Int = (lo + hi) / 2
			Local s:Int = doc.idline[mid]
			Local e:Int = doc.idline[mid + 1]
			
			If pos < s Then
				hi = mid - 1
			ElseIf pos >= e Then
				lo = mid + 1
			Else
				linecaret = mid
				found = 1
				Exit
			EndIf
		Wend
		
		If found = 0 Then
			If lo > 0 Or pos >= doc.idline[doc.idlines - 1] Then
				linecaret = lo
				If linecaret > doc.idlines - 2 Then linecaret = doc.idlines - 2
			EndIf
			If linecaret < 0 Then linecaret = 0
		EndIf
		
		If linecaret <> histVisitLastLn Then
			histVisitLastLn = linecaret
			HL_TrackVisitHistory()
		EndIf
	End
	
	Method IDE_FileIsLarge:Int()
		If doc = Null Then Return 0
		If doc.numtotallines > 8000 Then Return 1
		Return 0
	End
	
	Method HL_RequestViewportHighlight(resetBounds:Int = 0)
		If doc.textlocked Then Return
		If typewin = 3 Then Return
		hlNeedViewport = 1
		If resetBounds Then
			hlIdleId1 = -1
			hlIdleId2 = -1
			hlSweeping = 0
			' Force HL_SpreadStep to re-anchor on next frame so the new viewport is recolored.
			hlSpreadAnchorLn = -1
		EndIf
	End
	
	Method HL_VisibleLineStart:Int()
		Local id1:Int = line
		If id1 < 0 Then id1 = 0
		Return id1
	End
	
	Method HL_VisibleLineEnd:Int()
		Local vis:Int = numlineinpage
		If vis < 1 Then vis = 48
		
		Local id2:Int = line + vis + 3
		If lastDrawnLine > id2 Then id2 = lastDrawnLine
		
		Local maxLn:Int = doc.numtotallines - 2
		If maxLn < 0 Then maxLn = 0
		If id2 > maxLn Then id2 = maxLn
		If doc.idlines >= 2 And id2 > doc.idlines - 2 Then id2 = doc.idlines - 2
		
		Return id2
	End
	
	Method HL_LineHasBookmark:Int(ln:Int)
		Return HL_HistoryBookmarkName(ln) <> ""
	End
	
	Method HL_HistoryBookmarkName:String(ln:Int)
		If doc = Null Or ln < 0 Or ln >= doc.numtotallines Then Return ""
		
		Local l1:Int = doc.idline[ln]
		Local l2:Int = doc.idline[ln + 1]
		Local labelchr:Int[512]
		Local idlabelsx:Int = 0
		Local virg:Int = 0
		Local k:Int = 0
		
		For Local j:Int = l1 To l2 - 3
			Local c:Int = doc.Crs[j] & 255
			
			If k = 1 Then
				labelchr[idlabelsx] = c
				idlabelsx += 1
			Else
				If c = 34 And k = 0 Then virg = 1 - virg
				
				If virg = 0 And c = 39 Then
					Local pn:Int = ParseNOTE(j + 1)
					If pn Then
						k = 1
						If pn = 2 Then j = j + 4
					EndIf
				EndIf
			EndIf
		Next
		
		If k = 1 And idlabelsx > 0 Then
			Local lb2chr:Int[idlabelsx]
			For Local j:Int = 1 To idlabelsx - 1
				lb2chr[j - 1] = labelchr[j]
			Next
			Return String.FromChars(lb2chr).Trim
		EndIf
		
		Return ""
	End
	
	Method HL_LineQualifiesForHistory:Int(ln:Int)
		If doc = Null Or ln < 0 Or ln >= doc.numtotallines Then Return 0
		
		Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
		Local fi:Int = FirstCodeTokenIndex(toks)
		If fi < toks.Length Then
			Local t0:String = toks[fi].ToUpper()
			If t0 = "CLASS" Or t0 = "INTERFACE" Or t0 = "FUNCTION" Or t0 = "METHOD" Then Return 1
		EndIf
		
		If HL_LineHasBookmark(ln) Then Return 1
		Return 0
	End
	
	Method HL_HistoryKindLabel:String(kwUp:String)
		Select kwUp
			Case "CLASS" Return "Class"
			Case "INTERFACE" Return "Interface"
			Case "FUNCTION" Return "Function"
			Case "METHOD" Return "Method"
		End
		Return kwUp
	End
	
	Method HL_HistoryEntryLabel:String(ln:Int)
		Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
		Local fi:Int = FirstCodeTokenIndex(toks)
		If fi < toks.Length Then
			Local t0:String = toks[fi].ToUpper()
			If t0 = "CLASS" Or t0 = "INTERFACE" Or t0 = "FUNCTION" Or t0 = "METHOD" Then
				Local kind:String = HL_HistoryKindLabel(t0)
				If fi + 1 < toks.Length Then
					Local nm:String = toks[fi + 1]
					If HL_IsIdentToken(nm) Then Return kind + " " + nm
				EndIf
				Return kind
			EndIf
		EndIf
		
		Local bm:String = HL_HistoryBookmarkName(ln)
		If bm <> "" Then Return "Bookmark " + bm
		
		Return "Line " + (ln + 1)
	End
	
	Method HL_TrackVisitHistory()
		If doc = Null Then Return
		' Il dialetto 1 non ha il pannello History: senza questa uscita lo
		' creerebbe al primo spostamento del cursore.
		If blHLBasicVariant = 1 Then Return

		Local ln:Int = linecaret
		If ln < 0 Then Return
		If HL_LineQualifiesForHistory(ln) = 0 Then Return
		If histCount > 0 And histLines[0] = ln Then Return
		
		Local n:Int = 0
		For Local i:Int = 0 To histCount - 1
			If histLines[i] <> ln Then
				If n <> i Then
					histLines[n] = histLines[i]
					histLabels[n] = histLabels[i]
				EndIf
				n += 1
			EndIf
		Next
		histCount = n
		If histCount >= 20 Then histCount = 19
		
		For Local i:Int = histCount To 1 Step -1
			histLines[i] = histLines[i - 1]
			histLabels[i] = histLabels[i - 1]
		Next
		
		histLines[0] = ln
		histLabels[0] = HL_HistoryEntryLabel(ln)
		If histCount < 20 Then histCount += 1
		
		EnsureHistoryShortcutLast()
		RefreshHistoryShortcutList()
	End
	
	Method EnsureHistoryShortcutLast()
		If history = Null Then
			history = shortcutm.AddShortcut("History", $d0b0ff)
			history.sclist.cform = New ColorFormat
			history.sclist.cform.AddChrCol(64, $ffd080)
		Else
			shortcutm.allshortcuts.Remove(history)
			shortcutm.allshortcuts.AddLast(history)
		EndIf
	End
	
	Method RefreshHistoryShortcutList()
		If history = Null Then Return
		
		history.sclist.ClearList
		Local pNorm:String = HL_NormalizePath(doc.fullname)
		
		For Local i:Int = 0 To histCount - 1
			Local ln:Int = histLines[i]
			Local lbl:String = histLabels[i]
			history.sclist.AddShortcut(lbl, ln, pNorm)
		Next
	End
	
	
	Method AddText(tx:String, col = 0)
			
		'doc.Text = doc.Text + tx + invio
			
				
		If not (RightString(tx, 2) = invio) Then tx = tx + invio
		
		
		Local lt = tx.Length
		'Local ld = doc.Crs.Length
		Local c2 = col Shl 8
		'If ld + lt >= gth Then
	
		'Local tt:String
		'For Local i = 0 To lt - 1
		'	tt = tt + tx[i] + ","
		'Next
		'Print tt
		
		'End If
		Local l:Int = doc.Crs.Length
		
		'********
		For Local i:Int = l - 1 To 0 Step - 1
			
			If doc.Crs[i] = 0 Then
				
				l = l - 1
			
			Else
			  
				i = -1
			
			EndIf
		
		Next
		
		'l = l + 1
		'l = l - 1
		If l < 0 Then l = 0
		
		doc.Crs = doc.Crs.Resize(l + lt + 256)
		
		For Local i = 0 To lt - 1
			
			Local c = tx[i] | c2
		
			If (c & 255) = 13 or (c & 255) = 10 Then c = c & 255
			
			doc.Crs[l + i] = c
			
		Next
				
		'doc.Crs[l + lt] = 13
		'doc.Crs[l + lt + 1] = 10
		
		MakeLines2
				
		idcaret = l + lt
		GetCursorLine
		
		
		'********
		Local hh = VSBar.hb1 / (Float(ykscale))
						
		VSBar.maxv = doc.idlines - hh - 3
			
		line = doc.idlines - hh - 3
				
		If line < 0 Then line = 0
		
		VSBar.value = line
				
		VSBar.SetOBARFromValue()
		
		
		HSBar.value = xoffdraw
		HSBar.SetOBARFromValue
		
		
	End
	
	'note: HIGHLIGHT
	
	Method StartHighlightingscreenFull()
		hlIdleId1 = -1
		hlIdleId2 = -1
		hlIdleSymVer = -1
		hlSweeping = 1
		hlNeedViewport = 1
		hlSweepPos = line
		If hlSweepPos < 0 Then hlSweepPos = 0
		hlSweepCrsLen = doc.Crs.Length
		hlSweepUr = doc.idurstates
	End
	
	Method HL_RefreshVisibleLinesNow()
		If doc = Null Or doc.textlocked Or typewin = 3 Then Return
		If doc.idlines < 2 Then Return
		Local id1:Int = HL_VisibleLineStart()
		Local id2:Int = HL_VisibleLineEnd()
		If id2 < id1 Then Return
		hlNeedViewport = 1
		hlIdleId1 = -1
		hlIdleId2 = -1
		hlSpreadAnchorLn = -1
		line2 = -1
		For Local i:Int = id1 To id2
			Highlightingline(i)
		Next
	End
	
	Method HL_RefreshVisibleLinesSameFileNow()
		HL_RefreshVisibleLinesNow()
		Local samePath:String = HL_NormalizePath(doc.fullname)
		If samePath = "" Then Return
		For Local o1:= EachIn blSheet.allsheets
			For Local proj:= EachIn o1.childsboxes
				' i riquadri di disegno non hanno un documento di testo
				If proj.doc = Null Then Continue
				If proj <> Self And HL_NormalizePath(proj.doc.fullname) = samePath Then
					blTextbox(proj).HL_RefreshVisibleLinesNow()
				EndIf
			Next
		Next
	End
	
	Method HighlightinglineCaret()
		If doc.textlocked Then Return
		If typewin = 3 Then Return
		
		GetCursorLine
		
		Local ln:Int = linecaret
		If ln < 0 Then Return
		If doc.idlines < 2 Then Return
		If ln > doc.idlines - 2 Then ln = doc.idlines - 2
		
		HL_PatchLocalsOnEdit(ln)
		
		Local idl1:Int = doc.idline[ln]
		Local endi:Int = doc.idline[ln + 1] - 1
		While endi >= idl1
			Local c1:Int = doc.Crs[endi] & 255
			If c1 <> 10 And c1 <> 13 Then Exit
			endi -= 1
		Wend
		
		hlLastEditMs = Millisecs()
		
		' Niente hlFastBasicWordMode: in quella modalita' SetColorWordBasic salta
		' il riconoscimento delle keyword e assegna 0 a TUTTE le parole, quindi
		' sulla riga in scrittura sbiancavano anche If/Then/For.
		' Con hlPreserveSemanticWords il pass lessicale aggiorna keyword, stringhe
		' e numeri e lascia intatti i colori semantici gia' calcolati: non serve
		' piu' ricalcolarli, che era la parte cara.
		Local oldPres:Int = hlPreserveSemanticWords
		hlPreserveSemanticWords = 1
		HighlightinglineBasic(ln)
		hlPreserveSemanticWords = oldPres

		' Il pass base riscrive i colori della riga SENZA quelli di scope, quindi
		' a ogni tasto il verde dei local (e il colore dei field) spariva dalla
		' riga che si sta scrivendo, per tornare solo alla passata successiva sul
		' viewport, cioe' dopo la pausa post-modifica. Qui li riapplichiamo
		' subito, ma su QUESTA SOLA riga: e' una frazione del costo di una
		' passata intera e non rimette in gioco il lag di digitazione.

		' Solo la riga appena scritta va ridipinta dalla passata completa:
		' le altre restano valide, ed e' questo che evita di ricolorare
		' l'intera pagina a ogni battuta.
		HL_InvalidateLineColor(ln)

		hlNeedViewport = 1
	End
	
	Method HighlightVisibleLinesNow(immediate:Int = 1)
		HL_RequestViewportHighlight(1)
		If immediate Then
			Local oldForce:Int = hlForceViewport
			hlForceViewport = 1
			Highlightingscreen(1)
			hlForceViewport = oldForce
		EndIf
	End
	
	' Caret-centered spread highlight: anchors at the caret line, and on each frame
	' colors one line above and one below, until both ends step past the visible viewport.
	' Resets the anchor whenever the caret moves to a different line or the line structure
	' changes (Crs.Length / numtotallines). Per-keystroke typing keeps the anchor on the
	' same line, so the spread keeps making progress outward without re-doing work.
	Method HL_SpreadResetNow()
		If doc = Null Then Return
		If doc.idlines < 2 Then Return
		
		GetCursorLine
		Local ln:Int = linecaret
		If ln < 0 Then ln = 0
		If ln > doc.idlines - 2 Then ln = doc.idlines - 2
		
		hlSpreadAnchorLn = ln
		hlSpreadAbove = ln - 1
		hlSpreadBelow = ln + 1
		hlSpreadLines = doc.numtotallines
		
		If doc.numtotallines > 0 And ln >= 0 And ln < doc.numtotallines Then
			Highlightingline(ln)
		EndIf
	End
	
	' DIAGNOSTICA TEMPORANEA (CTRL+F10).
	' Scrive su hl_debug.txt tutto cio' che decide il colore di un identificatore
	' sulla riga del caret: la routine che lo contiene, se la cache di scope e'
	' valida, il contenuto delle DUE mappe di local usate dalla colorazione, e i
	' segmenti che il parser esterno ha restituito per quella riga.
	' DIAGNOSTICA TEMPORANEA: perche' il tip non mostra gli overload.
	' Scrive ac_debug.txt accanto all'eseguibile.
	' DIAGNOSTICA TEMPORANEA: perche' il tip non mostra gli overload.
	' Scrive ac_debug.txt accanto all'eseguibile, SALVANDO A OGNI PASSO: se una
	' chiamata solleva un errore, nel file resta comunque fin dove e' arrivata.
	Method ACDBG_Save(txt:String)
		os.SaveString(txt, os.ExtractDir(os.AppPath()) + "/ac_debug.txt")
	End

	Method ACDBG_DumpTip()
		' Stesse guardie di HLDBG_DumpCaretLine: senza, il metodo gira anche
		' sulle textbox senza documento (la console) e si interrompe prima di
		' scrivere il file.
		If focussheet = Null Then Return
		If focussheet.focusbox <> Self Then Return
		If doc = Null Then Return

		Local out:String = "PASSO 1: stato del tip" + invio
		out = out + "ctOn            = " + ctOn + invio
		out = out + "ctName          = |" + ctName + "|" + invio
		out = out + "ctOverloads     = " + ctOverloads.Length + "   idx=" + ctOverloadIdx + invio
		out = out + "ctCtxOwner      = |" + ctCtxOwner + "|" + invio
		out = out + "ctCtxIdent      = |" + ctCtxIdent + "|" + invio
		out = out + "acOwnerTypeUp   = |" + acOwnerTypeUp + "|" + invio
		out = out + "acAfterDot      = " + acAfterDot + "   acOn=" + acOn + invio
		out = out + "parserCycleId   = " + IDE_GetParserCycleId() + invio
		For Local i:Int = 0 To ctOverloads.Length - 1
			out = out + "   firma " + i + ": " + ctOverloads[i] + invio
		Next
		out = out + invio
		ACDBG_Save(out)

		Local ownerUp:String = ctCtxOwner
		If ownerUp = "" Then ownerUp = acOwnerTypeUp
		Local identUp:String = ctCtxIdent
		If identUp = "" And ctName <> "" Then identUp = ctName.ToUpper()

		out = out + "PASSO 2: owner=|" + ownerUp + "|  ident=|" + identUp + "|" + invio
		ACDBG_Save(out)
		If ownerUp = "" Then
			out = out + "   tipo non risolto: mi fermo qui." + invio
			ACDBG_Save(out)
			Return
		EndIf

		Local shortUp:String = AC_TypeIdNormUp(ownerUp)
		Local info:String = AC_FindTypeDeclInfo(ownerUp)
		out = out + "PASSO 3: AC_FindTypeDeclInfo = |" + info + "|" + invio
		Local extRaw:String = ""
		If info <> "" Then
			Local parts:= info.Split("|")
			If parts.Length >= 3 Then extRaw = parts[2]
		EndIf
		out = out + "   extends dal decl = |" + extRaw + "|" + invio
		ACDBG_Save(out)

		AC_RebuildTypeBaseCacheIfNeeded
		out = out + "   acTypeBaseUp     = |" + acTypeBaseUp.Get(shortUp) + "|" + invio
		out = out + "   dopo il ripiego  = |" + AC_TypeBaseFallbackUp(shortUp, extRaw) + "|" + invio + invio
		ACDBG_Save(out)

		If identUp = "" Then
			out = out + "   nessun identificatore: mi fermo qui." + invio
			ACDBG_Save(out)
			Return
		EndIf

		Local v1:= New StringMap<Int>
		Local sd:String[] = AC_CollectMemberDeclLinesInTypeSource(ownerUp, identUp, v1)
		out = out + "PASSO 4: AC_CollectMemberDeclLinesInTypeSource = " + sd.Length + invio
		For Local i2:Int = 0 To sd.Length - 1
			out = out + "   " + sd[i2] + invio
		Next
		out = out + invio
		ACDBG_Save(out)

		Local dc:String[] = CT_CollectDeclsForCall(ownerUp, identUp, linecaret)
		out = out + "PASSO 5: CT_CollectDeclsForCall = " + dc.Length + invio
		For Local i3:Int = 0 To dc.Length - 1
			out = out + "   " + dc[i3] + invio
		Next
		ACDBG_Save(out)
	End

	Method HLDBG_DumpCaretLine()

		' Solo la textbox col fuoco: altrimenti ogni textbox aggiornata riscrive il
		' file e l'ultima (di solito la console vuota) cancella quella buona.
		If focussheet = Null Then Return
		If focussheet.focusbox <> Self Then Return
		If doc = Null Then Return
		If typewin = 3 Then Return

		GetCursorLine
		Local idl:Int = linecaret
		If idl < 0 Then Return

		Local out:String = ""
		out = out + "riga 1-based = " + (idl + 1) + invio
		out = out + "testo        = |" + GetLineTextByIndex(idl) + "|" + invio + invio

		' Parola sotto il caret: estratta SUBITO perche' serve gia' al filtro dei
		' simboli del parser qui sotto (prima era una lista di nomi fissa).
		Local saveA0:Int = idstartsel
		Local saveB0:Int = idendsel
		SelectWord(idcaret)
		idstartsel = idselect1
		idendsel = idselect2
		Local wordSel:String = TextSelected
		idstartsel = saveA0
		idendsel = saveB0
		Local wUp:String = wordSel.ToUpper()

		' Primo carattere della parola: NON si usa idselect1, che puo' cadere sullo
		' spazio precedente e far leggere colore 0 per ogni passata (mi ha quasi
		' fatto incolpare la colorazione quando invece era gia' corretta).
		' Si risale dal caret finche' i caratteri sono di identificatore.
		Local wStart:Int = idcaret
		While wStart > 0
			Local cw:Int = doc.Crs[wStart - 1] & 255
			If IsALetter(cw) Or cw = 95 Or (cw >= 48 And cw <= 57) Then
				wStart -= 1
			Else
				Exit
			EndIf
		Wend

		Local enc:Int[] = FindNearestRoutineStart(idl)
		out = out + "routineStart = " + (enc[0] + 1) + "   inMethod = " + enc[1] + invio

		Local sc:Int = 0
		If ScopeCacheIsCurrent() Then sc = 1
		out = out + "ScopeCacheIsCurrent = " + sc + "   scopeDirty = " + scopeDirty + "   scopeRebuildOn = " + scopeRebuildOn + invio

		Local scopeId:Int = -1
		If idl < scopeMethodAtLine.Length Then scopeId = scopeMethodAtLine[idl]
		out = out + "scopeMethodAtLine[riga] = " + scopeId + "   scopeInfoCount = " + scopeInfoCount + invio

		If scopeId >= 0 And scopeId < scopeInfoCount Then
			out = out + "scope righe = " + (scopeInfos[scopeId].startLine + 1) + " -> " + (scopeInfos[scopeId].endLine + 1) + invio
			out = out + invio + "--- locals da scopeInfos (usati dall'autocomplete) ---" + invio
			If scopeInfos[scopeId].locals <> Null Then
				For Local it:= Eachin scopeInfos[scopeId].locals
					out = out + "   [" + String(it.Key) + "]" + invio
				Next
			Else
				out = out + "   (mappa NULL)" + invio
			EndIf
		EndIf

		out = out + invio + "--- locals da hlLocalsMap (usati dalla colorazione) ---" + invio
		Local hlm:StringMap<Int> = HL_EnsureLocalsForHighlight(enc[0], idl, enc[1])
		If hlm <> Null Then
			For Local it2:= Eachin hlm
				out = out + "   [" + String(it2.Key) + "]" + invio
			Next
		Else
			out = out + "   (mappa NULL)" + invio
		EndIf

		out = out + invio + "hlParserSegsStale = " + hlParserSegsStale + invio
		out = out + "segmenti dal parser = |" + HL_GetLine(doc.fullname, idl + 1) + "|" + invio

		' --- il parser ha simboli per QUESTO file? ---
		out = out + invio + "--- simboli del parser per questo file ---" + invio
		Local fdCur:SymbolFileData = SYM_GetFile(doc.fullname)
		If fdCur = Null Then fdCur = SYM_GetFile(HL_NormalizePath(doc.fullname))
		If fdCur = Null Then
			out = out + "   NESSUN dato: il parser non ha simboli per questo file" + invio
		Else
			out = out + "   dichiarazioni = " + fdCur.count + invio
			Local shown:Int = 0
			For Local i:Int = 0 To fdCur.count - 1
				Local nmUp:String = fdCur.names[i].ToUpper()
				If wUp <> "" And nmUp.Contains(wUp) Then
					out = out + "   [" + fdCur.decls[i] + "] nome=" + fdCur.names[i] + " riga=" + (fdCur.lines[i] + 1) + invio
					shown += 1
				EndIf
			Next
			If shown = 0 Then out = out + "   NESSUNA dichiarazione che contenga " + wordSel + invio
			out = out + "   ultime 5 dichiarazioni emesse:" + invio
			Local from5:Int = fdCur.count - 5
			If from5 < 0 Then from5 = 0
			For Local i:Int = from5 To fdCur.count - 1
				out = out + "      [" + fdCur.decls[i] + "] " + fdCur.names[i] + " riga=" + (fdCur.lines[i] + 1) + invio
			Next
		EndIf

		' --- i campi della classe che contiene la riga ---
		out = out + invio + "--- campi di classe (colore 7) ---" + invio
		Local cidDbg:Int = -1
		If idl >= 0 And idl < scopeClassAtLine.Length Then cidDbg = scopeClassAtLine[idl]
		out = out + "   scopeClassAtLine[riga] = " + cidDbg + "   scopeClassCount = " + scopeClassCount + invio
		If cidDbg >= 0 And cidDbg < scopeClassCount Then
			Local flDbg:StringMap<Int> = scopeClasses[cidDbg].fields
			out = out + "   classe righe = " + (scopeClasses[cidDbg].startLine + 1) + " -> " + (scopeClasses[cidDbg].endLine + 1) + invio
			If flDbg = Null Then
				out = out + "   (mappa fields NULL)" + invio
			Else
				Local hasF:Int = 0
				If flDbg.Contains(wUp) Then hasF = 1
				Local nF:Int = 0
				For Local itf:= Eachin flDbg
					nF += 1
				Next
				out = out + "   campi totali = " + nF + "   contiene " + wordSel + " = " + hasF + invio
			EndIf
		Else
			out = out + "   riga NON assegnata a nessuna classe" + invio
		EndIf

		EnsureHLCallableNameCache()

		Local inFn:Int = 0
		If hlFunctionNames.Contains(wUp) Then inFn = 1
		Local inMt:Int = 0
		If hlMethodNames.Contains(wUp) Then inMt = 1
		Local inCx:Int = 0
		If acCxCallableNames.Contains(wUp) Then inCx = 1
		Local inCxM:Int = 0
		If acCxMethodNames.Contains(wUp) Then inCxM = 1

		out = out + invio + "--- parola sotto il caret: " + wordSel + " ---" + invio
		out = out + "   hlFunctionNames   = " + inFn + invio
		out = out + "   hlMethodNames     = " + inMt + invio
		out = out + "   acCxCallableNames = " + inCx + "   (Function del doc)" + invio
		out = out + "   acCxMethodNames   = " + inCxM + "   (Method del doc)" + invio
		out = out + "   colore calcolato  = " + HL_CallableColorCtx(GetLineTextByIndex(idl), 0, idl, wUp) + invio

		Local shouldScoped:Int = HL_ShouldApplyScopedColors(idl)
		out = out + invio + "HL_ShouldApplyScopedColors = " + shouldScoped + invio
		out = out + "colore attuale sul primo carattere della parola = " + ((doc.Crs[idcaret] & 65280) Shr 8) + invio

		' --- QUALE PASSATA PERDE IL COLORE ---------------------------------
		' HighlightinglineBasic2 applica i segmenti del parser e poi lancia sette
		' passate Apply*. Se il parser dice 8 e sullo schermo si vede 0, una di
		' quelle sette lo sta sovrascrivendo: qui si rifa' la sequenza a mano
		' leggendo il colore della parola dopo ogni passo.
		If wStart >= 0 And idl + 1 < doc.idline.Length Then

			Local d1:Int = doc.idline[idl]
			Local d2:Int = doc.idline[idl + 1] - 1
			Local de:Int = d2
			While de >= d1
				Local cz:Int = doc.Crs[de] & 255
				If cz <> 10 And cz <> 13 Then Exit
				de -= 1
			Wend

			out = out + invio + "--- colore di " + wordSel + " dopo ogni passata ---" + invio

			hlLineTxtCacheLn = idl
			hlLineTxtCache = GetLineTextByIndex(idl)

			HighlightinglineBasic(idl)
			out = out + "   HighlightinglineBasic        = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			Local sgs:String = HL_GetLine(doc.fullname, idl + 1)
			If sgs <> "" And hlParserSegsStale = 0 Then
				Local prt:= sgs.Split(";")
				Local ps:Int = d1
				For Local i:Int = 0 To prt.Length - 1
					If ps > de Then Exit
					If prt[i] = "" Then Continue
					Local p2b:= prt[i].Split(",")
					If p2b.Length < 2 Then Continue
					Local cc:Int = Int(p2b[0])
					Local nn:Int = Int(p2b[1])
					For Local j:Int = 0 To nn - 1
						If ps > de Then Exit
						doc.Crs[ps] = (doc.Crs[ps] & 255) | cc * 256
						ps += 1
					Next
				Next
				out = out + "   segmenti del parser          = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio
			Else
				out = out + "   segmenti del parser          = NON APPLICATI (segs vuoti o stale)" + invio
			EndIf

			If HL_LineIsDeclFieldGlobalLocal(HL_LineText(idl)) = 0 Then
				If HL_ShouldApplyScopedColors(idl) Then ApplyScopedVariableColorsOnLine(idl, d1, de)
			EndIf
			out = out + "   ApplyScopedVariableColors    = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			ApplyKnownCallableColorsOnLine(idl, d1, de)
			out = out + "   ApplyKnownCallableColors     = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			ApplyImportedGlobalColorsOnLine(idl, d1, de)
			out = out + "   ApplyImportedGlobalColors    = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			ApplyImportedCallableColorsOnLine(idl, d1, de)
			out = out + "   ApplyImportedCallableColors  = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			ApplyFieldGlobalColorOnLine(idl, d1, de)
			out = out + "   ApplyFieldGlobalColor        = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			ApplyClassNameColorsOnLine(idl, d1, de)
			out = out + "   ApplyClassNameColors         = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			ApplyStaticClassFunctionFieldColorFix(idl, d1, de)
			out = out + "   ApplyStaticClassFunctionFix  = " + ((doc.Crs[wStart] & 65280) Shr 8) + invio

			hlLineTxtCacheLn = -1

		EndIf

		os.SaveString(out, HLDBG_Path())

	End

	Method HLDBG_Path:String()
		Return os.ExtractDir(os.AppPath()) + "/hl_debug.txt"
	End

	' Invalida tutte le righe: per cambiamenti che possono spostare i colori
	' ovunque (struttura del documento, simboli, indice di scope ripubblicato).
	Method HL_InvalidateAllLineColors()
		hlColorVer += 1
		If hlColorVer > 1000000000 Then
			hlColorVer = 1
			hlLineVer = hlLineVer.Resize(0)
		EndIf
	End

	Method HL_InvalidateLineColor(ln:Int)
		If ln < 0 Then Return
		If ln < hlLineVer.Length Then hlLineVer[ln] = 0
	End

	Method HL_SpreadStep()
		If doc = Null Then Return
		If doc.textlocked Then Return
		If typewin = 3 Then Return
		If doc.idlines < 2 Then Return
		If doc.numtotallines <= 0 Then Return
		
		GetCursorLine
		
		Local need:Int = 0
		If hlSpreadAnchorLn < 0 Then need = 1
		If hlSpreadAnchorLn <> linecaret Then need = 1
		If hlSpreadLines <> doc.numtotallines Then need = 1
		If need Then HL_SpreadResetNow()
		
		Local id1:Int = HL_VisibleLineStart()
		Local id2:Int = HL_VisibleLineEnd()
		
		Local spreadSteps:Int = 1
		If focussheet = Null Or focussheet.focusbox <> Self Then spreadSteps = 2
		
		For Local k:Int = 0 To spreadSteps - 1
			' One/two lines above per frame (if still inside the visible viewport).
			If hlSpreadAbove >= id1 And hlSpreadAbove >= 0 And hlSpreadAbove < doc.numtotallines Then
				Highlightingline(hlSpreadAbove)
				hlSpreadAbove -= 1
			EndIf
			
			' One/two lines below per frame (if still inside the visible viewport).
			If hlSpreadBelow <= id2 And hlSpreadBelow >= 0 And hlSpreadBelow < doc.numtotallines Then
				Highlightingline(hlSpreadBelow)
				hlSpreadBelow += 1
			EndIf
		Next
	End
			
	Method Highlightingscreen(forceAll:Int = 0)
		
	
		If doc.textlocked Then Return
		
		If typewin = 3 Then Return
		
		Local hlPause:Int = 350
		If focussheet = Null Or focussheet.focusbox <> Self Then hlPause = 0
		If doc.numtotallines > 8000 And hlPause > 0 Then hlPause = 450
		If forceAll = 0 And hlForceViewport = 0 And hlPause > 0 And Millisecs() - hlLastEditMs < hlPause Then Return
		
		Local vis:Int = numlineinpage
		If vis < 1 Then vis = 48
		
		Local id1:Int = HL_VisibleLineStart()
		Local id2:Int = HL_VisibleLineEnd()
		
		If id2 < id1 Then Return
		
		hlNeedViewport = 0
		
		' Guardia: se la pagina e' identica all'ultima passata completata non c'e'
		' niente da rifare.
		'
		' Qui c'era anche "IDE_GetParserCycleId() = classShortcutsVersionSeen", ma
		' classShortcutsVersionSeen non viene MAI assegnato al ciclo corrente
		' (e' solo dichiarato, azzerato e letto), quindi la condizione era di
		' fatto sempre falsa e la guardia non entrava mai in funzione: la pagina
		' veniva ricolorata a ogni frame. Finche' Highlightingscreen era chiamata
		' solo su PageUp/PageDown non si notava; chiamandola a ogni frame diventa
		' centinaia di ms per frame.
		' In piu' era il criterio sbagliato: i colori non dipendono dalla
		' freschezza degli shortcut di classe, che servono al pannello laterale.
		Local idleSkip:Int = 0
		If hlSweeping = 0 And scopeRebuildOn = 0
			If SYM_GetGlobalVersion() = hlIdleSymVer
				If doc.Crs.Length = hlSweepCrsLen And doc.idurstates = hlSweepUr
					If doc.Crs.Length = scopeCacheLen And doc.numtotallines = scopeCacheLines And scopeCacheLen >= 0
						If id1 = hlIdleId1 And id2 = hlIdleId2 And hlIdleId1 >= 0
							idleSkip = 1
						EndIf
					EndIf
				EndIf
			EndIf
		EndIf
		If idleSkip Then Return
		
		If ScopeWorkPaused() = 0 And scopeDirty = 0 Then EnsureScopeVarCache(0)
		
		Local needReset:Int = 0
		If doc.Crs.Length <> hlSweepCrsLen Then needReset = 1
		If doc.idurstates <> hlSweepUr Then needReset = 1
		If hlIdleId1 < 0 Then needReset = 1
		If hlSweeping = 0 And (id1 <> hlIdleId1 Or id2 <> hlIdleId2) Then needReset = 1
		If hlSweepPos < id1 Or hlSweepPos > id2 + 1 Then needReset = 1
		If hlIdleSymVer >= 0 And SYM_GetGlobalVersion() <> hlIdleSymVer Then needReset = 1
		
		If needReset Then
			hlSweepPos = id1
			hlSweeping = 1
			hlSweepCrsLen = doc.Crs.Length
			hlSweepUr = doc.idurstates
		EndIf
		
		Local lim:Int = id2
		Local remain:Int = id2 - hlSweepPos + 1
		If remain < 1 Then remain = 1
		
		' Tutta la pagina visibile viene colorata in un solo frame.
		' Prima i file grandi venivano spalmati in blocchi da 18-36 righe per
		' frame, cioe' 2-3 frame per riempire lo schermo: si vedeva il colore
		' "arrivare" dopo lo scroll. Ora il limite e' l'intero viewport.
		' Il costo per riga e' molto piu' basso da quando HL_LineText evita le
		' 9 riletture del testo della stessa riga.
		' hlSpreadBurstMax = 0 -> nessun limite (tutta la pagina).
		If forceAll = 0 And hlSpreadBurstMax > 0 Then
			Local burst:Int = hlSweepPos + hlSpreadBurstMax - 1
			If burst < lim Then lim = burst
		EndIf
		
		If hlLineVer.Length <> doc.numtotallines Then
			hlLineVer = hlLineVer.Resize(doc.numtotallines)
		EndIf

		Local painted:Int = 0
		For Local i:Int = hlSweepPos To lim
			If i >= 0 And i < hlLineVer.Length And hlLineVer[i] = hlColorVer Then Continue
			Highlightingline(i)
			painted += 1
			If i >= 0 And i < hlLineVer.Length Then hlLineVer[i] = hlColorVer
		Next
		
		hlSweepPos = lim + 1
		If hlSweepPos > id2 Then
			hlSweeping = 0
			hlIdleId1 = id1
			hlIdleId2 = id2
			hlSweepCrsLen = doc.Crs.Length
			hlSweepUr = doc.idurstates
			hlIdleSymVer = SYM_GetGlobalVersion()
		EndIf
	
		
	End Method
	
	Method GetOrCreateClassShortcut:blShortcut(classUp:String, classDisp:String)
		If classUp = "" Then Return Null
		
		Local sc:blShortcut = classShortcutsByUp.Get(classUp)
		If sc Then Return sc
		
		If classDisp = "" Then classDisp = classUp
		
		sc = shortcutm.AddShortcut(classDisp, $f0c070)
		sc.sclist.cform = New ColorFormat
		sc.sclist.cform.AddChrCol(40, $e080e0)
		sc.sclist.cform.AddChrCol(58, $20d0ff)
		sc.sclist.cform.AddChrCol(44, $20d0ff)
		
		classShortcutsByUp.Set(classUp, sc)
		classShortcuts = classShortcuts.Resize(classShortcutsCount + 1)
		classShortcuts[classShortcutsCount] = sc
		classShortcutsCount += 1
		
		EnsureHistoryShortcutLast()
		
		Return sc
	End
	
	Method ClearClassShortcuts()
		If classShortcutsCount > 0 Then
			For Local i:Int = 0 To classShortcutsCount - 1
				Local sc:blShortcut = classShortcuts[i]
				If sc Then shortcutm.allshortcuts.Remove(sc)
			Next
		EndIf
		
		classShortcuts = classShortcuts.Resize(0)
		classShortcutsCount = 0
		classShortcutsByUp = New StringMap<blShortcut>
	End
	
	Method AddDeclToClassShortcut(fileNorm:String, ln:Int, nm:String, ds:String)
		If nm = "" Or ds = "" Then Return
		
		Local dsTrim:= ds.Trim
		If dsTrim = "" Then Return
		
		'Use normalized decl kind (skips modifiers like Public/Final/Abstract).
		Local kwUp:String = SYM_DeclKindUp(dsTrim)
		If kwUp = "" Then Return
		
		Local dot:Int = nm.FindLast(".")
		Local owner:String = ""
		Local member:String = nm
		If dot > 0 Then
			owner = nm[..dot]
			member = nm[dot + 1 ..]
		EndIf
		
		If kwUp = "CLASS" Or kwUp = "INTERFACE" Then
			Local classDisp:String = nm
			Local ddisp:Int = classDisp.FindLast(".")
			If ddisp >= 0 And ddisp + 1 < classDisp.Length Then classDisp = classDisp[ddisp + 1 ..]
			classDisp = classDisp.Trim
			If classDisp = "" Then classDisp = nm
			Local classUp:String = nm.ToUpper()
			GetOrCreateClassShortcut(classUp, classDisp)
			Return
		EndIf
		
		If owner = "" Then Return
		
		Local ownerUp:String = owner.ToUpper()
		Local ownerDisp:String = owner
		Local dodisp:Int = ownerDisp.FindLast(".")
		If dodisp >= 0 And dodisp + 1 < ownerDisp.Length Then ownerDisp = ownerDisp[dodisp + 1 ..]
		ownerDisp = ownerDisp.Trim
		If ownerDisp = "" Then ownerDisp = owner
		Local sc:blShortcut = GetOrCreateClassShortcut(ownerUp, ownerDisp)
		If sc = Null Then Return
		
		Local label:String = ""
		If kwUp = "METHOD" Or kwUp = "FUNCTION" Or kwUp = "FIELD" Or kwUp = "GLOBAL" Or kwUp = "LOCAL" Or kwUp = "PROPERTY" Then
			label = kwUp[..1] + kwUp[1..].ToLower()
		Else
			Return
		EndIf
		
		sc.sclist.AddShortcut(label + " " + member + "@" + dsTrim, ln, fileNorm)
	End
	
	Method AddClassMemberShortcut:Void(sc:blShortcut, kwUp:String, member:String, ln:Int, fileNorm:String)
		If sc = Null Or member = "" Then Return
		
		Local label:String = ""
		If kwUp = "METHOD" Or kwUp = "FUNCTION" Or kwUp = "FIELD" Or kwUp = "GLOBAL" Or kwUp = "LOCAL" Or kwUp = "PROPERTY" Then
			label = kwUp[..1] + kwUp[1..].ToLower()
		Else
			Return
		EndIf
		
		sc.sclist.AddShortcut(label + " " + member, ln, fileNorm)
	End
	
	Method RemoveClassShortcut(classUp:String)
		If classUp = "" Then Return
		
		Local sc:blShortcut = classShortcutsByUp.Get(classUp)
		If sc = Null Then Return
		
		shortcutm.allshortcuts.Remove(sc)
		
		Local newMap:= New StringMap<blShortcut>
		Local newArr:blShortcut[] = New blShortcut[classShortcutsCount]
		Local n:Int = 0
		
		For Local i:Int = 0 To classShortcutsCount - 1
			Local s:blShortcut = classShortcuts[i]
			If s = Null Or s = sc Then Continue
			newArr[n] = s
			newMap.Set(s.scname.ToUpper(), s)
			n += 1
		Next
		
		classShortcutsByUp = newMap
		classShortcuts = newArr.Resize(n)
		classShortcutsCount = n
	End
	
	Method RefreshFileClassShortcuts()
		Local foundUp:= New StringMap<Int>
		RefreshFileClassShortcutsFromSource(foundUp)
		
		Local removeUp:String[] = New String[0]
		For Local i:Int = 0 To classShortcutsCount - 1
			Local sc:blShortcut = classShortcuts[i]
			If sc = Null Then Continue
			Local up:String = sc.scname.ToUpper()
			If Not foundUp.Contains(up) Then
				removeUp = removeUp.Resize(removeUp.Length + 1)
				removeUp[removeUp.Length - 1] = up
			EndIf
		Next
		
		For Local i:Int = 0 To removeUp.Length - 1
			RemoveClassShortcut(removeUp[i])
		Next
	End
	
	Method HL_ShortcutRecomputeClassUp:String(stackKind:String[], stackName:String[], top:Int)
		For Local i:Int = top To 0 Step -1
			If SCAN_IsClassKind(stackKind[i]) Then
				Return stackName[i]
			EndIf
		Next
		Return ""
	End
	
	Method RefreshFileClassShortcutsFromSource(foundUp:StringMap<Int>)
		Local pNorm:String = HL_NormalizePath(doc.fullname)
		Local clearedUp:= New StringMap<Int>
		
		Local stackKind:String[64]
		Local stackName:String[64]
		Local top:Int = -1
		Local curClassUp:String = ""
		Local externMode:Int = 0

		For Local ln:Int = 0 To doc.numtotallines - 1
			Local lineTxt:String = GetLineTextByIndex(ln)
			Local toks:= TokenizeCodeLine(lineTxt)
			Local fi:Int = FirstCodeTokenIndex(toks)
			externMode = SCAN_TrackExternSection(toks, stackKind, top, externMode)
			If fi >= toks.Length Then Continue

			Local t0:String = toks[fi].ToUpper()
			Local t1:String = ""
			If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()

			' Endif/Wend/Next chiudono il proprio blocco anche se sopra ne sono
			' rimasti aperti altri: si toglie quello, non la cima della pila.
			If t0 = "ENDIF" Then
				top = AC_ScanPopKindNamed(stackKind, stackName, top, "IF")
				Continue
			EndIf

			If t0 = "WEND" Or t0 = "NEXT" Then
				top = AC_ScanPopKindNamed(stackKind, stackName, top, "LOOP")
				Continue
			EndIf

			If t0 = "CLASS" Or t0 = "INTERFACE" Then
				If fi + 1 < toks.Length Then
					Local nm:String = toks[fi + 1]
					If HL_IsIdentToken(nm) And Not HL_IsKeywordCXS(nm) Then
						curClassUp = nm.ToUpper()
						Local sc:blShortcut = GetOrCreateClassShortcut(curClassUp, nm)
						If sc And Not clearedUp.Contains(curClassUp) Then
							sc.sclist.ClearList()
							clearedUp.Set(curClassUp, 1)
						EndIf
						foundUp.Set(curClassUp, 1)
					EndIf
				EndIf
				Local opnC:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
				If opnC <> "" Then
					top += 1
					If top > 63 Then top = 63
					stackKind[top] = opnC
					stackName[top] = curClassUp
				EndIf
				Continue
			EndIf

			If t0 = "METHOD" Or t0 = "FUNCTION" Then
				If curClassUp <> "" Then
					Local sc:blShortcut = classShortcutsByUp.Get(curClassUp)
					If sc = Null Then sc = GetOrCreateClassShortcut(curClassUp, curClassUp)
					If sc Then AddDeclNamesFromTokensShortcut(sc, toks, fi, t0, ln, pNorm)
				EndIf
				' Una dichiarazione Extern/Abstract, o una routine che si chiude
				' sulla propria riga, non apre nessun blocco.
				Local opnM:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
				If opnM <> "" Then
					top += 1
					If top > 63 Then top = 63
					stackKind[top] = opnM
					stackName[top] = ""
				EndIf
				Continue
			EndIf
			
			If t0 = "FIELD" Or t0 = "GLOBAL" Or t0 = "PROPERTY" Or t0 = "LOCAL" Then
				If curClassUp <> "" Then
					Local sc:blShortcut = classShortcutsByUp.Get(curClassUp)
					If sc = Null Then sc = GetOrCreateClassShortcut(curClassUp, curClassUp)
					If sc Then AddDeclNamesFromTokensShortcut(sc, toks, fi, t0, ln, pNorm)
				EndIf
				Continue
			EndIf
			
			If t0 = "END" Then
				Local want:String = SCAN_EndWantKind(t1)

				If want <> "" Then
					While top >= 0
						Local popped:String = stackKind[top]
						top -= 1
						If popped = want Or (want = "CLASS" And popped = "CLASSX") Then Exit
					Wend
				ElseIf top >= 0 Then
					top -= 1
				EndIf

				curClassUp = HL_ShortcutRecomputeClassUp(stackKind, stackName, top)
				Continue
			EndIf

			' Select/Try/If a blocco/While/For: chiusi da End, vanno sulla pila.
			Local opn:String = SCAN_OpenKind(lineTxt, toks, fi, stackKind, top, externMode)
			If opn <> "" Then
				top += 1
				If top > 63 Then top = 63
				stackKind[top] = opn
				stackName[top] = ""
				Continue
			EndIf
		Next
	End
	
	Method AddDeclNamesFromTokensShortcut(sc:blShortcut, toks:String[], kwIdx:Int, kwUp:String, ln:Int, fileNorm:String)
		If sc = Null Then Return
		
		Local expectName:Int = 1
		For Local j:Int = kwIdx + 1 To toks.Length - 1
			Local tk:String = toks[j]
			If tk = "," Then
				expectName = 1
				Continue
			EndIf
			If tk = ":" Or tk = "=" Then Exit
			
			If expectName And HL_IsIdentToken(tk) And Not HL_IsKeywordCXS(tk) Then
				AddClassMemberShortcut(sc, kwUp, tk, ln, fileNorm)
				expectName = 0
			EndIf
		Next
	End
	
	Method Highlightingline(idl:Int)
	
		If idl > doc.idlines - 1 Then Return

		If idl < 0 Then Return


		Select doc.language

			Case 0
				' Due dialetti BASIC: 2 e' quello di CerbIDE, 1 quello di MSXCompiler.
				If blHLBasicVariant = 1 Then
					HighlightinglineBasic(idl)
				Else
					HighlightinglineBasic2(idl)
				EndIf

			Case 1
				HighlightinglineAsm(idl)

			' C/C++ e Java: stesso colorer, cambiano le parole chiave e poco altro
			Case 2, 3
				HighlightinglineCLike(idl)

		End
	
	End Method

	' Testo della riga in corso di colorazione.
	' Colorare una riga richiede 9 letture del suo testo (HighlightinglineBasic2
	' piu' i vari Apply*ColorsOnLine): senza cache sono 9 scansioni di Crs e 9
	' String allocate per ogni riga, moltiplicate per tutte le righe a video.
	' La cache vale SOLO per la durata di HighlightinglineBasic2, quindi non puo'
	' mai diventare stantia: viene armata all'inizio e disarmata alla fine.
	' Nota: Highlightingline* modifica il byte alto di Crs (il colore), ma
	' GetLineTextByIndex maschera con &255, quindi il testo non cambia.
	Method HL_LineText:String(idl:Int)
		If idl = hlLineTxtCacheLn Then Return hlLineTxtCache
		Return GetLineTextByIndex(idl)
	End

	Method HighlightinglineBasic2(idl:Int)

		hlLineTxtCacheLn = idl
		hlLineTxtCache = GetLineTextByIndex(idl)

		Local segs:String = HL_GetLine(doc.fullname, idl + 1)

		Local idl1:Int = doc.idline[idl]
		Local idl2:Int = doc.idline[idl + 1] - 1
		
		Local endi:Int = idl2
		
		While endi >= idl1
			Local c1:Int = doc.Crs[endi] & 255
			If c1 <> 10 And c1 <> 13 Then Exit
			endi -= 1
		Wend
		
		HighlightinglineBasic(idl)
		
		If segs <> "" And hlParserSegsStale = 0 Then
			Local parts:= segs.Split(";")
			Local pos:Int = idl1
			
			For Local i:Int = 0 To parts.Length - 1
				If pos > endi Then Exit
				
				Local part:= parts[i]
				If part = "" Then Continue
				
				Local p2:= part.Split(",")
				If p2.Length < 2 Then Continue
				
				Local col:Int = Int(p2[0]) '~ 3
				Local ln:Int = Int(p2[1])
				
				For Local j:Int = 0 To ln - 1
					If pos > endi Then Exit
					
					Local c1:Int = doc.Crs[pos] & 255
					doc.Crs[pos] = c1 | col * 256
					pos += 1
				Next
			Next
		EndIf
		
		If HL_LineIsDeclFieldGlobalLocal(HL_LineText(idl)) = 0 Then
			If HL_ShouldApplyScopedColors(idl) Then
				ApplyScopedVariableColorsOnLine(idl, idl1, endi)
			EndIf
		EndIf
		ApplyKnownCallableColorsOnLine(idl, idl1, endi)
		ApplyImportedGlobalColorsOnLine(idl, idl1, endi)
		ApplyImportedCallableColorsOnLine(idl, idl1, endi)
		ApplyFieldGlobalColorOnLine(idl, idl1, endi)
		ApplyClassNameColorsOnLine(idl, idl1, endi)
		ApplyStaticClassFunctionFieldColorFix(idl, idl1, endi)

		hlLineTxtCacheLn = -1
		hlLineTxtCache = ""

	End Method
	
	Method ApplyStaticClassFunctionFieldColorFix(idl:Int, idl1:Int = -1, endi:Int = -1)
		If idl < 0 Then Return
		If Not AC_InClassStaticFunction(idl) Then Return
		
		If idl1 < 0 Or endi < 0 Then
			If doc.idlines < 2 Then Return
			idl1 = doc.idline[idl]
			endi = doc.idline[idl + 1] - 1
			While endi >= idl1
				Local c1:Int = doc.Crs[endi] & 255
				If c1 <> 10 And c1 <> 13 Then Exit
				endi -= 1
			Wend
		EndIf
		If endi < idl1 Then Return
		
		Local cid:Int = -1
		If idl >= 0 And idl < scopeClassAtLine.Length Then cid = scopeClassAtLine[idl]
		If cid < 0 Or cid >= scopeClassCount Then Return
		
		Local instFields:StringMap<Int> = scopeClasses[cid].fields
		If instFields = Null Then Return
		
		Local lineTxt:= HL_LineText(idl)
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				If HL_IsIdentToken(tok) And Not HL_IsKeywordCXS(tok) Then
					If MapHasKey(instFields, tok) Or MapHasKey(instFields, tok.ToUpper()) Then
						For Local k:Int = s To p - 1
							Local idx:Int = idl1 + k
							If idx <= endi Then
								Local c3:Int = doc.Crs[idx] & 255
								doc.Crs[idx] = c3
							EndIf
						Next
					EndIf
				EndIf
				Continue
			EndIf
			
			p += 1
		Wend
	End Method
	
	Method ApplyImportedGlobalColorsOnLine(idl:Int, idl1:Int = -1, endi:Int = -1)
		If idl < 0 Then Return
		If HL_LineIsDeclFieldGlobalLocal(HL_LineText(idl)) Then Return
		If idl1 < 0 Or endi < 0 Then
			If doc.idlines < 2 Then Return
			idl1 = doc.idline[idl]
			endi = doc.idline[idl + 1] - 1
			While endi >= idl1
				Local c1:Int = doc.Crs[endi] & 255
				If c1 <> 10 And c1 <> 13 Then Exit
				endi -= 1
			Wend
		EndIf
		If endi < idl1 Then Return
		
		EnsureHLCallableNameCache
		
		Local lineTxt:= HL_LineText(idl)
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				If Not HL_IsKeywordCXS(tok) And MapHasKey(hlGlobalNamesCase, tok) Then
					If HL_TokenIsMemberAfterDot(lineTxt, s) = 0 Then
						For Local k:Int = s To p - 1
							Local idx:Int = idl1 + k
							If idx <= endi Then
								Local c3:Int = doc.Crs[idx] & 255
								doc.Crs[idx] = c3 | 5 * 256
							EndIf
						Next
					EndIf
				EndIf
				
				Continue
			EndIf
			
			p += 1
		Wend
	End
	
	Method ApplyImportedCallableColorsOnLine(idl:Int, idl1:Int = -1, endi:Int = -1)
		If idl < 0 Then Return
		If idl1 < 0 Or endi < 0 Then
			If doc.idlines < 2 Then Return
			idl1 = doc.idline[idl]
			endi = doc.idline[idl + 1] - 1
			While endi >= idl1
				Local c1:Int = doc.Crs[endi] & 255
				If c1 <> 10 And c1 <> 13 Then Exit
				endi -= 1
			Wend
		EndIf
		If endi < idl1 Then Return
		
		Local lineTxt:= HL_LineText(idl)
		If HL_LineIsDeclMethodOrFunction(lineTxt) Then Return
		
		EnsureHLCallableNameCache
		
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				Local up:String = tok.ToUpper()
				Local colUse:Int = HL_CallableColorCtx(lineTxt, s, idl, up)
				If colUse > 0 And idl1 + s <= endi Then
					Local prevCol:Int = (doc.Crs[idl1 + s] / 256) & 255
					If prevCol = 6 Or prevCol = 7 Then colUse = 0
				EndIf
				If Not HL_IsKeywordCXS(tok) And colUse > 0 Then
					For Local k:Int = s To p - 1
						Local idx:Int = idl1 + k
						If idx <= endi Then
							Local c3:Int = doc.Crs[idx] & 255
							doc.Crs[idx] = c3 | colUse * 256
						EndIf
					Next
				EndIf
				
				Continue
			EndIf
			
			p += 1
		Wend
	End
	
	' Estrae nomi callable/tipo da UNA SymbolFileData gia' in memoria (nessun I/O).
	' Fattorizzato fuori da EnsureHLCallableNameCache cosi' lo stesso codice puo'
	' essere riusato come fast path in HL_RefreshCallableNamesFromImportFiles
	' (vedi li' per il motivo).
	Method HL_CollectCallableNamesFromSymFd(fd:SymbolFileData)
		If fd = Null Then Return
		
		For Local i:Int = 0 To fd.count - 1
			Local knd:String = SYM_DeclKindUp(fd.decls[i])
			Local nm:String = fd.names[i]
			If nm = "" Then Continue
			Local fullUp:String = nm.ToUpper()
			Local d:Int = nm.FindLast(".")
			If d >= 0 Then nm = nm[d + 1 ..]
			nm = nm.Trim
			If nm = "" Then Continue
			
			If knd = "GLOBAL" Or knd = "CONST" Then
				hlGlobalNamesCase.Set(nm, 1)
			ElseIf knd = "CLASS" Or knd = "INTERFACE" Then
				hlClassNamesUp.Set(nm.ToUpper(), 1)
			ElseIf knd = "FUNCTION" Then
				hlFunctionNames.Set(nm.ToUpper(), 1)
			ElseIf knd = "METHOD" Or knd = "PROPERTY" Then
				hlMethodNames.Set(nm.ToUpper(), 1)
			EndIf
		Next
	End

	Method EnsureHLCallableNameCache()
		' Keyed on parserCycleId (bumped once per COMPLETED parse cycle), not on
		' SYM_GetGlobalVersion() which is bumped once per emitted declaration. The
		' rebuild here is heavy (iterates all module symbols, reads imported module
		' files from disk and re-tokenizes them, and scans the whole document for
		' class names). With the per-decl version it ran on every keystroke while
		' the parser re-scanned the current file â€” the dominant file-size-dependent
		' typing lag (e.g. typing "canv.DrawImage" calls HL_IsClassNameUp each key).
		Local v:Int = IDE_GetParserCycleId()
		If hlCallableCacheVersion = v Then Return

		Local callT0:Int = Millisecs()

		hlCallableCacheVersion = v
		hlFunctionNames = New StringMap<Int>
		hlMethodNames = New StringMap<Int>
		hlGlobalNamesCase = New StringMap<Int>
		hlClassNamesUp = New StringMap<Int>
		
		Local symT0:Int = Millisecs()
		For Local pass:Int = 0 To 1
			Local m:StringMap<SymbolFileData>
			If pass = 0 Then m = symFiles Else m = symFilesFixed
			
			For Local it:=Eachin m
				HL_CollectCallableNamesFromSymFd(SymbolFileData(it.Value))
			Next
		Next
		
		HL_RefreshCallableNamesFromImportFiles
		
		AC_RebuildCXDocTypeCacheIfNeeded
		For Local it:=Eachin acCxCallableNames
			Local nm:String = String(it.Key)
			If nm <> "" Then hlFunctionNames.Set(nm.ToUpper(), 1)
		Next


		For Local it2:=Eachin acCxMethodNames
			Local nm2:String = String(it2.Key)
			If nm2 <> "" Then hlMethodNames.Set(nm2.ToUpper(), 1)
		Next
	End
	
	Method ApplyKnownCallableColorsOnLine(idl:Int, idl1:Int, endi:Int)
		If endi < idl1 Then Return
		If HL_LineIsDeclFieldGlobalLocal(HL_LineText(idl)) Then Return
		
		EnsureHLCallableNameCache
		
		Local lineTxt:= HL_LineText(idl)
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		Local expectDeclName:Int = 0
		Local expectDeclCol:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				Local up:= tok.ToUpper()
				Local q:Int = p
				While q < n And (lineTxt[q] = 32 Or lineTxt[q] = 9)
					q += 1
				Wend
				
				Local colUse:Int = 0
				Local guardScoped:Int = 0
				If up = "FUNCTION" Then
					expectDeclName = 1
					expectDeclCol = 10
				ElseIf up = "METHOD" Or up = "PROPERTY" Then
					expectDeclName = 1
					expectDeclCol = 8
				ElseIf Not HL_IsKeywordCXS(tok) Then
					If expectDeclName Then
						colUse = expectDeclCol
						expectDeclName = 0
						expectDeclCol = 0
					Else
						colUse = HL_CallableColorCtx(lineTxt, s, idl, up)
						guardScoped = 1
					EndIf
				EndIf
				
				If colUse > 0 And guardScoped And idl1 + s <= endi Then
					Local prevCol:Int = (doc.Crs[idl1 + s] / 256) & 255
					If prevCol = 6 Or prevCol = 7 Then colUse = 0
				EndIf
				
				If colUse > 0 Then
					For Local k:Int = s To p - 1
						Local idx:Int = idl1 + k
						If idx <= endi Then
							Local c3:Int = doc.Crs[idx] & 255
							doc.Crs[idx] = c3 | colUse * 256
						EndIf
					Next
				EndIf
				
				Continue
			EndIf
			
			If c <> 32 And c <> 9 And c <> 58 Then expectDeclName = 0
			p += 1
		Wend
	End
	
	Method ApplyFieldGlobalColorOnLine(idl:Int, idl1:Int, endi:Int)
		If idl < 0 Or endi < idl1 Then Return
		
		Local lineTxt:String = HL_LineText(idl)
		If lineTxt = "" Then Return
		
		Local waitCol:Int = 0
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				Local tokUp:= tok.ToUpper()
				
				If waitCol > 0 And HL_IsIdentToken(tok) Then
					For Local k:Int = s To p - 1
						Local idx:Int = idl1 + k
						If idx <= endi Then
							Local c3:Int = doc.Crs[idx] & 255
							doc.Crs[idx] = c3 | waitCol * 256
						EndIf
					Next
				EndIf
				
				If tokUp = "CLASS" Or tokUp = "INTERFACE" Or tokUp = "ENUMERATE" Then
					waitCol = 9
				ElseIf tokUp = "FIELD" Then
					waitCol = 7
				ElseIf tokUp = "GLOBAL" Then
					waitCol = 5
				ElseIf tokUp = "LOCAL" Then
					waitCol = 6
				EndIf
				
				Continue
			EndIf
			
			If waitCol > 0 Then
				If c <> 32 And c <> 9 And c <> 44 Then waitCol = 0
			EndIf
			
			p += 1
		Wend
	End Method
	
	Method ApplyClassNameColorsOnLine(idl:Int, idl1:Int = -1, endi:Int = -1)
		If idl < 0 Then Return
		If idl1 < 0 Or endi < 0 Then
			If doc.idlines < 2 Then Return
			idl1 = doc.idline[idl]
			endi = doc.idline[idl + 1] - 1
			While endi >= idl1
				Local c1:Int = doc.Crs[endi] & 255
				If c1 <> 10 And c1 <> 13 Then Exit
				endi -= 1
			Wend
		EndIf
		If endi < idl1 Then Return
		
		EnsureHLCallableNameCache
		
		Local lineTxt:= HL_LineText(idl)
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		Local waitClassName:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				Local up:= tok.ToUpper()
				Local colUse:Int = 0
				Local guardScoped:Int = 0
				
				If up = "EXTENDS" Or up = "IMPLEMENTS" Then
					colUse = 4
				ElseIf up = "CLASS" Or up = "INTERFACE" Or up = "ENUMERATE" Then
					waitClassName = 1
				ElseIf waitClassName And HL_IsIdentToken(tok) And Not HL_IsKeywordCXS(tok) Then
					colUse = 9
					waitClassName = 0
				ElseIf Not HL_IsKeywordCXS(tok) And HL_IsClassNameUp(up) Then
					If HL_TokenIsMemberAfterDot(lineTxt, s) = 0 Then
						colUse = 9
						guardScoped = 1
					EndIf
				EndIf
				
				If colUse > 0 And guardScoped And idl1 + s <= endi Then
					Local prevCol:Int = (doc.Crs[idl1 + s] / 256) & 255
					If prevCol = 6 Or prevCol = 7 Then colUse = 0
				EndIf
				
				If colUse > 0 Then
					For Local k:Int = s To p - 1
						Local idx:Int = idl1 + k
						If idx <= endi Then
							Local c3:Int = doc.Crs[idx] & 255
							doc.Crs[idx] = c3 | colUse * 256
						EndIf
					Next
				EndIf
				
				Continue
			EndIf
			
			If c <> 32 And c <> 9 And c <> 58 Then waitClassName = 0
			p += 1
		Wend
	End Method
	
	' La cache di scope e' "vecchia ma usabile": il documento e' stato toccato e la
	' ricostruzione non e' ancora finita, ma gli array per-riga esistono e sono
	' ancora allineati al numero di righe, quindi puntano alle routine giuste.
	'
	' Serve perche' senza di essa FindNearestRoutineStart ripiega su una SCANSIONE
	' ALL'INDIETRO fino a riga 0, tokenizzando ogni riga: eseguita per ogni riga
	' della pagina diventa O(N^2). Misurato: ~17 ms per riga, ~800 ms per passata
	' su un file di 4866 righe, cioe' i blocchi di quasi un secondo.
	' --- TRASLAZIONE DELLA CACHE DEGLI SCOPE DOPO UNA MODIFICA ----------------
	'
	' scopeMethodAtLine / scopeFuncAtLine / scopeClassAtLine sono indicizzati per
	' POSIZIONE di riga. Finche' l'unica condizione per usarli era che il numero
	' di righe non fosse cambiato, premere Invio buttava via l'INTERA mappa
	' semantica: ogni Global, Field e Local sullo schermo tornava bianco per tutta
	' la durata del rebuild - su 6.900 righe circa un secondo, e continuando a
	' scrivere non si riprendeva mai. Restava colorato solo cio' che si riconosce
	' lessicalmente (keyword, stringhe, numeri, identificatore seguito da paren-
	' tesi), che e' esattamente il quadro visto su 3dplayers.cxs.
	'
	' Qui la mappa viene invece TRASLATA: le righe sopra il punto di modifica
	' restano dove sono, quelle sotto scorrono di delta. E' esatta ovunque tranne
	' che sulle righe appena create, che ereditano lo scope della riga spezzata;
	' e comunque il rebuild vero la sostituisce entro un attimo.

	Method ScopeShiftPossible:Int()
		If doc = Null Then Return 0
		If scopeInfoCount <= 0 Then Return 0
		If scopeCacheDocPath <> doc.fullname Then Return 0
		If scopeCacheLines <> doc.numtotallines Then Return 0
		If scopeMethodAtLine.Length <> doc.numtotallines Then Return 0
		If scopeFuncAtLine.Length <> doc.numtotallines Then Return 0
		If scopeClassAtLine.Length <> doc.numtotallines Then Return 0
		Return 1
	End

	Method ScopeShiftLine:Int(v:Int, firstLine:Int, delta:Int, maxLine:Int)
		If v < 0 Then Return v
		If v < firstLine Then Return v

		Local r:Int = v + delta

		' Il limite basso e' firstLine-1, non firstLine: firstLine e' la prima riga
		' il cui OFFSET cambia, che sta sempre UNA DOPO la riga davvero modificata
		' (spezzare o fondere una riga non ne sposta l'inizio, sposta quello della
		' successiva). Clampando a firstLine, cancellando un blocco la riga di fine
		' della routine finiva una riga piu' in basso del vero.
		Local low:Int = firstLine - 1
		If low < 0 Then low = 0

		If r < low Then r = low
		If r > maxLine Then r = maxLine
		Return r
	End

	Method ScopeShiftForEdit:Void(oldIdline:Int[], oldLines:Int)

		Local newLines:Int = doc.numtotallines
		If newLines <= 0 Or oldLines <= 0 Then Return

		Local delta:Int = newLines - oldLines
		If delta = 0 Then Return

		' Prima riga il cui offset di partenza e' cambiato. La modifica sta nella
		' riga PRECEDENTE, che e' stata spezzata (Invio) o fusa (Backspace): il
		' suo inizio non si muove, si muove quello della riga dopo.
		Local lim:Int = oldLines
		If newLines < lim Then lim = newLines
		If oldIdline.Length < lim Then lim = oldIdline.Length
		If doc.idline.Length < lim Then lim = doc.idline.Length

		Local firstChanged:Int = 0
		While firstChanged < lim And oldIdline[firstChanged] = doc.idline[firstChanged]
			firstChanged += 1
		Wend

		Local src:Int = firstChanged - 1
		If src < 0 Then src = 0

		Local nm:Int[] = New Int[newLines]
		Local nf:Int[] = New Int[newLines]
		Local nc:Int[] = New Int[newLines]

		For Local i:Int = 0 To newLines - 1

			Local o:Int = 0
			If i < firstChanged Then
				o = i
			ElseIf delta > 0 And i < firstChanged + delta Then
				' Riga nuova di zecca: eredita lo scope di quella che e' stata spezzata.
				o = src
			Else
				o = i - delta
			EndIf

			If o < 0 Then o = 0
			If o > oldLines - 1 Then o = oldLines - 1

			nm[i] = scopeMethodAtLine[o]
			nf[i] = scopeFuncAtLine[o]
			nc[i] = scopeClassAtLine[o]

		Next

		scopeMethodAtLine = nm
		scopeFuncAtLine = nf
		scopeClassAtLine = nc

		Local maxLine:Int = newLines - 1

		For Local i:Int = 0 To scopeInfoCount - 1
			If scopeInfos[i] <> Null Then
				scopeInfos[i].startLine = ScopeShiftLine(scopeInfos[i].startLine, firstChanged, delta, maxLine)
				scopeInfos[i].endLine = ScopeShiftLine(scopeInfos[i].endLine, firstChanged, delta, maxLine)
			EndIf
		Next

		For Local i:Int = 0 To scopeClassCount - 1
			If scopeClasses[i] <> Null Then
				scopeClasses[i].startLine = ScopeShiftLine(scopeClasses[i].startLine, firstChanged, delta, maxLine)
				scopeClasses[i].endLine = ScopeShiftLine(scopeClasses[i].endLine, firstChanged, delta, maxLine)
			EndIf
		Next

		' Si riallinea solo la GEOMETRIA. Il contenuto (quali local sono dichiarati)
		' puo' essere cambiato, percio' scopeCacheLen resta quello vecchio e
		' ScopeCacheIsCurrent continua a rispondere 0: il rebuild vero parte lo
		' stesso e rimpiazza tutto. Nel frattempo pero' i colori non spariscono.
		scopeCacheLines = newLines

	End

	Method ScopeCacheUsableStale:Int()
		If doc = Null Then Return 0
		If scopeInfoCount <= 0 Then Return 0
		If scopeCacheLines <> doc.numtotallines Then Return 0
		If scopeMethodAtLine.Length <> doc.numtotallines Then Return 0
		If scopeFuncAtLine.Length <> doc.numtotallines Then Return 0
		If scopeClassAtLine.Length <> doc.numtotallines Then Return 0
		Return 1
	End

	Method ScopeCacheIsCurrent:Int()
		If scopeRebuildOn <> 0 Then Return 0
		If scopeCacheLines <> doc.numtotallines Then Return 0
		If scopeCacheLen <> doc.Crs.Length Then Return 0
		If scopeMethodAtLine.Length <> doc.numtotallines Then Return 0
		Return 1
	End
	
	' Millisecondi concessi per frame alla ricostruzione dello scope.
	'
	' Era fisso a 1 ms. Su T16 (28.648 righe, ~10 us per riga = ~290 ms di lavoro)
	' significava ~300 frame, cioe' 5 secondi, durante i quali i colori di scope
	' restano fermi alla versione precedente - e se nel frattempo e' cambiato il
	' numero di righe spariscono del tutto. Da qui il "timestamp resta bianco".
	'
	' Ora e' adattivo: mentre si scrive resta 1 ms per non disturbare la
	' digitazione; appena la digitazione si ferma sale, cosi' la ricostruzione
	' finisce in mezzo secondo invece che in cinque. In quei frame l'utente non
	' sta scrivendo, quindi il costo non si percepisce.
	Method ScopeRebuildBudgetMs:Int()
		If Millisecs() - hlLastEditMs < 250 Then Return 1
		Return 8
	End

	' Tetto di righe per passo. Alzato in modo che a comandare sia il budget in
	' millisecondi qui sopra, non questo numero.
	Method ScopeRebuildBatchSize:Int()
		Local n:Int = doc.numtotallines
		If n > 20000 Then Return 4000
		If n > 12000 Then Return 3000
		If n > 5000 Then Return 2000
		Return 1000
	End
	
	' Attesa dopo l'ultima modifica prima di far ripartire la ricostruzione.
	' Serve a non ricominciarla da capo a ogni tasto. Dimezzata: sommata al
	' budget adattivo qui sopra, i colori tornano in circa un secondo invece
	' che in quasi sette. Con il cache "cold" non si aspetta comunque nulla.
	Method ScopeDirtyDebounceMs:Int()
		If doc.numtotallines > 20000 Then Return 900
		If doc.numtotallines > 12000 Then Return 600
		If doc.numtotallines > 5000 Then Return 400
		Return 600
	End
	
	Method ScopeWorkPaused:Int()
		If scopeDirty = 0 And scopeRebuildOn = 0 Then Return 0
		If scopeDirty And scopeRebuildOn = 0 And Millisecs() - scopeDirtyMs < ScopeDirtyDebounceMs() Then Return 1
		Return 0
	End
	
	Method EnsureScopeVarCache(allowStep:Int = 1)
		Local need:Int = 0
		If scopeCacheLen <> doc.Crs.Length Then need = 1
		If scopeCacheLines <> doc.numtotallines Then need = 1
		If scopeDirty Then need = 1
		
		If need = 0 And scopeRebuildOn = 0 Then Return
		
		If allowStep = 0 Then Return
		
		Local cold:Int = 0
		If scopeCacheLen < 0 Or scopeCacheLines < 0 Then cold = 1
		If scopeMethodAtLine.Length = 0 Or scopeFuncAtLine.Length = 0 Or scopeClassAtLine.Length = 0 Then cold = 1
		
		If scopeRebuildOn = 0 Then
			If cold = 0 And scopeDirty And Millisecs() - scopeDirtyMs < ScopeDirtyDebounceMs() Then Return
			StartScopeVarCacheRebuild
			scopeDirty = 0
		EndIf
		
		StepScopeVarCacheRebuild ScopeRebuildBudgetMs(), ScopeRebuildBatchSize()
	End
	
	Method GetCachedLocalsForRoutine:StringMap<Int>(routineStart:Int, idl:Int, inMethod:Int)
		If ScopeCacheIsCurrent() = 0 And ScopeCacheUsableStale() = 0 Then Return Null
		If routineStart < 0 Or idl < 0 Then Return Null
		
		If inMethod Then
			If idl < scopeMethodAtLine.Length Then
				Local mid:Int = scopeMethodAtLine[idl]
				If mid >= 0 And mid < scopeInfoCount Then
					If scopeInfos[mid].startLine = routineStart Then Return scopeInfos[mid].locals
				EndIf
			EndIf
		Else
			If idl < scopeFuncAtLine.Length Then
				Local fid:Int = scopeFuncAtLine[idl]
				If fid >= 0 And fid < scopeInfoCount Then
					If scopeInfos[fid].startLine = routineStart Then Return scopeInfos[fid].locals
				EndIf
			EndIf
		EndIf
		
		Return Null
	End
	
	Method ScopeCopyStringMapInt:StringMap<Int>(src:StringMap<Int>)
		Local out:= New StringMap<Int>
		If src = Null Then Return out
		For Local it:= Eachin src
			out.Set(String(it.Key), Int(it.Value))
		Next
		Return out
	End
	
	Method ScopeRepatchRoutineLocalsFrom(fromLine:Int)
		If fromLine < 0 Then Return
		
		Local enc:= FindNearestRoutineStart(fromLine)
		Local routineStart:Int = enc[0]
		If routineStart < 0 Then Return
		
		Local scopeId:Int = -1
		If enc[1] Then
			If fromLine < scopeRebuildTmpMethodAtLine.Length Then scopeId = scopeRebuildTmpMethodAtLine[fromLine]
		Else
			If fromLine < scopeRebuildTmpFuncAtLine.Length Then scopeId = scopeRebuildTmpFuncAtLine[fromLine]
		EndIf
		If scopeId < 0 Or scopeId >= scopeRebuildTmpInfoCount Then Return
		
		scopeRebuildTmpInfos[scopeId].locals = New StringMap<Int>
		For Local ln:Int = routineStart To scopeRebuildTargetLines - 1
			AddDeclNamesFromLineKeywordCase(scopeRebuildTmpInfos[scopeId].locals, GetLineTextByIndex(ln), "LOCAL")
		Next
	End
	
	Method TryStartScopePartialRebuild:Int(fromLine:Int)
		If fromLine <= 0 Then Return 0
		If scopeMethodAtLine.Length <> doc.numtotallines Then Return 0
		If scopeCacheLen <> doc.Crs.Length Then Return 0
		If scopeRebuildOn <> 0 Then Return 0
		
		Local n:Int = doc.numtotallines
		scopeRebuildTargetLen = doc.Crs.Length
		scopeRebuildTargetLines = n
		scopeRebuildTargetUr = doc.idurstates
		
		scopeRebuildTmpGlobals = ScopeCopyStringMapInt(scopeGlobals)
		scopeRebuildTmpConsts = ScopeCopyStringMapInt(scopeConsts)
		scopeRebuildTmpFields = ScopeCopyStringMapInt(scopeFields)
		scopeRebuildTmpGlobalsCase = ScopeCopyStringMapInt(scopeGlobalsCase)
		scopeRebuildTmpFieldsCase = ScopeCopyStringMapInt(scopeFieldsCase)
		
		scopeRebuildTmpInfoCount = scopeInfoCount
		scopeRebuildTmpInfoCap = scopeInfoCount
		If scopeRebuildTmpInfoCap < 64 Then scopeRebuildTmpInfoCap = 64
		scopeRebuildTmpInfos = scopeRebuildTmpInfos.Resize(scopeRebuildTmpInfoCap)
		For Local i:Int = 0 To scopeInfoCount - 1
			Local sc:VarScopeInfo = scopeInfos[i]
			Local sc2:= New VarScopeInfo
			sc2.startLine = sc.startLine
			sc2.endLine = sc.endLine
			sc2.isMethod = sc.isMethod
			sc2.classId = sc.classId
			sc2.locals = ScopeCopyStringMapInt(sc.locals)
			scopeRebuildTmpInfos[i] = sc2
		Next
		
		scopeRebuildTmpClassCount = scopeClassCount
		scopeRebuildTmpClassCap = scopeClassCount
		If scopeRebuildTmpClassCap < 32 Then scopeRebuildTmpClassCap = 32
		scopeRebuildTmpClasses = scopeRebuildTmpClasses.Resize(scopeRebuildTmpClassCap)
		For Local i:Int = 0 To scopeClassCount - 1
			Local cl:VarClassInfo = scopeClasses[i]
			Local cl2:= New VarClassInfo
			cl2.startLine = cl.startLine
			cl2.endLine = cl.endLine
			cl2.nameUp = cl.nameUp
			cl2.extendsUp = cl.extendsUp
			cl2.fields = ScopeCopyStringMapInt(cl.fields)
			scopeRebuildTmpClasses[i] = cl2
		Next
		
		scopeRebuildTmpMethodAtLine = scopeMethodAtLine.Resize(n)
		scopeRebuildTmpFuncAtLine = scopeFuncAtLine.Resize(n)
		scopeRebuildTmpClassAtLine = scopeClassAtLine.Resize(n)
		For Local i:Int = 0 To n - 1
			scopeRebuildTmpMethodAtLine[i] = scopeMethodAtLine[i]
			scopeRebuildTmpFuncAtLine[i] = scopeFuncAtLine[i]
			scopeRebuildTmpClassAtLine[i] = scopeClassAtLine[i]
		Next
		
		Local prevLn:Int = fromLine - 1
		If prevLn < 0 Then prevLn = 0
		scopeRebuildCurMethod = scopeRebuildTmpMethodAtLine[prevLn]
		scopeRebuildCurFunc = scopeRebuildTmpFuncAtLine[prevLn]
		scopeRebuildCurClass = scopeRebuildTmpClassAtLine[prevLn]
		scopeRebuildBlockDepth = 0
		scopeRebuildRemDepth = 0
		scopeRebuildExtern = 0
		scopeRebuildClassExtern = 0
		
		ScopeRepatchRoutineLocalsFrom(fromLine)
		
		scopeRebuildNextLine = fromLine
		scopeRebuildOn = 1
		Return 1
	End
	
	Method MarkScopeDirty(fromLine:Int = -1)
		scopeDirty = 1
		scopeDirtyMs = Millisecs()
		If fromLine < 0 Then
			GetCursorLine()
			fromLine = linecaret
		EndIf
		If fromLine >= 0 Then
			If scopeDirtyFromLine < 0 Or fromLine < scopeDirtyFromLine Then scopeDirtyFromLine = fromLine
		EndIf
		' NOTE: do NOT invalidate acLocalDeclCacheLine / acClassDeclCachePath here.
		' Those caches are already keyed by (path, caretLn, numtotallines), so they
		' rebuild naturally when the caret moves to a different line or the line
		' structure changes. Invalidating them on every keystroke caused
		' AC_RebuildClassDeclCacheIfNeeded to re-tokenize many lines per keystroke
		' (huge cost on files with large classes), making typing noticeably laggy.
		' Stale display-case for an identifier the user is currently typing is fine.
	End
	
	Method StartScopeVarCacheRebuild()
		If scopeDirtyFromLine > 0 And TryStartScopePartialRebuild(scopeDirtyFromLine) Then
			scopeDirtyFromLine = -1
			Return
		EndIf
		scopeDirtyFromLine = -1
		
		scopeRebuildTargetLen = doc.Crs.Length
		scopeRebuildTargetLines = doc.numtotallines
		scopeRebuildTargetUr = doc.idurstates
		
		scopeRebuildTmpGlobals = New StringMap<Int>
		scopeRebuildTmpConsts = New StringMap<Int>
		scopeRebuildTmpFields = New StringMap<Int>
		scopeRebuildTmpGlobalsCase = New StringMap<Int>
		scopeRebuildTmpFieldsCase = New StringMap<Int>
		
		scopeRebuildTmpInfos = scopeRebuildTmpInfos.Resize(0)
		scopeRebuildTmpInfoCount = 0
		scopeRebuildTmpInfoCap = 0
		
		scopeRebuildTmpClasses = scopeRebuildTmpClasses.Resize(0)
		scopeRebuildTmpClassCount = 0
		scopeRebuildTmpClassCap = 0
		
		Local n:Int = scopeRebuildTargetLines
		scopeRebuildTmpMethodAtLine = scopeRebuildTmpMethodAtLine.Resize(n)
		scopeRebuildTmpFuncAtLine = scopeRebuildTmpFuncAtLine.Resize(n)
		scopeRebuildTmpClassAtLine = scopeRebuildTmpClassAtLine.Resize(n)
		
		For Local i:Int = 0 To n - 1
			scopeRebuildTmpMethodAtLine[i] = -1
			scopeRebuildTmpFuncAtLine[i] = -1
			scopeRebuildTmpClassAtLine[i] = -1
		Next
		
		scopeRebuildCurMethod = -1
		scopeRebuildCurFunc = -1
		scopeRebuildCurClass = -1
		scopeRebuildBlockDepth = 0
		scopeRebuildRemDepth = 0
		scopeRebuildExtern = 0
		scopeRebuildClassExtern = 0

		scopeRebuildNextLine = 0
		scopeRebuildOn = 1
	End
	
	Method EnsureScopeTmpInfoCap(minCap:Int)
		If scopeRebuildTmpInfoCap >= minCap Then Return
		Local newCap:Int = scopeRebuildTmpInfoCap
		If newCap < 64 Then newCap = 64
		While newCap < minCap
			newCap += 64
		Wend
		scopeRebuildTmpInfoCap = newCap
		scopeRebuildTmpInfos = scopeRebuildTmpInfos.Resize(scopeRebuildTmpInfoCap)
	End
	
	Method EnsureScopeTmpClassCap(minCap:Int)
		If scopeRebuildTmpClassCap >= minCap Then Return
		Local newCap:Int = scopeRebuildTmpClassCap
		If newCap < 32 Then newCap = 32
		While newCap < minCap
			newCap += 32
		Wend
		scopeRebuildTmpClassCap = newCap
		scopeRebuildTmpClasses = scopeRebuildTmpClasses.Resize(scopeRebuildTmpClassCap)
	End
	
	Method NewVarScopeTmp:Int(stLine:Int, isMeth:Int, classId:Int)
		EnsureScopeTmpInfoCap(scopeRebuildTmpInfoCount + 1)
		
		Local sc:=New VarScopeInfo
		sc.startLine = stLine
		sc.endLine = scopeRebuildTargetLines - 1
		sc.isMethod = isMeth
		sc.classId = classId
		
		scopeRebuildTmpInfos[scopeRebuildTmpInfoCount] = sc
		scopeRebuildTmpInfoCount += 1
		
		Return scopeRebuildTmpInfoCount - 1
	End
	
	Method NewVarClassTmp:Int(stLine:Int)
		EnsureScopeTmpClassCap(scopeRebuildTmpClassCount + 1)
		
		Local cl:= New VarClassInfo
		cl.startLine = stLine
		cl.endLine = scopeRebuildTargetLines - 1
		cl.nameUp = ""
		cl.extendsUp = ""
		
		scopeRebuildTmpClasses[scopeRebuildTmpClassCount] = cl
		scopeRebuildTmpClassCount += 1
		
		Return scopeRebuildTmpClassCount - 1
	End
	
	Method StepScopeVarCacheRebuild(budgetMs:Int, maxLinesPerStep:Int)
		If scopeRebuildOn = 0 Then Return
		
		If scopeRebuildTargetLen <> doc.Crs.Length Or scopeRebuildTargetLines <> doc.numtotallines Then
			StartScopeVarCacheRebuild
		EndIf
		
		Local n:Int = scopeRebuildTargetLines
		If n <= 0 Then
			scopeGlobals = New StringMap<Int>
			scopeConsts = New StringMap<Int>
			scopeFields = New StringMap<Int>
			scopeGlobalsCase = New StringMap<Int>
			scopeFieldsCase = New StringMap<Int>
			scopeInfos = scopeInfos.Resize(0)
			scopeInfoCount = 0
			scopeClasses = scopeClasses.Resize(0)
			scopeClassCount = 0
			scopeMethodAtLine = scopeMethodAtLine.Resize(0)
			scopeFuncAtLine = scopeFuncAtLine.Resize(0)
			scopeClassAtLine = scopeClassAtLine.Resize(0)
			scopeCacheLen = doc.Crs.Length
			scopeCacheLines = doc.numtotallines
			scopeCacheDocPath = doc.fullname
			scopeCacheUr = doc.idurstates
			scopeLayoutGen += 1
			scopeRebuildOn = 0
			Return
		EndIf
		
		Local t0:Int = Millisecs()
		Local processed:Int = 0
		
		While scopeRebuildNextLine < n And processed < maxLinesPerStep
			Local ln:Int = scopeRebuildNextLine

			
			Local lineTxt:= GetLineTextByIndex(ln)
			Local toks:= TokenizeCodeLine(lineTxt)
			
			Local firstIdx:Int = 0
			While firstIdx < toks.Length
				Local tk:= toks[firstIdx].ToUpper()
				If tk = "PUBLIC" Or tk = "PRIVATE" Or tk = "PROTECTED" Or tk = "FRIEND" Or tk = "FINAL" Or tk = "ABSTRACT" Then
					firstIdx += 1
				Else
					Exit
				EndIf
			Wend
			
			' Le direttive di preprocessore non aprono ne' chiudono nessuno scope.
			' Senza questo controllo "#If ... #End" veniva contato come un If
			' normale; e siccome aprire un Method AZZERA il contatore dei blocchi,
			' il "#End" arrivava a profondita' zero e chiudeva la CLASSE.
			' Su 3dplayers.cxs bastava il "#If" di riga 2784, che contiene un
			' Method a riga 2789, per far risultare Class Game finita a riga 2810
			' invece che a 5571: da li' in giu' scopeClassAtLine valeva -1 e nessun
			' Field veniva piu' colorato.
			Local isPre:Int = IFI_IsPreprocLine(IFI_TrimLeadingSpaces(lineTxt))

			' "#Rem ... #End" non e' codice, e' testo commentato: va saltato per
			' intero, altrimenti i Method e gli End che contiene vengono contati
			' come veri. In vortexx/src/light.cxs il blocco di righe 52-60 lasciava
			' aperto uno scope fantasma e la classe non si chiudeva piu'.
			' (Finora il conto tornava per caso, perche' anche il "#End" finale
			' veniva scambiato per un End vero e compensava.)
			Local pdir:String = IFI_PreprocDirective(lineTxt)
			Local inRem:Int = 0

			If scopeRebuildRemDepth > 0 Then
				inRem = 1
				If pdir = "REM" Then
					scopeRebuildRemDepth += 1
				ElseIf pdir = "END" Or pdir = "ENDIF" Then
					scopeRebuildRemDepth -= 1
				EndIf
			ElseIf pdir = "REM" Then
				inRem = 1
				scopeRebuildRemDepth += 1
			EndIf

			' "Extern" apre la sezione, "Public"/"Private" la chiudono quando non
			' siamo dentro una classe. Va letto prima del filtro su firstIdx:
			' una riga col solo "Public" non ha token di codice.
			If toks.Length > 0 And isPre = 0 And inRem = 0 Then
				Local tSec:String = toks[0].ToUpper()
				If tSec = "EXTERN" Then
					scopeRebuildExtern = 1
				ElseIf (tSec = "PUBLIC" Or tSec = "PRIVATE") And scopeRebuildCurClass < 0 Then
					scopeRebuildExtern = 0
				EndIf
			EndIf

			If firstIdx < toks.Length And isPre = 0 And inRem = 0 Then
				Local t00:= toks[firstIdx].ToUpper()

				' Una routine che si chiude sulla PROPRIA riga non apre nulla:
				'   Method TexDir:String() ; Return Cartella + Kit ; End
				' Guardando solo il primo token si vedeva "Method" e mai l'"End",
				' cosi' ogni riga di queste lasciava aperto uno scope fantasma e
				' l'End della classe finiva per chiudere quello invece della classe
				' (Class Divisa, righe 136-142 di 3dplayers.cxs).
				' Stessa regola gia' usata dall'indentatore.
				' Stessa regola per le sole dichiarazioni: dentro una sezione
				' Extern, dentro una classe Extern, o con Extern/Abstract sulla
				' riga, la routine non ha corpo e non lascia niente da chiudere.
				Local extHere:Int = scopeRebuildExtern
				If scopeRebuildCurClass >= 0 Then extHere = scopeRebuildClassExtern
				Local noBody:Int = 0
				If t00 = "METHOD" Or t00 = "FUNCTION" Then
					If IFI_RoutineClosesOnSameLine(toks, firstIdx) Then noBody = 1
					If SCAN_RoutineHasExternOrAbstract(toks, firstIdx) Then noBody = 1
					If extHere Then noBody = 1
				EndIf

				If noBody Then
					' niente: e' solo una dichiarazione
				ElseIf t00 = "METHOD" Then
					scopeRebuildCurMethod = NewVarScopeTmp(ln, 1, scopeRebuildCurClass)
					scopeRebuildBlockDepth = 0
				ElseIf t00 = "FUNCTION" Then
					scopeRebuildCurFunc = NewVarScopeTmp(ln, 0, scopeRebuildCurClass)
					scopeRebuildBlockDepth = 0
				ElseIf t00 = "CLASS" Then
					scopeRebuildCurClass = NewVarClassTmp(ln)
					scopeRebuildClassExtern = IFI_ClassIsExtern(toks, firstIdx, scopeRebuildExtern)
					If scopeRebuildCurClass >= 0 And firstIdx + 1 < toks.Length Then
						Local nm:= toks[firstIdx + 1]
						If HL_IsIdentToken(nm) And Not HL_IsKeywordCXS(nm) Then scopeRebuildTmpClasses[scopeRebuildCurClass].nameUp = nm.ToUpper()
					EndIf
					
					For Local k:Int = firstIdx + 2 To toks.Length - 2
						If toks[k].ToUpper() = "EXTENDS" Then
							Local su:= toks[k + 1]
							If HL_IsIdentToken(su) And Not HL_IsKeywordCXS(su) Then scopeRebuildTmpClasses[scopeRebuildCurClass].extendsUp = su.ToUpper()
							Exit
						EndIf
					Next
				EndIf
			EndIf
			
			scopeRebuildTmpMethodAtLine[ln] = scopeRebuildCurMethod
			scopeRebuildTmpFuncAtLine[ln] = scopeRebuildCurFunc
			scopeRebuildTmpClassAtLine[ln] = scopeRebuildCurClass

			' Dentro un "#Rem" non si raccolgono dichiarazioni: quei Global e quei
			' Field sono commentati, colorarli sarebbe sbagliato.
			Local declTo:Int = toks.Length - 1
			If inRem Then declTo = -1

			For Local i:Int = 0 To declTo
				Local up:= toks[i].ToUpper()
				
				If up = "GLOBAL" Then
					AddDeclNamesFromTokens(scopeRebuildTmpGlobals, toks, i)
					AddDeclNamesFromTokensCaseExact(scopeRebuildTmpGlobalsCase, toks, i)
				ElseIf up = "CONST" Then
					If scopeRebuildCurClass >= 0 Then
						AddDeclNamesFromTokens(scopeRebuildTmpClasses[scopeRebuildCurClass].fields, toks, i)
					Else
						AddDeclNamesFromTokens(scopeRebuildTmpConsts, toks, i)
					EndIf
				ElseIf up = "FIELD" Then
					If scopeRebuildCurClass >= 0 Then
						AddDeclNamesFromTokens(scopeRebuildTmpClasses[scopeRebuildCurClass].fields, toks, i)
					Else
						AddDeclNamesFromTokens(scopeRebuildTmpFields, toks, i)
						AddDeclNamesFromTokensCaseExact(scopeRebuildTmpFieldsCase, toks, i)
					EndIf
				ElseIf up = "LOCAL" Then
					If scopeRebuildCurMethod >= 0 Then
						AddDeclNamesFromTokensCaseExact(scopeRebuildTmpInfos[scopeRebuildCurMethod].locals, toks, i)
					ElseIf scopeRebuildCurFunc >= 0 Then
						AddDeclNamesFromTokensCaseExact(scopeRebuildTmpInfos[scopeRebuildCurFunc].locals, toks, i)
					EndIf
				EndIf
			Next
			
			' --- chiusura di blocchi e di routine ---
			'
			' In Cerberus "End" nudo NON chiude solo Method/Function/Class: chiude
			' anche If, Select e Try. Prima qui il primo "End" incontrato chiudeva
			' subito la routine, quindi un metodo come
			'
			'     Method GetTimestamp()
			'         Local timestamp = 0
			'         If IsLeapYear(i) Then ... Else ... End   <-- chiude l'If
			'         ... altre 15 righe ...
			'     End Method
			'
			' risultava finito alla riga dell'If. Tutto il codice sotto cadeva
			' fuori dallo scope del metodo: con il caret li' dentro,
			' FindNearestRoutineStart non trovava la routine e l'autocomplete non
			' offriva NESSUN local (ne' i typed ne' gli untyped).
			'
			' Ora si conta la profondita' dei blocchi che "End" puo' chiudere, e
			' un "End" nudo chiude la routine solo a profondita' zero.
			' For/While/Repeat non entrano nel conteggio: si chiudono con
			' Next/Wend/Forever/Until, mai con End.
			If firstIdx < toks.Length And isPre = 0 And inRem = 0 Then
				Local t0a:= toks[firstIdx].ToUpper()
				Local t1a:String = ""
				If firstIdx + 1 < toks.Length Then t1a = toks[firstIdx + 1].ToUpper()

				If t0a = "END" And t1a = "METHOD" Then
					If scopeRebuildCurMethod >= 0 Then scopeRebuildTmpInfos[scopeRebuildCurMethod].endLine = ln
					scopeRebuildCurMethod = -1
					scopeRebuildBlockDepth = 0
				ElseIf t0a = "END" And t1a = "FUNCTION" Then
					If scopeRebuildCurFunc >= 0 Then scopeRebuildTmpInfos[scopeRebuildCurFunc].endLine = ln
					scopeRebuildCurFunc = -1
					scopeRebuildBlockDepth = 0
				ElseIf t0a = "END" And t1a = "CLASS" Then
					If scopeRebuildCurClass >= 0 Then scopeRebuildTmpClasses[scopeRebuildCurClass].endLine = ln
					scopeRebuildCurClass = -1
					scopeRebuildBlockDepth = 0
				ElseIf t0a = "ENDIF" Then
					If scopeRebuildBlockDepth > 0 Then scopeRebuildBlockDepth -= 1
				ElseIf t0a = "WEND" Or t0a = "NEXT" Then
					If scopeRebuildBlockDepth > 0 Then scopeRebuildBlockDepth -= 1
				ElseIf t0a = "END" And (t1a = "IF" Or t1a = "SELECT" Or t1a = "TRY" Or t1a = "WHILE" Or t1a = "FOR") Then
					If scopeRebuildBlockDepth > 0 Then scopeRebuildBlockDepth -= 1
				ElseIf t0a = "END" Then
					If scopeRebuildBlockDepth > 0 Then
						scopeRebuildBlockDepth -= 1
					ElseIf scopeRebuildCurMethod >= 0 Then
						scopeRebuildTmpInfos[scopeRebuildCurMethod].endLine = ln
						scopeRebuildCurMethod = -1
					ElseIf scopeRebuildCurFunc >= 0 Then
						scopeRebuildTmpInfos[scopeRebuildCurFunc].endLine = ln
						scopeRebuildCurFunc = -1
					ElseIf scopeRebuildCurClass >= 0 Then
						scopeRebuildTmpClasses[scopeRebuildCurClass].endLine = ln
						scopeRebuildCurClass = -1
					EndIf
				ElseIf t0a = "IF" Then
					' solo l'If a blocco apre: "If a Then b" si chiude sulla riga.
					' Stessa logica usata dall'indentatore.
					If IFI_IfNeedsBlockIndent(lineTxt, toks, firstIdx) Then scopeRebuildBlockDepth += 1
				ElseIf t0a = "SELECT" Or t0a = "TRY" Then
					scopeRebuildBlockDepth += 1
				' While e For si chiudono con Wend/Next OPPURE con End: se il
				' terminatore non e' gia' sulla riga, il blocco resta aperto.
				ElseIf t0a = "WHILE" Then
					If IFI_HasKeywordOnSameLine(toks, firstIdx, "WEND") = 0 Then scopeRebuildBlockDepth += 1
				ElseIf t0a = "FOR" Then
					If IFI_HasKeywordOnSameLine(toks, firstIdx, "NEXT") = 0 Then scopeRebuildBlockDepth += 1
				EndIf
			EndIf
			
			scopeRebuildNextLine += 1
			processed += 1
			
			If budgetMs > 0 And Millisecs() - t0 >= budgetMs Then Exit
		Wend
		
		If scopeRebuildNextLine >= n Then
			scopeGlobals = scopeRebuildTmpGlobals
			scopeConsts = scopeRebuildTmpConsts
			scopeFields = scopeRebuildTmpFields
			scopeGlobalsCase = scopeRebuildTmpGlobalsCase
			scopeFieldsCase = scopeRebuildTmpFieldsCase
			
			scopeInfoCount = scopeRebuildTmpInfoCount
			scopeInfos = scopeInfos.Resize(scopeInfoCount)
			For Local i:Int = 0 To scopeInfoCount - 1
				scopeInfos[i] = scopeRebuildTmpInfos[i]
			Next
			
			scopeClassCount = scopeRebuildTmpClassCount
			scopeClasses = scopeClasses.Resize(scopeClassCount)
			For Local i:Int = 0 To scopeClassCount - 1
				scopeClasses[i] = scopeRebuildTmpClasses[i]
			Next
			
			scopeMethodAtLine = scopeRebuildTmpMethodAtLine
			scopeFuncAtLine = scopeRebuildTmpFuncAtLine
			scopeClassAtLine = scopeRebuildTmpClassAtLine
			
			scopeCacheLen = scopeRebuildTargetLen
			scopeCacheLines = scopeRebuildTargetLines
			scopeCacheDocPath = doc.fullname
			scopeCacheUr = scopeRebuildTargetUr
			
			scopeLayoutGen += 1
			scopeRebuildOn = 0
			acLocalDeclCachePath = ""
			acClassDeclCachePath = ""
			acLocalDeclCacheLine = -1
			If scopeDirty Then
				scopeDirty = 0
				StartScopeVarCacheRebuild()
			Else
				HL_RequestViewportHighlight(1)
			EndIf
		EndIf
	End
	
	Method GetLineTextByIndex:String(ln:Int)
		If ln < 0 Or ln >= doc.numtotallines Then Return ""
		
		Local s:Int = doc.idline[ln]
		Local e:Int = doc.idline[ln + 1] - 1
		If e < s Then Return ""
		
		Local chr:Int[e - s + 1]
		Local k:Int = 0
		
		For Local i:Int = s To e
			Local c:Int = doc.Crs[i] & 255
			If c <> 13 And c <> 10 Then
				chr[k] = c
				k += 1
			EndIf
		Next
		
		chr = chr.Resize(k)
		Return String.FromChars(chr)
	End
	
	Method TokenizeCodeLine:String[](lineTxt:String)
		Local out:String[16]
		Local outCount:Int = 0
		Local n:Int = lineTxt.Length
		Local i:Int = 0
		Local inStr:Int = 0
		
		While i < n
			Local c:Int = lineTxt[i]
			
			If c = 34 Then
				inStr = 1 - inStr
				i += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 1 Then
				i += 1
				Continue
			EndIf
			
			If c = 64 And i + 1 < n Then
				Local cN:Int = lineTxt[i + 1]
				If IsALetter(cN) Or cN = 95 Then
					Local s:Int = i
					i += 2
					While i < n
						Local c2:Int = lineTxt[i]
						If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
							i += 1
						Else
							Exit
						EndIf
					Wend
					Local tokA:= MidString(lineTxt, s + 1, i - s)
					If outCount = out.Length Then out = out.Resize(out.Length * 2)
					out[outCount] = tokA
					outCount += 1
					Continue
				EndIf
			EndIf
			
			If IsALetter(c) Or c = 95 Or c >= 48 And c <= 57 Then
				Local s:Int = i
				i += 1
				While i < n
					Local c2:Int = lineTxt[i]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						i += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, i - s)
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = tok
				outCount += 1
				Continue
			EndIf
			
			If c = 44 Or c = 58 Or c = 61 Then
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = String.FromChar(c)
				outCount += 1
			EndIf
			
			i += 1
		Wend
		
		If outCount = 0 Then Return New String[0]
		Return out.Resize(outCount)
	End
	
	Method AddDeclNamesFromTokens(dest:StringMap<Int>, toks:String[], startIdx:Int)
		Local expectName:Int = 1
		
		For Local i:Int = startIdx + 1 To toks.Length - 1
			Local t:= toks[i]
			Local up:= t.ToUpper()
			
			If t = "," Then
				expectName = 1
				Continue
			EndIf
			
			If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "END" Then Exit
			
			If expectName And HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
				dest.Set(up, 1)
				expectName = 0
				Continue
			EndIf
		Next
	End
	
	Method AddDeclNamesFromTokensCaseExact(dest:StringMap<Int>, toks:String[], startIdx:Int)
		If dest = Null Then Return
		Local expectName:Int = 1
		
		For Local i:Int = startIdx + 1 To toks.Length - 1
			Local t:= toks[i]
			Local up:= t.ToUpper()
			
			If t = "," Then
				expectName = 1
				Continue
			EndIf
			
			If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "END" Then Exit
			
			If expectName And HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
				dest.Set(t, 1)
				expectName = 0
				Continue
			EndIf
		Next
	End
	
	Method FirstCodeTokenIndex:Int(toks:String[])
		Local idx:Int = 0
		While idx < toks.Length
			Local tk:= toks[idx].ToUpper()
			If tk = "PUBLIC" Or tk = "PRIVATE" Or tk = "PROTECTED" Or tk = "FRIEND" Or tk = "FINAL" Or tk = "ABSTRACT" Then
				idx += 1
			Else
				Exit
			EndIf
		Wend
		Return idx
	End
	
	Method BuildLineScopeContext:LineScopeContext(idl:Int)
		Local ctx:= New LineScopeContext
		
		Local curMethod:Int
		Local curFunc:Int
		Local curClass:Int
		
		Local classFieldsStack:StringMap<Int>[64]
		Local classTop:Int = -1
		
		For Local ln:Int = 0 To idl
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local firstIdx:Int = FirstCodeTokenIndex(toks)
			
			If firstIdx < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				
				If t0 = "CLASS" Then
					classTop += 1
					If classTop > 63 Then classTop = 63
					classFieldsStack[classTop] = New StringMap<Int>
					curClass = 1
				ElseIf t0 = "METHOD" Then
					curMethod = 1
					curFunc = 0
					ctx.locals = New StringMap<Int>
				ElseIf t0 = "FUNCTION" Then
					curFunc = 1
					curMethod = 0
					ctx.locals = New StringMap<Int>
				EndIf
			EndIf
			
			For Local i:Int = 0 To toks.Length - 1
				Local up:= toks[i].ToUpper()
				If up = "GLOBAL" Then
					AddDeclNamesFromTokens(scopeGlobals, toks, i)
				ElseIf up = "FIELD" Then
					If classTop >= 0 Then
						AddDeclNamesFromTokens(classFieldsStack[classTop], toks, i)
					Else
						AddDeclNamesFromTokens(scopeFields, toks, i)
					EndIf
				ElseIf up = "LOCAL" Then
					If curMethod Or curFunc Then AddDeclNamesFromTokens(ctx.locals, toks, i)
				EndIf
			Next
			
			If firstIdx + 1 < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				Local t1:= toks[firstIdx + 1].ToUpper()
				If t0 = "END" And t1 = "METHOD" Then
					curMethod = 0
				ElseIf t0 = "END" And t1 = "FUNCTION" Then
					curFunc = 0
				ElseIf t0 = "END" And t1 = "CLASS" Then
					If classTop >= 0 Then classTop -= 1
					If classTop < 0 Then curClass = 0
				EndIf
			ElseIf firstIdx < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				If t0 = "END" Then
					If curMethod Then
						curMethod = 0
					ElseIf curFunc Then
						curFunc = 0
					ElseIf curClass Then
						If classTop >= 0 Then classTop -= 1
						If classTop < 0 Then curClass = 0
					EndIf
				EndIf
			EndIf
		Next
		
		If classTop >= 0 Then ctx.classFields = classFieldsStack[classTop]
		ctx.inMethod = curMethod
		
		Return ctx
	End
	
	Method FindEnclosingRoutineStart:Int[](idl:Int)
		Local res:Int[2]
		res[0] = -1
		res[1] = 0
		
		Local depthMeth:Int = 0
		Local depthFunc:Int = 0
		
		For Local ln:Int = idl To 0 Step -1
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local firstIdx:Int = FirstCodeTokenIndex(toks)
			
			If firstIdx + 1 < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				Local t1:= toks[firstIdx + 1].ToUpper()
				
				If t0 = "END" And t1 = "METHOD" Then
					depthMeth += 1
				ElseIf t0 = "END" And t1 = "FUNCTION" Then
					depthFunc += 1
				EndIf
			EndIf
			
			If firstIdx < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				If t0 = "METHOD" Then
					If depthMeth = 0 Then
						res[0] = ln
						res[1] = 1
						Return res
					Else
						depthMeth -= 1
					EndIf
				ElseIf t0 = "FUNCTION" Then
					If depthFunc = 0 Then
						res[0] = ln
						res[1] = 0
						Return res
					Else
						depthFunc -= 1
					EndIf
				EndIf
			EndIf
		Next
		
		Return res
	End

	Method AC_GetRoutineScopeAtLine:Int[](caretLn:Int)
		Local res:Int[3]
		res[0] = -1
		res[1] = 0
		res[2] = -1
		If caretLn < 0 Then Return res
		
		EnsureScopeVarCache(0)
		If caretLn >= scopeMethodAtLine.Length Then Return res
		
		Local mid:Int = scopeMethodAtLine[caretLn]
		If mid >= 0 And mid < scopeInfoCount Then
			res[0] = mid
			res[1] = 1
			res[2] = scopeInfos[mid].classId
			Return res
		EndIf
		
		Local fid:Int = scopeFuncAtLine[caretLn]
		If fid >= 0 And fid < scopeInfoCount Then
			res[0] = fid
			res[1] = 0
			res[2] = scopeInfos[fid].classId
			Return res
		EndIf
		
		Return res
	End
	
	Method AC_InClassInstanceMethod:Int(caretLn:Int)
		Local ctx:Int[] = AC_GetRoutineScopeAtLine(caretLn)
		If ctx[2] < 0 Then Return 0
		If ctx[1] = 0 Then Return 0
		Return 1
	End
	
	Method AC_IsTextualInstanceMethodContext:Int(caretLn:Int)
		If caretLn < 0 Then Return 0
		Local clsStart:Int = FindEnclosingClassStart(caretLn)
		If clsStart < 0 Then clsStart = FindNearestClassStart(caretLn)
		If clsStart < 0 Then Return 0
		Local rt:Int[] = FindEnclosingRoutineStart(caretLn)
		If rt[0] < 0 Then rt = FindNearestRoutineStart(caretLn)
		If rt[0] < 0 Then Return 0
		If rt[0] < clsStart Then Return 0
		If rt[1] = 0 Then Return 0
		Return 1
	End
	
	Method AC_InClassStaticFunction:Int(caretLn:Int)
		Local ctx:Int[] = AC_GetRoutineScopeAtLine(caretLn)
		If ctx[2] < 0 Then Return 0
		If ctx[1] <> 0 Then Return 0
		Return 1
	End
	
	Method FindNearestRoutineStart:Int[](idl:Int)
		Local res:Int[2]
		res[0] = -1
		res[1] = 0
		
		If (ScopeCacheIsCurrent() Or ScopeCacheUsableStale()) And idl >= 0 And idl < scopeMethodAtLine.Length
			Local mid:Int = scopeMethodAtLine[idl]
			If mid >= 0 And mid < scopeInfoCount
				res[0] = scopeInfos[mid].startLine
				res[1] = 1
				hlRoutineStart = res[0]
				hlRoutineIsMethod = 1
				hlRoutineEnd = scopeInfos[mid].endLine
				hlLocalsRoutine = hlRoutineStart
				hlLocalsIsMethod = 1
				Return res
			EndIf
			Local fid:Int = scopeFuncAtLine[idl]
			If fid >= 0 And fid < scopeInfoCount
				res[0] = scopeInfos[fid].startLine
				res[1] = 0
				hlRoutineStart = res[0]
				hlRoutineIsMethod = 0
				hlRoutineEnd = scopeInfos[fid].endLine
				hlLocalsRoutine = hlRoutineStart
				hlLocalsIsMethod = 0
				Return res
			EndIf
		EndIf
		
		If HL_RoutineBoundsValid(idl) Then
			res[0] = hlRoutineStart
			res[1] = hlRoutineIsMethod
			Return res
		EndIf
		
		Local scanFrom:Int = 0
		
		For Local ln:Int = idl To scanFrom Step -1
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local firstIdx:Int = FirstCodeTokenIndex(toks)
			If firstIdx < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				If t0 = "METHOD" Then
					res[0] = ln
					res[1] = 1
					HL_SetRoutineBounds(ln, 1)
					Return res
				ElseIf t0 = "FUNCTION" Then
					res[0] = ln
					res[1] = 0
					HL_SetRoutineBounds(ln, 0)
					Return res
				EndIf
			EndIf
		Next
		
		HL_ClearRoutineBounds()
		Return res
	End
	
	Method FindNearestClassStart:Int(fromLine:Int)
		If ScopeCacheIsCurrent() And fromLine >= 0 And fromLine < scopeClassAtLine.Length
			Local cid:Int = scopeClassAtLine[fromLine]
			If cid >= 0 And cid < scopeClassCount Then Return scopeClasses[cid].startLine
		EndIf
		
		For Local ln:Int = fromLine To 0 Step -1
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local firstIdx:Int = FirstCodeTokenIndex(toks)
			If firstIdx < toks.Length Then
				If toks[firstIdx].ToUpper() = "CLASS" Then Return ln
			EndIf
		Next
		Return -1
	End
	
	Method FindEnclosingClassStart:Int(fromLine:Int)
		Local depthClass:Int = 0
		
		For Local ln:Int = fromLine To 0 Step -1
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local firstIdx:Int = FirstCodeTokenIndex(toks)
			
			If firstIdx + 1 < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				Local t1:= toks[firstIdx + 1].ToUpper()
				If t0 = "END" And t1 = "CLASS" Then depthClass += 1
			EndIf
			
			If firstIdx < toks.Length Then
				Local t0:= toks[firstIdx].ToUpper()
				If t0 = "CLASS" Then
					If depthClass = 0 Then Return ln
					depthClass -= 1
				EndIf
			EndIf
		Next
		
		Return -1
	End
	
	Method BuildLocalsUpToLine:StringMap<Int>(startLine:Int, endLine:Int)
		Local out:= New StringMap<Int>
		If startLine < 0 Then Return out
		If endLine < startLine Then Return out
		
		For Local ln:Int = startLine To endLine
			AddDeclNamesFromLineKeyword(out, GetLineTextByIndex(ln), "LOCAL")
		Next
		
		Return out
	End
	
	Method BuildLocalsUpToLineCase:StringMap<Int>(startLine:Int, endLine:Int)
		Local out:= New StringMap<Int>
		If startLine < 0 Then Return out
		If endLine < startLine Then Return out
		
		For Local ln:Int = startLine To endLine
			AddDeclNamesFromLineKeywordCase(out, GetLineTextByIndex(ln), "LOCAL")
		Next
		
		Return out
	End
	
	Method BuildFieldsInClass:StringMap<Int>(classStart:Int, untilLine:Int)
		Local out:= New StringMap<Int>
		If classStart < 0 Then Return out
		If untilLine < classStart Then Return out
		
		For Local ln:Int = classStart To untilLine
			AddDeclNamesFromLineKeyword(out, GetLineTextByIndex(ln), "FIELD")
		Next
		
		Return out
	End
	
	Method BuildFieldsInClassCase:StringMap<Int>(classStart:Int, untilLine:Int)
		Local out:= New StringMap<Int>
		If classStart < 0 Then Return out
		If untilLine < classStart Then Return out
		
		For Local ln:Int = classStart To untilLine
			AddDeclNamesFromLineKeywordCase(out, GetLineTextByIndex(ln), "FIELD")
		Next
		
		Return out
	End
	
	Method HL_InvalidateLocalsCache()
		hlLocalsRoutine = -1
		hlLocalsIsMethod = 0
		hlLocalsEndLine = -1
		hlClassFieldsStart = -1
		hlClassFieldsEndLine = -1
		HL_ClearRoutineBounds()
	End
	
	Method HL_ClearRoutineBounds()
		hlRoutineStart = -1
		hlRoutineEnd = -1
		hlRoutineIsMethod = 0
	End
	
	Method HL_RoutineBoundsValid:Int(idl:Int)
		If hlRoutineStart < 0 Then Return 0
		If idl < hlRoutineStart Then Return 0
		If hlRoutineEnd >= hlRoutineStart And idl > hlRoutineEnd Then Return 0
		Return 1
	End
	
	Method HL_ScanRoutineEndLine:Int(startLine:Int, isMethod:Int)
		Local maxLn:Int = doc.numtotallines - 2
		If maxLn < startLine Then maxLn = startLine
		
		Local depth:Int = 1
		For Local ln:Int = startLine + 1 To maxLn
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			Local fi:Int = FirstCodeTokenIndex(toks)
			If fi >= toks.Length Then Continue
			
			Local t0:String = toks[fi].ToUpper()
			Local t1:String = ""
			If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()
			
			If t0 = "METHOD" Or t0 = "FUNCTION" Then
				depth += 1
				Continue
			EndIf
			
			If t0 = "END" Then
				Local close:Int = 0
				If t1 = "METHOD" Or t1 = "FUNCTION" Then
					close = 1
				ElseIf t1 = "" Then
					close = 1
				EndIf
				If close Then
					depth -= 1
					If depth = 0 Then Return ln
				EndIf
			EndIf
		Next
		
		Return maxLn
	End
	
	Method HL_SetRoutineBounds(startLine:Int, isMethod:Int)
		If startLine < 0 Then
			HL_ClearRoutineBounds()
			Return
		EndIf
		
		If hlRoutineStart = startLine And hlRoutineEnd >= startLine Then
			hlRoutineIsMethod = isMethod
			hlLocalsRoutine = startLine
			hlLocalsIsMethod = isMethod
			Return
		EndIf
		
		hlRoutineStart = startLine
		hlRoutineIsMethod = isMethod
		hlRoutineEnd = HL_ScanRoutineEndLine(startLine, isMethod)
		
		hlLocalsRoutine = startLine
		hlLocalsIsMethod = isMethod
	End
	
	Method HL_ShouldApplyScopedColors:Int(idl:Int)
		If idl < 0 Then Return 0
		If ScopeCacheIsCurrent() Then Return 1

		If scopeRebuildOn Then
			' Durante la ricostruzione NON si spengono i colori di scope.
			'
			' Prima qui c'era "Return 0": su un file da 28.648 righe la
			' ricostruzione parte dopo 1800 ms e poi macina 96 righe per frame,
			' cioe' circa 300 frame (~5 s). Sommati fanno quasi 7 secondi dopo
			' OGNI modifica in cui nessun local era verde e nessun field colorato:
			' da qui la sensazione che "le righe dopo il caret non si colorino".
			'
			' La cache vecchia in questo intervallo e' ancora integra: il rebuild
			' lavora su scopeRebuildTmp* e la pubblica solo alla fine. Usarla e'
			' molto meglio che restare senza colori. Al massimo un local dichiarato
			' un attimo prima diventa verde con qualche istante di ritardo.
			'
			' Si accetta solo se il numero di righe non e' cambiato: gli indici
			' per-riga (scopeMethodAtLine) sono posizionali, e se nel frattempo
			' sono state inserite o tolte righe non corrisponderebbero piu'.
			If ScopeCacheUsableStale() Then Return 1
			Return 0
		EndIf
		
		If scopeDirty Then
			' Documento modificato ma ricostruzione non ancora partita (c'e' il
			' debounce di mezzo): la cache e' ancora quella di prima, INTATTA.
			' Prima qui sopravviveva solo la riga del caret, quindi a ogni tasto
			' TUTTE le altre righe visibili perdevano il colore di scope e
			' tornavano bianche finche' il rebuild non finiva. Da qui i
			' "timestamp" che sbiancano mentre si scrive e tornano verdi dopo.
			' Vale la stessa condizione dell'altro ramo: la cache e' indicizzata
			' per posizione, quindi si usa solo se il numero di righe non cambia.
			If ScopeCacheUsableStale() Then Return 1
			GetCursorLine()
			If idl = linecaret Then Return 1
			If hlLocalsRoutine >= 0 And idl <= hlLocalsEndLine And HL_RoutineBoundsValid(idl) Then Return 1
			Return 0
		EndIf
		
		Return 1
	End
	
	Method HL_ExtendLocalsCache(routineStart:Int, toLine:Int, maxNewLines:Int = -1)
		If routineStart < 0 Or toLine < routineStart Then Return
		
		Local fromLn:Int = routineStart
		If hlLocalsRoutine = routineStart And hlLocalsEndLine >= routineStart Then
			fromLn = hlLocalsEndLine + 1
			If fromLn > toLine Then Return
		Else
			hlLocalsMap = New StringMap<Int>
			hlLocalsRoutine = routineStart
			hlLocalsEndLine = routineStart - 1
		EndIf
		
		If maxNewLines >= 0 Then
			Local cap:Int = fromLn + maxNewLines - 1
			If cap < fromLn Then cap = fromLn
			If toLine > cap Then toLine = cap
		EndIf
		
		For Local ln:Int = fromLn To toLine
			AddDeclNamesFromLineKeywordCase(hlLocalsMap, GetLineTextByIndex(ln), "LOCAL")
		Next
		hlLocalsEndLine = toLine
	End
	
	Method HL_ExtendClassFieldsCache(classStart:Int, toLine:Int)
		If classStart < 0 Or toLine < classStart Then Return
		
		Local fromLn:Int = classStart
		If hlClassFieldsStart = classStart And hlClassFieldsEndLine >= classStart Then
			fromLn = hlClassFieldsEndLine + 1
			If fromLn > toLine Then Return
		Else
			hlClassFieldsMap = New StringMap<Int>
			hlClassFieldsStart = classStart
			hlClassFieldsEndLine = classStart - 1
		EndIf
		
		For Local ln:Int = fromLn To toLine
			AddDeclNamesFromLineKeywordCase(hlClassFieldsMap, GetLineTextByIndex(ln), "FIELD")
		Next
		hlClassFieldsEndLine = toLine
	End
	
	Method HL_PatchLocalsOnEdit(fromLine:Int)
		If fromLine < 0 Then Return
		
		Local rStart:Int = -1
		Local isMeth:Int = 0
		
		If hlLocalsRoutine >= 0 And fromLine >= hlLocalsRoutine
			If hlLocalsEndLine < 0 Or fromLine <= hlLocalsEndLine + 1
				rStart = hlLocalsRoutine
				isMeth = hlLocalsIsMethod
			EndIf
		EndIf
		
		If rStart < 0 Then
			If HL_RoutineBoundsValid(fromLine) Then
				rStart = hlRoutineStart
				isMeth = hlRoutineIsMethod
			Else
				Local enc:= FindNearestRoutineStart(fromLine)
				rStart = enc[0]
				isMeth = enc[1]
			EndIf
		EndIf
		
		If rStart < 0 Then
			HL_InvalidateLocalsCache()
			Return
		EndIf
		
		If hlLocalsRoutine <> rStart
			hlLocalsMap = New StringMap<Int>
			hlLocalsRoutine = rStart
			hlLocalsIsMethod = isMeth
			hlLocalsEndLine = rStart - 1
			hlClassFieldsStart = -1
			hlClassFieldsEndLine = -1
		EndIf
		
		AddDeclNamesFromLineKeywordCase(hlLocalsMap, GetLineTextByIndex(fromLine), "LOCAL")
		If fromLine > hlLocalsEndLine Then hlLocalsEndLine = fromLine
	End
	
	Method HL_EnsureLocalsForHighlight:StringMap<Int>(routineStart:Int, idl:Int, inMethod:Int)
		If routineStart < 0 Or idl < 0 Then Return Null
		
		If hlLocalsRoutine = routineStart And idl <= hlLocalsEndLine Then Return hlLocalsMap
		
		Local target:Int = idl
		Local maxNew:Int = -1
		
		If scopeDirty And scopeRebuildOn = 0 Then
			GetCursorLine()
			If idl <> linecaret Then
				maxNew = 24
				If hlLocalsEndLine >= routineStart And idl > hlLocalsEndLine + maxNew Then
					target = hlLocalsEndLine + maxNew
				EndIf
			EndIf
		EndIf
		
		HL_ExtendLocalsCache(routineStart, target, maxNew)
		hlLocalsIsMethod = inMethod
		Return hlLocalsMap
	End
	
	Method HL_EnsureClassFieldsForHighlight:StringMap<Int>(classStart:Int, idl:Int)
		If classStart < 0 Or idl < 0 Then Return Null
		
		If hlClassFieldsStart = classStart And idl <= hlClassFieldsEndLine Then Return hlClassFieldsMap
		
		HL_ExtendClassFieldsCache(classStart, idl)
		Return hlClassFieldsMap
	End
	
	Method BuildNamesFromLineKeywordCase:StringMap<Int>(startLine:Int, endLine:Int, keyword:String)
		Local out:= New StringMap<Int>
		If startLine < 0 Then startLine = 0
		If endLine >= doc.numtotallines Then endLine = doc.numtotallines - 1
		If endLine < startLine Then Return out
		
		For Local ln:Int = startLine To endLine
			AddDeclNamesFromLineKeywordCase(out, GetLineTextByIndex(ln), keyword)
		Next
		
		Return out
	End
	
	Method AddDeclNamesFromLineKeyword(dest:StringMap<Int>, lineTxt:String, keyword:String)
		If dest = Null Then Return
		If lineTxt = "" Then Return
		
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		Local kwUp:= keyword.ToUpper()
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And IsALetter(c) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				Local tokUp:= tok.ToUpper()
				
				If tokUp = kwUp Then
					While p < n And (lineTxt[p] = 32 Or lineTxt[p] = 9)
						p += 1
					Wend
					
					While p < n
						While p < n And (lineTxt[p] = 32 Or lineTxt[p] = 9)
							p += 1
						Wend
						
						If p >= n Then Exit
						
						If Not IsALetter(lineTxt[p]) Then Exit
						
						Local s2:Int = p
						p += 1
						While p < n
							Local c3:Int = lineTxt[p]
							If IsALetter(c3) Or c3 >= 48 And c3 <= 57 Then
								p += 1
							Else
								Exit
							EndIf
						Wend
						
						Local nm:= MidString(lineTxt, s2 + 1, p - s2).ToUpper()
						If nm <> "" Then dest.Set(nm, 1)
						
						While p < n And (lineTxt[p] = 32 Or lineTxt[p] = 9)
							p += 1
						Wend
						
						If p < n And lineTxt[p] = 44 Then
							p += 1
							Continue
						EndIf
						
						Exit
					Wend
				EndIf
				
				Continue
			EndIf
			
			p += 1
		Wend
	End
	
	Method AddDeclNamesFromLineKeywordCase(dest:StringMap<Int>, lineTxt:String, keyword:String)
		If dest = Null Then Return
		If lineTxt = "" Then Return
		
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		Local kwUp:= keyword.ToUpper()
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				If tok.ToUpper() = kwUp Then
					While p < n
						While p < n And (lineTxt[p] = 32 Or lineTxt[p] = 9)
							p += 1
						Wend
						
						If p >= n Then Exit
						
						Local c3:Int = lineTxt[p]
						If Not (IsALetter(c3) Or c3 = 95) Then Exit
						
						Local s2:Int = p
						p += 1
						While p < n
							Local c4:Int = lineTxt[p]
							If IsALetter(c4) Or c4 = 95 Or c4 >= 48 And c4 <= 57 Then
								p += 1
							Else
								Exit
							EndIf
						Wend
						
						Local nm:= MidString(lineTxt, s2 + 1, p - s2)
						If nm <> "" Then dest.Set(nm, 1)
						
						While p < n And (lineTxt[p] = 32 Or lineTxt[p] = 9)
							p += 1
						Wend
						
						If p < n And lineTxt[p] = 44 Then
							p += 1
							Continue
						EndIf
						
						Exit
					Wend
				EndIf
				
				Continue
			EndIf
			
			p += 1
		Wend
	End
	
	Method MapHasKey:Int(mp:StringMap<Int>, key:String)
		If mp = Null Then Return 0
		If mp.Contains(key) Then Return 1
		Return 0
	End
	
	Method BuildLocalsForScope: StringMap<Int>(scopeId:Int)
		Local out:= New StringMap<Int>
		If scopeId < 0 Or scopeId >= scopeInfoCount Then Return out
		
		Local sc:= scopeInfos[scopeId]
		Local l1:Int = sc.startLine
		Local l2:Int = sc.endLine
		
		If l1 < 0 Then l1 = 0
		If l2 >= doc.numtotallines Then l2 = doc.numtotallines - 1
		
		For Local ln:Int = l1 To l2
			Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
			For Local i:Int = 0 To toks.Length - 1
				If toks[i].ToUpper() = "LOCAL" Then
					AddDeclNamesFromTokens(out, toks, i)
				EndIf
			Next
		Next
		
		Return out
	End
	
	Method HL_IsFieldOfTypeUp:Int(typeUp:String, fieldUp:String)
		If typeUp = "" Or fieldUp = "" Then Return 0
		
		Local tUp:String = AC_TypeIdNormUp(typeUp)
		Local fUp:String = fieldUp.ToUpper()
		If tUp = "" Or fUp = "" Then Return 0
		
		For Local ci:Int = 0 To scopeClassCount - 1
			If scopeClasses[ci].nameUp <> tUp Then Continue
			Local flds:StringMap<Int> = scopeClasses[ci].fields
			If flds = Null Then Continue
			If MapHasKey(flds, fieldUp) Or MapHasKey(flds, fUp) Then Return 1
		Next
		
		If SYM_FindFieldTypeUp(tUp, fUp) <> "" Then Return 1
		
		Return 0
	End
	
	Method HL_QualifiedMemberIsInstanceField:Int(lineTxt:String, tokStart:Int, idl:Int, tok:String)
		If Not HL_TokenIsMemberAfterDot(lineTxt, tokStart) Then Return 0
		
		Local q:Int = tokStart - 1
		While q >= 0
			Local cq:Int = lineTxt[q]
			If cq = 32 Or cq = 9 Then
				q -= 1
				Continue
			EndIf
			Exit
		Wend
		
		If q < 0 Or lineTxt[q] <> 46 Then Return 0
		
		Local ownerStr:String = HL_ReadIdentBeforeDot(lineTxt, q)
		If ownerStr = "" Then Return 0
		
		Local ownerTypeUp:String = HL_ResolveOwnerTypeUp(ownerStr.ToUpper(), idl)
		If ownerTypeUp = "" Then Return 0
		
		Return HL_IsFieldOfTypeUp(ownerTypeUp, tok.ToUpper())
	End
	
	Method HL_IsClassNameUp:Int(nameUp:String)
		If nameUp = "" Then Return 0
		
		EnsureHLCallableNameCache
		
		For Local ci:Int = 0 To scopeClassCount - 1
			If scopeClasses[ci].nameUp = nameUp Then Return 1
		Next
		
		If hlClassNamesUp.Contains(nameUp) Then Return 1
		
		Local v:Int = IDE_GetParserCycleId()
		If hlIsTypeCacheVersion <> v Then
			hlIsTypeCacheVersion = v
			hlIsTypeCache = New StringMap<Int>
		EndIf
		If hlIsTypeCache.Contains(nameUp) Then Return hlIsTypeCache.Get(nameUp)
		
		Local res:Int = 0
		If AC_IsKnownTypeUp(nameUp) Then res = 1
		
		hlIsTypeCache.Set(nameUp, res)
		Return res
	End
	
	Method HL_ResolveOwnerTypeUp:String(ownerUp:String, idl:Int)
		If ownerUp = "" Then Return ""
		
		If ownerUp = "SELF" Or ownerUp = "SUPER" Then
			If idl >= 0 And idl < scopeClassAtLine.Length Then
				Local cid:Int = scopeClassAtLine[idl]
				If cid >= 0 And cid < scopeClassCount Then
					If ownerUp = "SUPER" And scopeClasses[cid].extendsUp <> "" Then
						Return scopeClasses[cid].extendsUp
					EndIf
					Return scopeClasses[cid].nameUp
				EndIf
			EndIf
			Return ""
		EndIf
		
		If HL_IsClassNameUp(ownerUp) Then Return AC_TypeIdNormUp(ownerUp)
		
		Local v:Int = SYM_GetGlobalVersion()
		If hlOwnerTypeCacheVer <> v Or hlOwnerTypeCacheGen <> scopeLayoutGen Then
			hlOwnerTypeCacheVer = v
			hlOwnerTypeCacheGen = scopeLayoutGen
			hlOwnerTypeCache = New StringMap<String>
		EndIf
		
		Local scId:Int = -1
		If idl >= 0 And idl < scopeMethodAtLine.Length Then scId = scopeMethodAtLine[idl]
		If scId < 0 And idl >= 0 And idl < scopeFuncAtLine.Length Then scId = scopeFuncAtLine[idl]
		Local clId:Int = -1
		If idl >= 0 And idl < scopeClassAtLine.Length Then clId = scopeClassAtLine[idl]
		Local key:String = ownerUp + "@" + scId + "," + clId
		
		If hlOwnerTypeCache.Contains(key) Then Return hlOwnerTypeCache.Get(key)
		
		Local res:String = AC_FindTypeOfIdentUp(ownerUp, idl)
		hlOwnerTypeCache.Set(key, res)
		Return res
	End
	
	Method FillScopedColorMapForLine:Int[](idl:Int, idl1:Int, endi:Int)
		If endi < idl1 Then
			Local empty:Int[]
			Return empty
		EndIf

		Local fsT0:Int = Millisecs()
		EnsureHLCallableNameCache
		
		Local map:Int[endi - idl1 + 1]
		For Local i:Int = 0 To map.Length - 1
			map[i] = -1
		Next
		
		' scopeReady decide se prendere local e field dalla cache (O(1)) oppure
		' ricostruirli scansionando il documento.
		'
		' Prima richiedeva la cache PERFETTAMENTE corrente, quindi per tutta la
		' finestra "sporca" dopo ogni modifica ogni riga ripiegava su
		' HL_EnsureClassFieldsForHighlight, che riscansiona dalla riga della classe
		' fino a quella corrente e riparte da zero ogni volta che cambia la classe
		' di riferimento. Misurato: 350 ms su 366 del costo totale di colorazione.
		'
		' La cache vecchia ma allineata al numero di righe punta ancora alle
		' classi giuste, quindi va benissimo: stesso criterio gia' usato da
		' FindNearestRoutineStart e GetCachedLocalsForRoutine.
		Local scopeReady:Int = 0
		If ScopeCacheIsCurrent() Then
			scopeReady = 1
		ElseIf ScopeCacheUsableStale() Then
			scopeReady = 1
		EndIf
		
		Local locals:StringMap<Int>
		Local classFields:StringMap<Int>
		Local inMethod:Int = 0
		
		Local fsT1:Int = Millisecs()
		Local enc:Int[]
		If HL_RoutineBoundsValid(idl) Then
			enc = New Int[2]
			enc[0] = hlRoutineStart
			enc[1] = hlRoutineIsMethod
		Else
			enc = FindNearestRoutineStart(idl)
		EndIf
		Local routineStart:Int = enc[0]
		inMethod = enc[1]
		
		If routineStart >= 0 Then
			If scopeReady Then
				locals = GetCachedLocalsForRoutine(routineStart, idl, inMethod)
			EndIf
			' Come sopra: su documenti grandi non si ricostruiscono i local
			' riscansionando la routine (era il ripiego da 248 ms). Arrivano
			' dall'indice appena e' pronto.
			If locals = Null And doc.numtotallines <= 1500 Then
				Local fsT2:Int = Millisecs()
				locals = HL_EnsureLocalsForHighlight(routineStart, idl, inMethod)
			EndIf
			
			If inMethod Then
				' La cache di scope sa gia' in quale classe sta la riga: se e'
				' utilizzabile, la sua risposta e' definitiva, ANCHE quando dice
				' "nessuna classe" o "classe senza field".
				Local classKnown:Int = 0

				If scopeReady And idl >= 0 And idl < scopeClassAtLine.Length Then
					classKnown = 1
					Local cid:Int = scopeClassAtLine[idl]
					If cid >= 0 And cid < scopeClassCount Then
						classFields = scopeClasses[cid].fields
					EndIf
				EndIf

				' Ripiego SOLO se la cache non e' utilizzabile.
				'
				' Prima si ripiegava ogni volta che classFields restava Null, cioe'
				' anche quando la cache aveva gia' risposto "questa riga non sta in
				' una classe". E il ripiego non e' gratis: FindEnclosingClassStart
				' scansiona all'indietro fino a riga 0 tokenizzando ogni riga, e
				' quando non trova nulla le percorre tutte. Per ogni riga della
				' pagina: ~192.000 tokenizzazioni, 340 ms misurati su 366 del costo
				' totale di colorazione.
				' Se l'indice di scope non e' utilizzabile si RINUNCIA al colore dei field
				' per questo giro, invece di ricostruirli scansionando il documento.
				' FindEnclosingClassStart risale fino a riga 0 tokenizzando tutto: era il
				' ripiego da 169 ms. I field mancanti tornano da soli appena l'indice e'
				' pronto, perche' la riga viene invalidata e ridipinta.
				' Il ripiego resta solo per documenti piccoli, dove costa poco.
				If classFields = Null And classKnown = 0 And doc.numtotallines <= 1500 Then
					Local fsT3:Int = Millisecs()
					Local clsStart:Int = FindEnclosingClassStart(idl)
					If clsStart < 0 Then clsStart = FindNearestClassStart(routineStart)
					classFields = HL_EnsureClassFieldsForHighlight(clsStart, idl)
				EndIf
			EndIf
		EndIf
		
		Local lineTxt:= GetLineTextByIndex(idl)
		Local n:Int = lineTxt.Length
		Local p:Int = 0
		Local inStr:Int = 0
		
		While p < n
			Local c:Int = lineTxt[p]
			
			If c = 34 Then
				inStr = 1 - inStr
				p += 1
				Continue
			EndIf
			
			If inStr = 0 And c = 39 Then Exit
			
			If inStr = 0 And (IsALetter(c) Or c = 95) Then
				Local s:Int = p
				p += 1
				While p < n
					Local c2:Int = lineTxt[p]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						p += 1
					Else
						Exit
					EndIf
				Wend
				
				Local tok:= MidString(lineTxt, s + 1, p - s)
				Local col:Int = 0
				
				If Not HL_IsKeywordCXS(tok) Then
					Local tokUp:String = tok.ToUpper()
					
					Local q:Int = s - 1
					While q >= 0
						Local cq:Int = lineTxt[q]
						If cq = 32 Or cq = 9 Then
							q -= 1
							Continue
						EndIf
						Exit
					Wend
					If q >= 0 And lineTxt[q] = 46 Then
						Local ownerStr:String = HL_ReadIdentBeforeDot(lineTxt, q)
						
						' Caso array indicizzato: arr[..].membro  → risolvi il tipo elemento dell'array
						If ownerStr = "" Then
							Local bq:Int = q - 1
							While bq >= 0 And (lineTxt[bq] = 32 Or lineTxt[bq] = 9)
								bq -= 1
							Wend
							If bq >= 0 And lineTxt[bq] = 93 Then
								Local depthB:Int = 0
								Local openB:Int = -1
								Local bi:Int = bq
								While bi >= 0
									Local bc:Int = lineTxt[bi]
									If bc = 93 Then
										depthB += 1
									ElseIf bc = 91 Then
										depthB -= 1
										If depthB = 0 Then
											openB = bi
											Exit
										EndIf
									EndIf
									bi -= 1
								Wend
								If openB >= 0 Then
									Local aq:Int = openB - 1
									While aq >= 0 And (lineTxt[aq] = 32 Or lineTxt[aq] = 9)
										aq -= 1
									Wend
									If aq >= 0 And (IsALetter(lineTxt[aq]) Or lineTxt[aq] = 95 Or lineTxt[aq] >= 48 And lineTxt[aq] <= 57) Then
										Local ae:Int = aq
										While aq >= 0 And (IsALetter(lineTxt[aq]) Or lineTxt[aq] = 95 Or lineTxt[aq] >= 48 And lineTxt[aq] <= 57)
											aq -= 1
										Wend
										' aq+1 = primo carattere dell'ident: deve essere lettera/underscore (no numeri)
										If aq + 1 <= ae And (IsALetter(lineTxt[aq + 1]) Or lineTxt[aq + 1] = 95) Then
											Local arrName:String = MidString(lineTxt, aq + 2, ae - aq)
											If arrName <> "" Then
												Local arrTy:String = AC_StripOneArrayBracketSuffixUp(HL_ResolveOwnerTypeUp(arrName.ToUpper(), idl))
												If arrTy <> "" And HL_IsFieldOfTypeUp(arrTy, tokUp) Then col = 7
											EndIf
										EndIf
									EndIf
								EndIf
							EndIf
						EndIf
						
						If ownerStr <> "" Then
							Local ownerUp:String = ownerStr.ToUpper()
							Local ownerTypeUp:String = HL_ResolveOwnerTypeUp(ownerUp, idl)
							If ownerTypeUp <> "" And HL_IsFieldOfTypeUp(ownerTypeUp, tokUp) Then
								' Membro confermato come campo del tipo dell'owner: e' sempre colore campo (7),
								' anche se il nome coincide con funzioni/metodi globali di altri moduli (es. x1/y1 in Cerberus).
								col = 7
							EndIf
							Local ownerIsLocal:Int = 0
							If locals <> Null And (MapHasKey(locals, ownerStr) Or MapHasKey(locals, ownerUp)) Then ownerIsLocal = 1
							If inMethod And classFields <> Null And (MapHasKey(classFields, ownerStr) Or MapHasKey(classFields, ownerUp)) Then ownerIsLocal = 1
							If HL_IsClassNameUp(ownerUp) And ownerIsLocal = 0 Then
								Local oq:Int = q - 1
								While oq >= 0
									Local co:Int = lineTxt[oq]
									If co = 32 Or co = 9 Then
										oq -= 1
										Continue
									EndIf
									Exit
								Wend
								If oq >= 0 And (IsALetter(lineTxt[oq]) Or lineTxt[oq] = 95) Then
									Local oe:Int = oq
									oq -= 1
									While oq >= 0
										Local c2o:Int = lineTxt[oq]
										If IsALetter(c2o) Or c2o = 95 Or c2o >= 48 And c2o <= 57 Then
											oq -= 1
										Else
											Exit
										EndIf
									Wend
									Local oStart:Int = oq + 1
									For Local ko:Int = oStart To oe
										Local idxo:Int = idl1 + ko
										If idxo <= endi Then map[idxo - idl1] = 9
									Next
								EndIf
							EndIf
						EndIf
					EndIf
					
					If col = 0 Then
						If locals <> Null And (MapHasKey(locals, tok) Or MapHasKey(locals, tokUp)) Then
							col = 6
						ElseIf inMethod And classFields <> Null And (MapHasKey(classFields, tok) Or MapHasKey(classFields, tokUp)) Then
							col = 7
						ElseIf inMethod And MapHasKey(scopeFieldsCase, tok) Then
							col = 7
						ElseIf HL_IsClassNameUp(tokUp) Then
							col = 9
						ElseIf MapHasKey(scopeGlobalsCase, tok) Or MapHasKey(hlGlobalNamesCase, tok) Then
							col = 5
						EndIf
					EndIf
				EndIf
				
				If col > 0 Then
					For Local k:Int = s To p - 1
						Local idx:Int = idl1 + k
						If idx <= endi Then
							map[idx - idl1] = col
						EndIf
					Next
				EndIf
				
				Continue
			EndIf
			
			p += 1
		Wend
		
		Return map
	End
	
	Method ApplyScopedVariableColorsOnLine(idl:Int, idl1:Int, endi:Int)
		Local map:= FillScopedColorMapForLine(idl, idl1, endi)
		For Local i:Int = idl1 To endi
			Local col:Int = map[i - idl1]
			If col >= 0 Then
				Local c3:Int = doc.Crs[i] & 255
				doc.Crs[i] = c3 | col * 256
			EndIf
		Next
	End
	
