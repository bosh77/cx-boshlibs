		doc.NextURstates

		
	End
	
	Method ReplaceAllString(xxca, yyca, wwca, hhca)
	
		findstring = blEvents.FindText()
		replstring = blEvents.ReplText()
		
		If findstring = "" Then Return
		
		Local i = 0
	
		Local nrepl = 0
		
		Repeat
	
			If i >= doc.Crs.Length - 1 Then Exit
			
			Local find:Bool = True
			
			For Local j = 0 To findstring.Length - 1
			
				Local k = i + j
				
				If k >= doc.Crs.Length - 1 Then i = 0; Exit
				
				Local c = doc.Crs[k] & 255
				Local c2 = findstring[j]
				
				If c >= 65 and c <= 90 Then c = c + 32
				If c2 >= 65 and c2 <= 90 Then c2 = c2 + 32
				
				If c <> c2 Then find = False; Exit
								
			Next
		
			If find Then
				
				idstartsel = i
				idendsel = i + findstring.Length
								
				ReplaceS(xxca, yyca, wwca, hhca)
				
				nrepl = nrepl + 1
				
								
				Local l = replstring.Length - 1
				
				'If l < 0 Then l = 0
				
				i = i + l
				
			EndIf
				
			i = i + 1 'replstring.Length
			
			'If i = i2 Then Exit

			'i3 = i3 + 1
			If i >= doc.Crs.Length - 1 Then Exit

		Forever
	
		Notify("All Strings Replaced", nrepl + " strings replaced")
		
	End
	
	Method ReplaceString(xxca, yyca, wwca, hhca)
	
		findstring = blEvents.FindText()
		replstring = blEvents.ReplText()
		
		If findstring = "" Then Return
		
		'FindString
						
		Local i = idcaret
		'Local i2 = i
		
		Local i3 = 0
				
		If i = idstartsel Then i = i + 1
				
		Repeat
	
			If i >= doc.Crs.Length - 1 Then i = 0
			
			Local find:Bool = True
			
			For Local j = 0 To findstring.Length - 1
			
				Local k = i + j
				
				If k >= doc.Crs.Length - 1 Then i = 0; Exit
				
				Local c = doc.Crs[k] & 255
				Local c2 = findstring[j]
				
				If c >= 65 and c <= 90 Then c = c + 32
				If c2 >= 65 and c2 <= 90 Then c2 = c2 + 32
				
				If c <> c2 Then find = False; Exit
								
			Next
		
			If find Then
				
				idstartsel = i
				idendsel = i + findstring.Length
								
				ReplaceS(xxca, yyca, wwca, hhca)
				
				idstartsel = i
				idendsel = i + replstring.Length
				GetCursorLine
				line = linecaret - 8
				'
				i = idendsel - 1
				'
				If line < 0 Then line = 0
				'
				i3 = i3 + 1
				Exit
								
			EndIf
				
			i = i + 1
			'If i = i2 Then Exit

			i3 = i3 + 1
			If i3 > doc.Crs.Length Then Exit

		Forever
	
	End Method
	
	Method ReplaceS(xxca, yyca, wwca, hhca)
		
		SaveForReplaceString()

		CancSelected()

		Local txt:= replstring
		
		For Local i:Int = 0 To txt.Length - 1

			Local c:Int = txt[i]
			InsChar(c)

		Next

		MakeLines()
			
		CaretOutOfScreen(xxca, yyca, wwca, hhca)

		
		NotifyDocEdited
		
		'RefreshJoins(Self)
				
		'SetCurrentLine(False)
		
	End Method

	Method SaveForReplaceString()
	
		Local urs:= New URstate
		
		urs.modeur = 1
		
		Local idsel1:Int = idstartsel
		Local idsel2:Int = idendsel

		If idstartsel > idendsel Then
			idsel1 = idendsel
			idsel2 = idstartsel
		EndIf

		Local l:Int = idsel2 - idsel1
		
		Local cc2:Int[l]
		
		For Local i = 0 To l - 1
			cc2[i] = doc.Crs[idsel1 + i]
		Next
		
		urs.crs2 = cc2
		urs.idstartc2 = idsel1
		urs.idendc2 = idsel2
		
		
		Local txt:String = replstring
		
		If txt <> "" Then
		
			Local cc3:Int[txt.Length]
			
			For Local i:Int = 0 To txt.Length - 1

				Local c:Int = txt[i]
				cc3[i] = c
			
			Next
		
			urs.crs3 = cc3
			urs.idstartc3 = idstartsel
			urs.idendc3 = idstartsel + txt.Length
		
		EndIf
		
		urs.poscar = idstartsel
		
		doc.URstates[doc.idurstates] = urs
		
		doc.NextURstates
			
	End Method
	
	
	
		
		
	Method ParseLine()
		
		'note: PARSE LINE
		
		'Return
		
		If textchangedit = 0 Then Return
		
		textchangedit = 0
		
		' Su file enormi il riformattatore riga (InsertBlock+MakeLines2+RefreshShortcuts) blocca l'IDE.
		If IDE_FileIsLarge() Then Return
		
		GetCursorLine
		
		If linecaret = saveline Then Return
		
		Local tgtLn:Int = linecaret
		Local idlx:Int = idcaret - doc.idline[tgtLn]
		If idlx < 0 Then idlx = 0
		
		'GetCursorLine
		
		Local ln = saveline
		
		If ln < 0 or ln > doc.idline.Length - 2 Then Return
	
			
		Local idl1:Int = doc.idline[ln]
		Local idl2:Int = doc.idline[ln + 1] - 2
			
		'scan line
		Local lin:String
		Local virg:Int
		Local apos:Int
		Local space:Int = -1
		
		Local crs2:Int[65536]
		Local idcrs2:Int
		
		For Local i:Int = idl1 To idl2

			Local c:Int = doc.Crs[i]

			local c1:Int= c & 255
			
			If c1 = 34 and apos = 0 Then virg = virg ~ 1
			If c1 = 39 and virg = 0 Then apos = 1
			
			If virg = 0 and c1 = 32 and space >= 0 Then space = space + 1
			If c1 <> 32 or apos = 1 Then space = 0
			
			'If space < 2 Then lin = lin + String.FromChar(c1)
			
			If space < 2 Then
			
				crs2[idcrs2]=c1
				idcrs2 = idcrs2 + 1
			 
			EndIf
			
		Next
		
		virg = 0
		apos = 0
		
		Local crs3:Int[65536]
		Local idcrs3:Int

		For Local i:Int = 0 To idcrs2 - 1
				
			'Local cnt:Int = 0
			
			Local c1:Int = crs2[i]
			
			If c1 = 34 and apos = 0 Then virg = virg ~ 1
			If c1 = 39 and virg = 0 Then apos = 1
			
			If apos = 0 and virg = 0 Then
				
				'X, Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 44 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 44 and crs2[i + 1] <> 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					Continue
				
				EndIf

				'X; Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 59 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 59 and crs2[i + 1] <> 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					Continue
				
				EndIf
				
				'X:Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 58 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 58 and crs2[i + 1] = 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				
				'X(Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 40 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 40 and crs2[i + 1] = 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				'X)
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 41 Then
				
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
			
				')Y
				If c1 = 41 and crs2[i + 1] = 32 and IsAnOperand(crs2[i + 2]) = False Then
								
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				'X[Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 91 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 91 and crs2[i + 1] = 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				'X]Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 93 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 93 and crs2[i + 1] = 32 and IsAnOperand(crs2[i + 2]) = False Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				'X = Y
				If c1 <> 32 and c1 <> 58 and c1 <> 60 and c1 <> 62 and crs2[i + 1] = 61 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					Continue
					
				EndIf
				
				If c1 = 61 and crs2[i + 1] <> 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					Continue
				
				EndIf

				'X operand Y
				If c1 <> 32 and c1 <> 58 and c1 <> 40 and c1 <> 41 and c1 <> 91 and c1 <> 93 and c1 <> 60 and c1 <> 61 and c1 <> 62 and IsAnOperand(crs2[i + 1]) Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					'cnt = 1
					Continue
				EndIf
				
				
				') operand
				If c1 = 41 and IsAnOperand(crs2[i + 1]) Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = crs2[i + 1]
					idcrs3 = idcrs3 + 1
					i = i + 1
					
					
					If crs2[i + 1] <> 32 Then
						crs3[idcrs3] = 32
						idcrs3 = idcrs3 + 1

					EndIf
					
					Continue
				
				EndIf

				If IsAnOperand(c1) and crs2[i + 1] <> 32 and crs2[i + 1] <> 60 and crs2[i + 1] <> 62 and crs2[i + 1] <> 61 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					Continue
				
				EndIf

				
				'] operand
				If c1 = 93 and IsAnOperand(crs2[i + 1]) Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = 32
					idcrs3 = idcrs3 + 1
					crs3[idcrs3] = crs2[i + 1]
					idcrs3 = idcrs3 + 1
					i = i + 1
					
					If crs2[i + 1] <> 32 Then
						crs3[idcrs3] = 32
						idcrs3 = idcrs3 + 1

					EndIf

					Continue
				
				EndIf

				
				'X.Y
				If IsALetterOrDigitOrVirg(c1) and crs2[i + 1] = 32 and crs2[i + 2] = 46 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
				
				If c1 = 46 and crs2[i + 1] = 32 Then
				
					crs3[idcrs3] = c1
					idcrs3 = idcrs3 + 1
					i = i + 1
					Continue
				
				EndIf
							
			EndIf
			
			
			'If cnt = 0 Then
			crs3[idcrs3] = c1
			idcrs3 = idcrs3 + 1
			'EndIf
			
		Next
		
				
		'crs3 = crs3.Resize(idcrs3)
		'lin = String.FromChars(crs3) + " "
		
		For Local i:Int = idcrs3 - 1 To 0 Step - 1
		
			Local c = crs3[i]
		
			If c = 13 or c = 10 or c = 32 or c = 0 Then idcrs3 = idcrs3 - 1 Else Exit
		
		Next
		
		crs3 = crs3.Resize(idcrs3)
		
		lin = String.FromChars(crs3)
		
		'end scan line
		
		'Print "<" + lin + ">"
		
		'lin = TrimEndAll2(lin)

		SaveParseLineToUR(idl1, idl2, lin)
						
		'idcaret = idl1
		
		'Local l2 = linecaret
				
		CancelBlock(idl1, idl2)
		
		'idcaret = idl1
		
		'For Local i = 0 To lin.Length - 1
			
		'	InsChar(lin[i])
		 
		'Next
		
		Local lb = lin.Length
		
		InsertBlock(idl1, idl1 + lb, lin.ToChars)
				
		MakeLines2()

		doc.textchanged = 1
		'textchangedin = 1
		
		'RefreshJoins(Self)

		Local tl:Int = tgtLn
		If tl < 0 Then tl = 0
		If doc.idlines >= 2 And tl > doc.idlines - 2 Then tl = doc.idlines - 2
		
		Local row0:Int = doc.idline[tl]
		Local row1:Int = doc.idline[tl + 1]
		Local textCols:Int = row1 - row0 - 2
		If textCols < 0 Then textCols = 0
		If idlx > textCols Then idlx = textCols

		idcaret = row0 + idlx
		
		GetCursorLine
		
		'If idcaret >= idline[l2 + 2] Then idcaret = idline[l2 + 2]
		
		If doc.numtotallines <= 8000 Then RefreshShortcuts Else MarkShortcutsDirty()

	End Method
	
	
	
End


Global maxlines = 200000 '********

Class blDocument Extends blDoc
		
	'Field filename:String
		
	' fullname e' ereditato da blDoc
	' projname e' ereditato da blDoc
	Const stepcrs = 256
	Field Crs:Int[stepcrs]
	
	Field idlines:Int
	Field idline:Int[maxlines + 1]
	
	Field idurstates:Int
	Field idurstates2:Int
	
	Const maxur = 2047 '?  (511 is better?)
	Field URstates:URstate[maxur + 1]


	
	Field numtotallines
	Field numtotallines2
	
	Field ww2
	
	Field textchanged
	
	Field textlocked
	
	Field language:Int

	' Per il C/C++: "questa riga comincia gia' dentro un /* */".
	' I colorer lavorano una riga per volta e non si passano niente fra loro -
	' al BASIC non serve, non ha commenti a blocco - quindi lo stato dei /* */
	' va calcolato a parte, in una passata sola su tutto il file, e riletto qui
	' riga per riga. Lo riempie HL_CLikeScanBlockComments da MakeLines2.
	Field remAtLineStart:Int[]


	' sclist e' ereditato da blDoc
	'Field bookmarks:blShortcut
	'Field labels:blShortcut
	
	Method New(filnam:String)
		
		'fullname = filnam
	
		filnam = AdjustPath(filnam)

		Self.fullname = filnam
		Self.projname = os.StripDir(filnam)

		' Quale colorazione: la decide l'estensione del file.
		Self.language = blHLLanguageFromExt(filnam)


		'Self.fullname = AdjustPath(Self.fullname)
		'filnam = AdjustPath(filnam)


		LoadFile filnam
		
		
	End Method

	Method New()
	
		'Text = "CIAO" + invio
		
		Crs = Crs.Resize(256)
		
		'Local l:Int = Crs.Length
		
		'Print l
		
	End
	
	Method SaveFile(filename:String)
		
	
		Local l:Int = Crs.Length
		
		'********
		For Local i:Int = l - 1 To 0 Step - 1
			
			If Crs[i] = 0 Then
				
				l = l - 1
			
			Else
			  
				i = -1
			
			EndIf
		
		Next
		
		
		Local datag:DataBuffer
		datag = New DataBuffer(l)

		Local j:Int=0
    
		For Local k:Int = 0 To l - 1

			Local d:Int = Crs[k] & 255
			
			datag.PokeByte(j,d)
    
			j=j+1

		Next k
   	
		Local ddes:String = filename
		Local file:= FileStream.Open(ddes, "w")
			
		If file Then
			file.Write datag,0,datag.Length
			file.Close
		EndIf
		
		datag.Discard

		textchanged = 0

		' Salvataggio fatto dall'IDE: riallineo il timbro del file-watcher,
		' altrimenti la scrittura verrebbe rilevata come modifica esterna.
		BLFILES_WatchTouch(filename)
		If filename <> fullname Then BLFILES_WatchTouch(fullname)

	End Method
	
	Method LoadFile(filename:String)
		
		Local ddes:String = filename
		
		'Print filename
		
				
		If os.FileType(ddes) = os.FILETYPE_NONE Then Return 0
	
		'Print "LOADING"
		
		Local ext:String = os.ExtractExt(filename).ToUpper
		
		If ext = "ASM" or ext = "Z80" Then language = 1
		
		If ext = "ROM" or ext = "BIN" Then
			
			'Text = DisassemblerZ80(filename)
			
			fullname = LeftString(filename, filename.Length - 4) + "__.asm"
			projname = os.StripDir(fullname)
			
			'SaveFile(fullname)
			
			language = 1
						
			'Print fullname
			
		Else
		
			Local datag2:DataBuffer
			datag2 = DataBuffer.Load(ddes)

			Local l:Int = datag2.Length
			Local dt:Int[l]
			For Local k:Int = 0 To l - 1
				dt[k] = datag2.PeekByte(k) & 255
			Next
			Text = StripUtf8BomFromText(String.FromChars(dt))
		
			'Text = Text.Replace(String.FromChar(10), invio)
			datag2.Discard
			
		EndIf
		
		Text = AdjustText(Text)
				
		
		AddHistory filename
		
		Return 1
		
		
		'If RightString(filename.ToUpper, 4) = ".ASM" Then language = 1
		
		
	End Method
	
	Method Text:String() Property
		Local l:Int = Crs.Length
		While l > 0 And (Crs[l - 1] & 255) = 0
			l -= 1
		Wend
		
		If l <= 0 Then Return ""
		
		Local ch:Int[l]
		For Local i:Int = 0 To l - 1
			ch[i] = Crs[i] & 255
		Next
		
		Return String.FromChars(ch)
			
	End
	
	Method GetLineTextByIndex:String(ln:Int)
		If ln < 0 Or ln >= numtotallines Then Return ""
		
		Local s:Int = idline[ln]
		Local e:Int = idline[ln + 1] - 1
		If e < s Then Return ""
		
		While e >= s
			Local c:Int = Crs[e] & 255
			If c <> 13 And c <> 10 Then Exit
			e -= 1
		Wend
		
		If e < s Then Return ""
		
		Local chr:Int[e - s + 1]
		Local k:Int = 0
		
		For Local i:Int = s To e
			chr[k] = Crs[i] & 255
			k += 1
		Next
		
		Return String.FromChars(chr)
	End
	
	Method Text(text:String) Property
	
		Local ch:= text.ToChars()
		Local clean:Int[ch.Length]
		Local n:Int = 0
		
		For Local i:Int = 0 To ch.Length - 1
			Local c:Int = ch[i] & 255
			If c <> 0 Then
				clean[n] = c
				n += 1
			EndIf
		Next
		
		If n + 2 > Crs.Length Then
			Crs = Crs.Resize(n + 256)
		EndIf
		
		For Local i:Int = 0 To Crs.Length - 1
			Crs[i] = 0
		Next
		
		For Local i:Int = 0 To n - 1
			Crs[i] = clean[i]
		Next
		
		Crs[n] = 0
		Crs[n + 1] = 0
		
	End
	
	Function AdjustText:String(txt:String)
		
	
		If txt.Contains(String.FromChar(13)) and txt.Contains(String.FromChar(10)) Then
	
			'OK
			Return txt
	
		ElseIf txt.Contains(String.FromChar(10)) Then
	
			txt = txt.Replace(String.FromChar(10), invio)
		
		ElseIf txt.Contains(String.FromChar(13)) Then
	
			txt = txt.Replace(String.FromChar(13), invio)
		
		EndIf
	
	
		Return txt
		
		
	End
	
	Function TrimEndChr:String(var:String, chr:String)
	
		Local l = var.Length
		Local c2 = chr[0]
	
		For Local i:Int = var.Length - 1 To 0 Step - 1
		
			Local c = var[i]
		
			If c = c2 Then l = l - 1 Else Exit
		
		Next

		Return LeftString(var, l)
	
	End
	
	
	
	Method NextURstates()

		idurstates = idurstates + 1

		If idurstates > maxur Then idurstates = 0

		URstates[idurstates] = Null
		
		Local id:Int = idurstates

		If id = idurstates2 Then

			idurstates2 = idurstates2 + 1
			If idurstates2 > maxur Then idurstates2 = 0

		End If
		
	End Method
	
	
	
	
	
End

Class URstate
	
	Private
	
	Field crssaved:Int[]
	Field crssaved2:Int[]
	Field poscaret:Int
	Field _idstartc2:Int
	Field _idendc2:Int
	Field _idstartc3:Int
	Field _idendc3:Int
	
	Public
	
	Field lencrs:Int = -1
	Field modeur:Int
	
	
	Method crs2:Int[] () Property
	
		Return crssaved

	End
	
	Method crs2:Int(value:Int[]) Property

		crssaved = crssaved.Resize(value.Length)

		For Local i:Int = 0 To crssaved.Length - 1
			crssaved[i] = value[i]
		Next

	End

	Method crs3:Int[] () Property
	
		Return crssaved2

	End
	
	Method crs3:Int(value:Int[]) Property

		crssaved2 = crssaved2.Resize(value.Length)

		For Local i:Int = 0 To crssaved2.Length - 1
			crssaved2[i] = value[i]
		Next

	End
        
	Method poscar:Int() Property
           
		Return poscaret

	End
	
	Method poscar:Void(valuex:Int) Property

		poscaret = valuex

	End

	Method idstartc2:Int() Property
           
		Return _idstartc2

	End
	
	Method idstartc2:Void(valuex:Int) Property

		_idstartc2 = valuex

	End
	
	Method idendc2:Int() Property
           
		Return _idendc2

	End
	
	Method idendc2:Void(valuex:Int) Property

		_idendc2 = valuex

	End

	Method idstartc3:Int() Property
           
		Return _idstartc3

	End
	
	Method idstartc3:Void(valuex:Int) Property

		_idstartc3 = valuex

	End
	
	Method idendc3:Int() Property
           
		Return _idendc3

	End
	
	Method idendc3:Void(valuex:Int) Property

		_idendc3 = valuex

	End

End
