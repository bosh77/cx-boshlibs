	' Parola sotto il caret, con la stessa logica di GoToLabelOnCaret2 (F12):
	' se il caret e' subito dopo la parola o dentro di essa, la si prende
	' comunque. Ritorna "" se sotto il caret non c'e' un identificatore.
	Method WordOnCaret:String()
		If doc = Null Then Return ""
		If doc.Crs.Length <= 0 Then Return ""
		
		Local saveidstart:Int = idstartsel
		Local saveidend:Int = idendsel
		
		Local idc:Int = idcaret
		If idc < 0 Then idc = 0
		If idc > doc.Crs.Length - 1 Then idc = doc.Crs.Length - 1
		
		If idc > 0 Then
			Local c0:Int = doc.Crs[idc] & 255
			If c0 = 13 Or c0 = 10 Then idc -= 1
		EndIf
		
		While idc > 0
			Local c:Int = doc.Crs[idc] & 255
			If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then Exit
			idc -= 1
		Wend
		
		Local cStart:Int = doc.Crs[idc] & 255
		If Not (cStart = 95 Or cStart >= 65 And cStart <= 90 Or cStart >= 97 And cStart <= 122 Or cStart >= 48 And cStart <= 57) Then Return ""
		
		SelectWord(idc)
		idstartsel = idselect1
		idendsel = idselect2
		Local w:String = TextSelected
		idstartsel = saveidstart
		idendsel = saveidend
		
		Return w
	End

	Method GoToLabelOnCaret2()
		
		Local saveidstart:Int = idstartsel
		Local saveidend:Int = idendsel
		
		Local idc:Int = idcaret
		If idc < 0 Then idc = 0
		If idc > doc.Crs.Length - 1 Then idc = doc.Crs.Length - 1
		
		If idc > 0 Then
			Local c0:Int = doc.Crs[idc] & 255
			If c0 = 13 Or c0 = 10 Then idc -= 1
		EndIf
		
		While idc > 0
			Local c:Int = doc.Crs[idc] & 255
			If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then Exit
			idc -= 1
		Wend
		
		Local cStart:Int = doc.Crs[idc] & 255
		If Not (cStart = 95 Or cStart >= 65 And cStart <= 90 Or cStart >= 97 And cStart <= 122 Or cStart >= 48 And cStart <= 57) Then Return
		
		Local colHint:Int = (doc.Crs[idc] & 65280) Shr 8
		
		SelectWord(idc)
		
		idstartsel = idselect1
		idendsel = idselect2
		
		Local lab:= TextSelected
		
		idstartsel = saveidstart
		idendsel = saveidend
		
		If lab = "" Then Return
		If Not HL_IsIdentToken(lab) Then Return
		If HL_IsKeywordCXS(lab) Then Return
		
		
		'Print "<" + lab + ">"
		
		
		GetCursorLine
		Local caretLn:Int = linecaret
		If caretLn < 0 Then caretLn = 0
		
		Local identUp:= lab.ToUpper()
		Local curPath:= HL_NormalizePath(doc.fullname)
		
		EnsureScopeVarCache(0)
		Local curClassId:Int = -1
		Local curMethodId:Int = -1
		If caretLn >= 0 And caretLn < scopeClassAtLine.Length Then curClassId = scopeClassAtLine[caretLn]
		If caretLn >= 0 And caretLn < scopeMethodAtLine.Length Then curMethodId = scopeMethodAtLine[caretLn]
		
		Local curClassNameUp:String = ""
		If curClassId >= 0 And curClassId < scopeClassCount Then curClassNameUp = scopeClasses[curClassId].nameUp
		Local curExtendsUp:String = ""
		If curClassId >= 0 And curClassId < scopeClassCount Then curExtendsUp = scopeClasses[curClassId].extendsUp
		
		Local allowMemberLookupScope:Int = 0
		If curClassNameUp <> "" And curClassId >= 0 Then allowMemberLookupScope = 1
		Local allowMemberLookup:Int = allowMemberLookupScope
		
		Local ownerUp:String = ""
		Local ownerFromTypeInference:Int = 0
		Local ownerImplicit:Int = 0
		Local argCountHint:Int = -1
		Local argTypesHint:String[]
		Local selA:Int = idselect1
		Local selB:Int = idselect2
		If selA > selB Then
			Local tmp:=selA; selA = selB; selB = tmp
		EndIf
		
		Local chainUp:String[]
		Local p:Int = selA - 1
		While p >= 0 And (doc.Crs[p] & 255) = 32
			p -= 1
		Wend
		If p >= 0 And (doc.Crs[p] & 255) = 46
			p -= 1
			While p >= 0 And (doc.Crs[p] & 255) = 32
				p -= 1
			Wend
			
			Local endp:Int = p
			While p >= 0
				Local c:Int = doc.Crs[p] & 255
				If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then
					p -= 1
					Continue
				EndIf
				Exit
			Wend
			Local startp:Int = p + 1
			If endp >= startp Then
				Local owner:String = ""
				For Local j:Int = startp To endp
					owner += String.FromChar(doc.Crs[j] & 255)
				Next
				ownerUp = owner.ToUpper()
				
				chainUp = chainUp.Resize(1)
				chainUp[0] = ownerUp
				
				Local seek:Int = startp - 1
				While seek >= 0
					While seek >= 0 And (doc.Crs[seek] & 255) = 32
						seek -= 1
					Wend
					If seek < 0 Or (doc.Crs[seek] & 255) <> 46 Then Exit
					
					seek -= 1
					While seek >= 0 And (doc.Crs[seek] & 255) = 32
						seek -= 1
					Wend
					
					Local endq:Int = seek
					While seek >= 0
						Local c:Int = doc.Crs[seek] & 255
						If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then
							seek -= 1
							Continue
						EndIf
						Exit
					Wend
					Local startq:Int = seek + 1
					If endq < startq Then Exit
					
					Local seg:String = ""
					For Local j:Int = startq To endq
						seg += String.FromChar(doc.Crs[j] & 255)
					Next
					
					Local n:Int = chainUp.Length
					chainUp = chainUp.Resize(n + 1)
					For Local k:Int = n To 1 Step -1
						chainUp[k] = chainUp[k - 1]
					Next
					chainUp[0] = seg.ToUpper()
				Wend
			EndIf
		EndIf
		
		If ownerUp = "SELF" Then ownerUp = curClassNameUp
		If ownerUp = "SUPER" Then
			If curExtendsUp <> "" Then ownerUp = curExtendsUp Else ownerUp = curClassNameUp
		EndIf
		
		If chainUp.Length >= 2 Then
			Local baseTypeUp:String = ""
			Local baseUp:String = chainUp[0]
			
			If baseUp = "SELF" Then baseUp = curClassNameUp
			If baseUp = "SUPER" Then
				If curExtendsUp <> "" Then baseUp = curExtendsUp Else baseUp = curClassNameUp
			EndIf
			
			If baseUp = curClassNameUp Or baseUp = curExtendsUp Then
				baseTypeUp = baseUp
			Else
				Local inferredBaseUp:String = ""
				For Local ln:Int = caretLn To 0 Step -1
					Local lineTxt:= GetLineTextByIndex(ln)
					If lineTxt = "" Then Continue
					
					Local toks:= SYM_TokenizeLineSimple(lineTxt)
					Local ty:= SYM_FindVarTypeInLine(toks, baseUp)
					If ty <> "" Then
						inferredBaseUp = ty.ToUpper()
						Exit
					EndIf
				Next
				
				If inferredBaseUp <> "" Then baseTypeUp = inferredBaseUp Else baseTypeUp = baseUp
			EndIf
			
			For Local idx:Int = 1 To chainUp.Length - 1
				Local segUp:String = chainUp[idx]
				Local tyUp:= SYM_FindFieldTypeUp(baseTypeUp, segUp)
				If tyUp = "" Then
					baseTypeUp = ""
					Exit
				EndIf
				baseTypeUp = tyUp
			Next
			
			If baseTypeUp <> "" Then
				ownerUp = baseTypeUp
				ownerFromTypeInference = 1
			EndIf
		EndIf
		
		If ownerUp <> "" And ownerUp <> curClassNameUp And ownerUp <> curExtendsUp Then
			Local inferredOwnerUp:String = ""
			For Local ln:Int = caretLn To 0 Step -1
				Local lineTxt:= GetLineTextByIndex(ln)
				If lineTxt = "" Then Continue
				
				Local toks:= SYM_TokenizeLineSimple(lineTxt)
				Local ty:= SYM_FindVarTypeInLine(toks, ownerUp)
				If ty <> "" Then
					inferredOwnerUp = ty.ToUpper()
					Exit
				EndIf
			Next
			
			If inferredOwnerUp <> "" Then
				ownerUp = inferredOwnerUp
				ownerFromTypeInference = 1
			EndIf
		EndIf
		
		If ownerUp <> "" And ownerUp <> curClassNameUp And ownerUp <> curExtendsUp Then
			Local ty2:String = SYM_FindVarTypeInSymFiles(ownerUp, curPath, caretLn)
			If ty2 <> "" Then
				ownerUp = ty2
				ownerFromTypeInference = 1
			EndIf
		EndIf
		
		If ownerUp <> "" Then allowMemberLookup = 1 Else allowMemberLookup = allowMemberLookupScope
		If ownerUp = "" And allowMemberLookup Then
			ownerUp = curClassNameUp
			ownerImplicit = 1
		EndIf
		
		Local r:Int = selB
		While r < doc.Crs.Length And (doc.Crs[r] & 255) = 32
			r += 1
		Wend
		If r < doc.Crs.Length And (doc.Crs[r] & 255) = 40
			Local args:String[]
			Local curArg:String = ""
			Local depth:Int = 1
			Local i:Int = r + 1
			
			While i < doc.Crs.Length
				Local ch:Int = doc.Crs[i] & 255
				If ch = 13 Or ch = 10 Then Exit
				
				If ch = 40 Then
					depth += 1
					curArg += String.FromChar(ch)
				ElseIf ch = 41 Then
					depth -= 1
					If depth = 0 Then Exit
					curArg += String.FromChar(ch)
				ElseIf ch = 44 And depth = 1 Then
					Local n:Int = args.Length
					args = args.Resize(n + 1)
					args[n] = curArg
					curArg = ""
				Else
					curArg += String.FromChar(ch)
				EndIf
				
				i += 1
			Wend
			
			If depth = 0 Then
				Local n:Int = args.Length
				args = args.Resize(n + 1)
				args[n] = curArg
			EndIf
			
			If args.Length = 1 And args[0].Trim = "" Then
				argCountHint = 0
				argTypesHint = argTypesHint.Resize(0)
			Else
				argCountHint = args.Length
				argTypesHint = argTypesHint.Resize(args.Length)
				For Local j:Int = 0 To args.Length - 1
					argTypesHint[j] = SYM_InferExprTypeUp(args[j], caretLn)
				Next
			EndIf
		EndIf
		
		' For owner.member(...) calls, try a direct member lookup first.
		' This avoids wrong picks from global score heuristics.
		If ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then
			Local infoM:String = ""
			Local preferStMem:Int = 0
			If ownerFromTypeInference = 0 Then
				preferStMem = HL_IsClassNameUp(ownerUp)
			EndIf
			Local visited0:= New StringMap<Int>
			infoM = AC_FindMemberDeclInSource(ownerUp, identUp, argCountHint, visited0, preferStMem)
			
			If infoM = "" And identUp = "CLEAR" Then
				Local visited0b:= New StringMap<Int>
				infoM = AC_FindMemberDeclInSource(ownerUp, "CLS", argCountHint, visited0b, 0)
			EndIf
			
			If infoM = "" Then
				Local ownerShortUp:String = AC_ShortTypeUp(ownerUp)
				If ownerShortUp <> "" And ownerShortUp <> ownerUp Then
					Local preferSt2:Int = 0
					If ownerFromTypeInference = 0 Then
						preferSt2 = HL_IsClassNameUp(ownerShortUp)
					EndIf
					Local visited1:= New StringMap<Int>
					infoM = AC_FindMemberDeclInSource(ownerShortUp, identUp, argCountHint, visited1, preferSt2)
					If infoM = "" And identUp = "CLEAR" Then
						Local visited1b:= New StringMap<Int>
						infoM = AC_FindMemberDeclInSource(ownerShortUp, "CLS", argCountHint, visited1b, 0)
					EndIf
				EndIf
			EndIf
			
			If infoM <> "" Then
				Local parts:= infoM.Split("|")
				If parts.Length >= 2 Then
					Local fpNorm:String = parts[0]
					Local ln0:Int = Int(parts[1])
					If fpNorm <> "" And ln0 >= 0 Then
						OpenProject(fpNorm, ln0 + 1)
						If focussheet And focussheet.focusbox Then
							Local bx:= focussheet.focusbox
							If ln0 >= 0 And ln0 < bx.doc.idlines - 1 Then
								bx.idcaret = bx.doc.idline[ln0]
								bx.idstartsel = bx.idcaret
								bx.idendsel = bx.idcaret
								bx.lineevid = ln0 + 1
								bx.lineevidcount = 300
							EndIf
						EndIf
						Return
					EndIf
				EndIf
			EndIf
			
			' Fallback: if member is missing in symbol maps, resolve owner type
			' and search the method textually in its class source file.
			Local ownerShortUp:String = AC_ShortTypeUp(ownerUp)
			If ownerShortUp = "" Then ownerShortUp = ownerUp
			If ownerShortUp <> "" Then
				Local typeInfo:String = AC_FindTypeDeclInfo(ownerShortUp)
				If typeInfo <> "" Then
					Local tparts:= typeInfo.Split("|")
					If tparts.Length >= 1 Then
						Local typeFileNorm:String = tparts[0]
						If typeFileNorm <> "" Then
							Local mLn:Int = SYM_FindMethodInClassInFile(typeFileNorm, ownerShortUp, identUp)
							If mLn < 0 And identUp = "CLEAR" Then mLn = SYM_FindMethodInClassInFile(typeFileNorm, ownerShortUp, "CLS")
							If mLn >= 0 Then
								OpenProject(typeFileNorm, mLn + 1)
								If focussheet And focussheet.focusbox Then
									Local bx:= focussheet.focusbox
									If mLn >= 0 And mLn < bx.doc.idlines - 1 Then
										bx.idcaret = bx.doc.idline[mLn]
										bx.idstartsel = bx.idcaret
										bx.idendsel = bx.idcaret
										bx.lineevid = mLn + 1
										bx.lineevidcount = 300
									EndIf
								EndIf
								Return
							EndIf
							
							' Last-resort fallback for Clear: jump to owner type declaration.
							If identUp = "CLEAR" And tparts.Length >= 2 Then
								Local typeLn0:Int = Int(tparts[1])
								If typeLn0 >= 0 Then
									Local mLn2:Int = SYM_FindMemberFromClassStartInFile(typeFileNorm, typeLn0, "CLEAR", "CLS")
									If mLn2 >= 0 Then
										OpenProject(typeFileNorm, mLn2 + 1)
										If focussheet And focussheet.focusbox Then
											Local bx:= focussheet.focusbox
											If mLn2 >= 0 And mLn2 < bx.doc.idlines - 1 Then
												bx.idcaret = bx.doc.idline[mLn2]
												bx.idstartsel = bx.idcaret
												bx.idendsel = bx.idcaret
												bx.lineevid = mLn2 + 1
												bx.lineevidcount = 300
											EndIf
										EndIf
										Return
									EndIf
									
									OpenProject(typeFileNorm, typeLn0 + 1)
									If focussheet And focussheet.focusbox Then
										Local bx:= focussheet.focusbox
										If typeLn0 >= 0 And typeLn0 < bx.doc.idlines - 1 Then
											bx.idcaret = bx.doc.idline[typeLn0]
											bx.idstartsel = bx.idcaret
											bx.idendsel = bx.idcaret
											bx.lineevid = typeLn0 + 1
											bx.lineevidcount = 300
										EndIf
									EndIf
									Return
								EndIf
							EndIf
						EndIf
					EndIf
				EndIf
			EndIf
		EndIf
		
		Local kindHint:String = ""
		Select colHint
			Case 5
				kindHint = "GLOBAL"
			Case 6
				kindHint = "LOCAL"
			Case 7
				kindHint = "FIELD"
			Case 8
				' Colore callable: puo' essere Method o Function. Se non c'e' owner, non forzare METHOD.
				If ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then kindHint = "METHOD" Else kindHint = ""
			Case 9
				kindHint = "CLASS"
			Case 10
				kindHint = "FUNCTION"
		End
		
		Local bestFile:String = ""
		Local bestLine:Int = -1
		Local bestKind:String = ""
		Local bestScore:Int = -1000000

		Local fdCur:SymbolFileData = SYM_GetFile(doc.fullname)
		If fdCur = Null Then fdCur = SYM_GetFile(curPath)
		If fdCur Then
			For Local i:Int = 0 To fdCur.count - 1
				Local decl:= fdCur.decls[i]
				Local bits:= decl.Trim.Split(" ")
				Local knd:String = ""
				If bits.Length > 0 Then knd = bits[0].ToUpper()
				
				Local nmUp:= fdCur.names[i].ToUpper()
				Local exactMatch:Bool = (nmUp = identUp)
				Local suffixMatch:Bool = False
				If Not exactMatch Then
					If nmUp.EndsWith("." + identUp) Then suffixMatch = True
				EndIf
				If suffixMatch And Not allowMemberLookup Then
					If knd <> "CLASS" And knd <> "INTERFACE" And knd <> "ENUMERATE" Then Continue
				EndIf
				If Not exactMatch And Not suffixMatch Then Continue
				
				If kindHint = "LOCAL" And knd <> "LOCAL" Then Continue
				If kindHint = "FIELD" And knd <> "FIELD" Then Continue
				If kindHint = "METHOD" And knd <> "METHOD" Then Continue
				If kindHint = "FUNCTION" And knd <> "FUNCTION" Then Continue
				
				Local score:Int = 0
				Local ln0:Int = fdCur.lines[i]
				Local hasLine:Int = 0
				If ln0 >= 0 Then hasLine = 1
				score += 250
				
				If suffixMatch Then score -= 40
				
				If ownerUp <> "" And suffixMatch Then
					Local fullNmUp:= fdCur.names[i].ToUpper()
					Local d:Int = fullNmUp.FindLast(".")
					If d > 0 Then
						Local leftUp:= LeftString(fullNmUp, d)
						Local leftShortUp:String = AC_ShortTypeUp(leftUp)
						Local ownerShortUp:String = AC_ShortTypeUp(ownerUp)
						If leftUp = ownerUp Or leftShortUp = ownerShortUp Then
							score += 250
						ElseIf AC_IsBaseOfUp(ownerUp, leftUp) Then
							score += 150
						EndIf
					EndIf
				EndIf
				
				If kindHint <> "" Then
					If knd = kindHint Then score += 80 Else score -= 20
				EndIf
				
				If argCountHint >= 0 And (knd = "METHOD" Or knd = "FUNCTION") Then
					Local mm:Int[] = SYM_ParseArgMinMax(decl)
					If mm[0] >= 0 Then
						If argCountHint >= mm[0] And argCountHint <= mm[1] Then score += 120 Else score -= 30
					Else
						Local ac:Int = SYM_ParseArgCount(decl)
						If ac >= 0 Then
							If ac = argCountHint Then score += 120 Else score -= 30
						EndIf
					EndIf
				EndIf
				
				If argTypesHint.Length > 0 And (knd = "METHOD" Or knd = "FUNCTION") Then
					Local declTypes:= SYM_ParseDeclParamTypes(decl)
					If declTypes.Length = argTypesHint.Length Then
						For Local j:Int = 0 To argTypesHint.Length - 1
							score += SYM_TypeScore(declTypes[j], argTypesHint[j])
						Next
					Else
						score -= 10
					EndIf
				EndIf
				
				If knd = "LOCAL" Then
					If hasLine Then
						If ln0 <= caretLn Then score += 50 Else score -= 50
					Else
						score -= 200
					EndIf
				EndIf
				
				If hasLine Then
					score -= Abs(ln0 - caretLn)
				Else
					score -= 500
				EndIf
				
				If score > bestScore Then
					bestScore = score
					bestFile = curPath
					bestLine = ln0
					bestKind = knd
				EndIf
			Next
		EndIf

		If bestFile = "" Then
			Local quickKind:String = kindHint
			If quickKind = "" Then
				If allowMemberLookup Then quickKind = "METHOD" Else quickKind = "GLOBAL"
			EndIf
			
			Local stackKind:Int[64]
			Local stackTop:Int = -1
			Local classDepth:Int = 0
			For Local ln:Int = 0 To doc.numtotallines - 1
				Local lineTxt:= GetLineTextByIndex(ln)
				
				If Not allowMemberLookup And classDepth > 0 And (quickKind = "FUNCTION" Or quickKind = "METHOD" Or quickKind = "FIELD") Then
				Else
					If SYM_LineDefinesIdent(lineTxt, quickKind, identUp) Then
						bestFile = curPath
						bestLine = ln
						bestKind = quickKind
						Exit
					EndIf
				EndIf
				
				Local toks:= SYM_TokenizeLineSimple(lineTxt)
				Local fi:Int = SYM_FirstCodeTokenIndex(toks)
				If fi < toks.Length Then
					Local t0:= toks[fi].ToUpper()
					Local t1:String = ""
					If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()
					
					If t0 = "CLASS" Or t0 = "INTERFACE" Then
						stackTop += 1
						If stackTop > 63 Then stackTop = 63
						stackKind[stackTop] = 1
						classDepth += 1
					ElseIf t0 = "METHOD" Or t0 = "FUNCTION" Then
						stackTop += 1
						If stackTop > 63 Then stackTop = 63
						stackKind[stackTop] = 2
					ElseIf t0 = "END" Then
						Local want:Int = 0
						If t1 = "CLASS" Or t1 = "INTERFACE" Then want = 1
						If t1 = "METHOD" Or t1 = "FUNCTION" Then want = 2
						
						If stackTop >= 0 Then
							If want > 0 Then
								For Local k:Int = stackTop To 0 Step -1
									If stackKind[k] = want Then
										For Local kk:Int = stackTop To k Step -1
											If stackKind[kk] = 1 And classDepth > 0 Then classDepth -= 1
										Next
										stackTop = k - 1
										Exit
									EndIf
								Next
							Else
								If stackKind[stackTop] = 1 And classDepth > 0 Then classDepth -= 1
								stackTop -= 1
							EndIf
						EndIf
					EndIf
				EndIf
				
				If bestFile <> "" Then Exit
			Next
		EndIf
		
		' Prima dei simboli fixed: per funzioni/classi dei moduli Cerberus, i fixed possono
		' contenere riferimenti non apribili. Cerca direttamente nei sorgenti CXpath/modules.
		If bestFile = "" And (ownerUp = "" Or ownerImplicit = 1) Then
			If kindHint = "CLASS" Or kindHint = "" Or kindHint = "GLOBAL" Then
				Local infoCXType:String = AC_SearchTypeDeclInfoInCX(identUp)
				If infoCXType <> "" Then
					Local partsCXType:= infoCXType.Split("|")
					If partsCXType.Length >= 2 Then
						Local fpCXType:String = partsCXType[0]
						Local lnCXType:Int = Int(partsCXType[1])
						If fpCXType <> "" And lnCXType >= 0 Then
							OpenProject(fpCXType, lnCXType + 1)
							If focussheet And focussheet.focusbox Then
								Local bx:= focussheet.focusbox
								If lnCXType >= 0 And lnCXType < bx.doc.idlines - 1 Then
									bx.idcaret = bx.doc.idline[lnCXType]
									bx.idstartsel = bx.idcaret
									bx.idendsel = bx.idcaret
									bx.lineevid = lnCXType + 1
									bx.lineevidcount = 300
								EndIf
							EndIf
							Return
						EndIf
					EndIf
				EndIf
			EndIf
			
			If kindHint = "" Or kindHint = "FUNCTION" Or kindHint = "GLOBAL" Or kindHint = "CONST" Then
				Local cxKinds0:String[] = ["FUNCTION", "GLOBAL", "CONST"]
				If kindHint <> "" And kindHint <> "GLOBAL" And kindHint <> "CONST" Then
					cxKinds0 = cxKinds0.Resize(1)
					cxKinds0[0] = kindHint
				EndIf
				
				For Local ki0:Int = 0 To cxKinds0.Length - 1
					Local infoCXDecl:String = AC_SearchDeclInfoInCX(cxKinds0[ki0], identUp, 0)
					If infoCXDecl = "" Then Continue
					
					Local partsCXDecl:= infoCXDecl.Split("|")
					If partsCXDecl.Length >= 2 Then
						Local fpCXDecl:String = partsCXDecl[0]
						Local lnCXDecl:Int = Int(partsCXDecl[1])
						If fpCXDecl <> "" And lnCXDecl >= 0 Then
							OpenProject(fpCXDecl, lnCXDecl + 1)
							If focussheet And focussheet.focusbox Then
								Local bx:= focussheet.focusbox
								If lnCXDecl >= 0 And lnCXDecl < bx.doc.idlines - 1 Then
									bx.idcaret = bx.doc.idline[lnCXDecl]
									bx.idstartsel = bx.idcaret
									bx.idendsel = bx.idcaret
									bx.lineevid = lnCXDecl + 1
									bx.lineevidcount = 300
								EndIf
							EndIf
							Return
						EndIf
					EndIf
				Next
			EndIf
		EndIf
		
		If bestFile = "" Then
			For Local pass:Int = 0 To 1
				Local m:StringMap<SymbolFileData>
				If pass = 0 Then m = symFiles Else m = symFilesFixed
			
				For Local it:=Eachin m
					Local fp:String = String(it.Key)
					Local fd:SymbolFileData = SymbolFileData(it.Value)
					If fd = Null Then Continue
				
					Local fpNorm:= HL_NormalizePath(fp)
				
					For Local i:Int = 0 To fd.count - 1
						Local decl:= fd.decls[i]
						Local knd:String = SYM_DeclKindUp(decl)
				
						Local nmUp:= fd.names[i].ToUpper()
						Local exactMatch:Bool = (nmUp = identUp)
						Local suffixMatch:Bool = False
						If Not exactMatch Then
							If nmUp.EndsWith("." + identUp) Then suffixMatch = True
						EndIf
						If suffixMatch And Not allowMemberLookup Then
							If knd <> "CLASS" And knd <> "INTERFACE" And knd <> "ENUMERATE" Then Continue
						EndIf
						If Not exactMatch And Not suffixMatch Then Continue
					
						If kindHint = "LOCAL" And knd <> "LOCAL" Then Continue
						If kindHint = "FIELD" And knd <> "FIELD" Then Continue
						If kindHint = "METHOD" And knd <> "METHOD" Then Continue
						If kindHint = "FUNCTION" And knd <> "FUNCTION" Then Continue
					
						Local score:Int = 0
						Local ln0:Int = fd.lines[i]
						Local hasLine:Int = 0
						If ln0 >= 0 Then hasLine = 1
						If fpNorm = curPath Then score += 200
					
						If suffixMatch Then score -= 40
					
						If ownerUp <> "" And suffixMatch Then
							Local fullNmUp:= fd.names[i].ToUpper()
							Local d:Int = fullNmUp.FindLast(".")
							If d > 0 Then
								Local leftUp:= LeftString(fullNmUp, d)
								Local leftShortUp:String = AC_ShortTypeUp(leftUp)
								Local ownerShortUp:String = AC_ShortTypeUp(ownerUp)
								If leftUp = ownerUp Or leftShortUp = ownerShortUp Then
									score += 250
								ElseIf AC_IsBaseOfUp(ownerUp, leftUp) Then
									score += 150
								EndIf
							EndIf
						EndIf
					
						If kindHint <> "" Then
							If knd = kindHint Then score += 80 Else score -= 20
						EndIf
					
						If argCountHint >= 0 And (knd = "METHOD" Or knd = "FUNCTION") Then
							Local mm:Int[] = SYM_ParseArgMinMax(decl)
							If mm[0] >= 0 Then
								If argCountHint >= mm[0] And argCountHint <= mm[1] Then score += 120 Else score -= 30
							Else
								Local ac:Int = SYM_ParseArgCount(decl)
								If ac >= 0 Then
									If ac = argCountHint Then score += 120 Else score -= 30
								EndIf
							EndIf
						EndIf
					
						If argTypesHint.Length > 0 And (knd = "METHOD" Or knd = "FUNCTION") Then
							Local declTypes:= SYM_ParseDeclParamTypes(decl)
							If declTypes.Length = argTypesHint.Length Then
								For Local j:Int = 0 To argTypesHint.Length - 1
									score += SYM_TypeScore(declTypes[j], argTypesHint[j])
								Next
							Else
								score -= 10
							EndIf
						EndIf
					
						If knd = "LOCAL" Then
							If fpNorm <> curPath Then
								score -= 1000
							Else
								If hasLine Then
									If ln0 <= caretLn Then score += 50 Else score -= 50
								Else
									score -= 200
								EndIf
							EndIf
						EndIf
					
						If hasLine Then
							score -= Abs(ln0 - caretLn)
						Else
							score -= 500
						EndIf
					
						If score > bestScore Then
							bestScore = score
							bestFile = fpNorm
							bestLine = ln0
							bestKind = knd
						EndIf
					Next
				Next
			Next
		EndIf
		
		If bestFile = "" Then
			Local useKind:String = kindHint
			If useKind = "" Then
				If allowMemberLookup Then useKind = "METHOD" Else useKind = "GLOBAL"
			EndIf
			
			For Local pass:Int = 0 To 5
				Select pass
					Case 0
						If kindHint <> "" Then useKind = kindHint Else If allowMemberLookup Then useKind = "METHOD" Else useKind = "GLOBAL"
					Case 1
						If kindHint = "" Then useKind = "FUNCTION" Else Continue
					Case 2
						If kindHint = "" Then useKind = "CLASS" Else Continue
					Case 3
						If kindHint = "" And allowMemberLookup Then useKind = "FIELD" Else Continue
					Case 4
						If kindHint = "" Then useKind = "GLOBAL" Else Continue
					Case 5
						If kindHint = "" And allowMemberLookup Then useKind = "LOCAL" Else Continue
				End
				
				Local candFile:String = ""
				Local candLine:Int = -1
				Local candScore:Int = -1000000
				
				If candFile = "" Then
					For Local i:Int = 0 To idsoluzfile - 1
						Local fp0:= soluzfilename[i]
						If fp0 = "" Then Continue
						
						Local ee:= os.ExtractExt(fp0).ToUpper()
						If ee <> "CXS" And ee <> "BMX" Then Continue
						
						Local fpNorm:= HL_NormalizePath(fp0)
						If fpNorm = "" Then Continue
						
						Local ln:Int
						If (useKind = "METHOD" Or useKind = "FUNCTION") And argCountHint >= 0 Then
							ln = SYM_FindDeclLineInFileWithArgs(fpNorm, useKind, identUp, allowMemberLookup, argCountHint)
						Else
							ln = SYM_FindDeclLineInFile(fpNorm, useKind, identUp, allowMemberLookup)
						EndIf
						If ln < 0 Then Continue
						
						Local score:Int = 0
						If fpNorm = curPath Then score += 250
						score -= Abs(ln - caretLn)
						If fpNorm = curPath And ln <= caretLn Then score += 30
						
						If score > candScore Then
							candScore = score
							candFile = fpNorm
							candLine = ln
						EndIf
					Next
				EndIf
				
				If candFile <> "" Then
					bestFile = candFile
					bestLine = candLine
					bestKind = useKind
					Exit
				EndIf
			Next
		EndIf
		
		If bestFile = "" Then
			If kindHint = "" Or kindHint = "FUNCTION" Or kindHint = "METHOD" Or kindHint = "GLOBAL" Or kindHint = "CONST" Or kindHint = "CLASS" Or kindHint = "INTERFACE" Or kindHint = "ENUMERATE" Then
				Local kinds:String[] = ["FUNCTION", "METHOD", "GLOBAL", "CONST", "CLASS", "INTERFACE", "ENUMERATE"]
				If kindHint <> "" Then
					kinds = kinds.Resize(1)
					kinds[0] = kindHint
				EndIf
				
				Local bestDocLine:Int = -1
				Local bestDocKind:String = ""
				Local bestDocScore:Int = -1000000
				
				For Local ki:Int = 0 To kinds.Length - 1
					Local kndWant:String = kinds[ki]
					For Local ln:Int = 0 To doc.numtotallines - 1
						If SYM_LineDefinesIdent(GetLineTextByIndex(ln), kndWant, identUp) Then
							Local sc:Int = -Abs(ln - caretLn)
							If ln <= caretLn Then sc += 20
							If kndWant = "FUNCTION" Then sc += 8
							If kndWant = "METHOD" Then sc += 6
							If sc > bestDocScore Then
								bestDocScore = sc
								bestDocLine = ln
								bestDocKind = kndWant
							EndIf
						EndIf
					Next
				Next
				
				If bestDocLine >= 0 Then
					bestFile = curPath
					bestLine = bestDocLine
					bestKind = bestDocKind
				EndIf
			EndIf
		EndIf
		
		If bestFile = "" Then
			If kindHint = "LOCAL" Then
				Local routineStart:Int = -1
				For Local ln:Int = caretLn To 0 Step -1
					Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
					Local firstIdx:Int = FirstCodeTokenIndex(toks)
					If firstIdx < toks.Length Then
						Local t0:= toks[firstIdx].ToUpper()
						If t0 = "METHOD" Or t0 = "FUNCTION" Then
							routineStart = ln
							Exit
						EndIf
					EndIf
				Next
				
				If routineStart >= 0 Then
					For Local ln:Int = caretLn To routineStart Step -1
						Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
						For Local ti:Int = 0 To toks.Length - 2
							If toks[ti].ToUpper() = "LOCAL" Then
								For Local j:Int = ti + 1 To toks.Length - 1
									Local t:= toks[j]
									Local up:= t.ToUpper()
									If t = "," Then Continue
									If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "CLASS" Or up = "END" Then Exit
									If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
										If up = identUp Then
											bestFile = curPath
											bestLine = ln
											Exit
										EndIf
									EndIf
									If t = ":" Or t = "=" Then Exit
								Next
							EndIf
							If bestFile <> "" Then Exit
						Next
						If bestFile <> "" Then Exit
					Next
				EndIf
			ElseIf kindHint <> "" Then
				For Local ln:Int = 0 To doc.numtotallines - 1
					If Not allowMemberLookup And (kindHint = "FUNCTION" Or kindHint = "METHOD" Or kindHint = "FIELD") Then
						If ln < scopeClassAtLine.Length And scopeClassAtLine[ln] >= 0 Then Continue
					EndIf
					If SYM_LineDefinesIdent(GetLineTextByIndex(ln), kindHint, identUp) Then
						bestFile = curPath
						bestLine = ln
						bestKind = kindHint
						Exit
					EndIf
				Next
			EndIf
		EndIf
		
		If bestFile = "" And kindHint = "" Then
			For Local pass:Int = 0 To 1
				Local m:StringMap<SymbolFileData>
				If pass = 0 Then m = symFiles Else m = symFilesFixed
				
				For Local it:=Eachin m
					Local fp:String = String(it.Key)
					Local fd:SymbolFileData = SymbolFileData(it.Value)
					If fd = Null Then Continue
					
					Local fpNorm:= HL_NormalizePath(fp)
					
					For Local i:Int = 0 To fd.count - 1
						Local score:Int = 0
						If fpNorm = curPath Then score += 200
						score -= Abs(fd.lines[i] - caretLn)
						
						Local decl:= fd.decls[i]
						Local knd:String = SYM_DeclKindUp(decl)
						
						Local nmUp:= fd.names[i].ToUpper()
						Local exactMatch:Bool = (nmUp = identUp)
						Local suffixMatch:Bool = False
						If Not exactMatch Then
							If nmUp.EndsWith("." + identUp) Then suffixMatch = True
						EndIf
						If suffixMatch And Not allowMemberLookup Then
							If knd <> "CLASS" And knd <> "INTERFACE" And knd <> "ENUMERATE" Then Continue
						EndIf
						If Not exactMatch And Not suffixMatch Then Continue
						
						If ownerUp <> "" And suffixMatch Then
							Local fullNmUp:= fd.names[i].ToUpper()
							Local d:Int = fullNmUp.FindLast(".")
							If d > 0 Then
								Local leftUp:= LeftString(fullNmUp, d)
								Local leftShortUp:String = AC_ShortTypeUp(leftUp)
								Local ownerShortUp:String = AC_ShortTypeUp(ownerUp)
								If leftUp = ownerUp Or leftShortUp = ownerShortUp Then
									score += 150
								ElseIf AC_IsBaseOfUp(ownerUp, leftUp) Then
									score += 90
								EndIf
							EndIf
						EndIf
						
						If argCountHint >= 0 And (knd = "METHOD" Or knd = "FUNCTION") Then
							Local mm:Int[] = SYM_ParseArgMinMax(decl)
							If mm[0] >= 0 Then
								If argCountHint >= mm[0] And argCountHint <= mm[1] Then score += 60 Else score -= 10
							Else
								Local ac:Int = SYM_ParseArgCount(decl)
								If ac >= 0 Then
									If ac = argCountHint Then score += 60 Else score -= 10
								EndIf
							EndIf
						EndIf
						
						If score > bestScore Then
							bestScore = score
							bestFile = fpNorm
							bestLine = fd.lines[i]
						EndIf
					Next
				Next
			Next
		EndIf
		
		If bestFile = "" Then
			Local routineStart:Int = -1
			For Local ln:Int = caretLn To 0 Step -1
				Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
				Local firstIdx:Int = FirstCodeTokenIndex(toks)
				If firstIdx < toks.Length Then
					Local t0:= toks[firstIdx].ToUpper()
					If t0 = "METHOD" Or t0 = "FUNCTION" Then
						routineStart = ln
						Exit
					EndIf
				EndIf
			Next
			
			If routineStart >= 0 Then
				For Local ln:Int = caretLn To routineStart Step -1
					Local toks:= TokenizeCodeLine(GetLineTextByIndex(ln))
					For Local ti:Int = 0 To toks.Length - 2
						If toks[ti].ToUpper() = "LOCAL" Then
							For Local j:Int = ti + 1 To toks.Length - 1
								Local t:= toks[j]
								Local up:= t.ToUpper()
								If t = "," Then Continue
								If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "CLASS" Or up = "END" Then Exit
								If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
									If up = identUp Then
										bestFile = curPath
										bestLine = ln
										Exit
									EndIf
								EndIf
								If t = ":" Or t = "=" Then Exit
							Next
						EndIf
						If bestFile <> "" Then Exit
					Next
					If bestFile <> "" Then Exit
				Next
			EndIf
		EndIf
		
		If bestFile = "" Then
			If ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then
				Local visited:= New StringMap<Int>
				Local preferSt3:Int = HL_IsClassNameUp(ownerUp)
				Local infoM:String = AC_FindMemberDeclInSource(ownerUp, identUp, argCountHint, visited, preferSt3)
				If infoM <> "" Then
					Local parts:= infoM.Split("|")
					If parts.Length >= 2 Then
						Local fpNorm:String = parts[0]
						Local ln0:Int = Int(parts[1])
						If fpNorm <> "" And ln0 >= 0 Then
							OpenProject(fpNorm, ln0 + 1)
							Return
						EndIf
					EndIf
				EndIf
			EndIf
			
			If kindHint = "CLASS" Or kindHint = "" Then
				Local info:String = AC_SearchTypeDeclInfoInCX(identUp)
				If info <> "" Then
					Local parts:= info.Split("|")
					If parts.Length >= 2 Then
						Local fpNorm:String = parts[0]
						Local ln0:Int = Int(parts[1])
						If fpNorm <> "" And ln0 >= 0 Then
							OpenProject(fpNorm, ln0 + 1)
							If focussheet And focussheet.focusbox Then
								Local bx:= focussheet.focusbox
								If ln0 >= 0 And ln0 < bx.doc.idlines - 1 Then
									bx.idcaret = bx.doc.idline[ln0]
									bx.idstartsel = bx.idcaret
									bx.idendsel = bx.idcaret
									bx.lineevid = ln0 + 1
									bx.lineevidcount = 300
									Return
								EndIf
							EndIf
							Return
						EndIf
					EndIf
				EndIf
			EndIf
			
			If kindHint = "" Or kindHint = "FUNCTION" Or kindHint = "METHOD" Or kindHint = "GLOBAL" Or kindHint = "CONST" Then
				Local cxKinds:String[] = ["FUNCTION", "METHOD", "GLOBAL", "CONST"]
				If kindHint <> "" And kindHint <> "GLOBAL" And kindHint <> "CONST" Then
					cxKinds = cxKinds.Resize(1)
					cxKinds[0] = kindHint
				EndIf
				
				For Local ki:Int = 0 To cxKinds.Length - 1
					Local cxInfo:String = AC_SearchDeclInfoInCX(cxKinds[ki], identUp, 1)
					If cxInfo = "" Then Continue
					
					Local parts:= cxInfo.Split("|")
					If parts.Length >= 2 Then
						Local fpNorm:String = parts[0]
						Local ln0:Int = Int(parts[1])
						If fpNorm <> "" And ln0 >= 0 Then
							OpenProject(fpNorm, ln0 + 1)
							If focussheet And focussheet.focusbox Then
								Local bx:= focussheet.focusbox
								If ln0 >= 0 And ln0 < bx.doc.idlines - 1 Then
									bx.idcaret = bx.doc.idline[ln0]
									bx.idstartsel = bx.idcaret
									bx.idendsel = bx.idcaret
									bx.lineevid = ln0 + 1
									bx.lineevidcount = 300
								EndIf
							EndIf
							Return
						EndIf
					EndIf
				Next
			EndIf
			Return
		EndIf
		
		If bestLine < 0 Then
			Local useKind:String = kindHint
			If useKind = "" Then useKind = bestKind
			If useKind = "" And ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then useKind = "METHOD"
			Local fallbackKind:String = useKind
			If useKind = "" Then useKind = "GLOBAL"
			
			Local uk:String = useKind.ToUpper()
			If uk <> "GLOBAL" And uk <> "CONST" And uk <> "FUNCTION" And uk <> "CLASS" And uk <> "INTERFACE" And uk <> "ENUMERATE" And uk <> "FIELD" And uk <> "METHOD" And uk <> "LOCAL" Then
				useKind = "CLASS"
			EndIf
			
			Local found:Int = -1
			If bestFile = curPath Then
				For Local ln:Int = 0 To doc.numtotallines - 1
					If SYM_LineDefinesIdent(GetLineTextByIndex(ln), useKind, identUp) Then
						found = ln
						Exit
					EndIf
				Next
			Else
				If (useKind = "METHOD" Or useKind = "FUNCTION") And argCountHint >= 0 Then
					found = SYM_FindDeclLineInFileWithArgs(bestFile, useKind, identUp, allowMemberLookup, argCountHint)
				Else
					found = SYM_FindDeclLineInFile(bestFile, useKind, identUp, allowMemberLookup)
				EndIf
			EndIf
			
			If found < 0 Then
				If ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then
					Local visited:= New StringMap<Int>
					Local preferSt4:Int = HL_IsClassNameUp(ownerUp)
					Local infoM:String = AC_FindMemberDeclInSource(ownerUp, identUp, argCountHint, visited, preferSt4)
					If infoM <> "" Then
						Local parts:= infoM.Split("|")
						If parts.Length >= 2 Then
							Local fpNorm:String = parts[0]
							Local ln0:Int = Int(parts[1])
							If fpNorm <> "" And ln0 >= 0 Then
								OpenProject(fpNorm, ln0 + 1)
								Return
							EndIf
						EndIf
					EndIf
				EndIf
				
				Local info:String = AC_SearchTypeDeclInfoInCX(identUp)
				If info <> "" Then
					Local parts:= info.Split("|")
					If parts.Length >= 2 Then
						Local fpNorm:String = parts[0]
						Local ln0:Int = Int(parts[1])
						If fpNorm <> "" And ln0 >= 0 Then
							OpenProject(fpNorm, ln0 + 1)
							Return
						EndIf
					EndIf
				EndIf
				
				If fallbackKind = "" Or fallbackKind = "FUNCTION" Or fallbackKind = "METHOD" Or fallbackKind = "GLOBAL" Or fallbackKind = "CONST" Then
					Local cxKinds2:String[] = ["FUNCTION", "METHOD", "GLOBAL", "CONST"]
					If fallbackKind <> "" And fallbackKind <> "GLOBAL" And fallbackKind <> "CONST" Then
						cxKinds2 = cxKinds2.Resize(1)
						cxKinds2[0] = fallbackKind
					EndIf
					
					For Local ki2:Int = 0 To cxKinds2.Length - 1
						Local cxInfo2:String = AC_SearchDeclInfoInCX(cxKinds2[ki2], identUp, 1)
						If cxInfo2 = "" Then Continue
						
						Local parts2:= cxInfo2.Split("|")
						If parts2.Length >= 2 Then
							Local fpNorm2:String = parts2[0]
							Local ln02:Int = Int(parts2[1])
							If fpNorm2 <> "" And ln02 >= 0 Then
								OpenProject(fpNorm2, ln02 + 1)
								If focussheet And focussheet.focusbox Then
									Local bx:= focussheet.focusbox
									If ln02 >= 0 And ln02 < bx.doc.idlines - 1 Then
										bx.idcaret = bx.doc.idline[ln02]
										bx.idstartsel = bx.idcaret
										bx.idendsel = bx.idcaret
										bx.lineevid = ln02 + 1
										bx.lineevidcount = 300
									EndIf
								EndIf
								Return
							EndIf
						EndIf
					Next
				EndIf
				
				OpenProject(bestFile, 1)
				Return
			EndIf
			bestLine = found
		EndIf

		Local useKind2:String = kindHint
		If useKind2 = "" Then useKind2 = bestKind
		If useKind2 = "" And ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then useKind2 = "METHOD"
		If useKind2 = "" Then useKind2 = "GLOBAL"
		
		If bestLine >= 0 Then
			Local ok:Int = 0
			
			If bestFile = curPath Then
				If bestLine < doc.numtotallines Then
					If SYM_LineDefinesIdent(GetLineTextByIndex(bestLine), useKind2, identUp) Then ok = 1
				EndIf
			Else
				Local fp:= bestFile.Replace("\", "/")
				If os.FileType(fp) <> os.FILETYPE_FILE Then fp = bestFile
				If os.FileType(fp) = os.FILETYPE_FILE Then
					Local txt:= os.LoadString(fp)
					If txt <> "" Then
						txt = txt.Replace(invio, "~n")
						txt = txt.Replace(String.FromChar(13), "~n")
						txt = txt.Replace(String.FromChar(10), "~n")
						Local lines:= txt.Split("~n")
						If bestLine >= 0 And bestLine < lines.Length Then
							If SYM_LineDefinesIdent(lines[bestLine], useKind2, identUp) Then ok = 1
						EndIf
					EndIf
				EndIf
			EndIf
			
			If ok = 0 Then
				Local corrected:Int = -1
				
				If useKind2 = "METHOD" And ownerUp <> "" And allowMemberLookup And ownerImplicit = 0 Then
					Local ownerForFindUp:String = AC_ShortTypeUp(ownerUp)
					If ownerForFindUp = "" Then ownerForFindUp = ownerUp
					corrected = SYM_FindMethodInClassInFile(bestFile, ownerForFindUp, identUp)
				EndIf
				
				If corrected < 0 Then
					If (useKind2 = "METHOD" Or useKind2 = "FUNCTION") And argCountHint >= 0 Then
						corrected = SYM_FindDeclLineInFileWithArgs(bestFile, useKind2, identUp, 1, argCountHint)
					Else
						corrected = SYM_FindDeclLineInFile(bestFile, useKind2, identUp, 1)
					EndIf
				EndIf
				
				If corrected < 0 Then
					Local cxKinds3:String[] = ["FUNCTION", "METHOD", "GLOBAL", "CONST"]
					If kindHint <> "" And kindHint <> "GLOBAL" And kindHint <> "CONST" Then
						cxKinds3 = cxKinds3.Resize(1)
						cxKinds3[0] = kindHint
					ElseIf bestKind <> "" And bestKind <> "GLOBAL" Then
						cxKinds3 = cxKinds3.Resize(1)
						cxKinds3[0] = bestKind
					EndIf
					
					For Local ki3:Int = 0 To cxKinds3.Length - 1
						Local cxInfo3:String = AC_SearchDeclInfoInCX(cxKinds3[ki3], identUp, 1)
						If cxInfo3 = "" Then Continue
						
						Local parts3:= cxInfo3.Split("|")
						If parts3.Length >= 2 Then
							Local fpNorm3:String = parts3[0]
							Local ln03:Int = Int(parts3[1])
							If fpNorm3 <> "" And ln03 >= 0 Then
								OpenProject(fpNorm3, ln03 + 1)
								If focussheet And focussheet.focusbox Then
									Local bx:= focussheet.focusbox
									If ln03 >= 0 And ln03 < bx.doc.idlines - 1 Then
										bx.idcaret = bx.doc.idline[ln03]
										bx.idstartsel = bx.idcaret
										bx.idendsel = bx.idcaret
										bx.lineevid = ln03 + 1
										bx.lineevidcount = 300
									EndIf
								EndIf
								Return
							EndIf
						EndIf
					Next
				EndIf
				
				If corrected >= 0 Then bestLine = corrected
			EndIf
		EndIf
		
		Local bestFileSys:String = bestFile.Replace("\", "/")
		If os.FileType(bestFileSys) <> os.FILETYPE_FILE Then bestFileSys = bestFile
		If os.FileType(bestFileSys) <> os.FILETYPE_FILE Then
			Local cxKinds4:String[] = ["FUNCTION", "METHOD", "GLOBAL", "CONST"]
			If kindHint <> "" And kindHint <> "GLOBAL" And kindHint <> "CONST" Then
				cxKinds4 = cxKinds4.Resize(1)
				cxKinds4[0] = kindHint
			ElseIf bestKind <> "" And bestKind <> "GLOBAL" Then
				cxKinds4 = cxKinds4.Resize(1)
				cxKinds4[0] = bestKind
			EndIf
			
			For Local ki4:Int = 0 To cxKinds4.Length - 1
				Local cxInfo4:String = AC_SearchDeclInfoInCX(cxKinds4[ki4], identUp, 1)
				If cxInfo4 = "" Then Continue
				
				Local parts4:= cxInfo4.Split("|")
				If parts4.Length >= 2 Then
					Local fpNorm4:String = parts4[0]
					Local ln04:Int = Int(parts4[1])
					If fpNorm4 <> "" And ln04 >= 0 Then
						OpenProject(fpNorm4, ln04 + 1)
						If focussheet And focussheet.focusbox Then
							Local bx:= focussheet.focusbox
							If ln04 >= 0 And ln04 < bx.doc.idlines - 1 Then
								bx.idcaret = bx.doc.idline[ln04]
								bx.idstartsel = bx.idcaret
								bx.idendsel = bx.idcaret
								bx.lineevid = ln04 + 1
								bx.lineevidcount = 300
							EndIf
						EndIf
						Return
					EndIf
				EndIf
			Next
		EndIf
		
		OpenProject(bestFile, bestLine + 1)
		
		If focussheet And focussheet.focusbox Then
			Local bx:= focussheet.focusbox
			If bestLine >= 0 And bestLine < bx.doc.idlines - 1 Then
				bx.idcaret = bx.doc.idline[bestLine]
				bx.idstartsel = bx.idcaret
				bx.idendsel = bx.idcaret
				bx.lineevid = bestLine + 1
				bx.lineevidcount = 300
				Return
			EndIf
		EndIf
		
	End Method
	
	Method SelectWord(id:Int)

		If id < 0 Then id = 0
		
		If id > doc.Crs.Length - 1 Then id = doc.Crs.Length - 1
			
	
		Local c:Int = doc.Crs[id] & 255

		Local c1:Int = TypeCrs(c)
		
		idselect1 = id
		idselect2 = id

		'loop1
		Repeat
			If idselect1 >= doc.Crs.Length - 1 Then Exit
			
			If idselect1 < 0 Then Return
			
			Local t1:int = doc.Crs[idselect1] & 255
			Local c2:Int = TypeCrs(t1)
			If c2 <> c1 Then Exit
			If c2 = 254 Then Exit
			idselect1 = idselect1 + 1
		Forever

		'loop2
		Repeat
			If idselect2 <= 0 Then Exit
			Local t1:Int = doc.Crs[idselect2 - 1] & 255
			Local c2:Int = TypeCrs(t1)
			If c2 <> c1 Then Exit
			If c2 = 254 Then Exit
			idselect2 = idselect2 - 1
		Forever

	End
	Method TypeCrs:Int(c:Int)

		If c = 95 Or IsADigit(c) Or IsALetter(c) Then Return 1

		If c = 44 Then Return 2

		If c = 46 Then Return 3

		If c = 39 Then Return 251

		If c = 34 Then Return 252

		If c = 32 Then Return 253

		If c = 13 Or c = 10 Then Return 254

		Return 255

	End Method
	
	
