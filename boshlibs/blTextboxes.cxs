Import blTheme
Import blHooks
 
 

Import blDocBase
Import blFuncs
Import brl.filestream
Import brl.filesystem
Import brl.filepath
Import brl.requesters

Import blGraphics
Import blFiles

Import os
 
Global isontextbox

Global keyfind:Int

Global hlFastBasicWordMode:Int = 0

Const keywordscxsa:= "Void Strict " +
	"Public Private Protected Friend Property " +
	"Bool Int Float String Array Object Mod Continue Exit " +
	"Include Import Module Extern " +
	"New Self Super Eachin True False Null Not " +
	"Extends Abstract Final Select Case Default " +
	"Const Local Global Field Method Function Class "+
	"And Or Shl Shr End If Then Else Elseif Endif While Wend Repeat Until Forever " +
	"For To Step Next Return " +
	"Interface Implements Inline Alias Try Catch Throw Throwable " +
	"Enumerate"
	
Global keywordscxs:= keywordscxsa.Split(" ")


' Parole chiave C/C++ per la colorazione dei .cpp e .h. A differenza del
' Cerberus e dell'assembly, qui il confronto e' CASE SENSITIVE: "int" e' una
' parola chiave, "Int" e' un identificatore qualsiasi.
Const keywordscppa:= "alignas alignof and and_eq asm auto bitand bitor bool break " +
	"case catch char char8_t char16_t char32_t class compl concept const consteval " +
	"constexpr constinit const_cast continue co_await co_return co_yield decltype " +
	"default delete do double dynamic_cast else enum explicit export extern false " +
	"float for friend goto if inline int long mutable namespace new noexcept not " +
	"not_eq nullptr operator or or_eq private protected public register " +
	"reinterpret_cast requires return short signed sizeof static static_assert " +
	"static_cast struct switch template this thread_local throw true try typedef " +
	"typeid typename union unsigned using virtual void volatile wchar_t while " +
	"xor xor_eq override final"

Global keywordscpp:= keywordscppa.Split(" ")


' Parole chiave Java. Il colorer e' lo stesso del C/C++ - stessi /* */, stesse
' stringhe con escape, stessi numeri - e cambia praticamente solo questo
' elenco, piu' due dettagli: in Java non c'e' il preprocessore e ci sono invece
' le annotazioni (@Override). Anche qui il confronto e' CASE SENSITIVE.
Const keywordsjavaa:= "abstract assert boolean break byte case catch char class const " +
	"continue default do double else enum extends final finally float for goto if " +
	"implements import instanceof int interface long native new package private " +
	"protected public return short static strictfp super switch synchronized this " +
	"throw throws transient try void volatile while " +
	"true false null var record sealed permits yield"

Global keywordsjava:= keywordsjavaa.Split(" ")


' Quale colorazione usare per un file, dalla sua estensione.
' 0 = BASIC (Cerberus / MSX), 1 = assembly, 2 = C/C++, 3 = Java.
'
' Quello che non e' in elenco resta 0, cioe' esattamente com'era: fino a ora
' doc.language non lo assegnava nessuno e valeva 0 per tutti i file. In
' particolare .asm NON viene mandato al colorer assembly, anche se esiste:
' MSXCompiler colora l'assembly col ramo BASIC (blHLBasicVariant = 1), e
' dirottarlo qui gli cambierebbe i colori sotto i piedi senza averlo chiesto.
Function blHLLanguageFromExt:Int(filename:String)

	Local ext:String = os.ExtractExt(filename).ToLower()

	Select ext

		Case "cpp", "cc", "cxx", "c", "h", "hpp", "hxx", "mm"
			Return 2

		Case "java"
			Return 3

	End

	Return 0

End


Class HLFileData
	Field lines:= New StringMap<String>
End

Global hlFiles:= New StringMap<HLFileData>
Global hlFilesPending:= New StringMap<HLFileData>
Global hlFilesPendingLineCount:= New StringMap<Int>
Global hlFilesPendingReady:= New StringMap<HLFileData>

Function HL_NormalizePath:String(p:String)
	
	If p = "" Then Return ""
	p = p.Replace("\", "/")
	Local keepUnc:Int = p.StartsWith("//")
	While p.Contains("//")
		p = p.Replace("//", "/")
	Wend
	If keepUnc And p.StartsWith("/") Then p = "/" + p
	Return p
		
End

Function StripUtf8BomFromText:String(s:String)
	If s.Length < 3 Then Return s
	If s[0] = 239 And s[1] = 187 And s[2] = 191 Then Return s[3 ..]
	Return s
End

Class SymbolFileData
	Field version:Int
	Field names:String[]
	Field decls:String[]
	Field lines:Int[]
	Field count:Int
End

Class ACInClassData
	Field inClass:Int[]
End

Class ACClassContextData
	Field inClass:Int[]
	Field classUpAtLine:String[]
End

Class VarScopeInfo
	Field startLine:Int
	Field endLine:Int
	Field isMethod:Int
	Field classId:Int = -1
	Field locals:=New StringMap<Int>
End

Class VarClassInfo
	Field startLine:Int
	Field endLine:Int
	Field nameUp:String
	Field extendsUp:String
	Field fields:=New StringMap<Int>
End

Class LineScopeContext
	Field inMethod:Int
	Field locals:=New StringMap<Int>
	Field classFields:=New StringMap<Int>
End

Global symFiles:=New StringMap<SymbolFileData>
Global symFilesFixed:=New StringMap<SymbolFileData>
Global symVersionCounter:Int
Global acInClassCache:=New StringMap<ACInClassData>
Global acClassCtxCache:=New StringMap<ACClassContextData>
Global acTypeExtCacheVersion:Int
Global acTypeBaseUp:=New StringMap<String>
Global acTypeMembersCacheVersion:Int
Global acTypeMembersCache:=New StringMap<StringList>
Global acTypeStaticMembersCache:=New StringMap<StringList>
' Persistent member cache for built-in module types (Canvas, Image, ecc.):
' i loro file vivono sotto cerberus/modules/ e non cambiano mai durante la
' sessione, quindi il risultato di AC_GetMembersForType resta valido anche
' tra cicli del parser. Evita la rilettura+tokenizzazione del sorgente da
' disco ad ogni "." digitato.
Global acTypeMembersCacheMod:=New StringMap<StringList>
Global acTypeStaticMembersCacheMod:=New StringMap<StringList>
Global acTypeDeclInfoCacheVersion:Int
Global acTypeDeclInfoCacheCX:String
Global acTypeDeclInfoCache:=New StringMap<String>
Global acCxTypesCacheCX:String
Global acCxTypesCacheLoaded:Int
Global acCxTypesByFirst:=New StringMap<StringList>
Global acCxFunctionsByFirst:=New StringMap<StringList>
Global acCxCallableNames:=New StringMap<Int>
' Method e Property del documento corrente, tenuti distinti dalle Function.
Global acCxMethodNames:=New StringMap<Int>

Function HL_ClearFile:Void(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	hlFiles.Set(k, New HLFileData)
End

Function HL_DiscardPendingHL:Void()
	hlFilesPending = New StringMap<HLFileData>
	hlFilesPendingLineCount = New StringMap<Int>
	hlFilesPendingReady = New StringMap<HLFileData>
End

Function HL_CommitPendingHL:Void()
	Local committed:= New StringMap<Int>
	Local anyCommitted:Int = 0
	For Local it:= Eachin hlFilesPendingReady
		Local k:String = String(it.Key)
		Local fd:HLFileData = HLFileData(it.Value)
		If k <> "" And fd Then
			Local kn:String = HL_NormalizePath(k)
			hlFiles.Set(kn, fd)
			committed.Set(kn, 1)
			anyCommitted = 1
		EndIf
	Next
	
	If anyCommitted
		For Local o1:= EachIn blSheet.allsheets
			For Local proj:= EachIn o1.childsboxes
				' i riquadri di disegno non hanno un documento di testo
				If proj.doc = Null Then Continue
				Local pn:String = HL_NormalizePath(proj.doc.fullname)
				If committed.Contains(pn) Then
					proj.hlParserSegsStale = 0
					proj.hlNeedViewport = 1
					proj.hlIdleId1 = -1
					proj.hlIdleId2 = -1
					proj.hlSpreadAnchorLn = -1
					' Qui c'era anche "proj.scRefreshDocPath = ~q~q", che al ciclo
					' successivo faceva scattare una RefreshShortcuts completa
					' (misurati 511-696 ms su _prove/T16.cxs). Ma il parser non
					' c'entra niente con quelle liste: MakeLabels,
					' MakeListFunctions e RefreshFileClassShortcutsFromSource
					' leggono SOLO il testo del documento. Siccome un ciclo di
					' parser parte dopo ogni modifica, era una ricostruzione
					' completa buttata via a ogni edit - la pausa che si sentiva
					' premendo Invio o muovendo il caret dopo aver scritto.
					' I flag hl* qui sopra restano: quelli si' dipendono dal parser.
				EndIf
			Next
		Next
	EndIf
	
	HL_DiscardPendingHL
End

Function HL_BeginFileUpdate:Void(p:String, lineCount:Int)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:= New HLFileData
	Local old:= hlFiles.Get(k)
	If old Then
		For Local it:= Eachin old.lines
			fd.lines.Set(String(it.Key), String(it.Value))
		Next
	EndIf
	
	hlFilesPending.Set(k, fd)
	hlFilesPendingLineCount.Set(k, lineCount)
End

Function HL_SetLinePending:Void(p:String, line:Int, segs:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:= hlFilesPending.Get(k)
	If fd = Null Then
		HL_BeginFileUpdate(k, 0)
		fd = hlFilesPending.Get(k)
		If fd = Null Then Return
	EndIf
	
	fd.lines.Set(String(line), segs)
End

Function HL_EndFileUpdate:Void(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:= hlFilesPending.Get(k)
	If fd = Null Then Return
	
	Local lineCount:Int = hlFilesPendingLineCount.Get(k)
	If lineCount > 0 Then
		Local kill:String[]
		For Local it:= Eachin fd.lines
			Local lk:String = String(it.Key)
			Local ln:Int = Int(lk)
			If ln > lineCount Then
				Local n:Int = kill.Length
				kill = kill.Resize(n + 1)
				kill[n] = lk
			EndIf
		Next
		
		For Local i:Int = 0 To kill.Length - 1
			fd.lines.Set(kill[i], "")
		Next
	EndIf
	
	hlFilesPendingReady.Set(k, fd)
	hlFilesPending.Set(k, Null)
	hlFilesPendingLineCount.Set(k, 0)
End

Function HL_SetLine:Void(p:String, line:Int, segs:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:=hlFiles.Get(k)
	If fd = Null Then
		fd = New HLFileData
		hlFiles.Set(k, fd)
	EndIf
	
	fd.lines.Set(String(line), segs)
End

Function HL_GetLine:String(p:String, line:Int)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return ""
	
	Local fd:=hlFiles.Get(k)
	If fd = Null Then Return ""
	
	Local segs:=fd.lines.Get(String(line))
	If segs = "" Then Return ""
	
	Return segs
End

Function HL_IsIdentToken:Bool(tok:String)
	If tok = "" Then Return False
	
	Local i0:Int = 0
	If tok[0] = 64 And tok.Length > 1 Then i0 = 1
	
	Local c0:Int = tok[i0]
	If Not (c0 = 95 Or c0 >= 65 And c0 <= 90 Or c0 >= 97 And c0 <= 122) Then Return False
	
	For Local i:Int = i0 + 1 To tok.Length - 1
		Local c:Int = tok[i]
		If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then
		Else
			Return False
		EndIf
	Next
	
	Return True
End

Function HL_IsKeywordCXS:Bool(tok:String)
	Local up:= tok.ToUpper()
	For Local i:Int = 0 To keywordscxs.Length - 1
		If up = keywordscxs[i].ToUpper() Then Return True
	Next
	Return False
End

' Tipo dopo ":" in Local/Field/Global â€” puÃ² essere MyClass o primitivo String/Int/â€¦ (anche parola chiave).
Function HL_IsTypeRhsToken:Bool(tok:String)
	If tok = "" Then Return False
	Local up:String = tok.ToUpper()
	If up = "STRING" Or up = "INT" Or up = "FLOAT" Or up = "BOOL" Or up = "VOID" Or up = "OBJECT" Or up = "ARRAY" Then Return True
	If HL_IsIdentToken(tok) And Not HL_IsKeywordCXS(tok) Then Return True
	Return False
End

' Tipo dopo ":" con eventuale [] nei token successivi (Local a: Foo[]).
Function AC_TypeNameFromToksAt:String(toks:String[], typeIdx:Int)
	If typeIdx >= toks.Length Then Return ""
	Local ty:String = toks[typeIdx]
	If Not HL_IsTypeRhsToken(ty) Then Return ""
	Local up:String = ty.ToUpper()
	If up = "ARRAY" Then Return "ARRAY"
	If typeIdx + 2 < toks.Length And toks[typeIdx + 1] = "[" And toks[typeIdx + 2] = "]" Then Return up + "[]"
	Return up
End

Function HL_GetDocLineTextForPath:String(path:String, line1:Int)
	If path = "" Or line1 < 1 Then Return ""
	
	Local p:= HL_NormalizePath(path)
	Local pL:= p.ToLower()
	Local idx:Int = line1 - 1
	
	For Local d_any:= EachIn blSheet.docum
		Local d:= blDocument(d_any)
		If d = Null Then Continue
		Local dn:= HL_NormalizePath(d.fullname)
		If dn = p Or dn.ToLower() = pL Then
			If idx >= 0 And idx < d.numtotallines Then Return d.GetLineTextByIndex(idx)
			Return ""
		EndIf
	Next
	
	For Local sh:= EachIn blSheet.allsheets
		For Local g:= EachIn sh.childsboxes
			Local tb:= blTextbox(g)
			Local dn2:= HL_NormalizePath(tb.doc.fullname)
			If dn2 = p Or dn2.ToLower() = pL Then
				If idx >= 0 And idx < tb.doc.numtotallines Then Return tb.doc.GetLineTextByIndex(idx)
				Return ""
			EndIf
		Next
	Next
	
	Return ""
End

Function HL_LineIsDeclFieldGlobalLocal:Int(lineTxt:String)
	If lineTxt = "" Then Return 0
	
	Local n:Int = lineTxt.Length
	Local p:Int = 0
	
	While p < n
		While p < n
			Local c:Int = lineTxt[p]
			If IsALetter(c) Or c = 95 Then Exit
			p += 1
		Wend
		If p >= n Then Exit
		
		Local s:Int = p
		p += 1
		While p < n
			Local c2:Int = lineTxt[p]
			If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
				p += 1
			Else
				Exit
			EndIf
		Wend
		
		Local tokUp:= MidString(lineTxt, s + 1, p - s).ToUpper()
		If tokUp = "FIELD" Or tokUp = "GLOBAL" Or tokUp = "LOCAL" Then Return 1
		
	Wend
	
	Return 0
End

Function HL_LineIsDeclMethodOrFunction:Int(lineTxt:String)
	If lineTxt = "" Then Return 0
	
	Local toks:= SYM_TokenizeLineSimple(lineTxt)
	Local fi:Int = SYM_FirstCodeTokenIndex(toks)
	If fi >= toks.Length Then Return 0
	
	Local tokUp:String = toks[fi].ToUpper()
	If tokUp = "METHOD" Or tokUp = "FUNCTION" Or tokUp = "PROPERTY" Then Return 1
	
	Return 0
End

Function HL_LineIsDeclClassMethodOrFunction:Int(lineTxt:String)
	If lineTxt = "" Then Return 0
	
	Local toks:= SYM_TokenizeLineSimple(lineTxt)
	Local fi:Int = SYM_FirstCodeTokenIndex(toks)
	If fi >= toks.Length Then Return 0
	
	Local tokUp:String = toks[fi].ToUpper()
	If tokUp = "CLASS" Or tokUp = "INTERFACE" Or tokUp = "METHOD" Or tokUp = "FUNCTION" Or tokUp = "PROPERTY" Then Return 1
	
	Return 0
End

Function HL_ReadIdentBeforeDot:String(lineTxt:String, dotPos:Int)
	If lineTxt = "" Or dotPos < 0 Or dotPos >= lineTxt.Length Then Return ""
	
	Local q:Int = dotPos - 1
	While q >= 0
		Local cq:Int = lineTxt[q]
		If cq = 32 Or cq = 9 Then
			q -= 1
			Continue
		EndIf
		Exit
	Wend
	
	If q < 0 Then Return ""
	If Not IsALetter(lineTxt[q]) And lineTxt[q] <> 95 Then Return ""
	
	Local e:Int = q
	q -= 1
	While q >= 0
		Local c2:Int = lineTxt[q]
		If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
			q -= 1
		Else
			Exit
		EndIf
	Wend
	
	Return MidString(lineTxt, q + 2, e - q)
End

' True se tokStart e' il primo carattere di un identificatore subito dopo "." (es. Z.x1, (Obj).y1).
' Usato solo in ApplyClassNameColorsOnLine: un suffisso dopo "." non e' un riferimento a tipo "nudo"
' (evita che nomi come x1/y1 collidano con CLASS nei sym e sovrascrivano il colore Field).
Function HL_TokenIsMemberAfterDot:Int(lineTxt:String, tokStart:Int)
	If lineTxt = "" Or tokStart <= 0 Then Return 0
	
	Local q:Int = tokStart - 1
	While q >= 0
		Local cq:Int = lineTxt[q]
		If cq = 32 Or cq = 9 Then
			q -= 1
			Continue
		EndIf
		Exit
	Wend
	
	If q < 0 Then Return 0
	If lineTxt[q] <> 46 Then Return 0
	
	Local r:Int = q - 1
	While r >= 0
		Local cr:Int = lineTxt[r]
		If cr = 32 Or cr = 9 Then
			r -= 1
			Continue
		EndIf
		Exit
	Wend
	
	If r < 0 Then Return 0
	Local c0:Int = lineTxt[r]
	If c0 = 41 Then Return 1
	If IsALetter(c0) Or c0 = 95 Or c0 >= 48 And c0 <= 57 Then Return 1
	Return 0
End

Function HL_AdjustSegsForFieldGlobal:String(path:String, line1:Int, segs:String)
	If segs = "" Then Return segs
	If path = "" Then Return segs
	
	Local lineTxt:String = HL_GetDocLineTextForPath(path, line1)

	If lineTxt = "" Then Return segs
	
	Local parts:= segs.Split(";")
	Local out:String = ""
	Local pos:Int = 0
	Local waitField:Int = 0
	Local waitGlobal:Int = 0
	Local waitClass:Int = 0
	
	For Local i:Int = 0 To parts.Length - 1
		Local part:= parts[i]
		If part = "" Then Continue
		
		Local p2:= part.Split(",")
		If p2.Length < 2 Then Continue
		
		Local col:Int = Int(p2[0])
		Local ln:Int = Int(p2[1])
		If ln < 0 Then ln = 0
		
		Local tok:String = ""
		If ln > 0 And pos < lineTxt.Length Then
			Local maxlen:Int = ln
			If pos + maxlen > lineTxt.Length Then maxlen = lineTxt.Length - pos
			If maxlen > 0 Then tok = MidString(lineTxt, pos + 1, maxlen)
		EndIf
		pos += ln
		
		Local tokTrim:= tok.Trim()
		Local tokUp:= tokTrim.ToUpper()
		
		If tokUp = "EXTENDS" Or tokUp = "IMPLEMENTS" Then
			col = 4
		EndIf
		
		If waitClass And HL_IsIdentToken(tokTrim) Then
			col = 9
			waitClass = 0
			waitField = 0
			waitGlobal = 0
		ElseIf waitField And HL_IsIdentToken(tokTrim) Then
			col = 7
		ElseIf waitGlobal And HL_IsIdentToken(tokTrim) Then
			col = 5
			waitField = 0
		ElseIf waitField And tokTrim <> "" Then
			Local subPos:Int = 0
			While subPos < tok.Length
				While subPos < tok.Length And (tok[subPos] = 32 Or tok[subPos] = 9 Or tok[subPos] = 44)
					subPos += 1
				Wend
				If subPos >= tok.Length Then Exit
				Local subS:Int = subPos
				subPos += 1
				While subPos < tok.Length
					Local c:Int = tok[subPos]
					If c = 95 Or c >= 65 And c <= 90 Or c >= 97 And c <= 122 Or c >= 48 And c <= 57 Then
						subPos += 1
					Else
						Exit
					EndIf
				Wend
				Local subTok:= MidString(tok, subS + 1, subPos - subS)
				If HL_IsIdentToken(subTok.Trim()) Then col = 7
			Wend
		EndIf
		
		If tokTrim <> "" Then
			If tokUp = "CLASS" Or tokUp = "INTERFACE" Or tokUp = "ENUMERATE" Then
				waitClass = 1
				waitField = 0
				waitGlobal = 0
			ElseIf tokUp = "FIELD" Then
				waitField = 1
				waitGlobal = 0
				waitClass = 0
			ElseIf tokUp = "GLOBAL" Then
				waitGlobal = 1
				waitField = 0
				waitClass = 0
			ElseIf waitField Or waitGlobal Or waitClass Then
				If tokTrim <> "," Then
					waitField = 0
					waitGlobal = 0
					waitClass = 0
				EndIf
			EndIf
		EndIf
		
		out += col + "," + ln + ";"
	Next
	
	If out = "" Then Return segs
	Return out
End

Function SYM_GetFile:SymbolFileData(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return Null
	Local fd:= symFiles.Get(k)
	If fd Then Return fd
	
	Local k2:= k.ToLower()
	If k2 <> k Then
		fd = symFiles.Get(k2)
		If fd Then Return fd
	EndIf
	
	Local k3:= k.ToUpper()
	If k3 <> k And k3 <> k2 Then
		fd = symFiles.Get(k3)
		If fd Then Return fd
	EndIf
	
	fd = symFilesFixed.Get(k)
	If fd Then Return fd
	If k2 <> k Then
		fd = symFilesFixed.Get(k2)
		If fd Then Return fd
	EndIf
	If k3 <> k And k3 <> k2 Then
		fd = symFilesFixed.Get(k3)
		If fd Then Return fd
	EndIf
	
	Return Null
End

Function SYM_GetFileVersion:Int(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return 0
	Local v:Int = 0
	Local fd:= symFiles.Get(k)
	If fd Then v = fd.version
	Local fd2:= symFilesFixed.Get(k)
	If fd2 And fd2.version > v Then v = fd2.version
	
	Local k2:= k.ToLower()
	If k2 <> k Then
		fd = symFiles.Get(k2)
		If fd And fd.version > v Then v = fd.version
		fd2 = symFilesFixed.Get(k2)
		If fd2 And fd2.version > v Then v = fd2.version
	EndIf
	
	Local k3:= k.ToUpper()
	If k3 <> k And k3 <> k2 Then
		fd = symFiles.Get(k3)
		If fd And fd.version > v Then v = fd.version
		fd2 = symFilesFixed.Get(k3)
		If fd2 And fd2.version > v Then v = fd2.version
	EndIf
	
	Return v
End

Function SYM_GetGlobalVersion:Int()
	Return symVersionCounter
End

Function SYM_ClearFile:Void(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:=New SymbolFileData
	symVersionCounter += 1
	fd.version = symVersionCounter
	fd.count = 0
	fd.names = fd.names.Resize(0)
	fd.decls = fd.decls.Resize(0)
	fd.lines = fd.lines.Resize(0)
	symFiles.Set(k, fd)
	Local kc:= k.ToLower()
	acInClassCache.Set(kc, Null)
	acClassCtxCache.Set(kc, Null)
End

Function SYM_ClearFileFixed:Void(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:=New SymbolFileData
	symVersionCounter += 1
	fd.version = symVersionCounter
	fd.count = 0
	fd.names = fd.names.Resize(0)
	fd.decls = fd.decls.Resize(0)
	fd.lines = fd.lines.Resize(0)
	symFilesFixed.Set(k, fd)
	Local kc:= k.ToLower()
	acInClassCache.Set(kc, Null)
	acClassCtxCache.Set(kc, Null)
End

Function SYM_HasFixedFile:Int(p:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return 0
	If symFilesFixed.Get(k) Then Return 1
	
	Local k2:= k.ToLower()
	If k2 <> k Then
		If symFilesFixed.Get(k2) Then Return 1
	EndIf
	
	Local k3:= k.ToUpper()
	If k3 <> k And k3 <> k2 Then
		If symFilesFixed.Get(k3) Then Return 1
	EndIf
	
	Return 0
End

Function SYM_ParseName:String(declStr:String)
	If declStr = "" Then Return ""
	
	Local s:=declStr.Trim
	While s.StartsWith(" ")
		s = RightString(s, s.Length - 1)
	Wend
	
	Local bits:= s.Split(" ")
	If bits.Length < 2 Then Return s
	
	Local name:= bits[1]
	
	Local cut:Int = name.Find("(")
	If cut >= 0 Then name = LeftString(name, cut)
	
	cut = name.Find(":")
	If cut >= 0 Then name = LeftString(name, cut)
	
	cut = name.Find("<")
	If cut >= 0 Then name = LeftString(name, cut)
	
	cut = name.Find(",")
	If cut >= 0 Then name = LeftString(name, cut)
	
	Return name.Trim
End

Function SYM_DeclKindUp:String(declStr:String)
	If declStr = "" Then Return ""
	
	Local bits:= declStr.Trim.Split(" ")
	For Local i:Int = 0 To bits.Length - 1
		Local t:= bits[i].Trim
		If t = "" Then Continue
		Local up:= t.ToUpper()
		If up = "PUBLIC" Or up = "PRIVATE" Or up = "PROTECTED" Or up = "FRIEND" Or up = "FINAL" Or up = "ABSTRACT" Or up = "INLINE" Then Continue
		Return up
	Next
	
	Return ""
End

Function SYM_ParseArgCount:Int(declStr:String)
	If declStr = "" Then Return -1
	
	Local a:Int = declStr.Find("(")
	If a < 0 Then Return -1
	
	Local b:Int = declStr.Find(")", a + 1)
	If b < 0 Then Return -1
	
	Local inside:String = declStr[a + 1 .. b]
	inside = inside.Trim
	If inside = "" Then Return 0
	
	Local count:Int = 1
	For Local i:Int = 0 To inside.Length - 1
		If inside[i] = 44 Then count += 1
	Next
	
	Return count
End

Function SYM_ParseArgMinMax:Int[](declStr:String)
	Local out:Int[2]
	out[0] = -1
	out[1] = -1
	If declStr = "" Then Return out
	
	Local a:Int = declStr.Find("(")
	If a < 0 Then Return out
	
	Local b:Int = declStr.Find(")", a + 1)
	If b < 0 Then Return out
	
	Local inside:String = declStr[a + 1 .. b].Trim
	If inside = "" Then
		out[0] = 0
		out[1] = 0
		Return out
	EndIf
	
	Local parts:String[] = inside.Split(",")
	Local minArgs:Int = 0
	For Local i:Int = 0 To parts.Length - 1
		Local p:String = parts[i].Trim
		If p = "" Then Continue
		If p.Contains("=") Then Exit
		minArgs += 1
	Next
	
	out[0] = minArgs
	out[1] = parts.Length
	Return out
End


Function SYM_NormalizeTypeUp:String(typeStr:String)
	If typeStr = "" Then Return ""
	Local s:= typeStr.Trim
	If s = "" Then Return ""
	
	Local cut:Int = s.Find(" ")
	If cut >= 0 Then s = LeftString(s, cut)
	
	s = s.Trim
	If s = "" Then Return ""
	
	Return s.ToUpper()
End

Function SYM_ParseDeclParamTypes:String[](declStr:String)
	Local out:String[] = New String[0]
	If declStr = "" Then Return out
	
	Local a:Int = declStr.Find("(")
	If a < 0 Then Return out
	Local b:Int = declStr.Find(")", a + 1)
	If b < 0 Then Return out
	
	Local inside:String = declStr[a + 1 .. b].Trim
	If inside = "" Then Return out
	
	Local parts:= inside.Split(",")
	out = out.Resize(parts.Length)
	For Local i:Int = 0 To parts.Length - 1
		Local p:= parts[i].Trim
		Local c:Int = p.Find(":")
		If c >= 0 Then
			p = p[c + 1 ..].Trim
		Else
			Local bits:= p.Split(" ")
			If bits.Length > 0 Then p = bits[bits.Length - 1]
		EndIf
		
		Local eq:Int = p.Find("=")
		If eq >= 0 Then p = p[..eq].Trim
		
		out[i] = SYM_NormalizeTypeUp(p)
	Next
	
	Return out
End

Function SYM_ParseDeclTypeAfterColonUp:String(declStr:String)
	If declStr = "" Then Return ""
	Local c:Int = declStr.Find(":")
	If c < 0 Then Return ""
	Local s:= declStr[c + 1 ..].Trim
	Local p:Int = s.Find("(")
	If p >= 0 Then s = s[..p].Trim
	Return SYM_NormalizeTypeUp(s)
End

Function SYM_FindFieldTypeUp:String(ownerTypeUp:String, fieldUp:String)
	If ownerTypeUp = "" Or fieldUp = "" Then Return ""
	Local want:= ownerTypeUp + "." + fieldUp
	
	For Local it:=Eachin symFiles
		Local fd:SymbolFileData = SymbolFileData(it.Value)
		If fd = Null Then Continue
		
		For Local i:Int = 0 To fd.count - 1
			If fd.names[i].ToUpper() <> want Then Continue
			Local decl:= fd.decls[i].Trim
			Local bits:= decl.Split(" ")
			If bits.Length = 0 Then Continue
			If bits[0].ToUpper() <> "FIELD" Then Continue
			Return SYM_ParseDeclTypeAfterColonUp(decl)
		Next
	Next
	
	Return ""
End

Function SYM_InferExprTypeUp:String(expr:String, caretLn:Int)
	Local s:= expr.Trim
	If s = "" Then Return ""
	
	Local up:= s.ToUpper()
	If up = "TRUE" Or up = "FALSE" Then Return "BOOL"
	If up = "NULL" Then Return "NULL"
	
	If s.Length >= 2 And s[0] = 34 And s[s.Length - 1] = 34 Then Return "STRING"
	
	Local isNum:Int = 1
	Local hasDot:Int = 0
	Local start:Int = 0
	If s[0] = 45 Then start = 1
	If start >= s.Length Then isNum = 0
	For Local i:Int = start To s.Length - 1
		Local c:Int = s[i]
		If c >= 48 And c <= 57 Then
		ElseIf c = 46 Then
			hasDot = 1
		Else
			isNum = 0
			Exit
		EndIf
	Next
	If isNum Then
		If hasDot Then Return "FLOAT" Else Return "INT"
	EndIf

	Return ""
End

Function SYM_TypeScore:Int(expectedUp:String, actualUp:String)
	If expectedUp = "" Or actualUp = "" Then Return 0
	If expectedUp = actualUp Then Return 25
	
	If expectedUp = "FLOAT" And actualUp = "INT" Then Return 10
	If expectedUp = "INT" And actualUp = "FLOAT" Then Return 3
	If expectedUp = "OBJECT" And actualUp = "NULL" Then Return 10
	
	Return -5
End

Function SYM_AddDecl:Void(p:String, line1Based:Int, declStr:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:=symFiles.Get(k)
	If fd = Null Then
		SYM_ClearFile(k)
		fd = symFiles.Get(k)
	EndIf
	
	symVersionCounter += 1
	fd.version = symVersionCounter
	
	Local ln0:Int = line1Based - 1
	If line1Based <= 0 Then ln0 = -1
	
	Local nm:= SYM_ParseName(declStr)
	If nm = "" Then nm = declStr.Trim
	
	Local i:Int = fd.count
	fd.count = i + 1
	fd.names = fd.names.Resize(fd.count)
	fd.decls = fd.decls.Resize(fd.count)
	fd.lines = fd.lines.Resize(fd.count)
	fd.names[i] = nm
	fd.decls[i] = declStr.Trim
	fd.lines[i] = ln0
End

Function SYM_AddDeclFixed:Void(p:String, line1Based:Int, declStr:String)
	Local k:=HL_NormalizePath(p)
	If k = "" Then Return
	
	Local fd:=symFilesFixed.Get(k)
	If fd = Null Then
		SYM_ClearFileFixed(k)
		fd = symFilesFixed.Get(k)
	EndIf
	
	symVersionCounter += 1
	fd.version = symVersionCounter
	
	Local ln0:Int = line1Based - 1
	If line1Based <= 0 Then ln0 = -1
	
	Local nm:= SYM_ParseName(declStr)
	If nm = "" Then nm = declStr.Trim
	
	Local i:Int = fd.count
	fd.count = i + 1
	fd.names = fd.names.Resize(fd.count)
	fd.decls = fd.decls.Resize(fd.count)
	fd.lines = fd.lines.Resize(fd.count)
	fd.names[i] = nm
	fd.decls[i] = declStr.Trim
	fd.lines[i] = ln0
End

Function SYM_LineDefinesIdent:Bool(lineTxt:String, kindHint:String, identUp:String)
	If lineTxt = "" Then Return False
	
	Local toks:= SYM_TokenizeLineSimple(lineTxt)
	Local firstIdx:Int = SYM_FirstCodeTokenIndex(toks)
	If firstIdx >= toks.Length Then Return False
	
	Local t0:= toks[firstIdx].ToUpper()
	If kindHint <> "" And t0 <> kindHint Then Return False
	
	If t0 = "GLOBAL" Or t0 = "FIELD" Or t0 = "LOCAL" Then
		For Local i:Int = firstIdx + 1 To toks.Length - 1
			Local t:= toks[i]
			Local up:= t.ToUpper()
			
			If t = "," Then Continue
			If t = ":" Or t = "=" Then Exit
			If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "CLASS" Or up = "END" Then Exit
			
			If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
				If up = identUp Then Return True
			EndIf
		Next
		
		Return False
	EndIf
	
	If firstIdx + 1 >= toks.Length Then Return False
	Return toks[firstIdx + 1].ToUpper() = identUp
End

Function SYM_TokenizeLineSimple:String[](lineTxt:String)
	Local out:String[16]
	Local outCount:Int = 0
	Local n:Int = lineTxt.Length
	Local i:Int = 0
	Local inStr:Int = 0
	
	While i < n
		Local c:Int = lineTxt[i]
		
		If c = 34 Then
			inStr = 1 - inStr
			i += 1
			Continue
		EndIf
		
		If inStr = 0 And c = 39 Then Exit
		
		If c = 32 Or c = 9 Or c = 13 Or c = 10 Then
			i += 1
			Continue
		EndIf
		
		' @NomeTipo (es. Class @String in lang.cxs): un solo token, altrimenti CLASS + @ + String non matcha mai.
		If c = 64 And i + 1 < n Then
			Local cN:Int = lineTxt[i + 1]
			If IsALetter(cN) Or cN = 95 Then
				Local s:Int = i
				i += 2
				While i < n
					Local c2:Int = lineTxt[i]
					If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
						i += 1
					Else
						Exit
					EndIf
				Wend
				If outCount = out.Length Then out = out.Resize(out.Length * 2)
				out[outCount] = MidString(lineTxt, s + 1, i - s)
				outCount += 1
				Continue
			EndIf
		EndIf
		
		If IsALetter(c) Or c = 95 Then
			Local s:Int = i
			i += 1
			While i < n
				Local c2:Int = lineTxt[i]
				If IsALetter(c2) Or c2 = 95 Or c2 >= 48 And c2 <= 57 Then
					i += 1
				Else
					Exit
				EndIf
			Wend
			
			If outCount = out.Length Then out = out.Resize(out.Length * 2)
			out[outCount] = MidString(lineTxt, s + 1, i - s)
			outCount += 1
			Continue
		EndIf
		
		If outCount = out.Length Then out = out.Resize(out.Length * 2)
		out[outCount] = String.FromChar(c)
		outCount += 1
		i += 1
	Wend
	
	If outCount = 0 Then Return New String[0]
	Return out.Resize(outCount)
End

Function SYM_FirstCodeTokenIndex:Int(toks:String[])
	Local idx:Int = 0
	While idx < toks.Length
		Local tk:= toks[idx].ToUpper()
		If tk = "PUBLIC" Or tk = "PRIVATE" Or tk = "PROTECTED" Or tk = "FRIEND" Or tk = "FINAL" Or tk = "ABSTRACT" Then
			idx += 1
		Else
			Exit
		EndIf
	Wend
	Return idx
End

Function SYM_FindVarTypeInLine:String(toks:String[], varUp:String)
	If toks.Length = 0 Then Return ""
	
	For Local i:Int = 0 To toks.Length - 1
		Local up0:= toks[i].ToUpper()
		If up0 <> "LOCAL" And up0 <> "FIELD" And up0 <> "GLOBAL" Then Continue
		
		Local found:Int = 0
		For Local j:Int = i + 1 To toks.Length - 1
			Local t:= toks[j]
			Local up:= t.ToUpper()
			
			If t = "," Then Continue
			
			If t = ":" Then
				If j + 1 < toks.Length And toks[j + 1] = "=" Then
					If found And j + 3 < toks.Length And toks[j + 2].ToUpper() = "NEW" And HL_IsIdentToken(toks[j + 3]) Then Return toks[j + 3]
					Exit
				EndIf
				If found And j + 1 < toks.Length And HL_IsIdentToken(toks[j + 1]) Then Return toks[j + 1]
				Exit
			EndIf
			
			If t = "=" Then
				If found And j + 2 < toks.Length And toks[j + 1].ToUpper() = "NEW" And HL_IsIdentToken(toks[j + 2]) Then Return toks[j + 2]
				Exit
			EndIf
			
			If up = "LOCAL" Or up = "GLOBAL" Or up = "FIELD" Or up = "METHOD" Or up = "FUNCTION" Or up = "CLASS" Or up = "END" Then Exit
			
			If HL_IsIdentToken(t) And Not HL_IsKeywordCXS(t) Then
				If up = varUp Then found = 1
			EndIf
		Next
	Next
	
	For Local i:Int = 0 To toks.Length - 4
		If toks[i].ToUpper() <> varUp Then Continue
		
		Local k:Int = i + 1
		If k >= toks.Length Then Continue
		
		If toks[k] = ":" And k + 1 < toks.Length And toks[k + 1] = "=" Then
			k += 2
		ElseIf toks[k] = "=" Then
			k += 1
		Else
			Continue
		EndIf
		
		If k + 1 < toks.Length And toks[k].ToUpper() = "NEW" And HL_IsIdentToken(toks[k + 1]) Then Return toks[k + 1]
	Next
	
	Return ""
End

Function SYM_FindRoutineStartLine:Int(lines:String[], caretLn:Int)
	If lines.Length = 0 Then Return 0
	If caretLn < 0 Then caretLn = 0
	If caretLn > lines.Length - 1 Then caretLn = lines.Length - 1
	
	For Local ln:Int = caretLn To 0 Step -1
		Local toks:= SYM_TokenizeLineSimple(lines[ln])
		Local fi:Int = SYM_FirstCodeTokenIndex(toks)
		If fi < toks.Length Then
			Local t0:= toks[fi].ToUpper()
			If t0 = "METHOD" Or t0 = "FUNCTION" Then Return ln
		EndIf
	Next
	Return 0
End

Function SYM_FindVarTypeInLines:String(lines:String[], caretLn:Int, varUp:String)
	If lines.Length = 0 Then Return ""
	If caretLn < 0 Then caretLn = 0
	If caretLn > lines.Length - 1 Then caretLn = lines.Length - 1
	
	Local routineStart:Int = SYM_FindRoutineStartLine(lines, caretLn)
	
	For Local ln:Int = caretLn To routineStart Step -1
		Local toks:= SYM_TokenizeLineSimple(lines[ln])
		Local t:= SYM_FindVarTypeInLine(toks, varUp)
		If t <> "" Then Return t
	Next
	
	For Local ln:Int = caretLn To 0 Step -1
		Local toks:= SYM_TokenizeLineSimple(lines[ln])
		Local t:= SYM_FindVarTypeInLine(toks, varUp)
		If t <> "" Then Return t
	Next
	
	Return ""
End

Function SYM_FindVarTypeInSymFiles:String(varUp:String, curFileNorm:String, caretLn:Int)
	If varUp = "" Then Return ""
	
	Local wantUp:String = varUp.ToUpper()
	Local curNorm:String = HL_NormalizePath(curFileNorm)
	
	Local bestType:String = ""
	Local bestScore:Int = -1000000
	
	For Local pass:Int = 0 To 1
		Local m:StringMap<SymbolFileData>
		If pass = 0 Then m = symFiles Else m = symFilesFixed
		
		For Local it:= EachIn m
			Local fpNorm:String = HL_NormalizePath(String(it.Key))
			Local fd:SymbolFileData = SymbolFileData(it.Value)
			If fd = Null Then Continue
			
			For Local i:Int = 0 To fd.count - 1
				If fd.names[i].ToUpper() <> wantUp Then Continue
				
				Local declStr:String = fd.decls[i]
				Local knd:String = SYM_DeclKindUp(declStr)
				If knd <> "LOCAL" And knd <> "GLOBAL" And knd <> "FIELD" And knd <> "CONST" Then Continue
				If knd = "LOCAL" And fpNorm <> curNorm Then Continue
				
				Local toks:= SYM_TokenizeLineSimple(declStr)
				Local ty:String = SYM_FindVarTypeInLine(toks, wantUp)
				If ty = "" Then Continue
				
				Local score:Int = 0
				If fpNorm = curNorm Then score += 200 Else score -= 20
				
				Local ln0:Int = fd.lines[i]
				If ln0 >= 0 Then
					score -= Abs(ln0 - caretLn)
					If fpNorm = curNorm And ln0 <= caretLn Then score += 10
				Else
					score -= 300
				EndIf
				
				If score > bestScore Then
					bestScore = score
					bestType = ty.ToUpper()
				EndIf
			Next
		Next
	Next
	
	Return bestType
End

Function SYM_FindMethodInClassInLines:Int(lines:String[], classUp:String, methodUp:String)
	If lines.Length = 0 Then Return -1
	If classUp = "" Or methodUp = "" Then Return -1
	
	Local stackKind:Int[64]
	Local stackName:String[64]
	Local top:Int = -1
	
	For Local ln:Int = 0 To lines.Length - 1
		Local toks:= SYM_TokenizeLineSimple(lines[ln])
		Local fi:Int = SYM_FirstCodeTokenIndex(toks)
		If fi >= toks.Length Then Continue
		
		Local t0:= toks[fi].ToUpper()
		Local t1:String = ""
		If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()
		
		If t0 = "CLASS" Or t0 = "INTERFACE" Then
			top += 1
			If top > 63 Then top = 63
			stackKind[top] = 1
			stackName[top] = t1
			Continue
		EndIf
		
		If t0 = "METHOD" Then
			If top >= 0 And stackKind[top] = 1 And stackName[top] = classUp And t1 = methodUp Then Return ln
			Continue
		EndIf
		
		If t0 = "END" Then
			Local want:Int = 0
			If t1 = "CLASS" Or t1 = "INTERFACE" Then want = 1
			If t1 = "METHOD" Or t1 = "FUNCTION" Then want = 2
			
			If top >= 0 Then
				If want > 0 Then
					For Local k:Int = top To 0 Step -1
						If stackKind[k] = want Then
							top = k - 1
							Exit
						EndIf
					Next
				Else
					top -= 1
				EndIf
			EndIf
		EndIf
	Next
	
	Return -1
End

Function SYM_FindMethodInClassInFile:Int(filePath:String, classUp:String, methodUp:String)
	If filePath = "" Then Return -1
	
	Local fp:= filePath.Replace("\", "/")
	If os.FileType(fp) <> os.FILETYPE_FILE Then
		fp = filePath
		If os.FileType(fp) <> os.FILETYPE_FILE Then Return -1
	EndIf
	
	Local txt:= os.LoadString(fp)
	If txt = "" Then Return -1
	
	txt = txt.Replace(invio, "~n")
	txt = txt.Replace(String.FromChar(13), "~n")
	txt = txt.Replace(String.FromChar(10), "~n")
	Local lines:= txt.Split("~n")
	
	Return SYM_FindMethodInClassInLines(lines, classUp, methodUp)
End

Function SYM_FindMemberFromClassStartInFile:Int(filePath:String, classStartLn:Int, memberUp:String, altMemberUp:String = "")
	If filePath = "" Then Return -1
	If memberUp = "" And altMemberUp = "" Then Return -1
	
	Local fp:= filePath.Replace("\", "/")
	If os.FileType(fp) <> os.FILETYPE_FILE Then
		fp = filePath
		If os.FileType(fp) <> os.FILETYPE_FILE Then Return -1
	EndIf
	
	Local txt:= os.LoadString(fp)
	If txt = "" Then Return -1
	
	txt = txt.Replace(invio, "~n")
	txt = txt.Replace(String.FromChar(13), "~n")
	txt = txt.Replace(String.FromChar(10), "~n")
	Local lines:= txt.Split("~n")
	
	If classStartLn < 0 Then classStartLn = 0
	If classStartLn >= lines.Length Then Return -1
	
	Local classDepth:Int = 0
	For Local ln:Int = classStartLn + 1 To lines.Length - 1
		Local lineTxt:String = lines[ln]
		Local toks:= SYM_TokenizeLineSimple(lineTxt)
		Local fi:Int = SYM_FirstCodeTokenIndex(toks)
		If fi >= toks.Length Then Continue
		
		Local t0:String = toks[fi].ToUpper()
		Local t1:String = ""
		If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()
		
		If t0 = "CLASS" Or t0 = "INTERFACE" Then
			classDepth += 1
			Continue
		EndIf
		
		If t0 = "END" And (t1 = "CLASS" Or t1 = "INTERFACE") Then
			If classDepth = 0 Then Return -1
			classDepth -= 1
			Continue
		EndIf
		
		If classDepth = 0 And (t0 = "METHOD" Or t0 = "FUNCTION" Or t0 = "PROPERTY") Then
			Local nmUp:String = t1
			If nmUp = memberUp Then Return ln
			If altMemberUp <> "" And nmUp = altMemberUp Then Return ln
			
			' Tolerant fallback for non-standard signatures
			Local upLine:String = lineTxt.ToUpper()
			If upLine.Contains(memberUp + "(") Then Return ln
			If altMemberUp <> "" And upLine.Contains(altMemberUp + "(") Then Return ln
		EndIf
	Next
	
	Return -1
End

Function SYM_FindDeclLineInFile:Int(filePath:String, kindHint:String, identUp:String, allowInClass:Int)
	If filePath = "" Then Return -1
	
	Local fp:= filePath.Replace("\", "/")
	If os.FileType(fp) <> os.FILETYPE_FILE Then
		fp = filePath
		If os.FileType(fp) <> os.FILETYPE_FILE Then Return -1
	EndIf
	
	Local txt:= os.LoadString(fp)
	If txt = "" Then Return -1
	
	txt = txt.Replace(invio, "~n")
	txt = txt.Replace(String.FromChar(13), "~n")
	txt = txt.Replace(String.FromChar(10), "~n")
	Local lines:= txt.Split("~n")
	
	Local stackKind:Int[64]
	Local stackTop:Int = -1
	Local classDepth:Int = 0
	For Local ln:Int = 0 To lines.Length - 1
		If Not allowInClass And classDepth > 0 And (kindHint = "FUNCTION" Or kindHint = "METHOD" Or kindHint = "FIELD") Then
		Else
			If SYM_LineDefinesIdent(lines[ln], kindHint, identUp) Then Return ln
		EndIf
		
		Local toks:= SYM_TokenizeLineSimple(lines[ln])
		Local fi:Int = SYM_FirstCodeTokenIndex(toks)
		If fi < toks.Length Then
			Local t0:= toks[fi].ToUpper()
			Local t1:String = ""
			If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()
			
			If t0 = "CLASS" Or t0 = "INTERFACE" Then
				stackTop += 1
				If stackTop > 63 Then stackTop = 63
				stackKind[stackTop] = 1
				classDepth += 1
			ElseIf t0 = "METHOD" Or t0 = "FUNCTION" Then
				stackTop += 1
				If stackTop > 63 Then stackTop = 63
				stackKind[stackTop] = 2
			ElseIf t0 = "END" Then
				Local want:Int = 0
				If t1 = "CLASS" Or t1 = "INTERFACE" Then want = 1
				If t1 = "METHOD" Or t1 = "FUNCTION" Then want = 2
				
				If stackTop >= 0 Then
					If want > 0 Then
						For Local k:Int = stackTop To 0 Step -1
							If stackKind[k] = want Then
								For Local kk:Int = stackTop To k Step -1
									If stackKind[kk] = 1 And classDepth > 0 Then classDepth -= 1
								Next
								stackTop = k - 1
								Exit
							EndIf
						Next
					Else
						If stackKind[stackTop] = 1 And classDepth > 0 Then classDepth -= 1
						stackTop -= 1
					EndIf
				EndIf
			EndIf
		EndIf
	Next
	
	Return -1
End

Function SYM_FindDeclLineInFileWithArgs:Int(filePath:String, kindHint:String, identUp:String, allowInClass:Int, argCountHint:Int)
	If filePath = "" Then Return -1
	
	Local fp:= filePath.Replace("\", "/")
	If os.FileType(fp) <> os.FILETYPE_FILE Then
		fp = filePath
		If os.FileType(fp) <> os.FILETYPE_FILE Then Return -1
	EndIf
	
	Local txt:= os.LoadString(fp)
	If txt = "" Then Return -1
	
	txt = txt.Replace(invio, "~n")
	txt = txt.Replace(String.FromChar(13), "~n")
	txt = txt.Replace(String.FromChar(10), "~n")
	Local lines:= txt.Split("~n")
	
	Local wantArgs:Int = argCountHint
	If kindHint <> "METHOD" And kindHint <> "FUNCTION" Then wantArgs = -1
	
	Local firstAny:Int = -1
	Local bestLn:Int = -1
	
	Local stackKind:Int[64]
	Local stackTop:Int = -1
	Local classDepth:Int = 0
	For Local ln:Int = 0 To lines.Length - 1
		If Not allowInClass And classDepth > 0 And (kindHint = "FUNCTION" Or kindHint = "METHOD" Or kindHint = "FIELD") Then
		Else
			If SYM_LineDefinesIdent(lines[ln], kindHint, identUp) Then
				If firstAny < 0 Then firstAny = ln
				If wantArgs >= 0 Then
					Local mm:Int[] = SYM_ParseArgMinMax(lines[ln])
					If mm[0] >= 0 Then
						If wantArgs >= mm[0] And wantArgs <= mm[1] Then
							bestLn = ln
							Exit
						EndIf
					Else
						Local ac:Int = SYM_ParseArgCount(lines[ln])
						If ac >= 0 And ac = wantArgs Then
							bestLn = ln
							Exit
						EndIf
					EndIf
				Else
					Return ln
				EndIf
			EndIf
		EndIf
		
		Local toks:= SYM_TokenizeLineSimple(lines[ln])
		Local fi:Int = SYM_FirstCodeTokenIndex(toks)
		If fi < toks.Length Then
			Local t0:= toks[fi].ToUpper()
			Local t1:String = ""
			If fi + 1 < toks.Length Then t1 = toks[fi + 1].ToUpper()
			
			If t0 = "CLASS" Or t0 = "INTERFACE" Then
				stackTop += 1
				If stackTop > 63 Then stackTop = 63
				stackKind[stackTop] = 1
				classDepth += 1
			ElseIf t0 = "METHOD" Or t0 = "FUNCTION" Then
				stackTop += 1
				If stackTop > 63 Then stackTop = 63
				stackKind[stackTop] = 2
			ElseIf t0 = "END" Then
				Local want:Int = 0
				If t1 = "CLASS" Or t1 = "INTERFACE" Then want = 1
				If t1 = "METHOD" Or t1 = "FUNCTION" Then want = 2
				
				If stackTop >= 0 Then
					If want > 0 Then
						For Local k:Int = stackTop To 0 Step -1
							If stackKind[k] = want Then
								For Local kk:Int = stackTop To k Step -1
									If stackKind[kk] = 1 And classDepth > 0 Then classDepth -= 1
								Next
								stackTop = k - 1
								Exit
							EndIf
						Next
					Else
						If stackKind[stackTop] = 1 And classDepth > 0 Then classDepth -= 1
						stackTop -= 1
					EndIf
				EndIf
			EndIf
		EndIf
	Next
	
	If bestLn >= 0 Then Return bestLn
	Return firstAny
End

Function SYM_FillShortcutAll:Void(p:String, sc:blShortcut)
	If sc = Null Then Return
	sc.sclist.ClearList
	
	Local maxItems:Int = 40000
	Local added:Int = 0
	
	Local fd0:= SYM_GetFile(p)
	If fd0
		For Local i:Int = 0 To fd0.count - 1
			If added >= maxItems Then Return
			Local nm:= fd0.names[i]
			Local ds:= fd0.decls[i]
			Local ln:= fd0.lines[i]
			sc.sclist.AddShortcut(nm + "@" + ds, ln, HL_NormalizePath(p))
			added += 1
		Next
	EndIf
	
	For Local it:=Eachin symFiles
		Local k:String = String(it.Key)
		Local kNorm:=HL_NormalizePath(k)
		If kNorm = HL_NormalizePath(p) Then Continue
		
		Local fd:SymbolFileData = SymbolFileData(it.Value)
		If fd = Null Then Continue
		
		For Local i:Int = 0 To fd.count - 1
			If added >= maxItems Then Return
			Local nm:= fd.names[i]
			Local ds:= fd.decls[i]
			Local ln:= fd.lines[i]
			sc.sclist.AddShortcut(nm + "@" + ds, ln, kNorm)
			added += 1
		Next
	Next
End

Function SYM_FillShortcut:Void(p:String, sc:blShortcut)
	If sc = Null Then Return
	sc.sclist.ClearList
	
	Local fd:= SYM_GetFile(p)
	If fd = Null Then Return
	
	For Local i:Int = 0 To fd.count - 1
		Local nm:= fd.names[i]
		Local ds:= fd.decls[i]
		Local ln:= fd.lines[i]
		sc.sclist.AddShortcut(nm + "@" + ds, ln, "")
	Next
End

Function FindString()
	

	Local proj:= focussheet.focusbox
		
	If proj <> Null Then
		
		findstring = blEvents.FindText()
		
		If findstring = "" Then Return
		
		Local i = proj.idcaret
		'Local i2 = i
		
		Local i3 = 0
				
		If i = proj.idstartsel Then i = i + 1
				
		Repeat
	
			If i >= proj.doc.Crs.Length - 1 Then i = 0
			
			Local find:Bool = True
			
			For Local j = 0 To findstring.Length - 1
			
				Local k = i + j
				
				If k >= proj.doc.Crs.Length - 1 Then i = 0; Exit
				
				Local c = proj.doc.Crs[k] & 255
				Local c2 = findstring[j]
				
				If c >= 65 and c <= 90 Then c = c + 32
				If c2 >= 65 and c2 <= 90 Then c2 = c2 + 32
				
				If c <> c2 Then find = False; Exit
								
			Next
		
			If find Then
			
				proj.idcaret = i
				proj.idstartsel = i
				proj.idendsel = i + findstring.Length
				'5proj.GetCursorLine
				'proj.line = proj.linecaret - 8
				
				'If proj.line < 0 Then proj.line = 0
				
				findstr = 1
				
				Exit
				
			EndIf
				
			i = i + 1
			'If i = i2 Then Exit
			
			i3 = i3 + 1
			If i3 > proj.doc.Crs.Length Then Exit
		
		Forever
			
		
	EndIf
	
End

