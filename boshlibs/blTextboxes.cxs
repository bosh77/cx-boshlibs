	' Doc-wide identifier display-case cache.
	' Built lazily and reused while doc structure (line count + path) is unchanged.
	' Avoids per-keystroke O(N*M) full-doc scans inside AC_AddMapKeys.
	Field acIdentCase:=New StringMap<String>
	Field acIdentCasePath:String = ""
	Field acIdentCaseLines:Int = -1
	Field acIdentCaseValid:Int = 0
	
	' Incremental AC items cache.
	' When the user keeps typing the same identifier ("c" -> "ca" -> "can" -> "canv"),
	' the new set of matches is always a subset of the previous set. Instead of rebuilding
	' the whole items list every keystroke (iterating all symFiles / scope maps and resorting),
	' we just filter the previously built (and already sorted) items by the new prefix.
	' Invalidated only when caret line, scope generation, parser version, doc structure,
	' after-dot context, or doc path actually change.
	Field acFilterCacheValid:Int = 0
	Field acFilterCachePrefixUp:String = ""
	Field acFilterCacheItems:String[] = New String[0]
	Field acFilterCacheItemsUp:String[] = New String[0]
	Field acFilterCacheAfterDot:Int = -1
	Field acFilterCacheOwnerTypeUp:String = ""
	Field acFilterCacheOwnerStatic:Int = 0
	Field acFilterCacheStringKwDot:Int = 0
	Field acFilterCacheCaretLn:Int = -1
	Field acFilterCacheNumLines:Int = -1
	Field acFilterCacheSymVer:Int = -1
	Field acFilterCacheScopeGen:Int = -1
	Field acFilterCachePath:String = ""
	
	' Cache della risoluzione del tipo dell'owner dopo il punto (es. "canv" in "canv.DrawImage").
	' Mentre si digita il nome del membro, il contesto a sinistra del "." non cambia: la posizione
	' del punto, il caretLn, l'identificatore owner, lo stato dello scope/parser e il numero di
	' righe del documento restano stabili. Quindi anche la risoluzione (acOwnerTypeUp,
	' acOwnerStaticClass, acStringKeywordDot) e' identica ad ogni keystroke. Senza questa cache,
	' AC_UpdateFromCaret rifa' EnsureScopeVarCache + AC_FindTypeOfIdentUp + AC_InferExprTypeUpAtPos
	' + AC_IdentDeclaredAsArrayUp + HL_IsClassNameUp + AC_ShouldBlockMemberAutocompleteAfterDot
	' ad ogni tasto, il che e' la lentezza percepita durante "canv.DrawImage".
	Field acOwnerCtxCacheValid:Int = 0
	Field acOwnerCtxCacheCaretLn:Int = -1
	Field acOwnerCtxCacheDotPos:Int = -1
	Field acOwnerCtxCacheOwnerUp:String = ""
	Field acOwnerCtxCacheNumLines:Int = -1
	Field acOwnerCtxCacheScopeGen:Int = -1
	Field acOwnerCtxCacheParserVer:Int = -1
	Field acOwnerCtxCachePath:String = ""
	Field acOwnerCtxCacheTypeUp:String = ""
	Field acOwnerCtxCacheStatic:Int = 0
	Field acOwnerCtxCacheStringKw:Int = 0
	
	' Memoization for AC_FindTypeOfIdentUp / AC_IdentDeclaredAsArrayUp.
	' Both are called multiple times per keystroke from AC_UpdateFromCaret's
	' after-dot path (array check, type resolution, static-class check) and each
	' uncached call tokenizes up to caretLn lines, which dominates typing latency
	' when you write "canv.DrawImage" deep inside a long file.
	' Keyed on (parserCycleId, scopeLayoutGen) â€” NOT SYM_GetGlobalVersion(): the
	' latter is bumped once per emitted declaration, so while the parser re-scans
	' the current file during a typing burst it churns proportionally to file size,
	' which would invalidate these caches every frame and defeat the whole point.
	Field acFindTypeCache:=New StringMap<String>
	Field acFindTypeCacheVer:Int = -1
	Field acFindTypeCacheGen:Int = -1
	Field acIdentArrayCache:=New StringMap<Int>
	Field acIdentArrayCacheVer:Int = -1
	Field acIdentArrayCacheGen:Int = -1
	
