	Method MoveCaretToUp(nump, isshift:Bool)
	
		Local xpe
		
		If xposcaret < xposcaretsav Then xpe = xposcaretsav Else xpe = xposcaret
		
		Local l2:Int = linecaret - nump

		If l2 < 0 Then l2 = 0

		Local idl1:Int = doc.idline[l2]
		Local idl2:Int = doc.idline[l2 + 1]

		
		If idl1 + xpe > idl2 - 2 Then idl1 = idl2 - xpe - 2
		
		idcaret = idl1 + xpe

		'If l2 < line Then line = line - 1

		If line < 0 Then line = 0

		Select isshift

			Case 0

				idstartsel = idcaret
				idendsel = idcaret

			Case True

				idendsel = idcaret

		End Select

		'CaretOutOfScreen()
			
	End Method
	
	Method MoveCaretToDown(nump, isshift:Bool)
	
		Local xpe
		
		If xposcaret < xposcaretsav Then xpe = xposcaretsav Else xpe = xposcaret
		
		Local l2:Int = linecaret + nump
		
		If l2 > doc.idlines - 2 Then l2 = doc.idlines - 2

		If l2 < 0 Then l2 = 0
				
		Local idl1:Int = doc.idline[l2]
		Local idl2:Int = doc.idline[l2 + 1]

		If idl1 + xpe > idl2 - 2 Then idl1 = idl2 - xpe - 2

		idcaret = idl1 + xpe

		'If l2 > lastline - 1 Then line = line + 1

		Select isshift

			Case 0

				idstartsel = idcaret
				idendsel = idcaret

			Case True

				idendsel = idcaret

		End Select

		'CaretOutOfScreen()

	End Method
	
	Method MoveCaretToRight(isshift:Bool)
	
		If idcaret > doc.Crs.Length - 1 Then idcaret = doc.Crs.Length - 1

		If idcaret < 0 Then idcaret = 0
		
		'Print doc.Crs.Length
		'Print idcaret
		
		Local cc:Int = doc.Crs[idcaret] & 255

		If cc = 13 Then idcaret = idcaret + 1
		If cc <> 0 Then
			idcaret = idcaret + 1

		End If

		If idcaret > doc.Crs.Length - 1 Then idcaret = doc.Crs.Length - 1

		Select isshift

			Case 0

				idstartsel = idcaret
				idendsel = idcaret

			Case True

				idendsel = idcaret

		End Select

		'CaretOutOfScreen()
		
	End Method
	
	Method MoveCaretToLeft(isshift:Bool)

		idcaret = idcaret - 1

		If idcaret < 0 Then idcaret = 0
		If (doc.Crs[idcaret] & 255) = 10 Then idcaret = idcaret - 1
		If idcaret < 0 Then idcaret = 0

		Select isshift

			Case 0

				idstartsel = idcaret
				idendsel = idcaret

			Case True

				idendsel = idcaret

		End Select

		'CaretOutOfScreen()
				
	End Method
	
	
	
	Method CaretOutOfScreen(xxca, yyca, wwca, hhca)
	
		'NEW OUT OF SCREEN
		'If 1 = 1 Then
		
		GetCursorLine()
		
		Local vis:Int = numlineinpage
		If vis < 1 Then vis = 48
		
		If linecaret < line + 1 Then
		
			line = linecaret - 1
		
			VSBar.value = line
			VSBar.SetOBARFromValue
		
			'Return
		
		EndIf
		
		If linecaret > line + vis - 2 Then
		
			line = linecaret - vis + 2
		
			VSBar.value = line
			VSBar.SetOBARFromValue
		
			'Return
		
		EndIf
		
		'Print GetCursorX
			
		Local xc = GetCursorX2 * xkscale
			
		'Print xc + "," + (xoffdraw + 30)
		
		If xc < xoffdraw + 30 Then

			xoffdraw = xc - 30
			
			If xoffdraw < 0 Then xoffdraw = 0
			
			HSBar.value = xoffdraw
			HSBar.SetOBARFromValue
				
			'Return
			
		EndIf
			
		'Print xc + "," + (xoffdraw + numcolinpage * xkscale - 30)
		
		If xc > xoffdraw + numcolinpage * xkscale - 30 Then

			xoffdraw = xc - numcolinpage * xkscale + 30
			
			If xoffdraw < 0 Then xoffdraw = 0
			
			HSBar.value = xoffdraw
			HSBar.SetOBARFromValue
				
			'Print "R"
			
			Return
									
		EndIf
			
					
		'	Return
		
		'EndIf
		
