Class MyDrawList 'Extends BBMyDrawList
	Field commands:List<DrawCommand> = New List<DrawCommand>()

	Method AddCommand(cmd:DrawCommand)
		commands.AddLast(cmd)
	End
End

Interface IRenderer
	Method Render(list:DrawList)
	'	Method DrawText(cmd:DrawText)
	Method DrawText2(cmd:DrawCommand)
	Method DrawLine2(cmd:DrawLine)
	Method DrawImage2(cmd:DrawImage)
End

Class CanvasRenderer Implements IRenderer
		
	
	Method Render(list:MyDrawList, ca:Canvas)
	
		
		'		DrawImage.DRAWSTART
		
		For Local cmd:= EachIn list.commands
			
			'			If DrawText(cmd) Then Continue
			'			If DrawLine(cmd) Then Continue
			'			If DrawImage(cmd) Then Continue
			cmd.Draw2(ca)
			
		Next
	End

	Method DrawText2(cmd:DrawText)
		' OpenGL 2.0 calls to draw text here
	End

	Method DrawLine2(cmd:DrawLine)
		' OpenGL calls for lines here
	End

	Method DrawImage2(cmd:DrawImage)
		' OpenGL calls for images here
	End
End


Class PrinterRenderer Implements IRenderer

	Method Render(list:MyDrawList)
		
	
		pixelpercm = _StartPrintDocument / 100.0 '* kres
			
		Print pixelpercm
		
		For Local cmd:=EachIn list.commands
			'			If DrawText(cmd) Then Continue
			'			If DrawLine(cmd) Then Continue
			'			If DrawImage(cmd) Then Continue

			cmd.Print2
			

		Next
				
		_EndPrintDocument
		
	End

	Method DrawText(cmd:DrawText)
		' Conversion to printer commands here
	End

	Method DrawLine(cmd:DrawLine)
		' Lines with printer API here
	End

	Method DrawImage(cmd:DrawImage)
		' Print image
	End
End

