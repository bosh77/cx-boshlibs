' Percorso mostrato nella barra del foglio: un solo "/" (niente "//" da dir+file).
' Se inizia con "//" (UNC), preserva quelle due barre iniziali.
Function SheetDisplayPath:String(p:String)

	p = AdjustPath(p)
	
	If p = "" Then Return p
	
	If p.StartsWith("//")
	
		Local body:String = MidString(p, 3, p.Length - 2)
		
		While body.Contains("//")
		
			body = body.Replace("//", "/")
		
		Wend
		
		Return "//" + body
	
	EndIf
	
	While p.Contains("//")
	
		p = p.Replace("//", "/")
	
	Wend
	
	Return p

End

Function SheetPathsEqual:Int(a:String, b:String)

	Local ka:String = SheetDisplayPath(a)
	Local kb:String = SheetDisplayPath(b)
	
	#If HOST="winnt"
	
	Return ka.ToLower() = kb.ToLower()
	
	#Else
	
	Return ka = kb
	
	#EndIf

End

Class blSheet Extends blGraphic

	Global allsheets:= New List<blSheet>

	
	Global docum:= New List<blDoc>   ' testi e disegni insieme
	Global IDDOC:Int
		
	Global mainbox:blGraphic
	
	Field childsboxes:= New List<blGraphic>
	
	Field focusbox:blGraphic
	
	
	
	'Field isfocus
	
	
	Method New(x1:Float, y1:Float, x2:Float, y2:Float)
	
		Self.typeobj = 1
		
		Self.xo1 = x1
		Self.yo1 = y1
		Self.xo2 = x2
		Self.yo2 = y2
	
				
		'focussheet = Self
		
		'allsheets.AddLast Self
	
		
	End Method

	Function Init()
		
	
		#If NATIVEFONTSON then
		
		xfont1 = New blFont(xfont1name, kscalefont)
		
		#Else
		
		xfont1 = New blFont("Consolas")
		
		#EndIf
		
		'xfont1 = New blFont("Consolas")
		
		
		SetScale
		
		
	End Function
	
	Function SetScale()
			
		'		xkscale = 4 + kscale
		
		xkscale = xfont1.GetTextWidth("W", 0)
		
		'		ykscale = 8 + kscale * 2
		
		ykscale = xfont1.GetTextHeight("W", 0) + 2
		
		'		hcaret = 7 + kscale * 2

		hcaret = ykscale - 1

		'         ftext = New Font("Courier New", emSize:=kscale + 7)
  
		'         numlineinpage = (Height - 32) / ykscale
		'         numcolinpage = (Width - ww2 - 32) / xkscale
			
	
	End Function
	
	
	
	
	Method DrawSheet(canv:Canvas, x1, y1, x2, y2)
	
		'canv.SetColor 0.5, 0.9, 0.5
		
		'canv.SetColor 0.5, 0.5, 0.5
		
		If leftshsplitter Then xo1 = leftshsplitter.X1 Else xo1 = 0
		If rightshsplitter Then xo2 = rightshsplitter.X2 Else xo2 = 1
		
		If topshsplitter Then yo1 = topshsplitter.Y1 Else yo1 = 0
		If bottomshsplitter Then yo2 = bottomshsplitter.Y2 Else yo2 = 1
		
		IdeUiSetCanvas canv, IDEUI_SHEET_BG
		
		Local xca1 '= GetAbsX(xo1)
		Local yca1 '= GetAbsY(yo1)
		Local xca2 '= GetAbsX(xo2) - xca1
		Local yca2 '= GetAbsY(yo2) - yca1
		
		xca1 = xo1 * x2
		yca1 = yo1 * y2
		xca2 = xo2 * x2 - xca1
		yca2 = yo2 * y2 - yca1
				
		
		'If focussheet = Self Then canv.SetColor 1, 1, 0
		
		'canv.DrawRect(x1 + xca1 + 4, y1 + yca1 + 4, x1 + xca2 - 8, y1 + yca2 - 8)
		'canv.DrawRect(x1 + xca1 + 4, y1 + yca1 + 4, xca2 - 8, yca2 - 8)
		
		
		If focussheet = Self and actfocusmode = idfocus Then
			
			IdeUiSetCanvas canv, IDEUI_WIN_SEL
			canv.DrawRect(x1 + xca1, y1 + yca1, xca2, yca2)
		
			cursorvis = 1
			cursorvis2 = 1
			
			
		Else
			
			cursorvis = 0
			
		EndIf
		
		
		
		canv.SetColor 0.1, 0.1, 0.3
		'canv.DrawRect(x1 + xca1 + 5, y1 + yca1 + 5, x1 + xca2 - 10, y1 + yca2 - 10)
		canv.DrawRect(x1 + xca1 + 5, y1 + yca1 + 5, xca2 - 10, yca2 - 10)
		
		'		canv.SetColor 0.1, 0.1, 0.6
		'		canv.DrawRect(x1 + xca1 + 15, y1 + yca1 + 15, xca2 - 30, yca2 - 30)
		
		'canv.DrawRect(x1, y1, x2, y2)
		
		Local xs = xca1 + x1 + 5
		Local ys = yca1 + y1 + 5
		
		Local ys2 = ys + 20
		Local hs2 = yca2 - 25
		
		'canv.DrawRect(xs, ys, xca2, yca2)
		
		Local xx = 0
	
		canv.SetColor 1, 1, 1
		
		Local isempty = 1
		
		Local i = 0
		
		For Local o:= EachIn childsboxes
			' i riquadri di disegno non hanno un documento di testo
			' un riquadro puo' essere di testo (doc) o di disegno (draw): la linguetta
			' ha bisogno solo del nome, che sta nella base comune blDoc.
			Local dc:blDoc = o.doc
			If dc = Null Then dc = o.draw
			If dc = Null Then Continue
			
			isempty = 0
			
			Local xoffbox
			
			Local nf:= dc.projname
			If o.doc <> Null And o.doc.textchanged Then nf = nf + "*"
			
			Local ww = font1.GetTextWidth(nf, 0)
						
			
			If o = mainbox Then ww = ww + 20
				
			'If isfocus = i Then
			If focusbox = o Then
				IdeUiSetCanvas canv, IDEUI_TAB_ACTIVE
			Else
				IdeUiSetCanvas canv, IDEUI_TAB_INACTIVE
			EndIf
				
			If xx + ww + 34 > xca2 and i > 0 Then xx = 0; ys = ys + 22; ys2 = ys2 + 22; hs2 = hs2 - 22
			
			canv.DrawRect(xs + xx, ys, ww + 30, 20)
			If blForceCanvasFlush Then canv.Flush
						
			canv.SetColor 1, 1, 1
			
			'main project
			If o = mainbox Then
				canv.DrawImageRect(objsimg, xs + xx + 4, ys + 3, 8, 63, 8, 8, 0, 2.2, 2.2)
				If blForceCanvasFlush Then canv.Flush
				xoffbox = 20
			EndIf
			
			'file name
			'font1.DrawText(canv, nf, xs + xx + 7 + xoffbox, ys + 2, COLOR_BLACK, 4, 1)
			font1.DrawText(canv, nf, xs + xx + 7 + xoffbox, ys + 4, IdeUiFileNameColor(), 4, 1)
			
			canv.SetColor 1, 1, 1

			'close box
			Local xcl = 0
			If o.isonx Then xcl = 16 ' canv.SetColor 1, 0, 0
					
			canv.DrawImageRect(objsimg, xs + xx + ww + 12, ys + 3, xcl, 0, 14, 14)
			If blForceCanvasFlush Then canv.Flush
							
			'canv.SetColor 0.1, 0.1, 0.1
								
			xx = xx + ww + 34
						
			i = i + 1
			'Print o.filename
			
		Next
		
		Select isempty
		
			Case 0
			
				For Local proj:= EachIn childsboxes
					' i riquadri di disegno non hanno un documento di testo
					' qui NON si salta il riquadro di disegno: lo smista DrawDrawBox piu' sotto.
					
					'If proj.num = isfocus Then
					
					'proj.DrawTextBox(canv, xca1 + x1, yca1 + y1, xca2, yca2)
					If focusbox = proj Then
					
						' un riquadro di disegno si disegna in 3D, non come testo
						If proj.draw <> Null Then
							proj.DrawDrawBox(canv, xca1 + x1, ys2 + 22, xca2, hs2 - 22)
						Else
							proj.DrawTextBox(canv, xca1 + x1, ys2 + 22, xca2, hs2 - 22)
						EndIf
					
					 
						canv.SetColor 1, 1, 1
						
						canv.SetScissor xca1 + x1, ys2, xca2 - 2, hs2 - 44
						
						' il percorso vale per entrambi i tipi: il nome sta nella base comune blDoc
						Local dd:blDoc = proj.doc
						If dd = Null Then dd = proj.draw
						If dd <> Null Then DrawString(canv, font1, SheetDisplayPath(dd.fullname), xs + 3, ys2 + 7, IdeUiFileNameColor(), 0, 1)
						
						canv.SetScissor 0, 0, DeviceWidth, DeviceHeight
						
						'Local tw:= xkscale * perc.Length  ' * font1.GetTextWidth("A", 0)
						'DrawString(canv, font1, perc, x1 + x2 - 5, y1 + y2 - 20, -1, 2, 1)
					 
					EndIf
					If blForceCanvasFlush Then canv.Flush
					
				Next
			
				
				If focussheet.focusbox Then
				
					'barra in fondo
					Local ybs = DeviceHeight - 20
					'focusbox.MySetColor canv, 40, 40, 40
					canv.SetColor 0.2, 0.2, 0.2
					canv.DrawRect(0, ybs, ScrW, 20)
					If blForceCanvasFlush Then canv.Flush
	
					Local txtp:String = "Line: " + (focussheet.focusbox.linecaret + 1) + "  Char: " + (focussheet.focusbox.xposcaret + 1) '+ "   " + numcolinpage '+ "   " + GetCursorX
		
					Local perc:String = Int(kscalefont / 16.0 * 100) + "%"
			
					canv.SetColor 1, 1, 1
					DrawString(canv, font1, txtp + "        " + perc, 6, ybs + 4, -1, 0, 1)
					If blForceCanvasFlush Then canv.Flush
		
				EndIf
				
			
			Case 1
			
			
			
		End
			
	End Method

	
	
	Method UpdateSheet(x1, y1, x2, y2)
	
		'canv.SetColor 0.5, 0.9, 0.5
		
		Local xca1 '= GetAbsX(xo1)
		Local yca1 '= GetAbsY(yo1)
		Local xca2 '= GetAbsX(xo2) - xca1
		Local yca2 '= GetAbsY(yo2) - yca1
		
		xca1 = xo1 * x2
		yca1 = yo1 * y2
		xca2 = xo2 * x2 - xca1
		yca2 = yo2 * y2 - yca1
		
		'canv.DrawRect(x1 + xca1, y1 + yca1, x1 + xca2 - 1, y1 + yca2 - 1)
		'canv.DrawRect(x1, y1, x2, y2)
		
		Local xs = xca1 + x1 + 5
		Local ys = yca1 + y1 + 5
		
		Local ys2 = ys + 20
		Local hs2 = yca2 - 25
		
		'Local maxx = xs + xca2
		
		'canv.DrawRect(xs, ys, xca2, yca2)
		
		Local xx = 0
	
		'canv.SetColor 1, 1, 1
		
		Local i = 0
		
		'If canv.Font Then
	
			
		idfocus = 1
		
		
		For Local o:= EachIn childsboxes
			' i riquadri di disegno non hanno un documento di testo: come in DrawSheet,
			' si ripiega su o.draw. Senza questo fallback l'intera riga (hover, drag,
			' e la X di chiusura) veniva saltata per ogni blDrawbox.
			Local dc:blDoc = o.doc
			If dc = Null Then dc = o.draw
			If dc = Null Then Continue

			Local xoffbox

			Local nf:= dc.projname
			If o.doc <> Null And o.doc.textchanged Then nf = nf + "*"

			Local ww = font1.GetTextWidth(nf, 0)

			If o = mainbox Then ww = ww + 20; xoffbox = 20
						
			'			If isfocus Then
			'				canv.SetColor 0.7, 0.7, 0.2
			'			Else
			'				canv.SetColor 0.3, 0.5, 0.7
			'			EndIf
				 
			If xx + ww + 34 > xca2 and i > 0 Then xx = 0; ys = ys + 22; ys2 = ys2 + 22; hs2 = hs2 - 22
			
			
			If xmou > xs + xx and xmou < xs + xx + ww + 18 and ymou > ys and ymou < ys + 18 Then
			
				If touchhit Then

					If nochangefocus = 0 Then
					
						focusbox = o
						SetFocusSheet(actsheet)
				
						actfocusmode = idfocus
					
					EndIf
					
				EndIf
				
				If boxmove = Null and touchdown Then
					
					boxmove = o
					boxmovex = xs + xx - xmou
					boxmovey = ys - ymou
					boxmovew = ww + 30
					boxtextx = 7 + xoffbox
					
				EndIf
				
				If boxmove Then
					
					boxmoveon = o
					
					If xmou > xs + xx + (ww + 34) / 2 Then
						boxmovelr = 1
					Else
						boxmovelr=0
					EndIf
				
				EndIf
				
			EndIf
			
			'canv.DrawRect(xs + xx, ys, ww + 18, 18)
			
			Local x3 = xs + xx + ww + 12
			
			If xmou > x3 and xmou < x3 + 14 and ymou > ys + 3 and ymou < ys + 17 Then
				
				o.isonx = 1
				
				If touchrel Then
					
					o.CloseBox(Self)
					
				EndIf
				
			Else
				o.isonx = 0
			EndIf
			
			'canv.DrawImageRect(objsimg, xs + xx + ww + 20, ys + 3, 0, 0, 14, 14)
			
			
			'canv.SetColor 1,1,1
			'canv.DrawText(nf, xs + xx, ys + 2)
			
			xx = xx + ww + 34
			
			'If xx > xca2 Then xx = 0; ys = ys + 20
			
			i = i + 1
			'Print o.filename
			
		Next
		'EndIf
	
		
		For Local proj:= EachIn childsboxes
					
			'If proj.num = isfocus Then
					
			'proj.DrawTextBox(canv, xca1 + x1, yca1 + y1, xca2, yca2)
			If focusbox = proj Then
			
				' un riquadro di disegno si disegna in 3D, non come testo
				If proj.draw <> Null Then
					If nochangefocus = 0 Then proj.UpdateDrawBox(xca1 + x1, ys2, xca2, hs2)
				Else
					If nochangefocus = 0 Then proj.UpdateTextBox(xca1 + x1, ys2, xca2, hs2)
				EndIf
			
				
				'				If IsOnRect(xca1 + x1, ys2, xca2, hs2) Then
				'
				'					proj.UpdateMouseWheel 'UpdateSheetMouseWheel() 'x1 + xca1, y1 + yca1, xca2, yca2)
				'
				'					'Print Millisecs + " ---> " + numx + "," + (xwe + xca1) + "," + (ywe + yca1)
				'
				'
				'				EndIf
				
				'If actsheet = focussheet Then proj.UpdateTextBoxKeyb(x1, y1, x2, y2)
				If actsheet = focussheet Then
					
					If replstr = 1 Then proj.ReplaceString(xca1 + x1, ys2, xca2, hs2); replstr = 0
					
					If replstr = 2 Then proj.ReplaceAllString(xca1 + x1, ys2, xca2, hs2); replstr = 0
				 
					If replstr = 100 Then FindString; proj.CaretOutOfScreen(xca1 + x1, ys2, xca2, hs2); replstr = 0
					
					If replstr > 200 Then
						
						Local gol = replstr - 200
					
						proj.GoToLine gol
						
						blEvents.SetGotoLineVisible(0)
						
						replstr = 0
						
					EndIf
					
					If nochangefocus = 0 Then
						' un riquadro di disegno si disegna in 3D, non come testo
						If proj.draw <> Null Then
							proj.UpdateDrawBoxOne(xca1 + x1, ys2, xca2, hs2)
						Else
							proj.UpdateTextBoxOne(xca1 + x1, ys2, xca2, hs2)
						EndIf
					EndIf
				
				EndIf
				 
			EndIf
			
			
			'EndIf
					
		Next
		
		
		'If replstr = 1 Then focussheet.focusbox.ReplaceString(xca1 + x1, ys2, xca2, hs2); replstr = 0
				
		'If replstr = 2 Then focussheet.focusbox.ReplaceAllString(xca1 + x1, ys2, xca2, hs2); replstr = 0
				 
		
		'focussheet.focusbox.UpdateTextBoxKeyb(x1, y1, x2, y2)
		
		'If replstr = -1 Then replstr = 0
		
		If nochangefocus > 0 Then nochangefocus = nochangefocus - 1
		
		
	End Method
	
	'	Method IsOnBoxProjName(x1, y1, x2, y2)
	'
	'		Local xca1 '= GetAbsX(xo1)
	'		Local yca1 '= GetAbsY(yo1)
	'		Local xca2 '= GetAbsX(xo2) - xca1
	'		Local yca2 '= GetAbsY(yo2) - yca1
	'
	'		xca1 = xo1 * x2
	'		yca1 = yo1 * y2
	'		xca2 = xo2 * x2 - xca1
