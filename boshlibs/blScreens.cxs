			For Local o2:= EachIn blSplitter.splits
				
				If o1 <> o2 Then
				
					'					Local xx1b = GetAbsX(o2.x1) '- ScrX
					'					Local yy1b = GetAbsY(o2.y1) '- ScrY
					'					Local xx2b = GetAbsX(o2.x2) '- ScrX
					'					Local yy2b = GetAbsY(o2.y2) '- ScrY
				
					Local xx1b = o2.x1 '- ScrX
					Local yy1b = o2.y1 '- ScrY
					Local xx2b = o2.x2 '- ScrX
					Local yy2b = o2.y2 '- ScrY
					
