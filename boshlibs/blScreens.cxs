	Function SplitterAlExist:blSplitter(T:blSplitter)
	
		For Local o1:= EachIn blSplitter.splits
			
			If T.x1 = o1.x1 and T.x2 = o1.x2 and T.y1 = o1.y1 and T.y2 = o1.y2 Then Return o1
		
		Next
	
		Return Null
		
	End Function
	
	Function GetLeftSplitter:blSplitter(T:blSplitter)
		
		Local T2:blSplitter = Null
		
		Local xx = -100
		
		For Local o1:= EachIn blSplitter.splits
		
			If o1 <> T and T.idspl <> o1.idspl and o1.orient = T.orient Then
				
				If (GetAbsY(o1.Y2) - 1 < GetAbsY(T.Y1) or GetAbsY(o1.Y1) + 1 > GetAbsY(T.Y2)) Then
				
				Else
				
					If GetAbsX(o1.X1) < xmou and GetAbsX(o1.X1) > xx Then xx = GetAbsX(o1.X1); T2 = o1
				
				EndIf
					
			EndIf
		Next
		
		Return T2
		
	End Function
	
	Function GetRightSplitter:blSplitter(T:blSplitter)
		
		Local T2:blSplitter = Null
		
		Local xx = 10000
		
		For Local o1:= EachIn blSplitter.splits
		
			If o1 <> T and T.idspl <> o1.idspl and o1.orient = T.orient Then
				'If o1 <> T and o1.orient = T.orient Then
				
				If (GetAbsY(o1.Y2) - 1 < GetAbsY(T.Y1) or GetAbsY(o1.Y1) + 1 > GetAbsY(T.Y2)) Then
				
					'Print o1.Y2
					
				Else
				
					If GetAbsX(o1.X1) > xmou and GetAbsX(o1.X1) < xx Then xx = GetAbsX(o1.X1); T2 = o1
				
				EndIf
				
			EndIf
		Next
		
		Return T2
		
	End Function
	
	Function GetTopSplitter:blSplitter(T:blSplitter)
		
		Local T2:blSplitter = Null
		
		Local yy = -100
		
		For Local o1:= EachIn blSplitter.splits
		
			If o1 <> T and T.idspl <> o1.idspl and o1.orient = T.orient Then
				
				If (GetAbsX(o1.X2) - 1 < GetAbsX(T.X1) or GetAbsX(o1.X1) + 1 > GetAbsX(T.X2)) Then
				
				Else
				
					If GetAbsY(o1.Y1) < ymou and GetAbsY(o1.Y1) > yy Then yy = GetAbsY(o1.Y1); T2 = o1
				
				EndIf
					
			EndIf
		Next
		
		Return T2
		
	End Function
	
	Function GetBottomSplitter:blSplitter(T:blSplitter)
		
		Local T2:blSplitter = Null
		
		Local yy = 10000
		
		For Local o1:= EachIn blSplitter.splits
		
			If o1 <> T and T.idspl <> o1.idspl and o1.orient = T.orient Then
				
				If (GetAbsX(o1.X2) - 1 < GetAbsX(T.X1) or GetAbsX(o1.X1) + 1 > GetAbsX(T.X2)) Then
				
				Else
				
					If GetAbsY(o1.Y1) > ymou and GetAbsY(o1.Y1) < yy Then yy = GetAbsY(o1.Y1); T2 = o1
					
				EndIf
				
			EndIf
		Next
		
		Return T2
		
	End Function
	
End

Class blSplitter
	
	Global splits:= New List<blSplitter>

	Global IDSPL
	
	Field idspl
	
	Field og1:blGraphic
	Field og2:List<blGraphic>
	
	Field X:Float, Y:Float
	
	Field x1, y1, x2, y2
	
	Field X1:Float
	Field Y1:Float
	Field X2:Float
	Field Y2:Float
	
	Field modespl
	
	Field orient '0-VERT  1-ORIZZ
	
	Field drawon
	
	Field dragging
	Field dragoffset
	
	Field leftsplitter:blSplitter
	Field rightsplitter:blSplitter
	Field topsplitter:blSplitter
	Field bottomsplitter:blSplitter
	
	Field limleft:Float = 0.05
	Field limright:Float = 0.95
	Field limtop:Float = 0.05
	Field limbottom:Float = 0.95
	
