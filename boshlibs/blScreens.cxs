	'note: CREA SPLITTERS
	
	Method CreateSplitters()
			
		'Local xca = GetAbsX(xo1)
		'Local yca = GetAbsY(yo1)
		'Local wca = GetAbsX(xo2)
		'Local hca = GetAbsY(yo2)
				
		'canv.DrawRect(xca, yca, wca, hca)
				
		'		For Local o:= EachIn objs
		'
		'			Local t = o.typeobj
		'
		'			Select t
		'				Case 1
		'					o.DrawSheet(canv, xca, yca, wca, hca)
		'				Case 2
		'					o.DrawWin(canv, xca, yca, wca, hca)
		'			End
		'
		'			canv.SetColor 0.3, 0, 0
		'
			
		'			canv.DrawRect(xx1 + 10, yy1 + 10, xx2 - 20, yy2 - 20)
		'
		'		Next
		
		blSplitter.splits.Clear
		blSplitter.IDSPL = 0
		
		For Local o1:= EachIn objs
		
			Local fv = 0
			Local fo = 0
			
			Local TVERT:= New blSplitter()
			Local TORIZ:= New blSplitter()
			TORIZ.orient = 1
			
			Local xx1 = 10000
			Local xx2 = -10000
			
			Local yy1 = 10000
			Local yy2 = -10000
			
			Local xx1a = GetAbsX(o1.xo1) '- ScrX
			Local yy1a = GetAbsY(o1.yo1) '- ScrY
			Local xx2a = GetAbsX(o1.xo2) '- ScrX
			Local yy2a = GetAbsY(o1.yo2) '- ScrY
			
			'			xx1a = xx1a + ScrX
			'			yy1a = yy1a + ScrY
			'			xx2a = xx2a + ScrX
			'			yy2a = yy2a + ScrY
			
			For Local o2:= EachIn objs
				
				If o1 <> o2 Then
				
					Local xx1b = GetAbsX(o2.xo1) '- ScrX
					Local yy1b = GetAbsY(o2.yo1) '- ScrY
					Local xx2b = GetAbsX(o2.xo2) '- ScrX
					Local yy2b = GetAbsY(o2.yo2) '- ScrY
				
					'					xx1b = xx1b + ScrX
					'					yy1b = yy1b + ScrY
					'					xx2b = xx2b + ScrX
					'					yy2b = yy2b + ScrY
					
					If yy2a >= yy1b or yy2b >= yy1a Then
						
						Local dfx = Abs(xx2a - xx1b)
					
						If dfx < 5 Then
							
							fv = 1
														
							If yy1a < yy1 Then yy1 = yy1a
							If yy1b < yy1 Then yy1 = yy1b
							
							If yy2a > yy2 Then yy2 = yy2a
							If yy2b > yy2 Then yy2 = yy2b
														
							o1.rightsplitter = TVERT
							o2.leftsplitter = TVERT
							
						EndIf
					
					EndIf
								
					If xx2a >= xx1b or xx2b >= xx1a Then
						
						Local dfy = Abs(yy2a - yy1b)
					
						If dfy < 5 Then
							
							fo = 1
														
							If xx1a < xx1 Then xx1 = xx1a
							If xx1b < xx1 Then xx1 = xx1b
							
							If xx2a > xx2 Then xx2 = xx2a
							If xx2b > xx2 Then xx2 = xx2b
											
							o1.bottomsplitter = TORIZ
							o2.topsplitter = TORIZ
							
						EndIf
					
					EndIf
					
				EndIf
								
			Next
		
			If fv Then
			
				TVERT.x1 = xx2a
				TVERT.x2 = xx2a
				TVERT.X = o1.xo2
				TVERT.y1 = yy1
				TVERT.y2 = yy2
			
				TVERT.X1 = GetRelX(xx2a)
				TVERT.X2 = GetRelX(xx2a)
				TVERT.Y1 = GetRelY(yy1)
				TVERT.Y2 = GetRelY(yy2)
				
				Local T:= SplitterAlExist(TVERT)
				
				If T Then
					TVERT.idspl = T.idspl
				Else
					TVERT.idspl = blSplitter.IDSPL
					blSplitter.IDSPL = blSplitter.IDSPL + 1
				EndIf
				
				blSplitter.splits.AddLast TVERT
				'Print "NEW SPLITTER V"
				'EndIf
				
			
				'Print "NEW SPLITTER V"
				
				'				Print o1.rightsplitter.X
				'				Print T.X
				'Print TVERT.x1
				'Print TVERT.y1
				'Print TVERT.y2
				
				'Print ScrW + "," + ScrH
				
			EndIf
		
			If fo Then
			
				TORIZ.y1 = yy2a
				TORIZ.y2 = yy2a
				TORIZ.Y = o1.yo2
				TORIZ.x1 = xx1
				TORIZ.x2 = xx2
			
				TORIZ.X1 = GetRelX(xx1)
				TORIZ.X2 = GetRelX(xx2)
				TORIZ.Y1 = GetRelY(yy2a)
				TORIZ.Y2 = GetRelY(yy2a)
				
				
				'Local T:= SplitterAlExist(TORIZ)
				
				'If T Then
				'If o1.bottomsplitter = Null Then o1.bottomsplitter = TORIZ
				'If o1.topsplitter = Null Then o1.topsplitter = TORIZ
				'Else
				
				Local T:= SplitterAlExist(TORIZ)
				
				If T Then
					TORIZ.idspl = T.idspl
				Else
					TORIZ.idspl = blSplitter.IDSPL
					blSplitter.IDSPL = blSplitter.IDSPL + 1
				EndIf
				
				blSplitter.splits.AddLast TORIZ
				'Print "NEW SPLITTER O"
				'EndIf
				
				'blSplitter.splits.AddLast TORIZ
			
				'Print "NEW SPLITTER O"
				
				'				Print o1.rightsplitter.X
				'				Print T.X
				'Print TORIZ.x1
				'Print TORIZ.x2
				'Print TORIZ.y1
				'Print TORIZ.y2
				'Print TORIZ.y1
				'				Print T.y2
				
				'Print ScrW + "," + ScrH
				
			EndIf
			
		Next
		
		
		'CREA RIFERIMENTI
		
		For Local o1:= EachIn blSplitter.splits
		
			'			Local xx1a = GetAbsX(o1.x1) '- ScrX
			'			Local yy1a = GetAbsY(o1.y1) '- ScrY
			'			Local xx2a = GetAbsX(o1.x2) '- ScrX
