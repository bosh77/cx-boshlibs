
Import mojo2

Import blTheme
Import blHooks
Import blFuncs
Import brl.filestream
Import brl.filesystem
Import brl.filepath
Import blGraphics


' L'immagine viaggia col modulo: nessuna app deve fornirla. Nota: Cerberus
' appiattisce i percorsi dei dati importati, quindi niente sottocartelle.
Import "data/objsnew.png"


Class blScreen Extends blGraphic
		
	Const kanchor = 5
	
	'Field objs:= New List<blGraphic>
	
	'	Method New(canva:Canvas, x, y, w, h)
	'
	'		Self.canv = canva
	'
	'		Self.xsc = x
	'		Self.ysc = y
	'		Self.wsc = w
	'		Self.hsc = h
	'
	'	End Method

	Method New(canva:Canvas, x1:Float, y1:Float, x2:Float, y2:Float)
		
		objsimg = Image.Load("cerberus://data/objsnew.png", 0, 0, 0)
		
		Self.canv = canva
		
		Self.xo1 = x1
		Self.yo1 = y1
		Self.xo2 = x2
		Self.yo2 = y2
	
		ScrX = GetAbsScrX(xo1)
		ScrY = GetAbsScrY1(yo1)
		ScrW = GetAbsScrX(xo2) - ScrX
		ScrH = GetAbsScrY2(yo2) - ScrY
		
		
		
		'		ScrX = GetAbsScrX(xo1)
		'		ScrY = GetAbsScrY(yo1)
		'		ScrW = GetAbsScrX(xo2) - ScrX
		'		ScrH = GetAbsScrY(yo2) - ScrY
		
		
		
		'		xca = DeviceWidth * x
		'		yca = DeviceHeight * y
		'		wca = DeviceWidth * w
		'		hca = DeviceHeight * h
		
	End Method
	
	Method Draw()
		
		canv.SetColor 0.2, 0.2, 0.2
		
		'		Local xca = DeviceWidth * xp
		'		Local yca = DeviceHeight * yp
		'		Local wca = DeviceWidth * wp
		'		Local hca = DeviceHeight * hp
		
		'		Local xca = xsc
		'		Local yca = ysc
		'		Local wca = wsc
		'		Local hca = hsc

		ScrX = GetAbsScrX(xo1)
		ScrY = GetAbsScrY1(yo1)
		ScrW = GetAbsScrX(xo2) - ScrX
		ScrH = GetAbsScrY2(yo2) - ScrY
		
		'		Local xca1 = GetAbsX(xo1) '+ ScrX
		'		Local yca1 = GetAbsY(yo1) '+ ScrY
		'		Local xca2 = GetAbsX(xo2) '+ ScrX
		'		Local yca2 = GetAbsY(yo2) '+ ScrY
		'
		'		xca1 = ScrX
		'		yca1 = ScrY
		'		xca2 = ScrW
		'		yca2 = ScrH
		
		'Print ScrW + "," + ScrH
		
		'xca1 = GetAbsScrX(xo1)
		'yca1 = GetAbsScrY(yo1)
		'xca2 = GetAbsScrX(xo2) - xca1
		'yca2 = GetAbsScrY(yo2) - yca1
		
		canv.DrawRect(ScrX, ScrY, ScrW, ScrH)
				
		Local drawlogo = 1
		
		cursorvis2 = 0
		
		For Local o:= EachIn objs
			
			'Local t = o.typeobj
			
			'Select t
			'Case 1
			'o.DrawSheet(canv, xca, yca, wca, hca)
			'Case 2
			o.DrawWin(canv, ScrX, ScrY, ScrW, ScrH)
			'End
			
			'canv.SetColor 0.3, 0, 0
			
			'Local xx1 = ScrX + GetAbsX(o.xo1)
			'Local yy1 = ScrY + GetAbsY(o.yo1)
			'Local xx2 = (GetAbsX(o.xo2) - GetAbsX(o.xo1))
			'Local yy2 = (GetAbsY(o.yo2) - GetAbsY(o.yo1))
			
			'canv.DrawRect(xx1 + 10, yy1 + 10, xx2 - 20, yy2 - 20)
			drawlogo = 0
			
		Next
		
		'note: DRAW LOGO
		
		If drawlogo Then
				
			Local s:Float = ScrH / Float(logo.Height)
				
			Local nw:Float = logo.Width * s
				
			Local nw2 = (ScrW - nw) / 2.0
				
			canv.SetAlpha 0.4
			canv.SetColor 1, 1, 1
			canv.DrawImage(logo, ScrX + nw2, ScrY, 0, s, s)

			canv.SetAlpha 0.5
			canv.SetColor 1, 1, 0
			
			If idmenustart >= 0 Then
			
				canv.DrawRect(ScrX, ScrY + idmenustart * 128, 600, 128)
			
			EndIf
				
			canv.SetAlpha 1
			canv.SetColor 1, 1, 1
						
			canv.DrawImage(menustart, ScrX, ScrY)
				
				
		EndIf
							
		'Local kanchor = 5
		
		'note: DRAW SPLITTERS
		
		For Local o:= EachIn blSplitter.splits
		
			If o.leftsplitter Then o.X1 = o.leftsplitter.X1 'X
			If o.rightsplitter Then o.X2 = o.rightsplitter.X2 'X
		
			If o.topsplitter Then o.Y1 = o.topsplitter.Y1 'Y
			If o.bottomsplitter Then o.Y2 = o.bottomsplitter.Y2 'Y
			
			
			'Local xca2 = o.x1 '+ ScrX
			'Local yca2 = o.y1 '+ ScrY
			'Local wca2 = o.x2 '+ ScrX
			'Local hca2 = o.y2 '+ ScrY
			
			Local xca1 = GetAbsX(o.X1) + ScrX '+ xca
			Local yca1 = GetAbsY(o.Y1) + ScrY '+ yca
			Local wca1 = GetAbsX(o.X2) + ScrX '+ xca
			Local hca1 = GetAbsY(o.Y2) + ScrY '+ yca
			
			'If o.drawon Then
			
			'*new*
			If o.drawon or o.dragging Then
				
				'canv.SetColor 1, 0, 0
				'canv.SetColor 0, 0.9, 0.7
				canv.SetColor 1, 1, 0
				
				Select o.orient
			
					Case 0
										
						canv.DrawRect(xca1 - 2, yca1, 4, hca1 - yca1)
						
					Case 1
						
						canv.DrawRect(xca1, yca1 - 2, wca1 - xca1, 4)
						
				End
				
			EndIf
			
			'			If xmou > xca2 - kanchor and xmou < xca2 + kanchor Then
			'
			'				o.drawon = 1
			'
			'			Else
			'
			'				o.drawon = 0
			'
			'
			'			EndIf
		
		Next
		
		
	End Method
	
	Method Update()
	
		Local updlogo = 1
		
		For Local o:= EachIn objs
			
			'Local t = o.typeobj
			
			'Select t
			'Case 1
			'o.DrawSheet(canv, xca, yca, wca, hca)
			'Case 2
			o.UpdateWin(ScrX, ScrY, ScrW, ScrH)
			'End
			
						
			'canv.DrawRect(xx1 + 10, yy1 + 10, xx2 - 20, yy2 - 20)
			
			updlogo = 0
				
		Next
		
		
		If updlogo Then
			
			For Local i = 0 To 2
		
				If IsOnRect(ScrX, ScrY + i * 128, 600, 128) Then
					
					idmenustart = i
				
					If touchhit Then
										
						Select i
							Case 0
								NewProject
								LostFocus
								
							Case 1
								NewSolution
								LostFocus
							 
							Case 2
								OpenProject("")
								CreateHistory
								
						End
					
					EndIf
				
				EndIf
			
			Next
			
		EndIf
		
	
		
	
		'Local xca = GetAbsX(xo1)
		'Local yca = GetAbsY(yo1)
		'Local wca = GetAbsX(xo2)
		'Local hca = GetAbsY(yo2)
				
		'		canv.DrawRect(xca, yca, wca, hca)
		'
		'		For Local o:= EachIn objs
		'
		'			'			Local t = o.typeobj
		'			'
		'			'			Select t
		'			'				Case 1
		'			'					o.DrawSheet(canv, xca, yca, wca, hca)
		'			'				Case 2
		'			'					o.DrawWin(canv, xca, yca, wca, hca)
		'			'			End
		'
		'			Local xca2 = GetAbsX(o.xo) + xca
		'			Local yca2 = GetAbsY(o.yo) + yca
		'			Local wca2 = GetAbsX(o.wo) + xca2
		'			Local hca2 = GetAbsY(o.ho) + yca2
		'
		'			'If o.hook2 = 0 Then
		'			If lmou and hook = 0 Then
		'
		'				If xmou > xca2 - kanchor and xmou < xca2 + kanchor Then
		'
		'					'o.xo = o.xo + 0.01
		'					'o.wo = o.wo - 0.01
		'					hook = 1
		'					o.hookx = 1
		'					o.hookw = 1
		'
		'					o.hookvalx = xmou '- xca2
		'
		'				EndIf
		'
		'				If xmou > wca2 - kanchor and xmou < wca2 + kanchor Then
		'
		'					'o.wo = o.wo + 0.01
		'					hook = 1
		'					o.hookw = 1
		'
		'					o.hookvalw = xmou
		'
		'				EndIf
		'
		'				If ymou > yca2 - 2 and ymou < yca2 + 2 Then
		'
		'					'o.yo = o.yo + 0.01
		'					'o.ho = o.ho - 0.01
		'
		'				EndIf
		'
		'				If ymou > hca2 - 2 and ymou < hca2 + 2 Then
		'
		'					'o.ho = o.ho + 0.01
		'
		'				EndIf
		'
		'			EndIf
		'
		'
		'			If o.hookx = 1 Then
		'
		'				'o.xo = Float(o.hookvalx) / Float(xmou)
		'				'o.xo = Float(xmou) / Float(o.hookvalx)
		'				'o.xo = Float(xmou - Float(o.hookvalx)) / Float(DeviceWidth)
		'
		'				o.xo = Float(xmou - xca) / Float(DeviceWidth)
		'
		'			EndIf
		'
		'
		'			If lmou = 0 Then hook = 0; o.hookx = 0; o.hookw = 0
		'
		'
		'		Next
		
		'note: UPDATE SPLITTERS
		
		For Local o:= EachIn blSplitter.splits
		
			'			Local xca1 = o.x1 '+ ScrX '+ xca
			'			Local yca1 = o.y1 '+ ScrY '+ yca
			'			Local xca2 = o.x2 '+ ScrX '+ xca
			'			Local yca2 = o.y2 '+ ScrY '+ yca
			
			Local xca1 = GetAbsX(o.X1) + ScrX '+ xca
			Local yca1 = GetAbsY(o.Y1) + ScrY '+ yca
			Local xca2 = GetAbsX(o.X2) + ScrX '+ xca
			Local yca2 = GetAbsY(o.Y2) + ScrY '+ yca
			
			Select o.orient
			
				Case 0
			
					If ymou >= yca1 and ymou <= yca2 and xmou > xca1 - kanchor and xmou < xca1 + kanchor Then
			
						o.drawon = 1
				
						'Print Millisecs
						If touchhit Then
							'If lmou Then
												
							o.dragging = 1
					
							'Select o.modespl
				
							'Case 1,2
							o.dragoffset = xmou - xca1 + ScrX
							'Case 2
							'o.dragoffset = xmou - wca2
							'End
							
							'xmou2 = xmou
							
							'Local limlef = 50
							leftlimit = minsize
						
							Local T:= GetLeftSplitter(o)
							
							'If T Then Print T.X1
							
							If T Then leftlimit = GetAbsX(T.X1) + minsize  '; Print T.x1
							
							
							rightlimit = ScrW - minsize
							
							T = GetRightSplitter(o)
						
							'If T Then Print T.X1
							
							If T Then rightlimit = GetAbsX(T.X1) - minsize  '; Print T.x1
							
							
						EndIf
				
					Else
						o.drawon = 0
					EndIf
			
			
					If o.dragging Then
				
						'Select o.modespl
				
						'Case 0
				
						'o.og1.xo1 = Float(xmou - o.dragoffset) / Float(DeviceWidth)
						o.x1 = xmou - o.dragoffset '- ScrX
						
						
						'If o.limleft > - 50 and o.x1 < o.limleft Then o.x1 = o.limleft
						
						'If o.x1 < GetAbsX(o.limleft) Then o.x1 = GetAbsX(o.limleft)
						
						'If o.x1 > GetAbsX(o.limright) Then o.x1 = GetAbsX(o.limright)
						
												
						If o.x1 < leftlimit Then o.x1 = leftlimit  '; xmou = o.x1 + o.dragoffset
												
																		
						If o.x1 > rightlimit Then o.x1 = rightlimit  '; xmou = o.x1 + o.dragoffset
												
												
						o.x2 = o.x1
						'						Local kl:Float = Float(o.x1) / Float(ScrW)
						
						'o.X = Float(xmou - o.dragoffset) / Float(ScrW)
						
						
						'						o.X = kl ' Float(xmou - o.dragoffset) / Float(ScrW)

						o.X = GetRelX(o.x1) ' Float(xmou - o.dragoffset) / Float(ScrW)
						
						o.X1 = GetRelX(o.x1)
						o.X2 = GetRelX(o.x2)
						
						'For Local ox:= EachIn o.og2
				
						'	ox.xo2 = o.og1.xo1
				
						'Next
				
						'Case 1
				
						'						o.og1.xo2 = Float(xmou - o.dragoffset) / Float(DeviceWidth)
						'						o.x1 = xmou
						'
						'						For Local ox:= EachIn o.og2
						'
						'							ox.xo2 = o.og1.xo2
						'
						'						Next
				
						'End
				
						'UpdateLimits
						
					EndIf
			
				Case 1
					
					If xmou >= xca1 and xmou <= xca2 and ymou > yca1 - kanchor and ymou < yca1 + kanchor Then
			
						o.drawon = 1
				
						'Print Millisecs
						If touchhit Then
				
							o.dragging = 1
					
							'Select o.modespl
				
							'Case 1,2
							o.dragoffset = ymou - yca1 + ScrY
							'Case 2
							'o.dragoffset = xmou - wca2
							'End
							'ymou2 = ymou
				
							toplimit = minsize
						
							Local T:= GetTopSplitter(o)
						
							If T Then toplimit = GetAbsY(T.Y1) + minsize  '; Print T.x1
							
							bottomlimit = ScrH - minsize
						
							T = GetBottomSplitter(o)
						
							If T Then bottomlimit = GetAbsY(T.Y1) - minsize  '; Print T.x1
							
							
						EndIf
				
					Else
						o.drawon = 0
					EndIf
			
			
					If o.dragging Then
				
						'Select o.modespl
				
						'Case 0
				
						'o.og1.xo1 = Float(xmou - o.dragoffset) / Float(DeviceWidth)
						o.y1 = ymou - o.dragoffset '+ ScrY
						
						'						If o.y1 < GetAbsY(o.limtop) Then o.y1 = GetAbsY(o.limtop)
						
						'						If o.y1 > GetAbsY(o.limbottom) Then o.y1 = GetAbsY(o.limbottom)
							
						
												
						If o.y1 < toplimit Then o.y1 = toplimit  '; xmou = o.x1 + o.dragoffset
												
												
						If o.y1 > bottomlimit Then o.y1 = bottomlimit  '; xmou = o.x1 + o.dragoffset
						
						o.y2 = o.y1
						
						
						'Local kl:Float = Float(o.y1) / Float(ScrH)
						
						o.Y = GetRelY(o.y1) 'kl
						
						o.Y1 = GetRelY(o.y1)
						o.Y2 = GetRelY(o.y2)
						
						'For Local ox:= EachIn o.og2
				
						'	ox.xo2 = o.og1.xo1
				
						'Next
				
						'Case 1
				
						'						o.og1.xo2 = Float(xmou - o.dragoffset) / Float(DeviceWidth)
						'						o.x1 = xmou
						'
						'						For Local ox:= EachIn o.og2
						'
						'							ox.xo2 = o.og1.xo2
						'
						'						Next
				
						'End
						'UpdateLimits
						
					EndIf
					
			End
			
			
			If touchrel Then o.dragging = 0
			
		Next
	
		
		'		If focusboxold <> focussheet.focusbox Then Print Millisecs
		
		If focussheet Then focusboxold = focussheet.focusbox
		
		
	End
	
	'	Method AddSheet(x1:Float, y1:Float, x2:Float, y2:Float)
	'
	'		Local O:= New blSheet(x1, y1, x2, y2)
	'		objs.AddLast O
	'
	'		Print "New SHEET"
	'
	'	End Method
	
	Method AddWin(x1:Float, y1:Float, x2:Float, y2:Float, co, tw, winname:String)
	
		Local O:= New blWin(x1, y1, x2, y2, co, tw, winname)
		objs.AddLast O
		
		'Print "New WINDOW"
	
	End
	
	Method SetLAY(M)
	
	
		mainscr.objs.Clear
		
		
		Select M
		
			Case 0

				mainscr.AddWin(0.15, 0, 1, 0.7, COLOR_LIGHTCORAL, 1, "")
		
				mainscr.AddWin(0, 0, 0.15, 1, $E0, 2, "Shortcuts")
		
				mainscr.AddWin(0.15, 0.7, 0.55, 1, $00C000, 3, "Output console")
				
				'mainscr.AddWin(0.55, 0.7, 1, 1, $C00000, 4, "Error list")
				mainscr.AddWin(0.55, 0.7, 1, 1, $C00000, 5, "Error list")
		
			Case 1

				mainscr.AddWin(0, 0, 0.85, 0.7, COLOR_LIGHTCORAL, 1, "")
		
				mainscr.AddWin(0.85, 0, 1, 1, $E0, 2, "Shortcuts")
		
				mainscr.AddWin(0, 0.7, 0.45, 1, $00C000, 3, "Output console")
		
				'mainscr.AddWin(0.45, 0.7, 0.85, 1, $C00000, 4, "Error list")
				mainscr.AddWin(0.45, 0.7, 0.85, 1, $C00000, 5, "Error list")
				
		End

		mainscr.CreateSplitters
		
	End
	
