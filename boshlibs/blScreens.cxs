					'					yy1b = yy1b + ScrY
					'					xx2b = xx2b + ScrX
					'					yy2b = yy2b + ScrY
					
					Select o1.orient
					
						Case 0
						
							If o2.orient = 1 Then
							
								If yy1b >= yy1a and yy2b <= yy2a Then
								
									Local dfx = Abs(xx1a - xx1b)
									If dfx < 5 Then o2.leftsplitter = o1
							
									dfx = Abs(xx2a - xx2b)
									If dfx < 5 Then o2.rightsplitter = o1
								
								EndIf
								
							EndIf
						
						Case 1
						
							If o2.orient = 0 Then
							
								If xx1b >= xx1a and xx2b <= xx2a Then
								
									Local dfy = Abs(yy1a - yy1b)
									If dfy < 5 Then o2.topsplitter = o1
							
									dfy = Abs(yy2a - yy2b)
									If dfy < 5 Then o2.bottomsplitter = o1
								
								EndIf
								
							EndIf
						
					End
										
				EndIf
					
			Next
					
		Next
		
		
		
						
		
					
