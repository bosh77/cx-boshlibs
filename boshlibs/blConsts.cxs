Enumerate JsTopLeft = 0, JsTopCenter = 1, JsTopRight = 2, JsMiddleLeft = 4, JsMiddleCenter = 5, JsMiddleRight = 6, JsBottomLeft = 8, JsBottomCenter = 9, JsBottomRight = 10

