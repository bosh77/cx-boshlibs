	Method DrawColorText(canv:Canvas, txt:String, xx, yy, cfor:ColorFormat, ju, sc:Float)
	
		Local x2:float = xx
		
		Local bd = ju & 64
		Local ed = ju & 128
		
		Local ke = 0
		
		If ed Then ke = 3 * sc + 1
		
		For Local i:Int = 0 To txt.Length - 1
		
			Local c:Int=txt[i]
						
			If c < 256 Then
				
				'Local offs:float
				Local ww:float
				
				'Local xdraw:float' = xt
				'Local ydraw:float' = yt '+ ofy
						
				'Local ix:float '= ww * Cos(ang) * sc * ka
				'Local iy:float '= ww * Sin(ang) * sc * ka
						
				'Local ox:float '= offs * Sin(ang) * sc
				'Local oy:float '= offs * Cos(ang) * sc
						
				'				Select mm
				'
				'					Case 0
				'
				'						'DrawImageRect(table1, xx + xt, yy + ofy, x1[c], y1[c], w1[c], h1[c], 0, sc, sc)
				'						'xt = xt + w1[c] * sc * ka '+ k
				'						offs = offy1[c]
				'						ww = w1[c]
				'
				'					Case 128
				'
				'						offs = offy[c]
				ww = w[c]
				'
				'
				'						'DrawImageRect(table1, xdraw + ox, ydraw + oy, x[c], y[c], ww, h[c], ang, sc, sc)
				'
				'				End
			
				'xdraw = xt
				'ydraw = yt '+ ofy
						
				
				'iy = ww * Sin(ang) * sc * ka
						
				'ox = offs * Sin(ang) * sc
				'oy = offs * Cos(ang) * sc
				
				'Select mm
				'	Case 0
				'		canv.DrawImageRect(table2, xdraw + ox, ydraw + oy, x1[c], y1[c], ww, h1[c], ang, sc, sc)
				'	Case 128
				
				Local cold:= canv.Color
				Local calp:= canv.Alpha
				
				If bd Then
					
					Local kb = 5 * sc + 1
				
					canv.SetColor 0.1, 0.1, 0.1
					
					canv.DrawImageRect(table1, x2 + kb, yy + kb, x[c], y[c], ww, h, 0, sc, sc)
					
				EndIf
				
				If ed Then
										
					canv.SetColor 0.1, 0.1, 0.1
					
					For Local xe = -ke To ke
						For Local ye = -ke To ke
							canv.DrawImageRect(table1, x2 + xe, yy + ye, x[c], y[c], ww, h, 0, sc, sc)
						Next
					Next
				
				EndIf
				
				Local c1 = cfor.GetColorFromCh(c)
				
				If c1 <> - 1 Then
					canv.SetColor(c1)
				Else
					canv.SetColor(cold[0], cold[1], cold[2], calp)
				EndIf
				
				
				'canv.SetColor( $ff303030)
				'canv.SetAlpha 1
				
				canv.DrawImageRect(table1, x2, yy, x[c], y[c], ww, h, 0, sc, sc)
				
				
				
				'EndIf
				
				'End
				
				x2 = x2 + (ww + ke) * sc * ka
				'yt = yt - iy
				
			Endif
			
		Next
		
		xsav = x2
		
	End Method
	
	
	
	
	
	Method DrawText(canv:Canvas, txt:String, xx, yy, c1, ju, sc:Float)
	
		Local x2:float = xx
		
		Local bd = ju & 64
		Local ed = ju & 128
		
		Local ke = 0
		
		If ed Then ke = 3 * sc + 1
		
		For Local i:Int = 0 To txt.Length - 1
		
			Local c:Int=txt[i]
						
			If c>0 And c < 256 Then
				
				'Local offs:float
				Local ww:float
				
				'Local xdraw:float' = xt
				'Local ydraw:float' = yt '+ ofy
						
				'Local ix:float '= ww * Cos(ang) * sc * ka
				'Local iy:float '= ww * Sin(ang) * sc * ka
						
				'Local ox:float '= offs * Sin(ang) * sc
				'Local oy:float '= offs * Cos(ang) * sc
						
				'				Select mm
				'
				'					Case 0
				'
				'						'DrawImageRect(table1, xx + xt, yy + ofy, x1[c], y1[c], w1[c], h1[c], 0, sc, sc)
				'						'xt = xt + w1[c] * sc * ka '+ k
				'						offs = offy1[c]
				'						ww = w1[c]
				'
				'					Case 128
				'
				'						offs = offy[c]
				ww = w[c]
				'
				'
				'						'DrawImageRect(table1, xdraw + ox, ydraw + oy, x[c], y[c], ww, h[c], ang, sc, sc)
				'
				'				End
			
				'xdraw = xt
				'ydraw = yt '+ ofy
						
				
				'iy = ww * Sin(ang) * sc * ka
						
				'ox = offs * Sin(ang) * sc
				'oy = offs * Cos(ang) * sc
				
				'Select mm
				'	Case 0
				'		canv.DrawImageRect(table2, xdraw + ox, ydraw + oy, x1[c], y1[c], ww, h1[c], ang, sc, sc)
				'	Case 128
				
				Local cold:= canv.Color
				Local calp:= canv.Alpha
				
				If bd Then
					
					Local kb = 5 * sc + 1
				
					canv.SetColor 0.1, 0.1, 0.1
					
					canv.DrawImageRect(table1, x2 + kb, yy + kb, x[c], y[c], ww, h, 0, sc, sc)
					
				EndIf
				
				If ed Then
										
					canv.SetColor 0.1, 0.1, 0.1
					
					For Local xe = -ke To ke
						For Local ye = -ke To ke
							canv.DrawImageRect(table1, x2 + xe, yy + ye, x[c], y[c], ww, h, 0, sc, sc)
						Next
					Next
				
				EndIf
				
				If c1 <> - 1 Then
					canv.SetColor(c1)
				Else
					canv.SetColor(cold[0], cold[1], cold[2], calp)
				EndIf
				
				'canv.SetColor( $ff303030)
				'canv.SetAlpha 1
				
				canv.DrawImageRect(table1, x2, yy, x[c], y[c], ww, h, 0, sc, sc)
				
				
				
				'EndIf
				
				'End
				
				x2 = x2 + (ww + ke) * sc * ka
				'yt = yt - iy
				
			Endif
			
		Next
		
		xsav = x2
		
	End Method
	
	Method GetTextWidth:float(txt:String, ju, sc:float = 1)
		
		'Local bd = ju & 64
		Local ed = ju & 128
		
		Local ke = 0
		
		If ed Then ke = 3 * sc + 1
		
		Local wt:float = 0
		
		For Local i:Int=0 To txt.Length-1
			
			Local c:Int=txt[i]
			
			If c < 256 Then
				
				'Print c
				
				Local iw:Float = (w[c] + ke) * sc * ka
			
				wt = wt + iw
				
				'				Select i
				'					Case txt.Length - 1
				'						wt = wt + w[c] * sc * ka
				'					Default
				'						wt = wt + w[c] * sc * ka
				'				End
				
			Endif
					
		Next
	
		'Print wt
		
		Return wt
		
	End Method
	
	Method GetTextHeight:float(txt:String, ju, sc:float = 1)
		
		Return h
		
	End
	


	
	#If NATIVEFONTSON then
	
	' Opens the native system font dialog (Windows / macOS / Linux).
	' Returns 1 if the user confirmed, 0 if they cancelled.
	' The chosen name and size are read with SelectedName() and SelectedSize():
	' the module doesn't write into application variables.
	Method SelectFont:Int()
		
		Return _SelectFont()
		
	End
	
	Method SelectedName:String()
		
		Return _GetFontName()
		
	End
	
	Method SelectedSize:Int()
		
		Return _GetFontSize()
		
	End
	
	#EndIf

End


Class ColorFormat
	
	Field chrcl:Int[]
	Field colors:Int[]
	
	Method New()
		
	End
	
	Method AddChrCol(ch, co)
		
		Local l = chrcl.Length
		
		chrcl = chrcl.Resize(l + 1)
		colors = colors.Resize(l + 1)
		
		chrcl[l] = ch
		colors[l] = co
		
		
	End
	
	Method GetColorFromCh(c)
	
		Local l = chrcl.Length
		
		For Local i = 0 To l - 1
			
			If chrcl[i] = c Then Return colors[i]
		
		Next
	
		Return -1
		
	End
	
End

Function DrawString(canv:Canvas, ff:blFont, txt:String, x, y, c1, ju, s:float = 1)
		
	Local g1:Int = ju & 3
	Local g2:Int = ju & 12
	'Local g3:Int = ju & 128

	'If txt.EndsWith("_") Then inson=True; txt=LeftString(txt,txt.Length-1)
	
	'Local xs:Int=x
	'Local ys:Int=y
	Local lengtht:Int = ff.GetTextWidth(txt, ju, s)
	Local heightt:Int = ff.h * s 'ff.GetTxtHeight(txt, s, g3)
	'Local heightt:Int = ff.h * s * blFont.ka * blFont.ky
		
	'If inson Then txt=txt+"_"
	
	'########
	'	If idcurrobj = idobjedit and counter & 32 Then txt = txt + "_"
	
	'JsTopLeft=0, JsTopCenter=1, JsTopRight=2, JsMiddleLeft=4, JsMiddleCenter=5, JsMiddleRight=6, JsBottomLeft=8, JsBottomCenter=9, JsBottomRight=10
		
	Local ox:float
	Local oy:float
	
	Select g1
		Case 1
			ox = lengtht / 2.0
			'xs = x - ox * Cos(ang)' * s
			'ys = y + ox * Sin(ang)' * s
		Case 2
			ox = lengtht
			'xs = x - ox * Cos(ang)' * s
			'ys = y + ox * Sin(ang)' * s
	End

	x = x - ox
	
	'g2 = 0
	
	Select g2
		Case 4
			oy = heightt / 2.0
			'xs = xs - ox * Sin(ang)' * s
			'ys = ys - ox * Cos(ang)' * s
			'ys = y-heightt/2
		Case 8
			oy = heightt
			'xs = xs - ox * Sin(ang)' * s
			'ys = ys - ox * Cos(ang)' * s
	End
	
	y = y - oy
	
	ff.DrawText(canv, txt, x, y, c1, ju, s)
	
End
	
Function DrawStringM(canv:Canvas, ff:blFont, txt:String, x, y, c1, ju, w, s:float = 1)

	Local g1:Int = ju & 3
	Local g2:Int = ju & 12
	'Local g3:Int = ju & 128
	

	'Local parole:String[] = txt.Split(" ")
		
	'Local l:Int = parole.Length
	
	txt = txt + " "
	'txt = txt + " " ' String.FromChar(2)
	
	'Local l:Int = txt.Length
	
	'	Local cc:Int[l]
	'	Local bk:Int[l]
	'
	'	Local idbk
	'
	'	For Local i = 0 To l - 1
	'
	'		Local d = txt[i]
	'
	'		cc[i] = d
	'
	'		If d = 32 Then bk[idbk] = i; idbk = idbk + 1
	'
	'	Next
	
	Local words:String[] = txt.Split(" ")
	
	Local l:Int = words.Length
	
	Local txtlines:String[] = New String[l + 4]
	'Local txtlines2:String[] = New String[l + 4]
	
	Local nl ', nl2
	
	'Local lenwords:Int[] = New Int[l + 10]
		
	'Local wordok:Int[] = New Int[l + 10]
	
	'For Local i:Int=0 To l-1
	'txtlines[i]=parole[i]
	'	lenwords[i] = ff.GetTxtWidth(parole[i], s, 0)
	'Next
		
	'Local n:Int=0
	'Local p:Int=0
	'Local lu:Int=0
	'Local p2, p3, e
	
	Local str1:String
	Local str2:String
	'Local strold:String
	
	
	'Local lu, id, idp
	
	'idp = 0
	
	
	For Local i:String = EachIn words
	
		str2 = str1 + i
		
		Local lw = ff.GetTextWidth(str2.Trim, ju, s)
	
		If lw > w Then
			
			txtlines[nl] = str1.Trim
		
			nl = nl + 1
					
			str1 = ""
			
		EndIf
		
		str1 = str1 + i + " "
		
	Next
	
	If str1.Trim <> "" Then txtlines[nl] = str1; nl = nl + 1
	
	
	
	'Local heightt:float = 0 'ff.h * s '* n * blFont.ka
	Local heightt:float = 0 '-ff.h * s * 0.2 '* n * blFont.ka
		
	For Local i = 0 To nl - 1
		
		Local addk:Float = 1
		If i < nl - 1 Then addk = blFont.ky
		Local addy:Float = ff.h * s * blFont.ka * addk
		
		If txtlines[i].Trim <> "" Then heightt = heightt + addy
	Next
	
	Local oy:float
	
	Select g2
		Case 4
			oy = heightt / 2.0
			'xs = xs - ox * Sin(ang)' * s
			'ys = ys - ox * Cos(ang)' * s
			'ys = y-heightt/2
		Case 8
			oy = heightt
			'xs = xs - ox * Sin(ang)' * s
			'ys = ys - ox * Cos(ang)' * s
	End
	
	y = y - oy
	
	'n = n - 1
	
	
	For Local i:Int = 0 To nl - 1
		
		txt = txtlines[i].Trim
		
		If txt <> "" Then
		
			Local lengtht:Int = ff.GetTextWidth(txt, ju, s)
		
	
			Local ox:float
		
	
			Select g1
				Case 1
					ox = lengtht / 2.0
					'xs = x - ox * Cos(ang)' * s
					'ys = y + ox * Sin(ang)' * s
				Case 2
					ox = lengtht
					'xs = x - ox * Cos(ang)' * s
					'ys = y + ox * Sin(ang)' * s
			End

			'x = x - ox
		
			'DrawString(ff, txt, x, y, ju, s)
			ff.DrawText(canv, txt, x - ox, y, c1, ju, s)
		
			'y2 = y2 + iy
			'x3 = x3 + ix3
			'y3 = y3 + iy3
			
			Local addk:Float = 1
			If i < nl - 1 Then addk = blFont.ky
			Local addy:Float = ff.h * s * blFont.ka * addk
			
			y = y + addy
		
		EndIf
		
	Next
	
End


Function CreateFontFromFile:blFont(file:String)
		
	Local O:= New blFont(file)
		
	Return O
	
End Function
	
Function CreateFontFromSystem:blFont(fontname:String, fontsize)
		
	Local O:= New blFont(fontname, fontsize)
		
	Return O
	
End Function


