
' blFonts - native operating system fonts, rendered as a mojo2 texture
' atlas. Extracted from SweetHome (newer and working version).
'
' Three ways to get a font:
'
'   1) New blFont("manrope")                      atlas already ready in data/fonts (.png + .txt)
'   2) New blFont("Georgia", 30)                  system font by name and size
'      New blFont("cerberus://data/X.ttf", 30)    or a .ttf placed in the assets
'   3) blFont.TextImage("Georgia", 30, "ciao")    a single text as Image
'
' Mode 3 doesn't build the alphabet: it costs as much as the text and not as
' the font, so it's the right one for fixed texts (menu items, list rows).
'
' System fonts activate by themselves on the targets for which a real native
' implementation exists below. The app no longer has to declare anything;
' it can still force  #NATIVEFONTSON = 1  before the Imports.
'
' Those without system fonts (atlas mode from file): html5 and any target
' that's not glfw/android/ios. iOS has the native (CoreText, like macOS)
' since 2026-09-03, tested only on the iOS Simulator.

#If TARGET="android" Or TARGET="ios" Or (TARGET="glfw" And (HOST="winnt" Or HOST="macos" Or HOST="linux"))
#NATIVEFONTSON = 1
#EndIf


#If NATIVEFONTSON then

' The common C++ includes (<string>, <windows.h>, gdiplus) and convertBBString
' are in native/boshlib.cpp: the blFonts-*.cpp files have no includes of their
' own and count on finding them already emitted, so this Import must come
' BEFORE them. It goes through blNative because importing the same .cpp
' twice would duplicate it in the generated main.cpp.
Import blNative


' HOST is the system you compile on, not the target: for Android you must
' look at TARGET, otherwise building the apk from Windows would include the
' win file.

#If TARGET="android" Then
Import "native/blFonts-android.java"
#EndIf

' iOS: written 2026-09-03 (CoreText/CoreGraphics, same approach as
' blFonts-mac.cpp - see PORT-MAC-LINUX.md). Tested only on the iOS Simulator.
' CoreGraphics.framework is already in the ios template project; CoreText.framework
' isn't, and must be added - here #LIBS+= really works (src/transcc/builders/
' ios.cxs), so there's no need to touch the installation (see PORT-MAC-LINUX.md).
#If TARGET="ios" Then
Import "native/blFonts-ios.cpp"
#LIBS+="CoreText.framework"
#EndIf


' TARGET="glfw", not just "TARGET<>android": HOST="macos" also applies to ios
' (same host, different target) or html5 from a Mac, where the CoreText/
' GDI+/X11 natives must not be imported. Found out testing blVideos on iOS.
#If TARGET="glfw" And HOST="winnt" Then
Import "native/blFonts-win.cpp"
' the natives use range-for and auto: with MinGW C++11 must be turned on
' by hand (with MSVC the option is ignored and doesn't hurt)
#GLFW_GCC_CC_OPTS+="-std=gnu++11"
#EndIf


#If TARGET="glfw" And HOST="macos" Then
Import "native/blFonts-mac.cpp"
#GLFW_GCC_CC_OPTS+="-std=gnu++11"
#EndIf


#If TARGET="glfw" And HOST="linux" Then
Import "native/blFonts-linux.cpp"
#GLFW_GCC_CC_OPTS+="-std=gnu++11"
#GLFW_GCC_CC_OPTS+="-I/usr/include/freetype2"
#GLFW_GCC_LIB_OPTS+="-lfreetype"
#GLFW_GCC_LIB_OPTS+="-lfontconfig"
#EndIf


' iOS: there's no native source yet, blFonts-ios.cpp is empty.

#Endif

Import mojo2

Import brl.databuffer

#If NATIVEFONTSON then

Extern

