Enumerate TxEdge = 128, TxBorder = 64, TxMultiLine = 32

Enumerate TxOrRectEvidYellow = $1000000
Enumerate TxOrRectEvidAzure = $2000000
Enumerate TxOrRectEvidOrange = $3000000

