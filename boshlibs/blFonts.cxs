	Function GetFontList:String[] ()
	
		Return _GetFontListString().Split(";")
	 
	End


	' Image of a single text, ready to draw on the Canvas.
	'
	' It costs as much as the text and not as the font: a font name at size 40
	' takes a few tens of kilobytes, while the full atlas built by
	' New blFont(...) takes over a thousand. If a text never changes (a menu
	' item, a font name in a list) this one is better.
	'
	' The image is white with the alpha channel: the color is decided by whoever
	' draws with canv.SetColor before DrawRect.
	Function TextImage:Image(fontname:String, fontsize:Int, txt:String, alignx:Int = 0)

		Local bb:BBGetFont = CreateTextImage(fontname, fontsize, txt, alignx)

		If bb = Null Then Return Null
		If bb.dataPixel.Length < 6 Then Return Null

		Local ww:Int = bb.dataPixel[0]
		Local hh:Int = bb.dataPixel[1]

		If ww < 1 Or hh < 1 Then Return Null
		If bb.dataPixel.Length < ww * hh * 4 + 2 Then Return Null

		Local dd:DataBuffer = New DataBuffer(ww * hh * 4)

		Local j:Int = 2

		For Local i:Int = 0 Until ww * hh * 4 Step 4

			' the native delivers B,G,R,A with the text black on a white
			' background: inverting it gives a white text and the alpha channel
			' comes out of the brightness, so the edges stay blurred
			Local kb:Int = 255 - bb.dataPixel[j]
			Local kg:Int = 255 - bb.dataPixel[j + 1]
			Local kr:Int = 255 - bb.dataPixel[j + 2]

			dd.PokeByte(i + 0, kr)
			dd.PokeByte(i + 1, kg)
			dd.PokeByte(i + 2, kb)
			dd.PokeByte(i + 3, (kr + kg + kb) / 3)

			j += 4

		Next

		Local im:Image = New Image(ww, hh, 0, 0)

		im.WritePixels(0, 0, ww, hh, dd)

		dd.Discard()

		Return im

	End
	
	' Like TextImage, but KEEPING the colors of the text: for the emoji, which
	' are in color. TextImage inverts the pixels to get a white text to tint
	' with SetColor, and on an emoji that inversion gives the negative.
	'
	' Here the color stays the original and the alpha comes from how far the
	' pixel is from white: the native draws on a white background, so
	' white = nothing, everything else = full.
	'
	' Draw it with canv.SetColor(COL_WHITE), otherwise the current color
	' multiplies the ones in the image and dirtles them.
	'
	' Limit: the WHITE parts of an emoji become transparent, because on the
	' white background they can't be told apart. With solid emoji it doesn't
	' show; on those with white eyes or borders it does.
	Function TextImageColor:Image(fontname:String, fontsize:Int, txt:String, alignx:Int = 0)

		Local bb:BBGetFont = CreateTextImage(fontname, fontsize, txt, alignx)

		If bb = Null Then Return Null
		If bb.dataPixel.Length < 6 Then Return Null

		Local ww:Int = bb.dataPixel[0]
		Local hh:Int = bb.dataPixel[1]

		If ww < 1 Or hh < 1 Then Return Null
		If bb.dataPixel.Length < ww * hh * 4 + 2 Then Return Null

		Local dd:DataBuffer = New DataBuffer(ww * hh * 4)

		Local j:Int = 2

		For Local i:Int = 0 Until ww * hh * 4 Step 4

			' the native delivers B,G,R,A
			Local kb:Int = bb.dataPixel[j]
			Local kg:Int = bb.dataPixel[j + 1]
			Local kr:Int = bb.dataPixel[j + 2]

			' how far it is from white: you look at the lowest component,
			' so a full red (255,0,0) stays opaque instead of becoming
			' semi-transparent as the average would do
			Local mn:Int = kr

			If kg < mn Then mn = kg
			If kb < mn Then mn = kb

			Local ka:Int = 255 - mn

			' The colors must be PREMULTIPLIED by the alpha: mojo2 works
			' that way. Without it, the white background (255,255,255 with
			' alpha 0) stays full white and the text comes out inside an
			' opaque rectangle.
			' TextImage doesn't have this problem only because there the
			' background, being inverted, is already black.
			dd.PokeByte(i + 0, kr * ka / 255)
			dd.PokeByte(i + 1, kg * ka / 255)
			dd.PokeByte(i + 2, kb * ka / 255)
			dd.PokeByte(i + 3, ka)

		 	j += 4

		Next

		Local im:Image = New Image(ww, hh, 0, 0)

		im.WritePixels(0, 0, ww, hh, dd)

		dd.Discard()

		Return im

	End
	
	
	Method New(file:String)
	
	
		Local a:String
 			
		a = app.LoadString("cerberus://data/fonts/" + file + ".txt")
		
		
		Self.table1 = Image.Load("cerberus://data/fonts/" + file + ".png", 0, 0)
	
		Local d:String[]=a.Split(",")
		
	
		Local j:Int = 0
		
		h = Int(d[j])
		
		j = j + 1
		
		For Local i:Int = 32 To 255
		
			'Print i + "," + j
			
			Self.x[i] = Int(d[j])
			Self.y[i] = Int(d[j + 1])
			Self.w[i] = Int(d[j + 2])
			
			j = j + 3
				
		Next
		
	End
	
	
	#If NATIVEFONTSON then
	
	Method New(fontname:String, fontsize)
			
		'_New(fontname, fontsize, peso, ital)
		
		'Print "1"
		
		_New(fontname, fontsize, 0, False)
		
		'Print "2"
		
		Local bbf:= CreateFont(fontname, fontsize)
				
		'Print "3"
				
		'Print bbf.hFont

		'ADJUST FONT
		'@@@@@@@@
		bbf = AdjustFONT(bbf)
				
		Local db:= bbf.dataPixel
				
		'Print db.Length
		
		'Print db[0]
		'Print db[1]
		
		Local ww = db[0]
		Local hh = db[1]
		
		
		'w = ww
		'h = hh
		
		'PROVAI = New Image(ww, hh, 0, 0, 0)
		Self.table1 = New Image(ww, hh, 0, 0) ', 0) ' Image.Filter) ' | Image.Mipmap) ', 0)
		
		Local l = ww * hh * 4
		
		Local dd:DataBuffer = New DataBuffer(l)
		
		Local j = 2
		
		'Local ka
		
		For Local i = 0 To l - 1 Step 4
		
			'If db[j] < 140 Then
			'			If db[j] < 220 and db[j + 1] < 220 and db[j + 2] < 220 Then
			'				ka = 255
			'			Else
			'				ka = 0
			'			EndIf
			
			Local k1 = 255 - db[j]
			Local k2 = 255 - db[j + 1]
			Local k3 = 255 - db[j + 2]
			Local k4 = db[j + 3]
			  
			'k1=200
			
			'########
			'If k1 < 128 Then k4 = 0 Else k4 = 255
			'If k1 < 188 and k2 < 188 and k3 < 188 Then k4 = 0 Else k4 = 255
			
			
			'If k1 < KPROVA and k2 < KPROVA and k3 < KPROVA Then
			'If k1 < KPROVA or k2 < KPROVA or k3 < KPROVA Then
			'k4 = 0
			'Else
			'	k4 = 250
			'EndIf
			
			k4 = (k1 + k2 + k3) / 3.0
			
			'****
			'k1 = 200; k4 = 255
			
			dd.PokeByte(i + 0, k3)
			dd.PokeByte(i + 1, k2)
			dd.PokeByte(i + 2, k1)
			dd.PokeByte(i + 3, k4)
			
			'			dd.PokeByte(i + 0, 255)
			'			dd.PokeByte(i + 1, db[j + 1])
			'			dd.PokeByte(i + 2, db[j + 2])
			'			dd.PokeByte(i + 3, db[j + 0])
		
			j = j + 4
		Next
		
		
		'		PROVAI.WritePixels(0, 0, ww, hh, dd)
		Self.table1.WritePixels(0, 0, ww, hh, dd)
				
		Local KK = 105 - 32
				
		Local kx = bbf.xFont[KK]
		Local ky = bbf.yFont[KK]
		
		Local kw = bbf.wFont[KK]
		
		Local kh = bbf.hFont
				
		PROVAI2 = New Image(Self.table1, kx, ky, kw, kh, 0, 0)
				
		KK = 106 - 32
				
		kx = bbf.xFont[KK]
		ky = bbf.yFont[KK]
		kw = bbf.wFont[KK]
		'h = bbf.hFont
				
		PROVAI3 = New Image(Self.table1, kx, ky, kw, kh, 0, 0)
		
		
		Self.x = Self.x.Resize(256)
		Self.y = Self.y.Resize(256)
		Self.w = Self.w.Resize(256)
		
		'Print kh
		
		h = bbf.hFont
		
		j = 0
		
		For Local i:Int = 32 To 255
		
			Self.x[i] = bbf.xFont[j]
			Self.y[i] = bbf.yFont[j]
			Self.w[i] = bbf.wFont[j]
			
			j = j + 1
				
		Next
		
				
				
		'PROVAI3 = New Canvas(PROVAI2)
				
	
	End
	
	Function AdjustFONT:BBGetFont(bb:BBGetFont)
	
		Local KK1 = 0 '7
		Local KK2 = 0 '7
		
		#If HOST="macos" Then
		
			KK1 = 7
			KK2 = 7
		
		#Endif
		
		'For Local i = 2 To 10000
		'	bb.dataPixel[i] = 200
		'Next
	
		Local ww = bb.dataPixel[0]
		'Local hh = bb.dataPixel[1]
		
		Local h = bb.hFont
		
		'Print "->" + h
		
		Local nyf = 9999
		Local nyf2 = -9999
						
		For Local i = 1 To 223
		
			Local x = bb.xFont[i]
			Local y = bb.yFont[i]
			Local w = bb.wFont[i]
					
			Local ofy = i / 32
			ofy = ofy * h
			
			'STEP 1 downward
			For Local j = y + KK1 To y + h + KK1 - KK2 - 1
				For Local j2 = x To x + w - 1
					Local id = (j * ww + j2) * 4 + 2
					Local z1 = bb.dataPixel[id + 2]
					If z1 < 128 Then
						If j - ofy < nyf Then nyf = j - ofy
						Exit
					EndIf
				Next
			Next j
		
			'STEP 2 upward
			For Local j = y + h + KK1 - KK2 - 1 To y + KK1 Step - 1
				For Local j2 = x To x + w - 1
					Local id = (j * ww + j2) * 4 + 2
					Local z1 = bb.dataPixel[id + 2]
					If z1 < 128 Then
						If j - ofy > nyf2 Then nyf2 = j - ofy
						Exit
					EndIf
				Next
			Next
		Next
		
		For Local i = 1 To 223
			Local ofy = (i / 32) * h
			bb.yFont[i] = nyf + ofy
		Next
		
		bb.hFont = nyf2 - nyf + 1 '- 5
		
		Return bb
		
	End
	
	#EndIf
	
	
