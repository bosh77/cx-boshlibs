' Renders a single text instead of the whole alphabet: the returned image is
' as big as the text. alignx: 0 left, 1 center, 2 right.
Function CreateTextImage:BBGetFont(fontname:String, fontsize, txt:String, alignx:Int = 0) = "_CreateTextImage"

'Function MaximizeWin:Void() = "MAXWIN"
	
