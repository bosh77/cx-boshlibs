' --- orientation cube (TOP / BOTTOM / FRONT / BACK / LEFT / RIGHT) ------
' Moved here from CxCAD on 2026-09-03 with its six textures, so any
' application can have it:  MCubo = New Model(CreateMCuboMesh())

Function CreateCubeMat:material.Material(texfile:String)
	Local m:material.Material = New material.Material
	m.Color = vortex3.color.Color.RGB(220, 220, 220)
	m.ColorTexture = vortex3.texture.Texture.Load(texfile)
	Return m
End

Function CreateCubeFace:Surface(ax:Float, ay:Float, az:Float, bx:Float, by:Float, bz:Float, cx:Float, cy:Float, cz:Float, dx:Float, dy:Float, dz:Float, nx:Float, ny:Float, nz:Float, tx:Float, ty:Float, tz:Float)
	Local s:Surface = New Surface
	s.AddVertex(ax, ay, az, nx, ny, nz, $FFFFFFFF, 0, 0); s.VertexTangent(0, tx, ty, tz)
	s.AddVertex(bx, by, bz, nx, ny, nz, $FFFFFFFF, 1, 0); s.VertexTangent(1, tx, ty, tz)
	s.AddVertex(cx, cy, cz, nx, ny, nz, $FFFFFFFF, 0, 1); s.VertexTangent(2, tx, ty, tz)
	s.AddVertex(dx, dy, dz, nx, ny, nz, $FFFFFFFF, 1, 1); s.VertexTangent(3, tx, ty, tz)
	s.AddTriangle(0, 1, 2)
	s.AddTriangle(3, 2, 1)
	Return s
End

Function CreateCubeFace180:Surface(ax:Float, ay:Float, az:Float, bx:Float, by:Float, bz:Float, cx:Float, cy:Float, cz:Float, dx:Float, dy:Float, dz:Float, nx:Float, ny:Float, nz:Float, tx:Float, ty:Float, tz:Float)
	Local s:Surface = New Surface
	s.AddVertex(ax, ay, az, nx, ny, nz, $FFFFFFFF, 1, 1); s.VertexTangent(0, tx, ty, tz)
	s.AddVertex(bx, by, bz, nx, ny, nz, $FFFFFFFF, 0, 1); s.VertexTangent(1, tx, ty, tz)
	s.AddVertex(cx, cy, cz, nx, ny, nz, $FFFFFFFF, 1, 0); s.VertexTangent(2, tx, ty, tz)
	s.AddVertex(dx, dy, dz, nx, ny, nz, $FFFFFFFF, 0, 0); s.VertexTangent(3, tx, ty, tz)
	s.AddTriangle(0, 1, 2)
	s.AddTriangle(3, 2, 1)
	Return s
End

Function CreateMCuboMesh:Mesh()
	Local m:Mesh = New Mesh
	m.AddSurface(CreateCubeFace( 0.5, 0.5, 0.5, -0.5, 0.5, 0.5,  0.5,-0.5, 0.5, -0.5,-0.5, 0.5,  0, 0, 1, -1, 0, 0), CreateCubeMat("cube_top.png"))
	m.AddSurface(CreateCubeFace(-0.5, 0.5,-0.5,  0.5, 0.5,-0.5, -0.5,-0.5,-0.5,  0.5,-0.5,-0.5,  0, 0,-1,  1, 0, 0), CreateCubeMat("cube_bottom.png"))
	m.AddSurface(CreateCubeFace180(-0.5,-0.5,-0.5,  0.5,-0.5,-0.5, -0.5,-0.5, 0.5,  0.5,-0.5, 0.5,  0,-1, 0,  1, 0, 0), CreateCubeMat("cube_front.png"))
	m.AddSurface(CreateCubeFace180(-0.5, 0.5, 0.5,  0.5, 0.5, 0.5, -0.5, 0.5,-0.5,  0.5, 0.5,-0.5,  0, 1, 0,  1, 0, 0), CreateCubeMat("cube_back.png"))
	m.AddSurface(CreateCubeFace( 0.5, 0.5,-0.5,  0.5, 0.5, 0.5,  0.5,-0.5,-0.5,  0.5,-0.5, 0.5,  1, 0, 0,  0, 0, 1), CreateCubeMat("cube_left.png"))
	m.AddSurface(CreateCubeFace(-0.5, 0.5, 0.5, -0.5, 0.5,-0.5, -0.5,-0.5, 0.5, -0.5,-0.5,-0.5, -1, 0, 0,  0, 0,-1), CreateCubeMat("cube_right.png"))
	m.Rebuild()
	Return m
End
